defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Engines.BattleOutcomeAnalysisEngine do
  @moduledoc """
  Engine for comprehensive battle outcome analysis and critical moment identification.

  Provides detailed analysis of battle effectiveness trends, critical moments detection,
  performance analysis, and side classification for engagement analysis.

  Handles:
  - Battle effectiveness trend analysis over multiple phases
  - Critical moment identification (kill spikes, turning points, high-value losses)
  - Performance vs expected analysis and calculations
  - Battle outcome determination and confidence scoring
  - Side classification and participant grouping for single-group battles
  - Ship class performance calculation integration
  - Loss analysis and ratio calculations
  - Engagement pattern analysis and phase intensity calculation
  """

  require Logger
  alias EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Engines.BattleOutcomePredictor

  @doc """
  Analyze effectiveness trends between battle phases.
  """
  def analyze_effectiveness_trends(sides, killmails) do
    BattleOutcomePredictor.analyze_effectiveness_trends(sides, killmails)
  end

  @doc """
  Calculate phase intensity based on kill rates.
  """
  def calculate_phase_intensity(phase_kills, sides) do
    BattleOutcomePredictor.calculate_phase_intensity(phase_kills, sides)
  end

  @doc """
  Determine trend direction from phase analysis.
  """
  def determine_trend(phase_analysis) do
    BattleOutcomePredictor.determine_trend(phase_analysis)
  end

  @doc """
  Analyze losses by fleet composition.
  """
  def analyze_losses_by_composition(sides, killmails) do
    BattleOutcomePredictor.analyze_losses_by_composition(sides, killmails)
  end

  @doc """
  Analyze losses for a specific side.
  """
  def analyze_side_losses(losses, side_participants) do
    BattleOutcomePredictor.analyze_side_losses(losses, side_participants)
  end

  @doc """
  Classify ship by type ID.
  """
  def classify_ship_by_type_id(ship_type_id) do
    BattleOutcomePredictor.classify_ship_by_type_id(ship_type_id)
  end

  @doc """
  Calculate loss ratio between two sides.
  """
  def calculate_loss_ratio(side_a_losses, side_b_losses) do
    BattleOutcomePredictor.calculate_loss_ratio(side_a_losses, side_b_losses)
  end

  @doc """
  Analyze performance vs expected metrics.
  """
  def analyze_performance_vs_expected(sides, killmails) do
    BattleOutcomePredictor.analyze_performance_vs_expected(sides, killmails)
  end

  @doc """
  Estimate expected performance based on fleet composition.
  """
  def estimate_expected_performance(side_participants) do
    BattleOutcomePredictor.estimate_expected_performance(side_participants)
  end

  @doc """
  Calculate actual performance from battle results.
  """
  def calculate_actual_performance(side_participants, killmails) do
    # Calculate actual performance from battle results
    if Enum.empty?(side_participants) or Enum.empty?(killmails) do
      0.0
    else
      # Create character ID set for side participants
      side_chars =
        MapSet.new(side_participants, fn participant ->
          Map.get(participant, :character_id) ||
            Map.get(participant, :attacker_character_id) ||
            Map.get(participant, :victim_character_id)
        end)

      # Count kills achieved by this side
      kills_achieved =
        Enum.count(killmails, fn km ->
          # Check if any attacker is from this side
          attackers = Map.get(km, :attackers, [])
          Enum.any?(attackers, fn attacker ->
            attacker_id = Map.get(attacker, :character_id)
            MapSet.member?(side_chars, attacker_id)
          end)
        end)

      losses_suffered =
        Enum.count(killmails, fn km ->
          victim_id = Map.get(km, :victim_character_id)
          MapSet.member?(side_chars, victim_id)
        end)

      # Calculate performance score
      if length(side_participants) > 0 do
        kill_score = kills_achieved / length(side_participants)
        loss_penalty = losses_suffered / length(side_participants)

        performance = max(0.0, kill_score - loss_penalty * 0.5)
        Float.round(performance, 2)
      else
        0.0
      end
    end
  end

  @doc """
  Identify critical moments in the battle.
  """
  def identify_critical_moments(sides, killmails) do
    BattleOutcomePredictor.identify_critical_moments(sides, killmails)
  end

  @doc """
  Identify kill spikes in the battle timeline.
  """
  def identify_kill_spikes(sorted_killmails) do
    if Enum.empty?(sorted_killmails) do
      []
    else
      # Group killmails by 5-minute windows
      time_windows =
        sorted_killmails
        Enum.group_by(fn km ->
          timestamp = Map.get(km, :killmail_time)
          # Round to 5-minute intervals for grouping
          (DateTime.to_unix(timestamp, :minute) |> div(5)) * 5
        end)

      # Find windows with high activity
      avg_kills_per_window = length(sorted_killmails) / map_size(time_windows)

      time_windows
      Enum.filter(fn {_time, kills} -> length(kills) > avg_kills_per_window * 2 end)
      Enum.map(fn {time, kills} ->
        %{
          type: :kill_spike,
          timestamp: DateTime.from_unix!(time * 60),
          description: "High activity spike - #{length(kills)} kills in 5 minutes",
          severity: :high
        }
      end)
    end
  end

  @doc """
  Identify high-value target losses.
  """
  def identify_high_value_losses(sorted_killmails) do
    sorted_killmails
    Enum.filter(fn km ->
      # Simple high-value detection - would need more sophisticated logic
      ship_type_id = Map.get(km, :ship_type_id, 0)
      # Assume capital ships are high value (placeholder logic)
      ship_type_id > 20000
    end)
    Enum.map(fn km ->
      %{
        type: :high_value_loss,
        timestamp: Map.get(km, :killmail_time),
        description: "Capital ship destroyed",
        severity: :critical
      }
    end)
  end

  @doc """
  Identify turning points in the battle.
  """
  def identify_turning_points(sorted_killmails, _sides) do
    if length(sorted_killmails) < 10 do
      []
    else
      # Simple turning point detection based on kill momentum shifts
      sorted_killmails
      Enum.chunk_every(10, 5, :discard)
      Enum.with_index()
      Enum.filter(fn {phase_kills, _index} ->
        length(phase_kills) > 15  # Significant escalation threshold
      end)
      Enum.map(fn {phase_kills, index} ->
        %{
          type: :turning_point,
          timestamp: phase_kills |> List.first() |> Map.get(:killmail_time),
          description: "Significant escalation in phase #{index + 1}",
          severity: :medium
        }
      end)
    end
  end

  @doc """
  Determine battle outcome based on effectiveness and kill data.
  """
  def determine_battle_outcome(side_a_effectiveness, side_b_effectiveness, killmails) do
    if Enum.empty?(killmails) do
      %{
        outcome: :inconclusive,
        victor: :none,
        confidence: :low,
        effectiveness_difference: 0.0,
        total_kills: 0
      }
    else
      # Calculate effectiveness difference
      effectiveness_diff = side_a_effectiveness - side_b_effectiveness

      # Determine victor based on effectiveness
      victor =
        cond do
          effectiveness_diff > 0.3 -> :side_a
          effectiveness_diff < -0.3 -> :side_b
          true -> :contested
        end

      # Determine confidence based on kill data
      confidence =
        cond do
          abs(effectiveness_diff) > 0.4 -> :high
          abs(effectiveness_diff) > 0.2 -> :medium
          true -> :low
        end

      %{
        outcome: if(victor == :contested, do: :stalemate, else: :victory),
        victor: victor,
        confidence: confidence,
        effectiveness_difference: Float.round(effectiveness_diff, 2),
        total_kills: length(killmails)
      }
    end
  end

  @doc """
  Calculate detailed performance metrics for a ship class (integration point).
  """
  def do_calculate_ship_class_performance(ship_class, ships, killmails) do
    # This delegates to ShipClassPerformanceAnalyzer for consistency
    # but is included here as it's part of the battle outcome analysis flow

    # Note: This would typically delegate to the ShipClassPerformanceAnalyzer
    # For now, return a simplified structure
    %{
      ship_class: ship_class,
      ship_count: length(ships),
      performance_calculated: true,
      note: "Delegates to ShipClassPerformanceAnalyzer"
    }
  end

  @doc """
  Split single group by engagement patterns (for side classification).
  """
  def split_single_group_by_engagement(participants) do
    # Split participants when they appear to be a single group but have internal conflicts
    if length(participants) < 4 do
      %{side_a: participants, side_b: []}
    else
      # Build engagement graph from killmail patterns
      engagement_pairs =
        participants
        Enum.flat_map(fn p1 ->
          Enum.map(participants, fn p2 ->
            # Simple heuristic: different corporations/alliances might be opposing sides
            p1_corp = Map.get(p1, :corporation_id, 0)
            p2_corp = Map.get(p2, :corporation_id, 0)
            p1_alliance = Map.get(p1, :alliance_id, 0)
            p2_alliance = Map.get(p2, :alliance_id, 0)

            if (p1_corp != p2_corp and p1_alliance != p2_alliance) do
              {Map.get(p1, :character_id), Map.get(p2, :character_id)}
            else
              nil
            end
          end)
        end)
        Enum.filter(&(!is_nil(&1)))
        Enum.uniq()

      # Build adjacency map
      adjacency =
        engagement_pairs
        Enum.group_by(&elem(&1, 0), &elem(&1, 1))

      # Use simple graph partitioning - find two groups with minimal cross-edges
      # Start with first participant as seed for side A
      case participants do
        [first | _rest] ->
          first_id =
            Map.get(first, :character_id) ||
              Map.get(first, :attacker_character_id) ||
              Map.get(first, :victim_character_id)

          # Build side A from connections
          side_a_ids = build_connected_component(first_id, adjacency, MapSet.new([first_id]))

          # Partition participants based on discovered groups
          {side_a, side_b} =
            Enum.split_with(participants, fn p ->
              p_id =
                Map.get(p, :character_id) ||
                  Map.get(p, :attacker_character_id) ||
                  Map.get(p, :victim_character_id)

              MapSet.member?(side_a_ids, p_id)
            end)

          # If one side is empty or too imbalanced, fall back to simple split
          if Enum.empty?(side_b) || length(side_a) / length(participants) > 0.8 do
            %{
              side_a: Enum.take(participants, div(length(participants), 2)),
              side_b: Enum.drop(participants, div(length(participants), 2))
            }
          else
            %{side_a: side_a, side_b: side_b}
          end

        [] ->
          %{side_a: [], side_b: []}
      end
    end
  end

  @doc """
  Build connected component for graph-based side classification.
  """
  def build_connected_component(node, adjacency, visited) do
    if MapSet.member?(visited, node) do
      visited
    else
      new_visited = MapSet.put(visited, node)

      # Get unvisited neighbors
      neighbors = Map.get(adjacency, node, [])
      unvisited_neighbors = Enum.reject(neighbors, &MapSet.member?(visited, &1))

      # Recursively visit neighbors
      Enum.reduce(unvisited_neighbors, new_visited, fn neighbor, acc ->
        build_connected_component(neighbor, adjacency, acc)
      end)
    end
  end

  @doc """
  Convert ship list to participant format for analysis.
  """
  def convert_ships_to_participants(ship_list) when is_list(ship_list) do
    ship_list
    Enum.with_index()
    Enum.map(fn {ship, index} ->
      %{
        character_id: index,
        ship_name: Map.get(ship, :ship_name, "Unknown"),
        ship_type_id: Map.get(ship, :ship_type_id, 0),
        # Default to side_a since we don't have battle context
        side: :side_a,
        corporation_id: Map.get(ship, :corporation_id, 0),
        alliance_id: Map.get(ship, :alliance_id, 0)
      }
    end)
  end
end
