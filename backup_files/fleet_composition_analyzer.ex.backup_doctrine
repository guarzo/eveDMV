    synergy_advantages =
      if side_a_analysis.fleet_synergy > side_b_analysis.fleet_synergy * 1.3 do
        [%{advantage: :synergy_advantage, side: :side_a, magnitude: :moderate}]
      else
        []
      end

    advantages = numerical_advantages ++ logistics_advantages ++ synergy_advantages

    %{
