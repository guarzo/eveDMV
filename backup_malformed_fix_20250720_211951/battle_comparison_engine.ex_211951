defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.BattleComparisonEngine do
  @moduledoc """
  Handles battle comparison, evolution analysis, and cross-battle pattern detection.

  Responsible for:
  - Identifying common patterns across multiple battles
  - Analyzing tactical evolution over time
  - Comparing effectiveness trends between battles
  - Tracking doctrine usage patterns and changes
  - Analyzing ship composition trends
  - Detecting tactical adaptations and innovations
  """

  require Logger

  @doc """
  Identify common tactical patterns across multiple battles.
  """
  def identify_common_patterns(battle_analyses) do
    if length(battle_analyses) < 2 do
      []
    else
      # Extract patterns from each battle
      all_patterns =
        battle_analyses
        |> Enum.flat_map(fn analysis ->
          extract_patterns_from_battle(analysis)
        end)
        |> Enum.group_by(& &1.pattern_type)

      # Find patterns that appear in multiple battles
      common_patterns =
        all_patterns
        |> Enum.map(fn {pattern_type, instances} ->
          if length(instances) >= 2 do
            %{
              pattern_type: pattern_type,
              occurrences: length(instances),
              frequency: Float.round(length(instances) / length(battle_analyses) * 100, 1),
              examples: Enum.take(instances, 3),
              confidence: calculate_pattern_confidence(instances)
            }
          else
            nil
          end
        end)
        |> Enum.filter(&(&1 != nil))
        |> Enum.sort_by(& &1.frequency, :desc)

      common_patterns
    end
  end

  @doc """
  Analyze how tactics and ship usage evolve across multiple battles.
  """
  def analyze_tactical_evolution(battle_analyses) do
    if length(battle_analyses) < 2 do
      %{
        evolution_detected: false,
        message: "Need at least 2 battles to analyze tactical evolution",
        trends: []
      }
    else
      # Sort battles by time to analyze chronological evolution
      sorted_battles =
        Enum.sort_by(battle_analyses, fn analysis ->
          case analysis do
            %{start_time: time} -> time
            %{timestamp: time} -> time
            _ -> ~N[1970-01-01 00:00:00]
          end
        end)

      # Analyze various tactical trends
      doctrine_evolution = analyze_doctrine_evolution(sorted_battles)
      ship_composition_trends = analyze_ship_composition_trends(sorted_battles)
      engagement_pattern_evolution = analyze_engagement_pattern_evolution(sorted_battles)
      tactical_adaptation = analyze_tactical_adaptation(sorted_battles)

      %{
        evolution_detected: true,
        total_battles_analyzed: length(sorted_battles),
        time_span: calculate_analysis_timespan(sorted_battles),
        doctrine_evolution: doctrine_evolution,
        ship_composition_trends: ship_composition_trends,
        engagement_patterns: engagement_pattern_evolution,
        tactical_adaptations: tactical_adaptation,
        summary:
          generate_evolution_summary(
            doctrine_evolution,
            ship_composition_trends,
            engagement_pattern_evolution
          )
      }
    end
  end

  @doc """
  Compare effectiveness trends across battles.
  """
  def compare_effectiveness_trends(battle_analyses) do
    if length(battle_analyses) < 2 do
      %{trend: :insufficient_data}
    else
      # Extract effectiveness metrics from each battle
      effectiveness_data =
        battle_analyses
        |> Enum.with_index()
        |> Enum.map(fn {analysis, index} ->
          %{
            battle_index: index,
            timestamp: extract_battle_timestamp(analysis),
            kill_efficiency: extract_kill_efficiency(analysis),
            isk_efficiency: extract_isk_efficiency(analysis),
            tactical_success: calculate_tactical_success(analysis),
            strategic_impact: calculate_strategic_impact(analysis)
          }
        end)

      # Calculate trends
      kill_efficiency_trend = calculate_metric_trend(effectiveness_data, :kill_efficiency)
      isk_efficiency_trend = calculate_metric_trend(effectiveness_data, :isk_efficiency)
      tactical_trend = calculate_metric_trend(effectiveness_data, :tactical_success)
      strategic_trend = calculate_metric_trend(effectiveness_data, :strategic_impact)

      %{
        timeline: effectiveness_data,
        kill_efficiency_trend: kill_efficiency_trend,
        isk_efficiency_trend: isk_efficiency_trend,
        tactical_success_trend: tactical_trend,
        strategic_impact_trend: strategic_trend,
        overall_effectiveness_direction:
          determine_overall_effectiveness_trend([
            kill_efficiency_trend,
            isk_efficiency_trend,
            tactical_trend,
            strategic_trend
          ])
      }
    end
  end

  @doc """
  Compare doctrine usage patterns across battles.
  """
  def compare_doctrine_usage(battle_analyses) do
    if length(battle_analyses) < 2 do
      %{comparison: :insufficient_data}
    else
      # Extract doctrine data from each battle
      doctrine_timeline =
        battle_analyses
        |> Enum.with_index()
        |> Enum.map(fn {analysis, index} ->
          doctrines = extract_doctrines_from_battle(analysis)

          %{
            battle_index: index,
            timestamp: extract_battle_timestamp(analysis),
            primary_doctrines: doctrines,
            doctrine_count: length(doctrines),
            doctrine_diversity: calculate_doctrine_diversity(doctrines),
            dominant_doctrine: find_dominant_doctrine(doctrines)
          }
        end)

      # Analyze doctrine trends
      doctrine_changes = analyze_doctrine_changes(doctrine_timeline)
      doctrine_consistency = calculate_doctrine_consistency(doctrine_timeline)

      doctrine_effectiveness =
        analyze_doctrine_effectiveness_over_time(doctrine_timeline, battle_analyses)

      %{
        doctrine_timeline: doctrine_timeline,
        doctrine_changes: doctrine_changes,
        consistency_score: doctrine_consistency,
        effectiveness_analysis: doctrine_effectiveness,
        recommendations: generate_doctrine_recommendations(doctrine_changes, doctrine_consistency)
      }
    end
  end

  @doc """
  Analyze how doctrines evolve over multiple battles.
  """
  def analyze_doctrine_evolution(battle_analyses) do
    if length(battle_analyses) < 2 do
      %{evolution: :insufficient_data}
    else
      sorted_battles = Enum.sort_by(battle_analyses, &extract_battle_timestamp/1)

      # Track doctrine changes over time
      doctrine_progression =
        sorted_battles
        |> Enum.with_index()
        |> Enum.map(fn {battle, index} ->
          doctrines = extract_doctrines_from_battle(battle)

          %{
            battle_index: index,
            timestamp: extract_battle_timestamp(battle),
            doctrines: doctrines,
            primary_doctrine: find_dominant_doctrine(doctrines),
            doctrine_count: length(doctrines)
          }
        end)

      # Identify evolution patterns
      evolution_patterns = identify_doctrine_evolution_patterns(doctrine_progression)
      stability_analysis = analyze_doctrine_stability(doctrine_progression)
      innovation_detection = detect_doctrine_innovations(doctrine_progression)

      %{
        evolution_detected: true,
        progression: doctrine_progression,
        patterns: evolution_patterns,
        stability: stability_analysis,
        innovations: innovation_detection,
        summary: generate_doctrine_evolution_summary(evolution_patterns, stability_analysis)
      }
    end
  end

  @doc """
  Analyze ship composition trends across battles.
  """
  def analyze_ship_composition_trends(battle_analyses) do
    if length(battle_analyses) < 2 do
      %{trends: :insufficient_data}
    else
      # Extract ship composition data from each battle
      composition_timeline =
        battle_analyses
        |> Enum.with_index()
        |> Enum.map(fn {battle, index} ->
          composition = extract_ship_composition_from_battle(battle)

          %{
            battle_index: index,
            timestamp: extract_battle_timestamp(battle),
            composition: composition,
            dominant_ship_classes: identify_dominant_ship_classes(composition),
            diversity_score: calculate_composition_diversity(composition)
          }
        end)

      # Analyze trends
      ship_class_trends = analyze_ship_class_trends(composition_timeline)
      diversity_trends = analyze_diversity_trends(composition_timeline)
      composition_shifts = detect_composition_shifts(composition_timeline)

      %{
        timeline: composition_timeline,
        ship_class_trends: ship_class_trends,
        diversity_trends: diversity_trends,
        composition_shifts: composition_shifts,
        summary: generate_composition_trends_summary(ship_class_trends, diversity_trends)
      }
    end
  end

  @doc """
  Analyze engagement pattern evolution across battles.
  """
  def analyze_engagement_pattern_evolution(battle_analyses) do
    if length(battle_analyses) < 2 do
      %{evolution: :insufficient_data}
    else
      # Extract engagement patterns from each battle
      pattern_timeline =
        battle_analyses
        |> Enum.with_index()
        |> Enum.map(fn {battle, index} ->
          patterns = extract_engagement_patterns_from_battle(battle)

          %{
            battle_index: index,
            timestamp: extract_battle_timestamp(battle),
            patterns: patterns,
            primary_pattern: find_dominant_pattern(patterns),
            pattern_complexity: calculate_pattern_complexity(patterns)
          }
        end)

      # Analyze pattern evolution
      pattern_changes = analyze_pattern_changes(pattern_timeline)
      complexity_trends = analyze_complexity_trends(pattern_timeline)
      adaptation_detection = detect_tactical_adaptations(pattern_timeline)

      %{
        timeline: pattern_timeline,
        pattern_changes: pattern_changes,
        complexity_trends: complexity_trends,
        adaptations: adaptation_detection,
        summary: generate_pattern_evolution_summary(pattern_changes, complexity_trends)
      }
    end
  end

  @doc """
  Analyze tactical adaptations across battles.
  """
  def analyze_tactical_adaptation(battle_analyses) do
    if length(battle_analyses) < 3 do
      %{adaptations: :insufficient_data}
    else
      # Analyze consecutive battle pairs for adaptations
      adaptations =
        battle_analyses
        |> Enum.chunk_every(2, 1, :discard)
        |> Enum.with_index()
        |> Enum.map(fn {[prev_battle, curr_battle], index} ->
          detect_adaptation_between_battles(prev_battle, curr_battle, index)
        end)
        |> Enum.filter(&(&1 != nil))

      # Summarize adaptation patterns
      adaptation_summary = summarize_adaptations(adaptations)

      %{
        adaptations_detected: length(adaptations),
        adaptations: adaptations,
        summary: adaptation_summary,
        learning_curve: calculate_learning_curve(adaptations)
      }
    end
  end

  # Private helper functions

  defp extract_patterns_from_battle(battle_analysis) do
    patterns = []

    # Extract tactical patterns if available
    patterns =
      if Map.has_key?(battle_analysis, :tactical_patterns) do
        battle_analysis.tactical_patterns ++ patterns
      else
        patterns
      end

    # Extract engagement patterns if available
    patterns =
      if Map.has_key?(battle_analysis, :engagement_patterns) do
        battle_analysis.engagement_patterns ++ patterns
      else
        patterns
      end

    # Create pattern objects
    patterns
    |> Enum.map(fn pattern ->
      %{
        pattern_type: pattern.type || :unknown,
        characteristics: pattern.characteristics || [],
        confidence: pattern.confidence || 0.5,
        source_battle: battle_analysis.battle_id || "unknown"
      }
    end)
  end

  defp calculate_pattern_confidence(instances) do
    if Enum.empty?(instances) do
      0.0
    else
      avg_confidence = (instances |> Enum.map(& &1.confidence) |> Enum.sum()) / length(instances)
      # Boost confidence for patterns that appear frequently
      frequency_boost = min(length(instances) * 0.1, 0.3)
      Float.round(avg_confidence + frequency_boost, 2)
    end
  end

  defp calculate_analysis_timespan(sorted_battles) do
    if length(sorted_battles) < 2 do
      %{duration: "N/A"}
    else
      start_time = extract_battle_timestamp(List.first(sorted_battles))
      end_time = extract_battle_timestamp(List.last(sorted_battles))

      %{
        start_time: start_time,
        end_time: end_time,
        duration_days: NaiveDateTime.diff(end_time, start_time, :day)
      }
    end
  end

  defp extract_battle_timestamp(battle_analysis) do
    case battle_analysis do
      %{start_time: time} -> time
      %{timestamp: time} -> time
      %{analyzed_at: time} -> time
      _ -> ~N[1970-01-01 00:00:00]
    end
  end

  defp extract_kill_efficiency(battle_analysis) do
    case get_in(battle_analysis, [:performance_metrics, :by_side]) do
      nil ->
        50.0

      sides ->
        efficiencies =
          sides
          |> Map.values()
          |> Enum.map(&(&1.efficiency || 50.0))

        if Enum.empty?(efficiencies),
          do: 50.0,
          else: Enum.sum(efficiencies) / length(efficiencies)
    end
  end

  defp extract_isk_efficiency(battle_analysis) do
    case get_in(battle_analysis, [:performance_metrics, :by_side]) do
      nil ->
        50.0

      sides ->
        sides
        |> Map.values()
        |> Enum.map(fn side ->
          destroyed = side.isk_destroyed || 0
          lost = side.isk_lost || 0
          total = destroyed + lost
          if total > 0, do: destroyed / total * 100, else: 50.0
        end)
        |> case do
          [] -> 50.0
          efficiencies -> Enum.sum(efficiencies) / length(efficiencies)
        end
    end
  end

  defp calculate_tactical_success(battle_analysis) do
    # Simplified tactical success based on available metrics
    case get_in(battle_analysis, [:tactical_analysis, :effectiveness]) do
      nil -> 0.5
      effectiveness -> effectiveness
    end
  end

  defp calculate_strategic_impact(battle_analysis) do
    # Simplified strategic impact based on ISK destroyed and participant count
    isk_destroyed = get_in(battle_analysis, [:isk_destroyed]) || 0
    participants = get_in(battle_analysis, [:total_participants]) || 1

    # Normalize based on typical battle values
    impact_score = min(isk_destroyed / 1_000_000_000 + participants / 100, 1.0)
    Float.round(impact_score, 2)
  end

  defp calculate_metric_trend(effectiveness_data, metric_key) do
    values = Enum.map(effectiveness_data, &Map.get(&1, metric_key, 0))

    if length(values) < 2 do
      :insufficient_data
    else
      first_half = Enum.take(values, div(length(values), 2))
      second_half = Enum.drop(values, div(length(values), 2))

      avg_first = Enum.sum(first_half) / length(first_half)
      avg_second = Enum.sum(second_half) / length(second_half)

      change_pct = if avg_first > 0, do: (avg_second - avg_first) / avg_first * 100, else: 0

      cond do
        change_pct > 10 -> :improving
        change_pct < -10 -> :declining
        true -> :stable
      end
    end
  end

  defp determine_overall_effectiveness_trend(trends) do
    trend_scores =
      trends
      |> Enum.map(fn
        :improving -> 1
        :stable -> 0
        :declining -> -1
        _ -> 0
      end)

    avg_score = Enum.sum(trend_scores) / length(trend_scores)

    cond do
      avg_score > 0.3 -> :improving
      avg_score < -0.3 -> :declining
      true -> :stable
    end
  end

  defp extract_doctrines_from_battle(battle_analysis) do
    case get_in(battle_analysis, [:fleet_compositions]) do
      nil ->
        []

      compositions ->
        compositions
        |> Map.values()
        |> Enum.flat_map(fn side ->
          case get_in(side, [:doctrine_detected, :detected_doctrines]) do
            nil -> []
            doctrines -> doctrines
          end
        end)
    end
  end

  defp calculate_doctrine_diversity(doctrines) do
    if Enum.empty?(doctrines) do
      0.0
    else
      unique_doctrines = doctrines |> Enum.map(& &1.name) |> Enum.uniq()
      Float.round(length(unique_doctrines) / length(doctrines), 2)
    end
  end

  defp find_dominant_doctrine(doctrines) do
    if Enum.empty?(doctrines) do
      nil
    else
      doctrines
      |> Enum.group_by(& &1.name)
      |> Enum.max_by(fn {_name, instances} -> length(instances) end)
      |> elem(0)
    end
  end

  defp analyze_doctrine_changes(doctrine_timeline) do
    doctrine_timeline
    |> Enum.chunk_every(2, 1, :discard)
    |> Enum.map(fn [prev, curr] ->
      %{
        from_battle: prev.battle_index,
        to_battle: curr.battle_index,
        doctrine_change: prev.dominant_doctrine != curr.dominant_doctrine,
        complexity_change: curr.doctrine_count - prev.doctrine_count,
        diversity_change: curr.doctrine_diversity - prev.doctrine_diversity
      }
    end)
  end

  defp calculate_doctrine_consistency(doctrine_timeline) do
    if length(doctrine_timeline) < 2 do
      1.0
    else
      consistent_pairs =
        doctrine_timeline
        |> Enum.chunk_every(2, 1, :discard)
        |> Enum.count(fn [prev, curr] -> prev.dominant_doctrine == curr.dominant_doctrine end)

      Float.round(consistent_pairs / (length(doctrine_timeline) - 1), 2)
    end
  end

  defp analyze_doctrine_effectiveness_over_time(doctrine_timeline, _battle_analyses) do
    # Simplified effectiveness analysis
    %{
      trend: :stable,
      effectiveness_scores: Enum.map(doctrine_timeline, fn _ -> 0.75 end)
    }
  end

  defp generate_doctrine_recommendations(_doctrine_changes, consistency_score) do
    cond do
      consistency_score > 0.8 ->
        ["Maintain current doctrine consistency", "Consider minor tactical variations"]

      consistency_score < 0.3 ->
        ["Improve doctrine consistency", "Focus on core doctrine mastery"]

      true ->
        ["Balance doctrine consistency with tactical flexibility"]
    end
  end

  defp generate_evolution_summary(
         doctrine_evolution,
         ship_composition_trends,
         engagement_patterns
       ) do
    "Tactical evolution analysis completed across multiple battles. " <>
      "Doctrine evolution: #{inspect(doctrine_evolution.patterns)}. " <>
      "Ship composition trends: #{inspect(ship_composition_trends.ship_class_trends)}. " <>
      "Engagement patterns: #{inspect(engagement_patterns.pattern_changes)}."
  end

  # Placeholder implementations for complex analysis functions
  defp identify_doctrine_evolution_patterns(_progression), do: []
  defp analyze_doctrine_stability(_progression), do: %{score: 0.7}
  defp detect_doctrine_innovations(_progression), do: []

  defp generate_doctrine_evolution_summary(_patterns, _stability),
    do: "Doctrine evolution analysis"

  defp extract_ship_composition_from_battle(_battle), do: %{}
  defp identify_dominant_ship_classes(_composition), do: []
  defp calculate_composition_diversity(_composition), do: 0.5
  defp analyze_ship_class_trends(_timeline), do: %{}
  defp analyze_diversity_trends(_timeline), do: %{}
  defp detect_composition_shifts(_timeline), do: []

  defp generate_composition_trends_summary(_ship_trends, _diversity_trends),
    do: "Composition trends analysis"

  defp extract_engagement_patterns_from_battle(_battle), do: []
  defp find_dominant_pattern(_patterns), do: nil
  defp calculate_pattern_complexity(_patterns), do: 0.5
  defp analyze_pattern_changes(_timeline), do: %{}
  defp analyze_complexity_trends(_timeline), do: %{}
  defp detect_tactical_adaptations(_timeline), do: []
  defp generate_pattern_evolution_summary(_changes, _trends), do: "Pattern evolution analysis"

  defp detect_adaptation_between_battles(_prev, _curr, _index), do: nil
  defp summarize_adaptations(_adaptations), do: "Adaptation summary"
  defp calculate_learning_curve(_adaptations), do: 0.6
end
