defmodule EveDmv.Intelligence.Analyzers.WHVetting.RiskAnalyzer do
  @moduledoc """
  Analyzes security risks for wormhole vetting.
  Handles risk assessment, threat detection, and security scoring.
  """

  require Logger

  @doc """
  Analyze security risks based on character data and employment history.
  """
  def analyze_security_risks(character_data, employment_history) do
    age_risk = assess_character_age_risk(character_data)
    employment_risk = assess_employment_risk(employment_history)
    pattern_risk = assess_pattern_risk(character_data, employment_history)

    total_risk = age_risk + employment_risk + pattern_risk
    risk_level = classify_risk_level(total_risk)
    risk_factors = identify_risk_factors(age_risk, employment_risk, pattern_risk, employment_history)

    %{
      overall_risk: risk_level,
      risk_score: total_risk,
      age_risk: age_risk,
      employment_risk: employment_risk,
      pattern_risk: pattern_risk,
      risk_factors: risk_factors,
      recommendation: determine_risk_recommendation(risk_level, risk_factors)
    }
  end

  @doc """
  Detect eviction groups from _killmail participation.
  """
  def detect_eviction_groups(killmails) when is_list(killmails) do
    if Enum.empty?(killmails) do
      %{
        threat_level: :no_data,
        eviction_count: 0,
        confidence: 0.0,
        known_groups: []
      }
    else
      # Analyze participation with known eviction groups
      eviction_activity = analyze_eviction_participation(killmails)
      eviction_count = length(eviction_activity)

      %{
        threat_level: classify_eviction_threat(eviction_count),
        eviction_count: eviction_count,
        confidence: calculate_eviction_confidence(eviction_activity, killmails),
        known_groups: extract_known_groups(eviction_activity),
        details: eviction_activity
      }
    end
  end

  @doc """
  Analyze alt character patterns to detect potential security risks.
  """
  def analyze_alt_character_patterns(character_data, killmails) do
    character_age = DateTime.diff(DateTime.utc_now(), character_data.birthday, :day)

    alt_indicators = determine_alt_indicators(character_data, killmails, character_age)
    alt_confidence = calculate_alt_confidence(character_data, killmails)
    potential_alts = detect_potential_alts(character_data, killmails)

    %{
      likely_alt: alt_confidence > 0.6,
      confidence: Float.round(alt_confidence, 2),
      indicators: alt_indicators,
      potential_alts: potential_alts,
      risk_assessment: assess_alt_risk(alt_confidence, alt_indicators)
    }
  end

  # Private helper functions

  defp assess_character_age_risk(character_data) do
    character_age = DateTime.diff(DateTime.utc_now(), character_data.birthday, :day)

    cond do
      character_age < 30 -> 40  # Very new character
      character_age < 90 -> 25  # New character
      character_age < 365 -> 15 # Less than a year
      character_age < 730 -> 5  # Less than 2 years
      true -> 0                 # Established character
    end
  end

  defp assess_employment_risk(employment_history) do
    if length(employment_history) <= 1 do
      0  # Never changed corps
    else
      corp_changes = length(employment_history) - 1

      # Check for rapid corp hopping
      if detect_corp_hopping(employment_history) do
        30 + min(corp_changes * 5, 20)  # Base penalty + escalating penalty
      else
        min(corp_changes * 3, 15)       # Normal corp change penalty
      end
    end
  end

  defp assess_pattern_risk(_character_data, _employment_history) do
    # Placeholder for pattern analysis
    # In a real implementation, this would analyze suspicious patterns
    0
  end

  defp classify_risk_level(total_risk) do
    cond do
      total_risk >= 70 -> :critical
      total_risk >= 50 -> :high
      total_risk >= 30 -> :medium
      total_risk >= 15 -> :low
      true -> :minimal
    end
  end

  defp identify_risk_factors(age_risk, employment_risk, pattern_risk, employment_history) do

    factors
    maybe_add_risk_factor(age_risk >= 25, :new_character)
    maybe_add_risk_factor(employment_risk >= 20, :frequent_corp_changes)
    maybe_add_risk_factor(detect_corp_hopping(employment_history), :corp_hopping_pattern)
    maybe_add_risk_factor(pattern_risk > 0, :suspicious_patterns)
  end

  defp detect_corp_hopping(employment_history) do
    if length(employment_history) >= 3 do
      # Check if there are multiple corp changes within a short time period
      sorted_history = Enum.sort_by(employment_history, & &1.start_date, DateTime)

      recent_changes =
        sorted_history
        Enum.chunk_every(2, 1, :discard)
        |>         Enum.count(fn [prev, current] ->
          DateTime.diff(current.start_date, prev.start_date, :day) < 30
        end)

      recent_changes >= 2
    else
      false
    end
  end

  defp maybe_add_risk_factor(factors, true, factor), do: [factor | factors]
  defp maybe_add_risk_factor(factors, false, _factor), do: factors

  defp analyze_eviction_participation(killmails) do
    # Analyze killmails for participation with known eviction groups
    eviction_corps = known_eviction_corporations()

    killmails
    |>     Enum.filter(&has_eviction_group_participation?(&1.attackers, eviction_corps))
    Enum.map(&extract_eviction_details/1)
  end

  defp has_eviction_group_participation?(participants, eviction_corps) do
    Enum.any?(participants, fn participant ->
      known_eviction_group?(participant.corporation_name, participant.alliance_name)
    end)
  end

  defp known_eviction_group?(corp_name, alliance_name) do
    eviction_corps = known_eviction_corporations()
    eviction_alliances = known_eviction_alliances()

    (corp_name && corp_name in eviction_corps) or
    (alliance_name && alliance_name in eviction_alliances)
  end

  defp known_eviction_corporations do
    [
      "Hard Knocks Inc.",
