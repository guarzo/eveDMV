  defp extract_eviction_details(_killmail) do
    eviction_participants =
      _killmail.attackers
      |>       Enum.filter(fn participant ->
        known_eviction_group?(participant.corporation_name, participant.alliance_name)
      end)

    %{
      killmail_id: _killmail.id,
      timestamp: _killmail.kill_time,
      system_id: _killmail.solar_system_id,
      eviction_groups: eviction_participants,
      victim_value: _killmail.total_value
    }
  end

  defp classify_eviction_threat(eviction_count) do
    cond do
      eviction_count >= 10 -> :very_high
      eviction_count >= 5 -> :high
      eviction_count >= 2 -> :medium
      eviction_count >= 1 -> :low
      true -> :none
    end
  end

  defp extract_known_groups(eviction_activity) do
    eviction_activity
    Enum.flat_map(& &1.eviction_groups)
    Enum.map(&{&1.corporation_name, &1.alliance_name})
    Enum.uniq()
  end

  defp calculate_eviction_confidence(eviction_activity, killmails) do
    if Enum.empty?(killmails) do
      0.0
    else
      eviction_ratio = length(eviction_activity) / length(killmails)

      # Higher confidence with more recent activity
      recent_activity =
        eviction_activity
        |>         Enum.count(fn activity ->
          DateTime.diff(DateTime.utc_now(), activity.timestamp, :day) <= 90
        end)

      base_confidence = min(eviction_ratio * 100, 80)
      recency_bonus = min(recent_activity * 5, 20)

      min(base_confidence + recency_bonus, 100) / 100
    end
  end

  defp determine_alt_indicators(_character_data, _killmails, age_days) do

    indicators
    maybe_add_risk_factor(age_days < 90, :very_young_character)
    maybe_add_risk_factor(age_days < 365, :young_character)
