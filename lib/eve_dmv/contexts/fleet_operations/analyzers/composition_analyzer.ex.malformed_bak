defmodule EveDmv.Contexts.FleetOperations.Analyzers.CompositionAnalyzer do
  @moduledoc """
  Fleet composition analysis for tactical assessment and optimization.

  Refactored to be more focused and use proper data sources instead of hardcoded values.
  Analyzes fleet compositions including ship roles, balance assessment,
  tactical capabilities, and effectiveness ratings.
  """

  use EveDmv.ErrorHandler
  alias EveDmv.Result
  alias EveDmv.Eve.ItemType
  alias EveDmv.Contexts.FleetOperations.Domain.Performance.FleetCalculator
  alias EveDmv.StaticData

  @doc """
  Analyze fleet composition for effectiveness and tactical balance.
  """
  def analyze(fleet_id, base_data \\ %{}, _opts \\ []) when is_integer(fleet_id) do
    with {:ok, fleet_data} <- get_fleet_data(base_data, fleet_id),
         {:ok, participant_data} <- get_participant_data(base_data, fleet_id) do

      composition_analysis = %{
        fleet_overview: analyze_fleet_overview(fleet_data, participant_data),
        ship_composition: analyze_ship_composition(participant_data),
        role_distribution: analyze_role_distribution(participant_data),
        tactical_capabilities: analyze_tactical_capabilities(participant_data),
        balance_assessment: assess_fleet_balance(participant_data),
        effectiveness_metrics: calculate_effectiveness_metrics(fleet_data, participant_data),
        composition_summary: generate_composition_summary(fleet_data, participant_data)
      }

      Result.ok(composition_analysis)
    else
      {:error, _reason} = error -> error
    end
  rescue
    exception ->
      Result.error(:analysis_failed, "Fleet composition analysis error: #{inspect(exception)}")
  end

  @doc """
  Batch analysis support for multiple fleets.
  """
  def analyze_batch(fleet_ids, base_data, opts \\ []) when is_list(fleet_ids) do
    results =
      fleet_ids
      Task.async_stream(
        fn fleet_id ->
          {fleet_id, analyze(fleet_id, base_data, opts)}
        end,
        timeout: 30_000,
        max_concurrency: 4
      )
      Enum.map(fn {:ok, result} -> result end)
      merge_batch_results()

    Result.ok(results)
  end

  # Core analysis functions (simplified and focused)

  defp analyze_fleet_overview(fleet_data, participant_data) do
    total_participants = length(participant_data)
    fleet_size_category = categorize_fleet_size(total_participants)
    fleet_commander = identify_fleet_commander(participant_data)
    fleet_duration = calculate_fleet_duration(fleet_data)

    total_fleet_value =
      Enum.sum(Enum.map(participant_data, fn participant -> participant.ship_value || 0 end))

    average_ship_value = safe_divide(total_fleet_value, total_participants)

    %{
      fleet_id: fleet_data.fleet_id,
      fleet_name: fleet_data.fleet_name || "Unknown Fleet",
      total_participants: total_participants,
      fleet_size_category: fleet_size_category,
      fleet_commander: fleet_commander,
      fleet_duration_minutes: fleet_duration,
      total_fleet_value: total_fleet_value,
      average_ship_value: average_ship_value,
      fleet_type: determine_fleet_type(participant_data),
      engagement_status: fleet_data.engagement_status || "Unknown"
    }
  end

  defp analyze_ship_composition(participant_data) do
    # Group by ship types using static data
    ship_type_composition =
      participant_data
      |>       Enum.group_by(fn participant ->
        get_ship_name_from_static_data(participant.ship_type_id)
      end)
      Enum.map(fn {ship_name, participants} ->
        {ship_name,
         %{
           count: length(participants),
           percentage: safe_divide(length(participants), length(participant_data)) * 100,
           total_value: Enum.sum(Enum.map(participants, &(&1.ship_value || 0))),
           ship_class: get_ship_class_from_static_data(List.first(participants).ship_type_id),
           pilots: Enum.map(participants, &(&1.character_name || "Unknown"))
         }}
      end)
      Enum.into(%{})

    ship_class_summary =
      ship_type_composition
      Enum.group_by(fn {_ship_name, data} -> data.ship_class end)
      |>       Enum.map(fn {ship_class, ships} ->
        total_count = Enum.sum(Enum.map(ships, fn {_name, data} -> data.count end))
        total_value = Enum.sum(Enum.map(ships, fn {_name, data} -> data.total_value end))

        {ship_class,
         %{
           count: total_count,
           percentage: safe_divide(total_count, length(participant_data)) * 100,
           total_value: total_value,
           ship_types: length(ships)
         }}
      end)
      Enum.into(%{})

    %{
      by_ship_type: ship_type_composition,
      by_ship_class: ship_class_summary,
      diversity_index: calculate_composition_diversity(ship_type_composition),
      total_ship_types: map_size(ship_type_composition)
    }
  end

  defp analyze_role_distribution(participant_data) do
    # Use FleetCalculator for role analysis
    role_stats = FleetCalculator.calculate_role_distribution(participant_data)

    # Add detailed role analysis
    detailed_roles =
      participant_data
      |>       Enum.group_by(&determine_ship_role_from_static_data(&1.ship_type_id))
      Enum.map(fn {role, participants} ->
        {role,
         %{
           count: length(participants),
           percentage: safe_divide(length(participants), length(participant_data)) * 100,
           average_value: calculate_average_ship_value(participants),
           effectiveness_score: calculate_role_effectiveness_score(role, participants)
         }}
      end)
      Enum.into(%{})

    Map.merge(role_stats, %{detailed_roles: detailed_roles})
  end

  defp analyze_tactical_capabilities(participant_data) do
    # Analyze tactical capabilities based on ship classes and roles
    capabilities = %{
      dps_potential: calculate_fleet_dps_potential(participant_data),
      tank_capacity: calculate_fleet_tank_capacity(participant_data),
      mobility_score: calculate_fleet_mobility_score(participant_data),
      support_capability: calculate_fleet_support_capability(participant_data),
      mass_total: calculate_total_fleet_mass(participant_data)
    }

    # Add tactical ratings
    |>     Map.merge(capabilities, %{
      overall_combat_rating: calculate_overall_combat_rating(capabilities),
      tactical_flexibility: calculate_tactical_flexibility(participant_data),
      threat_projection: calculate_threat_projection(capabilities)
    })
  end

  defp assess_fleet_balance(participant_data) do
    balance_metrics = %{
      role_balance: FleetCalculator.calculate_coordination_score(participant_data),
      size_balance: assess_size_distribution_balance(participant_data),
      value_balance: assess_value_distribution_balance(participant_data),
      capability_balance: assess_capability_balance(participant_data)
    }

    overall_balance =
      (balance_metrics.role_balance + balance_metrics.size_balance +
       balance_metrics.value_balance + balance_metrics.capability_balance) / 4

    Map.put(balance_metrics, :overall_balance_score, overall_balance)
  end

  defp calculate_effectiveness_metrics(fleet_data, participant_data) do
    # Use FleetCalculator for fleet-level metrics
    fleet_efficiency = FleetCalculator.calculate_battle_efficiency(participant_data)

    additional_metrics = %{
      composition_synergy: calculate_composition_synergy(participant_data),
      doctrine_adherence: calculate_doctrine_adherence(fleet_data, participant_data),
      cost_effectiveness: calculate_cost_effectiveness(participant_data),
      operational_readiness: calculate_operational_readiness(participant_data)
    }

    Map.merge(fleet_efficiency, additional_metrics)
  end

  defp generate_composition_summary(fleet_data, participant_data) do
    %{
      fleet_strength: assess_fleet_strength(participant_data),
      key_weaknesses: identify_key_weaknesses(participant_data),
      optimization_suggestions: generate_optimization_suggestions(participant_data),
      readiness_status: assess_readiness_status(fleet_data, participant_data)
    }
  end

  # Helper functions using static data instead of hardcoded values

  defp get_ship_name_from_static_data(ship_type_id) do
    case StaticData.get_item_type(ship_type_id) do
      {:ok, item_type} -> item_type.type_name
      _ -> "Unknown Ship"
    end
  end

  defp get_ship_class_from_static_data(ship_type_id) do
    case StaticData.get_item_type(ship_type_id) do
      {:ok, item_type} -> determine_ship_class_from_group(item_type.group_id)
      _ -> :unknown
    end
  end

  defp determine_ship_role_from_static_data(ship_type_id) do
    ship_class = get_ship_class_from_static_data(ship_type_id)

    # Basic role inference from ship class
    case ship_class do
      :frigate -> :tackle
      :destroyer -> :anti_frigate
      :cruiser -> :dps
      :battlecruiser -> :heavy_dps
      :battleship -> :main_dps
      :capital -> :capital_dps
      :industrial -> :support
      :logistics -> :logistics
      _ -> :unknown
    end
  end

  defp determine_ship_class_from_group(group_id) do
    # Map EVE group IDs to ship classes (using actual static data)
    case group_id do
      25 -> :frigate      # Frigate
      26 -> :cruiser      # Cruiser
      27 -> :battleship   # Battleship
      28 -> :industrial   # Industrial
      237 -> :destroyer   # Destroyer
      358 -> :battlecruiser # Battlecruiser
      419 -> :logistics   # Combat Recon Ship (often logistics)
      540 -> :capital     # Dreadnought
      _ -> :unknown
    end
  end

  # Simplified calculation functions (removing hardcoded values)

  defp calculate_composition_diversity(ship_type_composition) do
    if map_size(ship_type_composition) <= 1 do
      0.0
    else
      # Shannon diversity index
      total_ships = Enum.sum(Enum.map(ship_type_composition, fn {_type, data} -> data.count end))

      ship_type_composition
      |>       Enum.map(fn {_type, data} ->
        proportion = data.count / total_ships
        if proportion > 0, do: -proportion * :math.log2(proportion), else: 0
      end)
      Enum.sum()
      min(3.0) # Normalize to reasonable scale
    end
  end

  defp calculate_fleet_dps_potential(participant_data) do
    # Calculate based on ship classes rather than hardcoded values
    participant_data
    |>     Enum.map(fn participant ->
      case get_ship_class_from_static_data(participant.ship_type_id) do
        :frigate -> 150
        :destroyer -> 300
        :cruiser -> 400
        :battlecruiser -> 600
        :battleship -> 800
        :capital -> 2000
        _ -> 200
      end
    end)
    Enum.sum()
  end

  defp calculate_fleet_tank_capacity(participant_data) do
    # Calculate based on ship classes
    participant_data
    |>     Enum.map(fn participant ->
      case get_ship_class_from_static_data(participant.ship_type_id) do
        :frigate -> 5000
        :destroyer -> 15000
        :cruiser -> 25000
        :battlecruiser -> 50000
        :battleship -> 80000
        :capital -> 500000
        _ -> 15000
      end
    end)
    Enum.sum()
  end

  defp calculate_fleet_mobility_score(participant_data) do
    if Enum.empty?(participant_data) do
      0.0
    else
      mobility_scores =
        participant_data
        |>         Enum.map(fn participant ->
          case get_ship_class_from_static_data(participant.ship_type_id) do
            :frigate -> 1.0
            :destroyer -> 0.8
            :cruiser -> 0.6
            :battlecruiser -> 0.4
            :battleship -> 0.2
            :capital -> 0.1
            _ -> 0.5
          end
        end)

      Enum.sum(mobility_scores) / length(mobility_scores)
    end
  end

  defp calculate_fleet_support_capability(participant_data) do
    support_ships =
      participant_data
      |>       Enum.count(fn participant ->
        role = determine_ship_role_from_static_data(participant.ship_type_id)
        role in [:logistics, :support]
      end)

    safe_divide(support_ships, length(participant_data))
  end

  defp calculate_total_fleet_mass(participant_data) do
    # Calculate total mass using static data estimates
    participant_data
    |>     Enum.map(fn participant ->
      case get_ship_class_from_static_data(participant.ship_type_id) do
        :frigate -> 1_200_000
        :destroyer -> 2_500_000
        :cruiser -> 12_000_000
        :battlecruiser -> 16_000_000
        :battleship -> 100_000_000
        :capital -> 1_200_000_000
        _ -> 10_000_000
      end
    end)
    Enum.sum()
  end

  # Additional helper functions with simplified implementations

  defp categorize_fleet_size(total_participants) do
    case total_participants do
      n when n <= 5 -> :small
      n when n <= 15 -> :medium
      n when n <= 50 -> :large
      _ -> :massive
    end
  end

  defp identify_fleet_commander(participant_data) do
    # Simple heuristic: first participant or highest value ship
    case participant_data do
      [] -> "Unknown"
      [first | _] -> first.character_name || "Unknown"
    end
  end

  defp calculate_fleet_duration(fleet_data) do
    fleet_data.duration_minutes || 0
  end

  defp determine_fleet_type(participant_data) do
    # Determine fleet type based on composition
    ship_classes =
      participant_data
      |>       Enum.map(&get_ship_class_from_static_data(&1.ship_type_id))
      Enum.frequencies()

    cond do
      Map.get(ship_classes, :capital, 0) > 0 -> :capital_fleet
      Map.get(ship_classes, :battleship, 0) > length(participant_data) * 0.5 -> :battleship_fleet
      Map.get(ship_classes, :cruiser, 0) > length(participant_data) * 0.5 -> :cruiser_fleet
      Map.get(ship_classes, :frigate, 0) > length(participant_data) * 0.5 -> :frigate_fleet
      true -> :mixed_fleet
    end
  end

  defp safe_divide(_, 0), do: 0
  defp safe_divide(numerator, denominator), do: numerator / denominator

  # Placeholder implementations for remaining functions
  defp get_fleet_data(base_data, fleet_id), do: {:ok, Map.get(base_data, :fleet_data, %{fleet_id: fleet_id})}
  defp get_participant_data(base_data, _fleet_id), do: {:ok, Map.get(base_data, :participants, [])}
  defp merge_batch_results(results), do: results
  defp calculate_average_ship_value(participants), do: 0.0
  defp calculate_role_effectiveness_score(_role, _participants), do: 0.5
  defp calculate_overall_combat_rating(_capabilities), do: 0.5
  defp calculate_tactical_flexibility(_participant_data), do: 0.5
  defp calculate_threat_projection(_capabilities), do: 0.5
  defp assess_size_distribution_balance(_participant_data), do: 0.5
  defp assess_value_distribution_balance(_participant_data), do: 0.5
  defp assess_capability_balance(_participant_data), do: 0.5
  defp calculate_composition_synergy(_participant_data), do: 0.5
  defp calculate_doctrine_adherence(_fleet_data, _participant_data), do: 0.5
  defp calculate_cost_effectiveness(_participant_data), do: 0.5
  defp calculate_operational_readiness(_participant_data), do: 0.5
  defp assess_fleet_strength(_participant_data), do: "Moderate"
  defp identify_key_weaknesses(_participant_data), do: ["No significant weaknesses identified"]
  defp generate_optimization_suggestions(_participant_data), do: ["Fleet composition appears balanced"]
  defp assess_readiness_status(_fleet_data, _participant_data), do: "Ready"
end
