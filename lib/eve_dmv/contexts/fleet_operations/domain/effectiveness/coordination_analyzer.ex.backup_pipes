defmodule EveDmv.Contexts.FleetOperations.Domain.Effectiveness.CoordinationAnalyzer do
  @moduledoc """
  Analyzes fleet coordination effectiveness.

  Evaluates timing, targeting, and tactical coordination patterns
  to determine fleet cohesion and effectiveness.
  """

  require Logger

  @doc """
  Calculate fleet coordination score based on engagement patterns.
  """
  def calculate_coordination_score(participants, killmails) do
    coordination_metrics = analyze_fleet_coordination(participants, killmails)

    %{
      overall_score: coordination_metrics.overall_score,
      coordination_grade: determine_coordination_grade(coordination_metrics.overall_score),
      coordination_breakdown: coordination_metrics
    }
  end

  @doc """
  Analyze detailed fleet coordination metrics.
  """
  def analyze_fleet_coordination(participants, killmails) do
    participant_ids = MapSet.new(participants, &(&1.character_id))

    kill_participation = calculate_kill_participation(participants, killmails, participant_ids)
    timing_coordination = analyze_timing_coordination(killmails, participant_ids)
    target_focus = analyze_target_focus(killmails, participant_ids)
    damage_spread = analyze_damage_spread(killmails, participant_ids)

    overall_score = calculate_overall_coordination_score(%{
      kill_participation: kill_participation,
      timing_coordination: timing_coordination,
      target_focus: target_focus,
      damage_spread: damage_spread
    })

    %{
      kill_participation: kill_participation,
      timing_coordination: timing_coordination,
      target_focus: target_focus,
      damage_spread: damage_spread,
      overall_score: overall_score
    }
  end

  defp calculate_kill_participation(participants, killmails, participant_ids) do
    # Analyze how many fleet members participate in kills
    fleet_kills = Enum.filter(killmails, fn killmail ->
      attackers = Map.get(killmail, :attackers, [])
      Enum.any?(attackers, fn attacker ->
        MapSet.member?(participant_ids, attacker.character_id)
      end)
    end)

    if Enum.empty?(fleet_kills) do
      %{
        average_participants_per_kill: 0,
        participation_rate: 0,
        coordination_score: 0
      }
    else
      participation_counts = Enum.map(fleet_kills, fn killmail ->
        attackers = Map.get(killmail, :attackers, [])
        fleet_attackers = Enum.filter(attackers, fn attacker ->
          MapSet.member?(participant_ids, attacker.character_id)
        end)
        length(fleet_attackers)
      end)

      avg_participants = Enum.sum(participation_counts) / length(participation_counts)
      participation_rate = avg_participants / length(participants)

      %{
        average_participants_per_kill: Float.round(avg_participants, 1),
        participation_rate: Float.round(participation_rate, 2),
        coordination_score: calculate_participation_score(participation_rate)
      }
    end
  end

  defp calculate_participation_score(participation_rate) do
    cond do
      participation_rate > 0.7 -> 1.0
      participation_rate > 0.5 -> 0.8
      participation_rate > 0.3 -> 0.6
      participation_rate > 0.1 -> 0.4
      true -> 0.2
    end
  end

  defp analyze_timing_coordination(killmails, participant_ids) do
    # Analyze kill timing patterns
    fleet_kills = filter_fleet_kills(killmails, participant_ids)

    if length(fleet_kills) < 2 do
      %{
        kill_clustering: 0,
        average_time_between_kills: 0,
        coordination_score: 0.5
      }
    else
      sorted_kills = Enum.sort_by(fleet_kills, &(&1.timestamp))

      time_gaps = calculate_time_gaps(sorted_kills)
      avg_gap = if Enum.empty?(time_gaps), do: 0, else: Enum.sum(time_gaps) / length(time_gaps)

      # Calculate clustering (kills close together in time)
      clustered_kills = Enum.count(time_gaps, &(&1 < 120)) # Within 2 minutes
      clustering_rate = clustered_kills / length(time_gaps)

      %{
        kill_clustering: Float.round(clustering_rate, 2),
        average_time_between_kills: Float.round(avg_gap, 0),
        coordination_score: calculate_timing_score(clustering_rate, avg_gap)
      }
    end
  end

  defp calculate_time_gaps(sorted_kills) do
    sorted_kills
    |> Enum.chunk_every(2, 1, :discard)
    |> Enum.map(fn [first, second] ->
      DateTime.diff(second.timestamp, first.timestamp)
    end)
  end

  defp calculate_timing_score(clustering_rate, avg_gap) do
    # High clustering and low average gap indicates good coordination
    clustering_score = clustering_rate
    gap_score = cond do
      avg_gap < 60 -> 1.0
      avg_gap < 180 -> 0.8
      avg_gap < 300 -> 0.6
      true -> 0.4
    end

    (clustering_score + gap_score) / 2
  end

  defp analyze_target_focus(killmails, participant_ids) do
    # Analyze how well the fleet focuses on primary targets
    fleet_kills = filter_fleet_kills(killmails, participant_ids)

    if Enum.empty?(fleet_kills) do
      %{focus_efficiency: 0, primary_target_percentage: 0, coordination_score: 0}
    else
      # Group kills by timestamp proximity to identify primary targets
      kill_groups = group_kills_by_time(fleet_kills, 30) # 30 second windows

      focus_scores = Enum.map(kill_groups, fn group ->
        if length(group) == 1 do
          1.0 # Single kill = perfect focus
        else
          # Calculate damage concentration on primary target
          total_damage = Enum.sum(Enum.map(group, &(&1.total_damage || 0)))
          max_damage = Enum.max(Enum.map(group, &(&1.total_damage || 0)))
          if total_damage > 0, do: max_damage / total_damage, else: 0
        end
      end)

      avg_focus = Enum.sum(focus_scores) / length(focus_scores)

      %{
        focus_efficiency: Float.round(avg_focus, 2),
        primary_target_percentage: Float.round(avg_focus * 100, 1),
        coordination_score: avg_focus
      }
    end
  end

  defp group_kills_by_time(kills, window_seconds) do
    kills
    |> Enum.sort_by(&(&1.timestamp))
    |> Enum.reduce([], fn kill, groups ->
      case groups do
        [] -> [[kill]]
        [current_group | rest] ->
          last_kill = List.last(current_group)
          if DateTime.diff(kill.timestamp, last_kill.timestamp) <= window_seconds do
            [[kill | current_group] | rest]
          else
            [[kill] | groups]
          end
      end
    end)
  end

  defp analyze_damage_spread(killmails, participant_ids) do
    # Analyze how damage is distributed among fleet members
    fleet_kills = filter_fleet_kills(killmails, participant_ids)

    if Enum.empty?(fleet_kills) do
      %{damage_concentration: 0, top_damage_dealers: [], coordination_score: 0.5}
    else
      # Calculate damage dealt by each fleet member
      damage_by_pilot = calculate_damage_by_pilot(fleet_kills, participant_ids)

      total_damage = Enum.sum(Map.values(damage_by_pilot))
      sorted_dealers = damage_by_pilot
        |> Enum.sort_by(fn {_, damage} -> damage end, :desc)
        |> Enum.take(5)

      # Calculate Gini coefficient for damage distribution
      damage_concentration = calculate_gini_coefficient(Map.values(damage_by_pilot))

      %{
        damage_concentration: Float.round(damage_concentration, 2),
        top_damage_dealers: Enum.map(sorted_dealers, fn {pilot_id, damage} ->
          %{
            character_id: pilot_id,
            damage_dealt: damage,
            percentage: Float.round(damage / total_damage * 100, 1)
          }
        end),
        coordination_score: calculate_damage_spread_score(damage_concentration)
      }
    end
  end

  defp calculate_damage_by_pilot(fleet_kills, participant_ids) do
    fleet_kills
    |> Enum.flat_map(fn killmail ->
      Map.get(killmail, :attackers, [])
      |> Enum.filter(fn attacker ->
        MapSet.member?(participant_ids, attacker.character_id)
      end)
      |> Enum.map(fn attacker ->
        {attacker.character_id, attacker.damage_done || 0}
      end)
    end)
    |> Enum.reduce(%{}, fn {pilot_id, damage}, acc ->
      Map.update(acc, pilot_id, damage, &(&1 + damage))
    end)
  end

  defp calculate_gini_coefficient(values) do
    if Enum.empty?(values) or Enum.sum(values) == 0 do
      0
    else
      sorted = Enum.sort(values)
      n = length(sorted)
      sum_of_products = sorted
        |> Enum.with_index(1)
        |> Enum.reduce(0, fn {value, index}, acc ->
          acc + (2 * index - n - 1) * value
        end)

      mean = Enum.sum(sorted) / n
      gini = sum_of_products / (n * n * mean)
      Float.round(gini, 3)
    end
  end

  defp calculate_damage_spread_score(gini_coefficient) do
    # Lower Gini = more equal distribution = better coordination
    cond do
      gini_coefficient < 0.2 -> 1.0
      gini_coefficient < 0.4 -> 0.8
      gini_coefficient < 0.6 -> 0.6
      gini_coefficient < 0.8 -> 0.4
      true -> 0.2
    end
  end

  defp calculate_overall_coordination_score(metrics) do
    weights = %{
      kill_participation: 0.3,
      timing_coordination: 0.25,
      target_focus: 0.25,
      damage_spread: 0.2
    }

    weighted_score =
      metrics.kill_participation.coordination_score * weights.kill_participation +
      metrics.timing_coordination.coordination_score * weights.timing_coordination +
      metrics.target_focus.coordination_score * weights.target_focus +
      metrics.damage_spread.coordination_score * weights.damage_spread

    Float.round(weighted_score, 2)
  end

  defp determine_coordination_grade(coordination_score) do
    cond do
      coordination_score >= 0.9 -> "A+"
      coordination_score >= 0.8 -> "A"
      coordination_score >= 0.7 -> "B"
      coordination_score >= 0.6 -> "C"
      coordination_score >= 0.5 -> "D"
      true -> "F"
    end
  end

  defp filter_fleet_kills(killmails, participant_ids) do
    Enum.filter(killmails, fn killmail ->
      attackers = Map.get(killmail, :attackers, [])
      Enum.any?(attackers, fn attacker ->
        MapSet.member?(participant_ids, attacker.character_id)
      end)
    end)
  end
end