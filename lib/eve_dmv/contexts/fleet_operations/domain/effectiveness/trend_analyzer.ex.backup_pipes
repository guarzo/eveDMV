defmodule EveDmv.Contexts.FleetOperations.Domain.Effectiveness.TrendAnalyzer do
  @moduledoc """
  Analyzes fleet performance trends over time.

  Provides trend analysis, improvement tracking, and recommendations
  based on historical engagement data.
  """

  require Logger

  @doc """
  Calculate performance trends for a corporation over time.
  """
  def calculate_performance_trends(engagements, time_range) do
    # Group engagements by time periods
    time_buckets = group_engagements_by_time(engagements, time_range)

    # Calculate effectiveness for each time bucket
    trend_data =
      Enum.map(time_buckets, fn {period, period_engagements} ->
        period_metrics = aggregate_engagement_metrics(period_engagements)

        %{
          period: period,
          engagement_count: length(period_engagements),
          isk_efficiency: calculate_isk_efficiency_score(period_metrics),
          kill_death_ratio:
            if(period_metrics.total_losses > 0,
              do: period_metrics.total_kills / period_metrics.total_losses,
              else: 0
            ),
          survival_rate: calculate_survival_score(period_metrics),
          average_fleet_size:
            if(length(period_engagements) > 0,
              do: period_metrics.total_participants / length(period_engagements),
              else: 0
            )
        }
      end)

    # Calculate trend directions
    trends = calculate_trend_directions(trend_data)

    %{
      time_range: time_range,
      trend_data: trend_data,
      trends: trends,
      overall_improvement: calculate_overall_improvement_trend(trend_data),
      recommendations: generate_trend_recommendations(trends)
    }
  end

  defp group_engagements_by_time(engagements, time_range) do
    # Group engagements into time buckets based on time_range
    bucket_size = determine_bucket_size(time_range)

    engagements
    |> Enum.group_by(fn engagement ->
      # Group by bucket (e.g., week, month)
      timestamp = Map.get(engagement, :timestamp) || DateTime.utc_now()
      DateTime.to_date(timestamp) |> Date.beginning_of_week()
    end)
    |> Enum.sort_by(fn {date, _} -> date end, Date)
  end

  defp determine_bucket_size(:last_7d), do: :daily
  defp determine_bucket_size(:last_30d), do: :weekly
  defp determine_bucket_size(:last_90d), do: :monthly
  defp determine_bucket_size(_), do: :weekly

  defp calculate_trend_directions(trend_data) do
    if length(trend_data) < 2 do
      %{
        isk_efficiency: :stable,
        kill_death_ratio: :stable,
        survival_rate: :stable,
        fleet_size: :stable
      }
    else
      recent_data = Enum.take(trend_data, -3)
      earlier_data = Enum.take(trend_data, 3)

      %{
        isk_efficiency: calculate_metric_trend(recent_data, earlier_data, :isk_efficiency),
        kill_death_ratio: calculate_metric_trend(recent_data, earlier_data, :kill_death_ratio),
        survival_rate: calculate_metric_trend(recent_data, earlier_data, :survival_rate),
        fleet_size: calculate_metric_trend(recent_data, earlier_data, :average_fleet_size)
      }
    end
  end

  defp calculate_metric_trend(recent_data, earlier_data, metric) do
    recent_avg = Enum.sum(Enum.map(recent_data, &Map.get(&1, metric, 0))) / length(recent_data)
    earlier_avg = Enum.sum(Enum.map(earlier_data, &Map.get(&1, metric, 0))) / length(earlier_data)

    cond do
      recent_avg > earlier_avg * 1.1 -> :improving
      recent_avg < earlier_avg * 0.9 -> :declining
      true -> :stable
    end
  end

  defp calculate_overall_improvement_trend(trend_data) do
    if length(trend_data) < 2 do
      :insufficient_data
    else
      # Compare first third to last third of data
      data_count = length(trend_data)
      first_third = Enum.take(trend_data, div(data_count, 3))
      last_third = Enum.take(trend_data, -div(data_count, 3))

      # Calculate average effectiveness for each period
      first_avg = calculate_period_effectiveness_average(first_third)
      last_avg = calculate_period_effectiveness_average(last_third)

      cond do
        last_avg > first_avg * 1.15 -> :significant_improvement
        last_avg > first_avg * 1.05 -> :moderate_improvement
        last_avg < first_avg * 0.95 -> :declining_performance
        last_avg < first_avg * 0.85 -> :significant_decline
        true -> :stable_performance
      end
    end
  end

  defp calculate_period_effectiveness_average(period_data) do
    Enum.sum(Enum.map(period_data, fn data ->
      (data.isk_efficiency + data.survival_rate) / 2
    end)) / length(period_data)
  end

  defp generate_trend_recommendations(trends) do
    recommendations = []

    recommendations =
      if trends.isk_efficiency == :declining do
        ["Focus on target selection and damage application" | recommendations]
      else
        recommendations
      end

    recommendations =
      if trends.survival_rate == :declining do
        ["Improve fleet positioning and logistics support" | recommendations]
      else
        recommendations
      end

    recommendations =
      if trends.kill_death_ratio == :declining do
        ["Review engagement tactics and fleet composition" | recommendations]
      else
        recommendations
      end

    recommendations =
      if trends.fleet_size == :declining do
        ["Work on recruitment and fleet participation incentives" | recommendations]
      else
        recommendations
      end

    if Enum.empty?(recommendations) do
      ["Maintain current operational standards"]
    else
      recommendations
    end
  end

  # Helper functions needed by trend analysis
  defp aggregate_engagement_metrics(engagements) do
    Enum.reduce(engagements, %{
      total_kills: 0,
      total_losses: 0,
      total_isk_destroyed: 0,
      total_isk_lost: 0,
      total_participants: 0,
      total_survivors: 0,
      objectives_completed: 0,
      objectives_attempted: 0,
      engagement_durations: [],
      pilot_performance_scores: []
    }, fn engagement, acc ->
      %{
        total_kills: acc.total_kills + Map.get(engagement, :kills, 0),
        total_losses: acc.total_losses + Map.get(engagement, :losses, 0),
        total_isk_destroyed: acc.total_isk_destroyed + Map.get(engagement, :isk_destroyed, 0),
        total_isk_lost: acc.total_isk_lost + Map.get(engagement, :isk_lost, 0),
        total_participants: acc.total_participants + Map.get(engagement, :participant_count, 0),
        total_survivors: acc.total_survivors + Map.get(engagement, :survivors, 0),
        objectives_completed: acc.objectives_completed + Map.get(engagement, :objectives_completed, 0),
        objectives_attempted: acc.objectives_attempted + Map.get(engagement, :objectives_attempted, 0),
        engagement_durations: [Map.get(engagement, :duration_seconds, 0) | acc.engagement_durations],
        pilot_performance_scores: [Map.get(engagement, :avg_pilot_performance, 0.5) | acc.pilot_performance_scores]
      }
    end)
  end

  defp calculate_isk_efficiency_score(metrics) do
    total_value_destroyed = metrics.total_isk_destroyed
    total_value_lost = metrics.total_isk_lost

    cond do
      total_value_destroyed == 0 and total_value_lost == 0 ->
        0.5
      total_value_lost == 0 ->
        1.0
      true ->
        efficiency = total_value_destroyed / (total_value_destroyed + total_value_lost)
        Float.round(efficiency, 3)
    end
  end

  defp calculate_survival_score(metrics) do
    if metrics.total_participants > 0 do
      survival_rate = metrics.total_survivors / metrics.total_participants
      survival_rate
    else
      0.0
    end
  end
end
