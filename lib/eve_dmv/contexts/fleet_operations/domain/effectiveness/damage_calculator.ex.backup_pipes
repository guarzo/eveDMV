defmodule EveDmv.Contexts.FleetOperations.Domain.Effectiveness.DamageCalculator do
  @moduledoc """
  Calculates damage-related metrics for fleet effectiveness.
  
  Provides damage efficiency calculations, DPS analysis, and
  damage application effectiveness metrics.
  """

  require Logger

  @doc """
  Calculate damage per second efficiency for a fleet.
  """
  def calculate_dps_efficiency(participants, killmails, engagement_duration_seconds) do
    total_damage = calculate_total_damage_dealt(participants, killmails)

    if engagement_duration_seconds > 0 do
      dps = total_damage / engagement_duration_seconds

      efficiency_metrics = %{
        total_damage: total_damage,
        engagement_duration: engagement_duration_seconds,
        damage_per_second: Float.round(dps, 2),
        damage_per_pilot: Float.round(total_damage / length(participants), 2),
        dps_per_pilot: Float.round(dps / length(participants), 2)
      }

      {:ok, efficiency_metrics}
    else
      {:error, :invalid_duration}
    end
  end

  @doc """
  Calculate total damage dealt by fleet participants.
  """
  def calculate_total_damage_dealt(participants, killmails) do
    participant_ids = MapSet.new(participants, &(&1.character_id))

    # Sum damage from all killmails where fleet members participated
    killmails
    |> Enum.flat_map(fn killmail ->
      Map.get(killmail, :attackers, [])
      |> Enum.filter(fn attacker ->
        MapSet.member?(participant_ids, attacker.character_id)
      end)
      |> Enum.map(&(Map.get(&1, :damage_done, 0)))
    end)
    |> Enum.sum()
  end

  @doc """
  Analyze damage spread across the fleet.
  """
  def analyze_damage_spread(fleet_attackers) do
    if Enum.empty?(fleet_attackers) do
      %{
        concentration_index: 0,
        top_damage_percentage: 0,
        distribution_rating: "N/A"
      }
    else
      damage_values = Enum.map(fleet_attackers, &(&1.damage_done || 0))
      total_damage = Enum.sum(damage_values)
      
      if total_damage == 0 do
        %{
          concentration_index: 0,
          top_damage_percentage: 0,
          distribution_rating: "No Damage"
        }
      else
        sorted_damage = Enum.sort(damage_values, :desc)
        top_20_percent_count = max(1, div(length(sorted_damage), 5))
        top_20_damage = Enum.sum(Enum.take(sorted_damage, top_20_percent_count))
        
        concentration = Float.round(top_20_damage / total_damage, 2)
        
        %{
          concentration_index: concentration,
          top_damage_percentage: Float.round(concentration * 100, 1),
          distribution_rating: rate_damage_distribution(concentration)
        }
      end
    end
  end

  @doc """
  Calculate damage efficiency metrics.
  """
  def calculate_damage_efficiency(participants, killmails) do
    participant_ids = MapSet.new(participants, &(&1.character_id))
    
    # Calculate various damage metrics
    total_damage = calculate_total_damage_dealt(participants, killmails)
    damage_application = analyze_damage_application(killmails, participant_ids)
    overkill_analysis = analyze_overkill_patterns(killmails, participant_ids)
    
    %{
      total_damage_dealt: total_damage,
      average_damage_per_pilot: Float.round(total_damage / length(participants), 0),
      damage_application_efficiency: damage_application,
      overkill_percentage: overkill_analysis.percentage,
      wasted_damage_estimate: overkill_analysis.wasted_damage,
      efficiency_rating: calculate_efficiency_rating(damage_application, overkill_analysis)
    }
  end

  defp analyze_damage_application(killmails, participant_ids) do
    fleet_kills = filter_fleet_kills(killmails, participant_ids)
    
    if Enum.empty?(fleet_kills) do
      %{
        hit_quality: 0,
        application_percentage: 0,
        resistance_penetration: 0
      }
    else
      # Analyze how well damage was applied
      application_scores = Enum.map(fleet_kills, fn killmail ->
        analyze_kill_damage_application(killmail, participant_ids)
      end)
      
      avg_hit_quality = average(Enum.map(application_scores, &(&1.hit_quality)))
      avg_application = average(Enum.map(application_scores, &(&1.application)))
      
      %{
        hit_quality: Float.round(avg_hit_quality, 2),
        application_percentage: Float.round(avg_application * 100, 1),
        resistance_penetration: estimate_resistance_penetration(fleet_kills)
      }
    end
  end

  defp analyze_kill_damage_application(killmail, participant_ids) do
    fleet_attackers = killmail.attackers
      |> Enum.filter(fn attacker ->
        MapSet.member?(participant_ids, attacker.character_id)
      end)
    
    if Enum.empty?(fleet_attackers) do
      %{hit_quality: 0, application: 0}
    else
      # Estimate hit quality based on damage patterns
      total_fleet_damage = Enum.sum(Enum.map(fleet_attackers, &(&1.damage_done || 0)))
      ship_hp = Map.get(killmail, :ship_hp, 50000) # Default ship HP estimate
      
      hit_quality = min(1.0, total_fleet_damage / ship_hp)
      application = calculate_application_efficiency(fleet_attackers, killmail)
      
      %{
        hit_quality: hit_quality,
        application: application
      }
    end
  end

  defp calculate_application_efficiency(fleet_attackers, _killmail) do
    # Simplified application efficiency based on attacker count and damage spread
    if length(fleet_attackers) == 0 do
      0
    else
      damage_values = Enum.map(fleet_attackers, &(&1.damage_done || 0))
      avg_damage = Enum.sum(damage_values) / length(damage_values)
      max_damage = Enum.max(damage_values)
      
      # Good application = consistent damage across attackers
      if max_damage > 0 do
        consistency = avg_damage / max_damage
        min(1.0, consistency * 1.2) # Slight bonus for good consistency
      else
        0
      end
    end
  end

  defp estimate_resistance_penetration(fleet_kills) do
    # Simplified resistance penetration estimate
    # In real implementation, would analyze damage types vs ship resistances
    0.75
  end

  defp analyze_overkill_patterns(killmails, participant_ids) do
    fleet_kills = filter_fleet_kills(killmails, participant_ids)
    
    if Enum.empty?(fleet_kills) do
      %{percentage: 0, wasted_damage: 0, instances: 0}
    else
      overkill_instances = Enum.map(fleet_kills, fn killmail ->
        calculate_overkill_for_kill(killmail, participant_ids)
      end)
      
      total_instances = Enum.count(overkill_instances, &(&1.is_overkill))
      total_wasted = Enum.sum(Enum.map(overkill_instances, &(&1.wasted_damage)))
      
      %{
        percentage: Float.round(total_instances / length(fleet_kills) * 100, 1),
        wasted_damage: total_wasted,
        instances: total_instances
      }
    end
  end

  defp calculate_overkill_for_kill(killmail, participant_ids) do
    fleet_damage = killmail.attackers
      |> Enum.filter(fn attacker ->
        MapSet.member?(participant_ids, attacker.character_id)
      end)
      |> Enum.map(&(&1.damage_done || 0))
      |> Enum.sum()
    
    ship_hp = Map.get(killmail, :ship_hp, 50000)
    
    if fleet_damage > ship_hp * 1.5 do
      %{
        is_overkill: true,
        wasted_damage: fleet_damage - ship_hp
      }
    else
      %{
        is_overkill: false,
        wasted_damage: 0
      }
    end
  end

  defp calculate_efficiency_rating(damage_application, overkill_analysis) do
    # Calculate overall efficiency rating
    application_score = damage_application.application_percentage / 100
    overkill_penalty = min(0.3, overkill_analysis.percentage / 100 * 0.5)
    
    raw_score = application_score * 0.7 + damage_application.hit_quality * 0.3 - overkill_penalty
    
    cond do
      raw_score >= 0.9 -> "Excellent"
      raw_score >= 0.75 -> "Good"
      raw_score >= 0.6 -> "Average"
      raw_score >= 0.45 -> "Below Average"
      true -> "Poor"
    end
  end

  defp rate_damage_distribution(concentration) do
    cond do
      concentration < 0.4 -> "Well Distributed"
      concentration < 0.6 -> "Moderately Concentrated"
      concentration < 0.8 -> "Highly Concentrated"
      true -> "Extremely Concentrated"
    end
  end

  defp filter_fleet_kills(killmails, participant_ids) do
    Enum.filter(killmails, fn killmail ->
      attackers = Map.get(killmail, :attackers, [])
      Enum.any?(attackers, fn attacker ->
        MapSet.member?(participant_ids, attacker.character_id)
      end)
    end)
  end

  defp average(list) when is_list(list) and length(list) > 0 do
    Enum.sum(list) / length(list)
  end
  defp average(_), do: 0
end