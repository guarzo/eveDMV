defmodule EveDmv.Contexts.FleetOperations.Domain.Performance.ThreatScorer do
  @moduledoc """
  Character threat scoring system for fleet operations context.

  Moved from character intelligence domain to fleet operations as it's primarily
  used for fleet composition and tactical assessment purposes.
  """

  import Ash.Query

  require Logger

  # Threat scoring parameters
  @analysis_window_days 90
  @minimum_killmails_for_scoring 5
  @combat_skill_weight 0.30
  @ship_mastery_weight 0.25
  @gang_effectiveness_weight 0.25
  @unpredictability_weight 0.10
  @recent_activity_weight 0.10

  @threat_levels %{
    extreme: 9.0,
    very_high: 7.5,
    high: 6.0,
    moderate: 4.0,
    low: 2.0,
    minimal: 0.0
  }

  @doc """
  Calculate comprehensive threat score for a character in fleet context.
  """
  def calculate_threat_score(character_id, options \\ []) do
    analysis_window = Keyword.get(options, :analysis_window_days, @analysis_window_days)
    include_breakdown = Keyword.get(options, :include_detailed_breakdown, true)
    weight_recent = Keyword.get(options, :weight_recent_activity, true)

    Logger.info("Calculating threat score for character #{character_id}")

    start_time = System.monotonic_time(:millisecond)

    with {:ok, combat_data} <- fetch_character_combat_data(character_id, analysis_window),
         {:ok, dimensional_scores} <- calculate_dimensional_scores(combat_data, weight_recent),
         {:ok, weighted_score} <- calculate_weighted_threat_score(dimensional_scores),
         {:ok, threat_assessment} <-
           generate_threat_assessment(
             character_id,
             weighted_score,
             dimensional_scores,
             include_breakdown
           ) do
      end_time = System.monotonic_time(:millisecond)
      duration_ms = end_time - start_time

      Logger.info("""
      Threat scoring completed in #{duration_ms}ms:
      - Character: #{character_id}
      - Threat Level: #{threat_assessment.threat_level}
      - Overall Score: #{Float.round(threat_assessment.overall_score, 2)}
      - Data Points: #{length(combat_data.killmails)}
      """)

      {:ok, threat_assessment}
    end
  end

  @doc """
  Compare threat levels between multiple characters.
  """
  def compare_threat_levels(character_ids, options \\ []) do
    analysis_window = Keyword.get(options, :analysis_window_days, @analysis_window_days)

    character_ids
    Task.async_stream(
      fn char_id ->
        case calculate_threat_score(char_id, analysis_window_days: analysis_window, include_detailed_breakdown: false) do
          {:ok, assessment} -> {char_id, assessment}
          {:error, _} -> {char_id, nil}
        end
      end,
      timeout: 30_000,
      max_concurrency: 4
    )
    Enum.map(fn {:ok, result} -> result end)
    |>     Enum.reject(fn {_char_id, assessment} -> is_nil(assessment) end)
    Enum.sort_by(fn {_char_id, assessment} -> assessment.overall_score end, :desc)
    then(&{:ok, &1})
  end

  # Private implementation functions

  defp fetch_character_combat_data(character_id, analysis_window_days) do
    cutoff_date = Date.add(Date.utc_today(), -analysis_window_days)

    # For now, return mock data structure until proper Ash queries are implemented
    # In production, this would use proper Ash queries to fetch character combat data

    with {:ok, attacker_killmails} <- {:ok, []},
         {:ok, victim_killmails} <- {:ok, []} do

      combat_data = %{
        character_id: character_id,
        analysis_period_days: analysis_window_days,
        attacker_killmails: attacker_killmails,
        victim_killmails: victim_killmails,
        killmails: attacker_killmails ++ victim_killmails,
        total_kills: length(attacker_killmails),
        total_losses: length(victim_killmails)
      }

      {:ok, combat_data}
    end
  end

  defp calculate_dimensional_scores(combat_data, weight_recent) do
    if length(combat_data.killmails) < @minimum_killmails_for_scoring do
      {:ok, %{
        combat_skill: 0.0,
        ship_mastery: 0.0,
        gang_effectiveness: 0.0,
        unpredictability: 0.0,
        recent_activity: 0.0,
        data_quality: :insufficient
      }}
    else
      combat_skill = calculate_combat_skill_score(combat_data)
      ship_mastery = calculate_ship_mastery_score(combat_data)
      gang_effectiveness = calculate_gang_effectiveness_score(combat_data)
      unpredictability = calculate_unpredictability_score(combat_data)
      recent_activity = calculate_recent_activity_score(combat_data, weight_recent)

      {:ok, %{
        combat_skill: combat_skill,
        ship_mastery: ship_mastery,
        gang_effectiveness: gang_effectiveness,
        unpredictability: unpredictability,
        recent_activity: recent_activity,
        data_quality: :sufficient
      }}
    end
  end

  defp calculate_combat_skill_score(combat_data) do
    total_isk_destroyed = calculate_total_isk_destroyed(combat_data.attacker_killmails)
    total_isk_lost = calculate_total_isk_lost(combat_data.victim_killmails)
    survival_rate = calculate_survival_rate(combat_data)
    damage_efficiency = calculate_damage_efficiency(combat_data.attacker_killmails)

    # ISK efficiency component (0-3 points)
    isk_ratio = if total_isk_lost > 0, do: total_isk_destroyed / total_isk_lost, else: total_isk_destroyed / 1_000_000
    isk_efficiency_score = :math.log10(max(isk_ratio, 0.1)) + 1 |> max(0) min(3)

    # Survival rate component (0-3 points)
    survival_updated_score = survival_rate * 3

    # Damage efficiency component (0-4 points)
    damage_updated_score = damage_efficiency * 4

    # Weighted combination
    combat_skill = (isk_efficiency_score * 0.3) + (survival_score * 0.3) + (damage_score * 0.4)
    min(combat_skill, 10.0)
  end

  defp calculate_ship_mastery_score(combat_data) do
    ship_types_used = extract_ship_types_used(combat_data.killmails)
    diversity_index = calculate_ship_diversity_index(ship_types_used)
    specialization_balance = calculate_specialization_balance(ship_types_used)

    # Ship diversity component (0-4 points)
    diversity_updated_score = diversity_index * 4

    # Specialization balance component (0-6 points)
    balance_updated_score = specialization_balance * 6

    ship_mastery = (diversity_score * 0.4) + (balance_score * 0.6)
    min(ship_mastery, 10.0)
  end

  defp calculate_gang_effectiveness_score(combat_data) do
    fleet_participation_rate = calculate_fleet_participation_rate(combat_data.killmails)
    support_role_effectiveness = calculate_support_role_effectiveness(combat_data.killmails)

    # Fleet participation component (0-5 points)
    participation_updated_score = fleet_participation_rate * 5

    # Support effectiveness component (0-5 points)
    support_updated_score = support_role_effectiveness * 5

    gang_effectiveness = (participation_score + support_score) / 2
    min(gang_effectiveness, 10.0)
  end

  defp calculate_unpredictability_score(combat_data) do
    tactical_variance = calculate_tactical_variance(combat_data.killmails)
    target_selection_variance = calculate_target_selection_variance(combat_data.attacker_killmails)

    # Tactical variance component (0-5 points)
    tactical_updated_score = tactical_variance * 5

    # Target selection variance component (0-5 points)
    target_updated_score = target_selection_variance * 5

    unpredictability = (tactical_score + target_score) / 2
    min(unpredictability, 10.0)
  end

  defp calculate_recent_activity_score(combat_data, weight_recent) do
    if not weight_recent do
      5.0 # Neutral score if not weighting recent activity
    else
      recent_killmails = filter_recent_killmails(combat_data.killmails, 30)
      activity_level = calculate_activity_level(recent_killmails)
      performance_variance = calculate_performance_variance(combat_data)

      # Recent activity level (0-5 points)
      activity_updated_score = activity_level * 5

      # Performance consistency (0-5 points)
      consistency_updated_score = (1.0 - performance_variance) * 5

      recent_activity = (activity_score + consistency_score) / 2
      min(recent_activity, 10.0)
    end
  end

  defp calculate_weighted_threat_score(dimensional_scores) do
    if dimensional_scores.data_quality == :insufficient do
      {:ok, %{
        overall_score: 0.0,
        confidence: :low,
        weighted_components: %{
          combat_skill: 0.0,
          ship_mastery: 0.0,
          gang_effectiveness: 0.0,
          unpredictability: 0.0,
          recent_activity: 0.0
        }
      }}
    else
      weighted_score =
        (dimensional_scores.combat_skill * @combat_skill_weight) +
        (dimensional_scores.ship_mastery * @ship_mastery_weight) +
        (dimensional_scores.gang_effectiveness * @gang_effectiveness_weight) +
        (dimensional_scores.unpredictability * @unpredictability_weight) +
        (dimensional_scores.recent_activity * @recent_activity_weight)

      confidence = if weighted_score > 1.0, do: :high, else: :medium

      {:ok, %{
        overall_score: weighted_score,
        confidence: confidence,
        weighted_components: %{
          combat_skill: dimensional_scores.combat_skill * @combat_skill_weight,
          ship_mastery: dimensional_scores.ship_mastery * @ship_mastery_weight,
          gang_effectiveness: dimensional_scores.gang_effectiveness * @gang_effectiveness_weight,
          unpredictability: dimensional_scores.unpredictability * @unpredictability_weight,
          recent_activity: dimensional_scores.recent_activity * @recent_activity_weight
        }
      }}
    end
  end

  defp generate_threat_assessment(character_id, weighted_score, dimensional_scores, include_breakdown) do
    threat_level = determine_threat_level(weighted_score.overall_score)

    assessment = %{
      character_id: character_id,
      overall_score: weighted_score.overall_score,
      threat_level: threat_level,
      confidence: weighted_score.confidence,
      assessment_timestamp: DateTime.utc_now()
    }

    final_assessment = if include_breakdown do
      Map.merge(assessment, %{
        dimensional_breakdown: dimensional_scores,
        weighted_components: weighted_score.weighted_components,
        threat_level_thresholds: @threat_levels
      })
    else
      assessment
    end

    {:ok, final_assessment}
  end

  defp determine_threat_level(score) do
    cond do
      score >= @threat_levels.extreme -> :extreme
      score >= @threat_levels.very_high -> :very_high
      score >= @threat_levels.high -> :high
      score >= @threat_levels.moderate -> :moderate
      score >= @threat_levels.low -> :low
      true -> :minimal
    end
  end

  # Helper calculation functions (simplified versions)

  defp calculate_total_isk_destroyed(attacker_killmails) do
    attacker_killmails
    |>     Enum.map(&(&1.total_value || 0))
    Enum.sum()
  end

  defp calculate_total_isk_lost(victim_killmails) do
    victim_killmails
    |>     Enum.map(&(&1.total_value || 0))
    Enum.sum()
  end

  defp calculate_survival_rate(combat_data) do
    total_engagements = length(combat_data.attacker_killmails) + length(combat_data.victim_killmails)
    if total_engagements > 0 do
      length(combat_data.attacker_killmails) / total_engagements
    else
      0.0
    end
  end

  defp calculate_damage_efficiency(attacker_killmails) do
    # Simplified damage efficiency calculation
    if Enum.empty?(attacker_killmails), do: 0.0, else: 0.7
  end

  defp extract_ship_types_used(killmails) do
    killmails
    |>     Enum.flat_map(fn km ->
      ship_types = [km.victim["ship_type_id"]]
      attacker_ships = Enum.map(km.attackers || [], &(&1["ship_type_id"]))
      ship_types ++ attacker_ships
    end)
    Enum.reject(&is_nil/1)
    Enum.frequencies()
  end

  defp calculate_ship_diversity_index(ship_types_map) do
    if map_size(ship_types_map) <= 1, do: 0.0, else: 0.6
  end

  defp calculate_specialization_balance(ship_types_map) do
    if map_size(ship_types_map) == 0, do: 0.0, else: 0.5
  end

  defp calculate_fleet_participation_rate(killmails) do
    # Simplified fleet participation calculation
    fleet_kills = Enum.count(killmails, fn km -> length(km.attackers || []) > 1 end)
    if length(killmails) > 0, do: fleet_kills / length(killmails), else: 0.0
  end

  defp calculate_support_role_effectiveness(killmails) do
    # Simplified support role calculation
    if Enum.empty?(killmails), do: 0.0, else: 0.4
  end

  defp calculate_tactical_variance(killmails) do
    # Simplified tactical variance calculation
    if length(killmails) < 5, do: 0.3, else: 0.6
  end

  defp calculate_target_selection_variance(attacker_killmails) do
    # Simplified target selection variance
    if length(attacker_killmails) < 3, do: 0.2, else: 0.5
  end

  defp calculate_activity_level(recent_killmails) do
    # Activity level based on recent _killmail count
    case length(recent_killmails) do
      0 -> 0.0
      1..5 -> 0.3
      6..15 -> 0.6
      _ -> 1.0
    end
  end

  defp calculate_performance_variance(combat_data) do
    # Simplified performance variance calculation
    if length(combat_data.killmails) < 10, do: 0.4, else: 0.2
  end

  defp filter_recent_killmails(killmails, days) do
    cutoff_date = Date.add(Date.utc_today(), -days)
    Enum.filter(killmails, fn km ->
      Date.compare(km.killmail_time, cutoff_date) in [:eq, :gt]
    end)
  end
end
