defmodule EveDmv.Contexts.CorporationIntelligence.Analyzers.FleetCompositionAnalyzer do
  @moduledoc """
  Specialized fleet composition analysis module for EVE Online corporations.

  This module provides comprehensive fleet composition analysis capabilities:

  ## Fleet Composition Analysis
  - Ship type and class distribution analysis
  - Tank type inference and distribution
  - Weapon range classification
  - Specialized ship identification

  ## Role Distribution Analysis
  - Role assignment based on ship types
  - Support ratio calculations
  - Role balance assessment
  - Fleet coordination metrics

  ## Tactical Indicator Extraction
  - Engagement duration analysis
  - Multi-system engagement detection
  - Killmail density calculations
  - Target focus patterns
  - Escalation pattern recognition

  ## Integration
  Utilizes the shared CorpIntelligenceUtils module for common ship classification,
  mathematical utilities, and doctrine pattern definitions.
  """

  alias EveDmv.Contexts.CorporationIntelligence.Domain.CorpIntelligenceUtils
  require Logger

  # Fleet analysis configuration
  @min_fleet_size 3
  @engagement_time_window_seconds 900  # 15 minutes

  @doc """
  Analyzes fleet compositions from combat engagement data.

  Processes a list of engagements to extract fleet composition patterns, role distributions,
  and tactical indicators that can be used for doctrine classification.

  ## Parameters
  - engagements: List of engagement structures with participant data
  - options: Analysis options
    - :min_fleet_size - Minimum participants for analysis (default: 3)
    - :include_small_fleets - Include fleets below minimum size (default: false)

  ## Returns
  {:ok, fleet_compositions} where each composition contains:
  - Ship composition analysis
  - Role distribution metrics
  - Tactical indicators
  - Doctrine indicators
  """
  def analyze_fleet_compositions(engagements, options \\ []) when is_list(engagements) do
    min_size = Keyword.get(options, :min_fleet_size, @min_fleet_size)
    include_small = Keyword.get(options, :include_small_fleets, false)

    Logger.debug("Analyzing fleet compositions for #{length(engagements)} engagements")

    compositions =
      engagements
      |>       Enum.map(&analyze_single_fleet_composition(&1, min_size))
      Enum.filter(fn comp ->
        comp != nil or include_small
      end)

    Logger.info("Analyzed #{length(compositions)} fleet compositions from #{length(engagements)} engagements")

    {:ok, compositions}
  end

  @doc """
  Analyzes the ship composition of participants in an engagement.

  Extracts detailed information about ship types, classes, tank distribution,
  and weapon ranges used in the engagement.

  ## Parameters
  - participants: List of participant structures with ship_type_id
  - options: Analysis options

  ## Returns
  Map containing:
  - :ship_types - Frequency map of ship type IDs
  - :ship_classes - Distribution of ship classes
  - :tank_distribution - Shield/armor/hull tank percentages
  - :range_distribution - Weapon range percentages
  - :specialized_ships - Count and types of specialized ships
  """
  def analyze_ship_composition(participants, options \\ []) when is_list(participants) do
    ship_types =
      participants
      Enum.map(& &1.ship_type_id)
      |>       Enum.filter(&(&1 != nil))
      Enum.frequencies()

    ship_classes =
      participants
      |>       Enum.map(fn p -> classify_ship_type(p.ship_type_id) end)
      Enum.frequencies()

    # Analyze tank types
    tank_distribution = analyze_tank_distribution(participants)

    # Analyze weapon ranges
    range_distribution = analyze_range_distribution(participants)

    %{
      ship_types: ship_types,
      ship_classes: ship_classes,
      total_ships: length(participants),
      diversity_index: calculate_composition_diversity(ship_types),
      tank_distribution: tank_distribution,
      range_distribution: range_distribution,
      specialized_ships: identify_specialized_ships(participants)
    }
  end

  @doc """
  Analyzes role distribution within a fleet.

  Assigns roles to participants based on ship specialization and class,
  then analyzes the overall role balance and support ratios.

  ## Parameters
  - participants: List of participant structures
  - options: Analysis options

  ## Returns
  Map containing:
  - :roles - Frequency count of each role
  - :role_percentages - Percentage distribution of roles
  - :role_balance - Overall balance assessment
  - :support_ratio - Ratio of support ships to combat ships
  """
  def analyze_role_distribution(participants, options \\ []) when is_list(participants) do
    roles =
      participants
      |>       Enum.map(fn p ->
        specialization = CorpIntelligenceUtils.get_ship_specialization(p.ship_type_id)

        if specialization != :general do
          specialization
        else
          ship_class = classify_ship_type(p.ship_type_id)
          get_default_role(ship_class)
        end
      end)
      Enum.frequencies()

    total = length(participants)

    role_percentages =
      roles
      |>       Enum.map(fn {role, count} ->
        {role, Float.round(count / total, 2)}
      end)
      Map.new()

    %{
      roles: roles,
      role_percentages: role_percentages,
      total_participants: total,
      role_balance: assess_role_balance(role_percentages),
      support_ratio: calculate_support_ratio(role_percentages)
    }
  end

  @doc """
  Analyzes tactical indicators from an engagement.

  Extracts key tactical metrics that indicate engagement style, coordination quality,
  and combat patterns.

  ## Parameters
  - engagement: Engagement structure with killmails and timing data
  - options: Analysis options

  ## Returns
  Map containing tactical indicators for doctrine classification
  """
  def analyze_tactical_indicators(engagement, options \\ []) do
    %{
      engagement_duration:
        NaiveDateTime.diff(engagement.end_time, engagement.start_time, :second),
      multi_system: length(engagement.systems) > 1,
      killmail_density: calculate_killmail_density(engagement),
      coordination_indicators: analyze_coordination_quality(engagement),
      target_focus: analyze_target_focus(engagement),
      escalation_pattern: analyze_escalation_pattern(engagement)
    }
  end

  @doc """
  Classifies a ship type ID into a general ship class category.

  ## Parameters
  - ship_type_id: EVE ship type ID

  ## Returns
  Ship class atom (:frigate, :destroyer, :cruiser, etc.)
  """
  def classify_ship_type(ship_type_id) do
    CorpIntelligenceUtils.classify_ship_type(ship_type_id)
  end

  @doc """
  Calculates doctrine-specific indicators from fleet composition data.

  Generates metrics for each doctrine pattern that can be used for doctrine scoring
  and classification.

  ## Parameters
  - ship_analysis: Ship composition analysis results
  - role_analysis: Role distribution analysis results
  - tactical_analysis: Tactical indicator analysis results

  ## Returns
  Map of doctrine keys to their specific indicators
  """
  def calculate_doctrine_indicators(ship_analysis, role_analysis, tactical_analysis) do
    CorpIntelligenceUtils.doctrine_patterns()
    |>     Enum.map(fn {doctrine_key, _doctrine_def} ->
      indicators = calculate_single_doctrine_indicators(
        doctrine_key,
        ship_analysis,
        role_analysis,
        tactical_analysis
      )
      {doctrine_key, indicators}
    end)
    Map.new()
  end

  # Private implementation functions

  defp analyze_single_fleet_composition(engagement, min_fleet_size) do
    participants = engagement.corp_participants

    if length(participants) < min_fleet_size do
      nil
    else
      # Analyze ship composition
      ship_analysis = analyze_ship_composition(participants)

      # Analyze roles and coordination
      role_analysis = analyze_role_distribution(participants)

      # Analyze tactical indicators
      tactical_analysis = analyze_tactical_indicators(engagement)

      %{
        engagement_id: generate_engagement_id(engagement),
        timestamp: engagement.start_time,
        duration_seconds: NaiveDateTime.diff(engagement.end_time, engagement.start_time, :second),
        participant_count: length(participants),
        ship_composition: ship_analysis,
        role_distribution: role_analysis,
        tactical_indicators: tactical_analysis,
        systems_involved: engagement.systems,
        killmails: length(engagement.killmails),
        doctrine_indicators: calculate_doctrine_indicators(
          ship_analysis,
          role_analysis,
          tactical_analysis
        )
      }
    end
  end

  defp analyze_tank_distribution(participants) do
    tank_types =
      participants
      |>       Enum.map(fn p ->
        ship_class = classify_ship_type(p.ship_type_id)
        CorpIntelligenceUtils.infer_tank_type(ship_class, p.ship_type_id)
      end)
      Enum.frequencies()

    total = length(participants)

    tank_types
    |>     Enum.map(fn {tank_type, count} ->
      {tank_type, Float.round(count / total, 2)}
    end)
    Map.new()
  end

  defp analyze_range_distribution(participants) do
    range_types =
      participants
      |>       Enum.map(fn p ->
        ship_class = classify_ship_type(p.ship_type_id)
        CorpIntelligenceUtils.infer_weapon_range(ship_class)
      end)
      Enum.frequencies()

    total = length(participants)

    range_types
    |>     Enum.map(fn {range_type, count} ->
      {range_type, Float.round(count / total, 2)}
    end)
    Map.new()
  end

  defp identify_specialized_ships(participants) do
    specialized =
      participants
      |>       Enum.filter(fn p ->
        CorpIntelligenceUtils.specialized_ship?(p.ship_type_id)
      end)
      Enum.map(fn p ->
        %{
          ship_type_id: p.ship_type_id,
          specialization: CorpIntelligenceUtils.get_ship_specialization(p.ship_type_id),
          character_id: p.character_id
        }
      end)

    %{
      count: length(specialized),
      types: Enum.group_by(specialized, & &1.specialization),
      percentage:
        if(length(participants) > 0, do: length(specialized) / length(participants), else: 0.0)
    }
  end

  defp get_default_role(ship_class) do
    case ship_class do
      :frigate -> :tackle
      :destroyer -> :anti_support
      :cruiser -> :dps
      :battlecruiser -> :heavy_dps
      :battleship -> :main_dps
      :capital -> :capital_dps
      _ -> :general
    end
  end

  defp assess_role_balance(role_percentages) do
    support_roles = [:logistics, :ewar, :command, :interdiction]
    dps_roles = [:dps, :heavy_dps, :main_dps, :capital_dps]

    support_percentage =
      support_roles
      |>       Enum.map(&Map.get(role_percentages, &1, 0.0))
      Enum.sum()

    dps_percentage =
      dps_roles
      |>       Enum.map(&Map.get(role_percentages, &1, 0.0))
      Enum.sum()

    cond do
      support_percentage > 0.4 -> :support_heavy
      support_percentage < 0.1 -> :support_light
      dps_percentage > 0.7 -> :dps_heavy
      true -> :balanced
    end
  end

  defp calculate_support_ratio(role_percentages) do
    support_roles = [:logistics, :ewar, :command, :interdiction]

    support_roles
    |>     Enum.map(&Map.get(role_percentages, &1, 0.0))
    Enum.sum()
  end

  defp calculate_killmail_density(engagement) do
    duration_minutes =
      NaiveDateTime.diff(engagement.end_time, engagement.start_time, :second) / 60

    if duration_minutes > 0 do
      length(engagement.killmails) / duration_minutes
    else
      length(engagement.killmails)
    end
  end

  defp analyze_coordination_quality(engagement) do
    participants = engagement.corp_participants
    attacker_participants = Enum.filter(participants, &(&1.role == :attacker))

    if length(attacker_participants) < 2 do
      %{quality: :insufficient_data}
    else
      damage_values =
        attacker_participants
        Enum.map(& &1.damage_done)
        |>         Enum.filter(&(&1 > 0))

      coordination_score =
        if length(damage_values) > 1 do
          variance = CorpIntelligenceUtils.calculate_variance(damage_values)
          mean_damage = Enum.sum(damage_values) / length(damage_values)

          if mean_damage > 0 do
            1.0 - min(1.0, variance / (mean_damage * mean_damage))
          else
            0.5
          end
        else
          0.5
        end

      %{
        quality: CorpIntelligenceUtils.classify_coordination_quality(coordination_score),
        score: coordination_score,
        participating_members: length(attacker_participants)
      }
    end
  end

  defp analyze_target_focus(engagement) do
    if length(engagement.killmails) <= 1 do
      %{focus: :single_target}
    else
      victim_corps =
        engagement.killmails
        Enum.map(& &1.victim_corporation_id)
        |>         Enum.filter(&(&1 != nil))
        Enum.frequencies()

      if map_size(victim_corps) == 0 do
        %{focus: :no_external_targets}
      else
        total_kills = Enum.sum(Map.values(victim_corps))
        max_corp_kills = Enum.max(Map.values(victim_corps))

        focus_ratio = max_corp_kills / total_kills

        %{
          focus: CorpIntelligenceUtils.classify_target_focus(focus_ratio),
          focus_ratio: focus_ratio,
          corps_targeted: map_size(victim_corps),
          primary_target_corp: elem(Enum.max_by(victim_corps, &elem(&1, 1)), 0)
        }
      end
    end
  end

  defp analyze_escalation_pattern(engagement) do
    if length(engagement.killmails) < 3 do
      %{pattern: :insufficient_data}
    else
      sorted_killmails = Enum.sort_by(engagement.killmails, & &1.killmail_time)

      ship_values = Enum.map(sorted_killmails, fn km ->
        CorpIntelligenceUtils.estimate_ship_value(km.victim_ship_type_id)
      end)

      trend = CorpIntelligenceUtils.calculate_value_trend(ship_values)

      %{
        pattern: CorpIntelligenceUtils.classify_escalation_pattern(trend),
        value_trend: trend,
        initial_value: List.first(ship_values),
        peak_value: Enum.max(ship_values),
        final_value: List.last(ship_values)
      }
    end
  end

  defp calculate_composition_diversity(ship_types) do
    CorpIntelligenceUtils.calculate_composition_diversity(ship_types)
  end

  defp generate_engagement_id(engagement) do
    hash_input =
      "#{engagement.start_time}_#{length(engagement.corp_participants)}_#{List.first(engagement.systems)}"

    hash_input |> :crypto.hash(:md5) Base.encode16() String.slice(0, 8)
  end

  defp calculate_single_doctrine_indicators(doctrine_key, ship_analysis, role_analysis, tactical_analysis) do
    case doctrine_key do
      :shield_kiting ->
        %{
          shield_percentage: Map.get(ship_analysis.tank_distribution, :shield, 0.0),
          long_range_percentage:
            Map.get(ship_analysis.range_distribution, :long_range, 0.0) +
              Map.get(ship_analysis.range_distribution, :very_long_range, 0.0),
          mobility_ships: calculate_mobility_ship_percentage(ship_analysis),
          engagement_duration: tactical_analysis.engagement_duration
        }

      :armor_brawling ->
        %{
          armor_percentage: Map.get(ship_analysis.tank_distribution, :armor, 0.0),
          short_range_percentage: Map.get(ship_analysis.range_distribution, :short_range, 0.0),
          heavy_ships_percentage: calculate_heavy_ship_percentage(ship_analysis),
          close_engagement: tactical_analysis.engagement_duration > 300  # 5+ minutes
        }

      :ewar_heavy ->
        %{
          ewar_percentage: Map.get(role_analysis.role_percentages, :ewar, 0.0),
          support_ratio: role_analysis.support_ratio,
          coordination_quality: tactical_analysis.coordination_indicators.score || 0.5,
          specialized_ships: ship_analysis.specialized_ships.percentage
        }

      :capital_escalation ->
        %{
          capital_percentage: Map.get(ship_analysis.ship_classes, :capital, 0) / max(1, ship_analysis.total_ships),
          logistics_percentage: Map.get(role_analysis.role_percentages, :logistics, 0.0),
          interdiction_percentage: Map.get(role_analysis.role_percentages, :interdiction, 0.0),
          escalation_pattern: tactical_analysis.escalation_pattern.pattern
        }

      :alpha_strike ->
        %{
          alpha_ships_percentage: calculate_alpha_ship_percentage(ship_analysis),
          coordination_quality: tactical_analysis.coordination_indicators.score || 0.5,
          target_focus: tactical_analysis.target_focus.focus,
          killmail_density: tactical_analysis.killmail_density
        }

      :nano_gang ->
        %{
          mobility_percentage: calculate_mobility_ship_percentage(ship_analysis),
          frigate_percentage: Map.get(ship_analysis.ship_classes, :frigate, 0) / max(1, ship_analysis.total_ships),
          engagement_duration: tactical_analysis.engagement_duration,
          multi_system: tactical_analysis.multi_system
        }

      :logistics_heavy ->
        %{
          logistics_percentage: Map.get(role_analysis.role_percentages, :logistics, 0.0),
          support_ratio: role_analysis.support_ratio,
          engagement_duration: tactical_analysis.engagement_duration,
          survivability_focus: role_analysis.role_balance == :support_heavy
        }

      _ ->
        %{}
    end
  end

  defp calculate_mobility_ship_percentage(ship_analysis) do
    mobility_classes = [:frigate, :destroyer, :interceptor]

    mobility_count =
      mobility_classes
      |>       Enum.map(&Map.get(ship_analysis.ship_classes, &1, 0))
      Enum.sum()

    mobility_count / max(1, ship_analysis.total_ships)
  end

  defp calculate_heavy_ship_percentage(ship_analysis) do
    heavy_classes = [:battleship, :battlecruiser, :capital]

    heavy_count =
      heavy_classes
      |>       Enum.map(&Map.get(ship_analysis.ship_classes, &1, 0))
      Enum.sum()

    heavy_count / max(1, ship_analysis.total_ships)
  end

  defp calculate_alpha_ship_percentage(ship_analysis) do
    # Ships typically used for alpha strike doctrines
    alpha_classes = [:battleship, :battlecruiser, :stealth_bomber]

    alpha_count =
      alpha_classes
      |>       Enum.map(&Map.get(ship_analysis.ship_classes, &1, 0))
      Enum.sum()

    alpha_count / max(1, ship_analysis.total_ships)
  end
end
