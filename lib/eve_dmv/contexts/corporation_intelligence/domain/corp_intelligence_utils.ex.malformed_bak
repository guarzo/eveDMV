  end

  @doc """
  Classifies coordination quality based on numerical score.

  Converts coordination scores (0.0-1.0) into qualitative assessments
  for tactical analysis and fleet effectiveness evaluation.
  """
  def classify_coordination_quality(score) when is_number(score) do
    cond do
      score >= 0.8 -> :excellent
      score >= 0.6 -> :good
      score >= 0.4 -> :moderate
      true -> :poor
    end
  end

  @doc """
  Classifies target focus based on focus ratio.

  Determines how concentrated a fleet's attacks were on specific targets,
  indicating tactical discipline and coordination.
  """
  def classify_target_focus(focus_ratio) when is_number(focus_ratio) do
    cond do
      focus_ratio >= 0.8 -> :highly_focused
      focus_ratio >= 0.6 -> :moderately_focused
      focus_ratio >= 0.4 -> :somewhat_focused
      true -> :dispersed
    end
  end

  @doc """
  Classifies escalation patterns based on value trend.

  Analyzes value progression in engagements to identify escalation
  or de-escalation patterns in combat.
  """
  def classify_escalation_pattern(trend) when is_number(trend) do
    cond do
      trend > 50_000_000 -> :strong_escalation
      trend > 10_000_000 -> :moderate_escalation
      trend > -10_000_000 -> :stable
      trend > -50_000_000 -> :de_escalation
      true -> :strong_de_escalation
    end
  end

