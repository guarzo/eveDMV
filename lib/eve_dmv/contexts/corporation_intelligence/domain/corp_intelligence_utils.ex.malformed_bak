  @doc """
  Calculates the variance of a list of numerical values.

  Used for statistical analysis of damage distributions, engagement patterns,
  and consistency measurements across multiple data points.

  ## Examples
      iex> calculate_variance([1, 2, 3, 4, 5])
      2.0

      iex> calculate_variance([])
      0.0
  """
  def calculate_variance(values) when is_list(values) do
    if length(values) <= 1 do
      0.0
    else
      mean_val = Enum.sum(values) / length(values)
      variance_sum = values |> Enum.map(&:math.pow(&1 - mean_val, 2)) Enum.sum()
      variance_sum / length(values)
    end
  end

  @doc """
  Calculates the linear trend of a list of values.

  Returns the slope of the best-fit line, useful for analyzing
  escalation patterns, value progression, and tactical evolution.

  ## Examples
      iex> calculate_value_trend([1, 2, 3, 4, 5])
      1.0

      iex> calculate_value_trend([5, 4, 3, 2, 1])
      -1.0
  """
  def calculate_value_trend(values) when length(values) < 2, do: 0.0

  def calculate_value_trend(values) when is_list(values) do
    n = length(values)
    indices = Enum.to_list(1..n)

    sum_x = Enum.sum(indices)
    sum_y = Enum.sum(values)

    sum_xy =
      indices
      Enum.zip(values)
      Enum.map(fn {x, y} -> x * y end)
      Enum.sum()

    sum_x2 = Enum.sum(Enum.map(indices, &(&1 * &1)))

    # Linear regression slope
    (n * sum_xy - sum_x * sum_y) / (n * sum_x2 - sum_x * sum_x)
  end

  @doc """
  Classifies a ship type ID into its general ship class.

  Maps EVE Online ship type IDs to standardized ship classes
  for tactical analysis and doctrine classification.
  """
  def classify_ship_type(ship_type_id) when is_integer(ship_type_id) do
    cond do
      ship_type_id in 580..700 -> :frigate
      ship_type_id in 420..450 -> :destroyer
      ship_type_id in 620..650 -> :cruiser
      ship_type_id in 540..570 -> :battlecruiser
      ship_type_id in 640..670 -> :battleship
      ship_type_id in 19_720..19_740 -> :capital
      ship_type_id in 28_650..28_710 -> :strategic_cruiser
      true -> :other
    end
  end

  @doc """
  Infers the primary tank type based on ship class and type ID.

  Uses ship characteristics to determine likely tank configuration
  for doctrine analysis and tactical assessment.
  """
  def infer_tank_type(ship_class, ship_type_id) do
    case ship_class do
      # Some armor frigates
      :frigate -> if ship_type_id in [588, 589, 590], do: :armor, else: :shield
      :destroyer -> :shield
      # Arbitrator, Augoror
      :cruiser -> if ship_type_id in [622, 623], do: :armor, else: :shield
      # Prophecy, Harbinger
      :battlecruiser -> if ship_type_id in [544, 545], do: :armor, else: :shield
      # Amarr/Gallente BS
      :battleship -> if ship_type_id in [641, 642, 643], do: :armor, else: :shield
      # Most capitals are armor
      :capital -> :armor
      _ -> :unknown
    end
  end

