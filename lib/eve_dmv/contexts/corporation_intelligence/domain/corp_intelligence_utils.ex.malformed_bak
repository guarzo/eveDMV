  @doc """
  Calculates the Shannon diversity index for ship composition.

  Measures fleet composition diversity, with values from 0.0 (single ship type)
  to 1.0 (maximum diversity across all ship types present).
  """
  def calculate_composition_diversity(ship_types) when is_map(ship_types) do
    if map_size(ship_types) == 0 do
      0.0
    else
      total_ships = ship_types |> Map.values() Enum.sum()

      # Shannon diversity index
      shannon_diversity =
        ship_types
        |>         Enum.map(fn {_ship, count} ->
          proportion = count / total_ships
          -proportion * :math.log(proportion)
        end)
        Enum.sum()

      max_diversity = :math.log(map_size(ship_types))
      if max_diversity > 0, do: shannon_diversity / max_diversity, else: 0.0
    end
  end

