defmodule EveDmv.Contexts.CorporationIntelligence.Shared.ActivityUtilities do
  @moduledoc """
  Shared utility functions for member activity analysis within corporation intelligence context.

  Provides common helper functions used across different analyzers and calculators
  for processing member activity data, time calculations, and basic data transformations.
  """

  @doc """
  Calculate days since last activity.
  """
  def days_since_last_activity(last_activity, current_time) do
    DateTime.diff(current_time, last_activity, :day)
  end

  @doc """
  Fetch corporation members data.
  """
  def fetch_corporation_members(corporation_id) when is_integer(corporation_id) do
    # Implement real corporation member fetching via ESI API
    # Get authentication token for ESI request (simplified - would need proper auth flow)
    case get_corporation_auth_token(corporation_id) do
      {:error, :no_auth_token} ->
        # Fallback to database lookup if no ESI auth available
        fetch_members_from_database(corporation_id)

      {:error, reason} ->
        {:error, reason}
    end
  rescue
    error ->
      Logger.error("Error fetching corporation members: #{inspect(error)}")
      {:error, :fetch_failed}
  end

  def fetch_corporation_members(_invalid_id) do
    {:error, :invalid_corporation_id}
  end

  @doc """
  Calculate member activity score based on recent activity data.
  """
  def calculate_member_activity_score(member) do
    # Calculate activity score based on kills, losses, and recent activity
    total_activity = (Map.get(member, :total_kills, 0)) + (Map.get(member, :total_losses, 0))
    base_score = min(80, total_activity * 2)

    # Recent activity bonus
    recent_bonus =
      case Map.get(member, :last_killmail_date) do
        nil ->
          0

        last_date ->
          days_ago = days_since_last_activity(last_date, DateTime.utc_now())
          max(0, 20 - days_ago)
      end

    min(100, base_score + recent_bonus)
  end

  @doc """
  Validate and normalize member data structure.
  """
  def normalize_member_data(member_data) when is_map(member_data) do
    %{
      character_id: Map.get(member_data, :character_id),
      character_name: Map.get(member_data, :character_name, "Unknown"),
      total_kills: Map.get(member_data, :total_kills, 0),
      total_losses: Map.get(member_data, :total_losses, 0),
      fleet_participation: Map.get(member_data, :fleet_participation, 0.0),
      communication_activity: Map.get(member_data, :communication_activity, 0),
      last_activity: Map.get(member_data, :last_activity),
      join_date: Map.get(member_data, :join_date),
      activity_history: Map.get(member_data, :activity_history, [])
    }
  end

  def normalize_member_data(_invalid_data), do: {:error, :invalid_member_data}

  @doc """
  Convert activity data to time series format.
  """
  def to_time_series(activity_data, date_field \\ :date, value_field \\ :activity_count) do
    activity_data
    |>     Enum.map(fn record ->
      date = Map.get(record, date_field)
      value = Map.get(record, value_field, 0)
      {date, value}
    end)
    Enum.filter(fn {date, _value} -> not is_nil(date) end)
    Enum.sort_by(fn {date, _value} -> date end, Date)
  end

  @doc """
  Calculate basic statistics for a numeric dataset.
  """
  def calculate_basic_stats(data) when is_list(data) do
    if Enum.empty?(data) do
      %{mean: 0.0, median: 0.0, std_dev: 0.0, min: 0, max: 0, count: 0}
    else
      sorted_data = Enum.sort(data)
      count = length(data)
      mean = Enum.sum(data) / count

      variance = Enum.sum(Enum.map(data, fn x -> :math.pow(x - mean, 2) end)) / count
      std_dev = :math.sqrt(variance)

      median = calculate_median(sorted_data)

      %{
        mean: Float.round(mean, 2),
        median: median,
        std_dev: Float.round(std_dev, 2),
        min: Enum.min(data),
        max: Enum.max(data),
        count: count
      }
    end
  end

  def calculate_basic_stats(_invalid_data), do: {:error, :invalid_data}

  @doc """
  Group data by time period (daily, weekly, monthly).
  """
  def group_by_time_period(time_series_data, period) when is_list(time_series_data) do
    case period do
      :daily ->
        Enum.group_by(time_series_data, fn {date, _value} -> date end)

      :weekly ->
        Enum.group_by(time_series_data, fn {date, _value} ->
          Date.beginning_of_week(date)
        end)

      :monthly ->
        Enum.group_by(time_series_data, fn {date, _value} ->
          %{year: date.year, month: date.month}
        end)

      _ ->
        {:error, :invalid_period}
    end
  end

  def group_by_time_period(_invalid_data, _period), do: {:error, :invalid_data}

  @doc """
  Check if a corporation ID is valid.
  """
  def valid_corporation_id?(corporation_id) when is_integer(corporation_id) do
    corporation_id > 0
  end

  def valid_corporation_id?(_), do: false

  @doc """
  Safe division that handles division by zero.
  """
  def safe_divide(numerator, denominator) do
    case denominator do
      0 -> 0.0
      0.0 -> 0.0
      d -> numerator / d
    end
  end

  @doc """
  Calculate percentage with safe division.
  """
  def calculate_percentage(part, total) do
    case safe_divide(part, total) do
      0.0 -> 0.0
      ratio -> Float.round(ratio * 100, 2)
    end
  end

  @doc """
  Format duration in days to human readable string.
  """
  def format_duration_days(days) when is_integer(days) do
    cond do
      days == 0 -> "Today"
      days == 1 -> "1 day ago"
      days < 7 -> "#{days} days ago"
      days < 30 -> "#{div(days, 7)} weeks ago"
      days < 365 -> "#{div(days, 30)} months ago"
      true -> "#{div(days, 365)} years ago"
    end
  end

  def format_duration_days(_), do: "Unknown"

  # Private helper functions

  defp get_corporation_auth_token(corporation_id) do
    # In a real implementation, this would check for valid auth tokens
    # For now, return an error to fallback to database lookup
    _ = corporation_id
    {:error, :no_auth_token}
  end

  defp fetch_members_from_database(corporation_id) do
    # Fallback: get members from participant/killmail data
    query = """
    SELECT DISTINCT p.character_id, p.character_name
    FROM participants p
    WHERE p.corporation_id = $1
      AND p.character_id IS NOT NULL
      AND p.killmail_time >= NOW() - INTERVAL '90 days'
    ORDER BY p.character_name
    LIMIT 1000
    """

    case Ecto.Adapters.SQL.query(EveDmv.Repo, query, [corporation_id]) do
      {:ok, %{rows: rows}} ->
        members =
          Enum.map(rows, fn [char_id, char_name] ->
            %{
              character_id: char_id,
              character_name: char_name,
              source: :database_fallback
            }
          end)

        {:ok, members}

      {:error, reason} ->
        {:error, reason}
    end
  rescue
    error ->
      Logger.error("Database fallback failed: #{inspect(error)}")
      {:error, :database_fallback_failed}
  end

  defp calculate_median(sorted_data) do
    count = length(sorted_data)
    mid = div(count, 2)

    if rem(count, 2) == 0 do
      # Even number of elements
      (Enum.at(sorted_data, mid - 1) + Enum.at(sorted_data, mid)) / 2
    else
      # Odd number of elements
      Enum.at(sorted_data, mid)
    end
  end
end
