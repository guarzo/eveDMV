      fleet_role_analysis: fleet_role_analysis,
      situational_analysis: situational_analysis,
      meta_analysis: meta_analysis,
      overall_profile: compile_overall_specialization_profile(specializations, combat_patterns),
      last_updated: DateTime.utc_now(),
      profile_confidence: calculate_profile_confidence(specializations, combat_patterns)
    }
  end

  defp fetch_specialization_analysis_data(participant) do
    character_id = participant.character_id
    
    if is_nil(character_id) do
      %{}
    else
      # Extended specialization analysis query (15 months of data)
      fifteen_months_ago = DateTime.add(DateTime.utc_now(), -15 * 30 * 24 * 3600, :second)
      
      query = """
      WITH specialization_analysis AS (
        SELECT 
          COALESCE(victim_character_id, (a->>'character_id')::bigint) as character_id,
          k.killmail_time,
          k.solar_system_id,
          k.attacker_count,
          (k.raw_data->'zkb'->>'totalValue')::bigint as kill_value,
          (a->>'ship_type_id')::integer as ship_type_id,
          (a->>'weapon_type_id')::integer as weapon_type_id,
          (a->>'damage_done')::integer as damage_done,
          (a->>'final_blow')::boolean as final_blow,
          (a->>'security_status')::float as security_status,
          victim_character_id IS NULL as is_kill,
          victim_character_id IS NOT NULL as is_death,
          CASE WHEN k.attacker_count = 1 THEN 1 ELSE 0 END as is_solo,
          CASE WHEN k.attacker_count <= 5 THEN 1 ELSE 0 END as is_small_gang,
          CASE WHEN k.attacker_count BETWEEN 6 AND 20 THEN 1 ELSE 0 END as is_medium_fleet,
          CASE WHEN k.attacker_count > 20 THEN 1 ELSE 0 END as is_large_fleet,
          -- Time-based classification
          DATE_PART('hour', k.killmail_time) as kill_hour,
          CASE 
            WHEN DATE_PART('hour', k.killmail_time) BETWEEN 22 AND 6 THEN 1 ELSE 0 
          END as is_night_activity,
          -- System security classification  
          CASE 
            WHEN k.solar_system_id >= 30000000 AND k.solar_system_id < 31000000 THEN 'highsec'
            WHEN k.solar_system_id >= 31000000 AND k.solar_system_id < 32000000 THEN 'lowsec'  
            WHEN k.solar_system_id >= 32000000 THEN 'nullsec'
            ELSE 'unknown'
          END as space_type,
          -- Value-based engagement classification
          CASE 
            WHEN (k.raw_data->'zkb'->>'totalValue')::bigint >= 1000000000 THEN 'capital'
            WHEN (k.raw_data->'zkb'->>'totalValue')::bigint >= 100000000 THEN 'expensive'
            WHEN (k.raw_data->'zkb'->>'totalValue')::bigint >= 10000000 THEN 'moderate'
            ELSE 'cheap'
          END as value_tier,
          -- Victim ship classification for targeting analysis
          (SELECT type_name FROM eve_item_types WHERE type_id = k.victim_ship_type_id) as victim_ship_name,
          k.victim_ship_type_id
        FROM killmails_raw k
        CROSS JOIN LATERAL jsonb_array_elements(k.raw_data->'attackers') AS a
        WHERE k.killmail_time >= $1 
          AND (
            k.victim_character_id = $2 OR 
            (a->>'character_id')::bigint = $2
          )
      )
      SELECT 
        COUNT(*) as total_engagements,
        -- Combat specialization metrics
        SUM(is_kill::int) as total_kills,
        SUM(is_death::int) as total_deaths,
        SUM(final_blow::int) as final_blows,
        AVG(damage_done) as avg_damage_per_engagement,
        -- Fleet size preferences
        SUM(is_solo::int) as solo_engagements,
        SUM(is_small_gang::int) as small_gang_engagements,
        SUM(is_medium_fleet::int) as medium_fleet_engagements,
        SUM(is_large_fleet::int) as large_fleet_engagements,
        -- Ship and weapon diversity
        COUNT(DISTINCT ship_type_id) as ships_used,
        COUNT(DISTINCT weapon_type_id) as weapons_used,
        array_agg(DISTINCT ship_type_id ORDER BY ship_type_id) as ship_types,
        array_agg(DISTINCT weapon_type_id ORDER BY weapon_type_id) FILTER (WHERE weapon_type_id IS NOT NULL) as weapon_types,
        -- Space type preferences
        SUM(CASE WHEN space_type = 'highsec' THEN 1 ELSE 0 END) as highsec_activity,
        SUM(CASE WHEN space_type = 'lowsec' THEN 1 ELSE 0 END) as lowsec_activity,
        SUM(CASE WHEN space_type = 'nullsec' THEN 1 ELSE 0 END) as nullsec_activity,
        -- Value tier preferences  
        SUM(CASE WHEN value_tier = 'capital' THEN 1 ELSE 0 END) as capital_targets,
        SUM(CASE WHEN value_tier = 'expensive' THEN 1 ELSE 0 END) as expensive_targets,
        SUM(CASE WHEN value_tier = 'moderate' THEN 1 ELSE 0 END) as moderate_targets,
        SUM(CASE WHEN value_tier = 'cheap' THEN 1 ELSE 0 END) as cheap_targets,
        -- Behavioral patterns
        SUM(is_night_activity::int) as night_activity,
        COUNT(DISTINCT DATE(killmail_time)) as active_days,
        AVG(kill_value) as avg_kill_value,
        MAX(kill_value) as max_kill_value,
        -- Targeting patterns (victim ship analysis)
        array_agg(DISTINCT victim_ship_type_id ORDER BY victim_ship_type_id) FILTER (WHERE victim_ship_type_id IS NOT NULL AND is_kill = 1) as target_ship_types,
        COUNT(DISTINCT victim_ship_type_id) FILTER (WHERE is_kill = 1) as target_diversity
      FROM specialization_analysis
      WHERE character_id = $2
      """
      
      case Ecto.Adapters.SQL.query(EveDmv.Repo, query, [fifteen_months_ago, character_id]) do
        {:ok, %{rows: [[total_eng, total_kills, total_deaths, final_blows, avg_damage,
                        solo_eng, small_gang, medium_fleet, large_fleet, ships_used, weapons_used,
                        ship_types, weapon_types, highsec, lowsec, nullsec, capital_targets,
                        expensive_targets, moderate_targets, cheap_targets, night_activity,
                        active_days, avg_kill_value, max_kill_value, target_ship_types, target_diversity]]}} ->
          %{
            total_engagements: total_eng || 0,
            total_kills: total_kills || 0,
            total_deaths: total_deaths || 0,
            final_blows: final_blows || 0,
            avg_damage_per_engagement: avg_damage || 0,
            fleet_size_preferences: %{
              solo: solo_eng || 0,
              small_gang: small_gang || 0,
              medium_fleet: medium_fleet || 0,
              large_fleet: large_fleet || 0
            },
            ship_weapon_data: %{
              ships_used: ships_used || 0,
              weapons_used: weapons_used || 0,
              ship_types: ship_types || [],
              weapon_types: weapon_types || []
            },
            space_preferences: %{
              highsec: highsec || 0,
              lowsec: lowsec || 0,
              nullsec: nullsec || 0
            },
            target_preferences: %{
              capital_targets: capital_targets || 0,
              expensive_targets: expensive_targets || 0,
              moderate_targets: moderate_targets || 0,
              cheap_targets: cheap_targets || 0
            },
            behavioral_data: %{
              night_activity: night_activity || 0,
              active_days: active_days || 0,
              avg_kill_value: avg_kill_value || 0,
              max_kill_value: max_kill_value || 0
            },
            targeting_data: %{
              target_ship_types: target_ship_types || [],
              target_diversity: target_diversity || 0
            }
          }
        
        {:ok, %{rows: []}} ->
          %{total_engagements: 0}
        
        {:error, _} ->
          Logger.warning("Failed to fetch specialization analysis data for character #{character_id}")
          %{total_engagements: 0}
      end
    end
  end

  defp identify_combat_specializations(specialization_data, participant) do
    total_engagements = Map.get(specialization_data, :total_engagements, 0)
    
    if total_engagements < 20 do
      [:insufficient_data]
    else
      specializations = []
      
      # Analyze final blow specialization
      final_blows = Map.get(specialization_data, :final_blows, 0)
      final_blow_ratio = final_blows / max(total_engagements, 1)
      
      if final_blow_ratio >= 0.4 do
        specializations = specializations ++ [:finisher]
      end
      
      # Analyze damage dealing patterns
      avg_damage = Map.get(specialization_data, :avg_damage_per_engagement, 0)
      if avg_damage >= 5000 do
        specializations = specializations ++ [:heavy_damage_dealer]
      end
      
      # Analyze kill efficiency
      total_kills = Map.get(specialization_data, :total_kills, 0)
      kill_efficiency = total_kills / max(total_engagements, 1)
      
      if kill_efficiency >= 0.8 do
        specializations = specializations ++ [:efficient_killer]
      end
      
      # Analyze combat consistency
      total_deaths = Map.get(specialization_data, :total_deaths, 0)
      if total_deaths > 0 do
        kd_ratio = total_kills / total_deaths
        if kd_ratio >= 3.0 do
          specializations = specializations ++ [:combat_specialist]
        end
      end
      
      if length(specializations) == 0, do: [:generalist_combatant], else: specializations
    end
  end

  defp identify_tactical_specializations(specialization_data, participant) do
    fleet_prefs = Map.get(specialization_data, :fleet_size_preferences, %{})
    space_prefs = Map.get(specialization_data, :space_preferences, %{})
    total_engagements = Map.get(specialization_data, :total_engagements, 0)
    
    if total_engagements < 10 do
      [:insufficient_data]
    else
      specializations = []
      
      # Analyze fleet size specialization
      solo_ratio = Map.get(fleet_prefs, :solo, 0) / max(total_engagements, 1)
      small_gang_ratio = Map.get(fleet_prefs, :small_gang, 0) / max(total_engagements, 1)
      large_fleet_ratio = Map.get(fleet_prefs, :large_fleet, 0) / max(total_engagements, 1)
      
      cond do
        solo_ratio >= 0.6 -> specializations = specializations ++ [:solo_hunter]
        small_gang_ratio >= 0.5 -> specializations = specializations ++ [:small_gang_specialist]
        large_fleet_ratio >= 0.4 -> specializations = specializations ++ [:fleet_combatant]
        true -> specializations = specializations
      end
      
      # Analyze space type specialization
      total_space_activity = Map.get(space_prefs, :highsec, 0) + Map.get(space_prefs, :lowsec, 0) + Map.get(space_prefs, :nullsec, 0)
      
      if total_space_activity > 0 do
        nullsec_ratio = Map.get(space_prefs, :nullsec, 0) / total_space_activity
        lowsec_ratio = Map.get(space_prefs, :lowsec, 0) / total_space_activity
        highsec_ratio = Map.get(space_prefs, :highsec, 0) / total_space_activity
        
        cond do
          nullsec_ratio >= 0.7 -> specializations = specializations ++ [:nullsec_operative]
          lowsec_ratio >= 0.6 -> specializations = specializations ++ [:lowsec_pirate]
          highsec_ratio >= 0.8 -> specializations = specializations ++ [:highsec_hunter]
          nullsec_ratio + lowsec_ratio >= 0.8 -> specializations = specializations ++ [:dangerous_space_specialist]
          true -> specializations = specializations
        end
      end
      
      if length(specializations) == 0, do: [:flexible_tactician], else: specializations
    end
  end

  defp identify_ship_specializations(specialization_data, participant) do
    ship_weapon_data = Map.get(specialization_data, :ship_weapon_data, %{})
    ships_used = Map.get(ship_weapon_data, :ships_used, 0)
    ship_types = Map.get(ship_weapon_data, :ship_types, [])
    total_engagements = Map.get(specialization_data, :total_engagements, 0)
    
    if total_engagements < 15 or ships_used == 0 do
      [:insufficient_data]
    else
      # Analyze ship diversity vs specialization
      specializations = []
      
      if ships_used <= 3 and total_engagements >= 20 do
        # High specialization in few ships
        specializations = specializations ++ [:ship_specialist]
        
        # Identify specific ship class specializations
        ship_class_distribution = analyze_ship_class_distribution(ship_types)
        primary_class = get_dominant_ship_class(ship_class_distribution)
        
        case primary_class do
          :frigate -> specializations = specializations ++ [:frigate_specialist]
          :destroyer -> specializations = specializations ++ [:destroyer_specialist]
          :cruiser -> specializations = specializations ++ [:cruiser_specialist]
          :battlecruiser -> specializations = specializations ++ [:battlecruiser_specialist]
          :battleship -> specializations = specializations ++ [:battleship_specialist]
          :capital -> specializations = specializations ++ [:capital_specialist]
          _ -> specializations = specializations
        end
      elsif ships_used >= 10 do
        # High ship diversity
        specializations = specializations ++ [:multi_ship_pilot]
        
        # Check for tactical ship usage
        if has_tactical_ship_mix?(ship_types) do
          specializations = specializations ++ [:tactical_ship_user]
        end
      end
      
      # Check for specific ship role specializations
      role_specializations = identify_ship_role_specializations(ship_types)
      specializations = specializations ++ role_specializations
      
      if length(specializations) == 0, do: [:standard_pilot], else: specializations
    end
  end

  defp identify_weapon_specializations(specialization_data, participant) do
    ship_weapon_data = Map.get(specialization_data, :ship_weapon_data, %{})
    weapons_used = Map.get(ship_weapon_data, :weapons_used, 0)
    weapon_types = Map.get(ship_weapon_data, :weapon_types, [])
    total_engagements = Map.get(specialization_data, :total_engagements, 0)
    
    if total_engagements < 15 or weapons_used == 0 do
      [:insufficient_data]
    else
      specializations = []
      
      # Analyze weapon diversity vs specialization
      if weapons_used <= 5 and total_engagements >= 25 do
        specializations = specializations ++ [:weapon_specialist]
        
        # Identify specific weapon system specializations based on weapon type IDs
        weapon_categories = categorize_weapon_types(weapon_types)
        primary_weapon_category = get_dominant_weapon_category(weapon_categories)
        
        case primary_weapon_category do
          :missiles -> specializations = specializations ++ [:missile_specialist]
          :projectiles -> specializations = specializations ++ [:projectile_specialist]
          :lasers -> specializations = specializations ++ [:laser_specialist]
          :hybrids -> specializations = specializations ++ [:hybrid_specialist]
          :drones -> specializations = specializations ++ [:drone_specialist]
          _ -> specializations = specializations
        end
      elsif weapons_used >= 15 do
        specializations = specializations ++ [:weapon_generalist]
      end
      
      if length(specializations) == 0, do: [:standard_weapon_user], else: specializations
    end
  end

  defp identify_role_specializations(specialization_data, participant) do
    target_prefs = Map.get(specialization_data, :target_preferences, %{})
    targeting_data = Map.get(specialization_data, :targeting_data, %{})
    total_kills = Map.get(specialization_data, :total_kills, 0)
    
    if total_kills < 10 do
      [:insufficient_data]
    else
      specializations = []
      
      # Analyze target value preferences
      capital_targets = Map.get(target_prefs, :capital_targets, 0)
      expensive_targets = Map.get(target_prefs, :expensive_targets, 0)
      total_valuable_targets = capital_targets + expensive_targets
      
      if total_valuable_targets >= total_kills * 0.3 do
        specializations = specializations ++ [:high_value_hunter]
      end
      
      if capital_targets >= 5 do
        specializations = specializations ++ [:capital_hunter]
      end
      
      # Analyze target diversity
      target_diversity = Map.get(targeting_data, :target_diversity, 0)
      if target_diversity >= 15 do
        specializations = specializations ++ [:opportunistic_hunter]
      elsif target_diversity <= 5 and total_kills >= 20 do
        specializations = specializations ++ [:focused_hunter]
      end
      
      if length(specializations) == 0, do: [:general_hunter], else: specializations
    end
  end

  defp identify_behavioral_specializations(specialization_data, participant) do
    behavioral_data = Map.get(specialization_data, :behavioral_data, %{})
    night_activity = Map.get(behavioral_data, :night_activity, 0)
    active_days = Map.get(behavioral_data, :active_days, 0) 
    total_engagements = Map.get(specialization_data, :total_engagements, 0)
    
    if total_engagements < 10 do
      [:insufficient_data]
    else
      specializations = []
      
      # Analyze time-based specializations
      night_ratio = night_activity / max(total_engagements, 1)
      if night_ratio >= 0.6 do
        specializations = specializations ++ [:night_hunter]
      end
      
      # Analyze activity consistency
      if active_days >= 90 and total_engagements >= 50 do
        specializations = specializations ++ [:consistent_operator]
      elsif active_days <= 20 and total_engagements >= 30 do
        specializations = specializations ++ [:burst_activity_hunter]
      end
      
      # Analyze engagement frequency
      if active_days > 0 do
        daily_engagement_rate = total_engagements / active_days
        if daily_engagement_rate >= 3.0 do
          specializations = specializations ++ [:high_activity_hunter]
        elsif daily_engagement_rate <= 0.5 do
          specializations = specializations ++ [:selective_hunter]
        end
      end
      
      if length(specializations) == 0, do: [:standard_activity_pattern], else: specializations
    end
  end

  # Placeholder implementations for basic specialization compatibility
  defp identify_specializations(participant) do
    # Enhanced implementation using comprehensive system
    specialization_profile = identify_comprehensive_specializations(participant)
    
    # Extract key specializations for backward compatibility
    all_specs = specialization_profile.all_specializations
    
    if length(all_specs) > 0 do
      Enum.take(all_specs, 3)  # Return top 3 specializations
    else
      [participant.tactical_role || :unknown]
    end
  end

  defp analyze_activity_patterns(participant) do
    # Comprehensive activity pattern analysis using real historical data
    character_id = participant.character_id
    activity_data = fetch_comprehensive_activity_data(character_id)
    
    # Extract temporal patterns
    temporal_analysis = analyze_temporal_patterns(activity_data)
    
    # Extract geographical patterns  
    geographical_analysis = analyze_geographical_patterns(activity_data)
    
    # Extract engagement patterns
    engagement_analysis = analyze_engagement_patterns(activity_data)
    
    # Extract behavioral patterns
    behavioral_analysis = analyze_behavioral_patterns(activity_data)
    
    # Combine all patterns into comprehensive profile
    %{
      active_hours: temporal_analysis.active_hours,
      preferred_systems: geographical_analysis.preferred_systems,
      engagement_patterns: engagement_analysis.patterns,
      temporal_intelligence: temporal_analysis,
      geographical_intelligence: geographical_analysis,
      behavioral_intelligence: behavioral_analysis,
      activity_confidence: calculate_activity_confidence(activity_data),
      pattern_stability: assess_pattern_stability(activity_data),
      predictive_windows: generate_predictive_activity_windows(temporal_analysis)
    }
  end

  # New helper functions for detailed participant extraction
  defp get_ship_name_from_type_id(nil), do: "Unknown Ship"

  defp get_ship_name_from_type_id(type_id) when is_integer(type_id) do
    # Query the database for ship name
    case EveDmv.Repo.one(
           from(i in EveDmv.Eve.ItemType,
             where: i.type_id == ^type_id,
             select: i.type_name
           )
         ) do
      nil -> "Unknown Ship (#{type_id})"
      name -> name
    end
  end

  defp get_ship_name_from_type_id(_), do: "Unknown Ship"

  defp determine_tactical_role_by_type_id(nil), do: :unknown

  defp determine_tactical_role_by_type_id(type_id) when is_integer(type_id) do
    # Query the database for ship group to determine role
    case EveDmv.Repo.one(
           from(i in EveDmv.Eve.ItemType,
             where: i.type_id == ^type_id and i.is_ship == true,
             select: i.group_name
           )
         ) do
      nil -> :unknown
      group_name -> determine_role_from_group(group_name)
    end
  end

  defp determine_tactical_role_by_type_id(_), do: :unknown

  defp determine_role_from_group(group_name) do
    cond do
      group_name =~ "Logistics" -> :logistics
      group_name =~ "Command" -> :command
      group_name =~ "Interceptor" -> :tackle
      group_name =~ "Interdictor" -> :interdiction
      group_name =~ "Recon" -> :ewar
      group_name =~ "Electronic Attack" -> :ewar
      group_name =~ "Covert Ops" -> :stealth
      group_name =~ "Stealth Bomber" -> :bomber
      group_name =~ "Dreadnought" -> :siege
      group_name =~ "Carrier" -> :carrier
      group_name =~ "Supercarrier" -> :carrier
      group_name =~ "Titan" -> :titan
      group_name =~ "Force Auxiliary" -> :logistics
      group_name =~ "Black Ops" -> :stealth
      group_name =~ "Marauder" -> :siege
      true -> :dps
    end
  end

  defp classify_ship_by_type_id(nil), do: :unknown

  defp classify_ship_by_type_id(type_id) when is_integer(type_id) do
    # Use the existing ShipTypes module for classification
    EveDmv.StaticData.ShipTypes.classify_ship_type(type_id)
  end

  defp classify_ship_by_type_id(_), do: :unknown

  defp is_npc_entity(attacker) do
    # Check various indicators that this is an NPC
    cond do
      # No character ID usually means NPC
      is_nil(attacker["character_id"]) ->
        true

      # Faction police, CONCORD, etc have specific corporation IDs
      attacker["corporation_id"] in [1_000_125, 1_000_126, 1_000_127, 1_000_128] ->
        true

      # Check for faction names in corporation name
      String.contains?(attacker["corporation_name"] || "", [
        "CONCORD",
        "Police",
        "Navy",
        "Customs"
      ]) ->
        true

      # Default to false
      true ->
        false
    end
  end

  # Advanced side classification functions
  defp analyze_engagement_patterns(participants) do
    # Analyze how participants engaged with each other
    alliance_engagement_matrix = build_alliance_engagement_matrix(participants)
    corp_engagement_matrix = build_corp_engagement_matrix(participants)

    # Identify engagement clusters
    alliance_clusters = identify_alliance_clusters(alliance_engagement_matrix)
    corp_clusters = identify_corp_clusters(corp_engagement_matrix)

    # Analyze temporal patterns
    temporal_patterns = analyze_temporal_engagement_patterns(participants)

    %{
      alliance_engagement_matrix: alliance_engagement_matrix,
      corp_engagement_matrix: corp_engagement_matrix,
      alliance_clusters: alliance_clusters,
      corp_clusters: corp_clusters,
      temporal_patterns: temporal_patterns,
      mutual_hostility_score: calculate_mutual_hostility_score(alliance_engagement_matrix)
    }
  end

  defp build_alliance_engagement_matrix(participants) do
    # Build matrix showing which alliances attacked which based on actual killmail relationships
    alliances =
      participants
      |> Enum.map(& &1.alliance_id)
      |> Enum.reject(&is_nil/1)
      |> Enum.uniq()

    # Initialize matrix
    matrix =
      alliances
      |> Enum.map(fn alliance ->
        {alliance,
         alliances
         |> Enum.map(fn target -> {target, 0} end)
         |> Enum.into(%{})}
      end)
      |> Enum.into(%{})

    # Group participants by killmail to analyze per-killmail engagement patterns
    killmail_groups = Enum.group_by(participants, & &1.killmail_id)

    # For each killmail, analyze the engagement between alliances
    killmail_groups
    |> Enum.reduce(matrix, fn {_killmail_id, killmail_participants}, acc ->
      attackers = Enum.filter(killmail_participants, &(&1.participant_type == :attacker))
      victims = Enum.filter(killmail_participants, &(&1.participant_type == :victim))

      # For each attacker-victim pair in this killmail, increment engagement count
      for attacker <- attackers,
          victim <- victims,
          not is_nil(attacker.alliance_id),
          not is_nil(victim.alliance_id),
          attacker.alliance_id != victim.alliance_id,
          reduce: acc do
        matrix_acc ->
          if Map.has_key?(matrix_acc, attacker.alliance_id) do
            update_in(matrix_acc, [attacker.alliance_id, victim.alliance_id], &(&1 + 1))
          else
            matrix_acc
          end
      end
    end)
  end

  defp build_corp_engagement_matrix(participants) do
    # Build matrix showing which corporations attacked which based on actual killmail relationships
    corps =
      participants
      |> Enum.map(& &1.corporation_id)
      |> Enum.reject(&is_nil/1)
      |> Enum.uniq()

    # Initialize matrix
    matrix =
      corps
      |> Enum.map(fn corp ->
        {corp,
         corps
         |> Enum.map(fn target -> {target, 0} end)
         |> Enum.into(%{})}
      end)
      |> Enum.into(%{})

    # Group participants by killmail to analyze per-killmail engagement patterns
    killmail_groups = Enum.group_by(participants, & &1.killmail_id)

    # For each killmail, analyze the engagement between corporations
    killmail_groups
    |> Enum.reduce(matrix, fn {_killmail_id, killmail_participants}, acc ->
      attackers = Enum.filter(killmail_participants, &(&1.participant_type == :attacker))
      victims = Enum.filter(killmail_participants, &(&1.participant_type == :victim))

      # For each attacker-victim pair in this killmail, increment engagement count
      for attacker <- attackers,
          victim <- victims,
          not is_nil(attacker.corporation_id),
          not is_nil(victim.corporation_id),
          attacker.corporation_id != victim.corporation_id,
          reduce: acc do
        matrix_acc ->
          if Map.has_key?(matrix_acc, attacker.corporation_id) do
            update_in(matrix_acc, [attacker.corporation_id, victim.corporation_id], &(&1 + 1))
          else
            matrix_acc
          end
      end
    end)
  end

  defp identify_alliance_clusters(engagement_matrix) do
    # Use engagement patterns to identify alliance clusters/coalitions
    alliances = Map.keys(engagement_matrix)

    # Find alliances that don't attack each other (potential same side)
    friendly_pairs =
      for alliance1 <- alliances,
          alliance2 <- alliances,
          alliance1 != alliance2,
          get_in(engagement_matrix, [alliance1, alliance2]) == 0,
          get_in(engagement_matrix, [alliance2, alliance1]) == 0 do
        {alliance1, alliance2}
      end

    # Also consider alliances that have mutual hostility against common enemies
    mutual_hostility_pairs = find_mutual_hostility_pairs(engagement_matrix, alliances)

    # Combine friendly pairs with mutual hostility pairs for clustering
    all_friendly_pairs = (friendly_pairs ++ mutual_hostility_pairs) |> Enum.uniq()

    # Build clusters from all friendly relationships
    clusters = build_clusters_from_pairs(all_friendly_pairs, alliances)

    # Identify opposing sides based on engagement patterns
    opposing_sides = identify_opposing_alliance_sides(engagement_matrix, clusters)

    %{
      clusters: clusters,
      cluster_count: length(clusters),
      largest_cluster: find_largest_cluster(clusters),
      isolated_alliances: find_isolated_alliances(alliances, clusters),
      opposing_sides: opposing_sides,
      mutual_hostility_pairs: mutual_hostility_pairs
    }
  end

  defp identify_corp_clusters(engagement_matrix) do
    # Similar clustering logic for corporations
    corps = Map.keys(engagement_matrix)

    friendly_pairs =
      for corp1 <- corps,
          corp2 <- corps,
          corp1 != corp2,
          get_in(engagement_matrix, [corp1, corp2]) == 0,
          get_in(engagement_matrix, [corp2, corp1]) == 0 do
        {corp1, corp2}
      end

    clusters = build_clusters_from_pairs(friendly_pairs, corps)

    %{
      clusters: clusters,
      cluster_count: length(clusters),
      largest_cluster: find_largest_cluster(clusters)
    }
  end

  defp build_clusters_from_pairs(friendly_pairs, entities) do
    # Build connected components from friendly pairs
    # This is a simplified clustering algorithm

    # Start with each entity in its own cluster
    initial_clusters = Enum.map(entities, &[&1])

    # Merge clusters based on friendly pairs
    Enum.reduce(friendly_pairs, initial_clusters, fn {entity1, entity2}, clusters ->
      # Find clusters containing entity1 and entity2
      cluster1_idx = Enum.find_index(clusters, &(entity1 in &1))
      cluster2_idx = Enum.find_index(clusters, &(entity2 in &1))

      cond do
        # Already in same cluster
        cluster1_idx == cluster2_idx ->
          clusters

        cluster1_idx && cluster2_idx ->
          # Merge the two clusters
          cluster1 = Enum.at(clusters, cluster1_idx)
          cluster2 = Enum.at(clusters, cluster2_idx)
          merged = cluster1 ++ cluster2

          clusters
          |> List.delete_at(max(cluster1_idx, cluster2_idx))
          |> List.delete_at(min(cluster1_idx, cluster2_idx))
          |> List.insert_at(0, merged)

        # One or both entities not found
        true ->
          clusters
      end
    end)
  end

  defp find_largest_cluster(clusters) do
    if length(clusters) > 0 do
      clusters
      |> Enum.max_by(&length/1, fn -> [] end)
    else
      []
    end
  end

  defp find_isolated_alliances(alliances, clusters) do
    clustered_alliances = List.flatten(clusters)
    alliances -- clustered_alliances
  end

  defp analyze_temporal_engagement_patterns(participants) do
    # Analyze when different groups became active
    # This would be more complex with real killmail timestamps

    attackers_by_alliance =
      participants
      |> Enum.filter(&(&1.participant_type == :attacker))
      |> Enum.group_by(& &1.alliance_id)

    victims_by_alliance =
      participants
      |> Enum.filter(&(&1.participant_type == :victim))
      |> Enum.group_by(& &1.alliance_id)

    %{
      first_attackers: identify_first_aggressors(attackers_by_alliance),
      engagement_escalation:
        analyze_escalation_pattern(attackers_by_alliance, victims_by_alliance),
      # Would need killmail timestamps
      temporal_clustering: :not_implemented
    }
  end

  defp identify_first_aggressors(attackers_by_alliance) do
    # In a real implementation, would use killmail timestamps
    # For now, return the alliances with most attackers as likely aggressors
    attackers_by_alliance
    |> Enum.sort_by(fn {_alliance, members} -> -length(members) end)
    |> Enum.take(3)
    |> Enum.map(fn {alliance, members} ->
      %{alliance_id: alliance, aggressor_count: length(members)}
    end)
  end

  defp analyze_escalation_pattern(attackers_by_alliance, victims_by_alliance) do
    # Analyze how the engagement escalated
    attacker_alliances = Map.keys(attackers_by_alliance)
    victim_alliances = Map.keys(victims_by_alliance)

    # Look for patterns indicating escalation
    %{
      mutual_engagement: length(attacker_alliances -- attacker_alliances -- victim_alliances),
      one_sided_aggression: length(attacker_alliances -- victim_alliances),
      defensive_only: length(victim_alliances -- attacker_alliances),
      escalation_assessment: assess_escalation_type(attacker_alliances, victim_alliances)
    }
  end

  defp assess_escalation_type(attacker_alliances, victim_alliances) do
    mutual = length(attacker_alliances -- attacker_alliances -- victim_alliances)
    total_attackers = length(attacker_alliances)

    cond do
      mutual / total_attackers > 0.7 -> :mutual_combat
      mutual / total_attackers > 0.3 -> :escalated_conflict
      mutual == 0 -> :one_sided_aggression
      true -> :limited_retaliation
    end
  end

  defp calculate_mutual_hostility_score(engagement_matrix) do
    # Calculate how much mutual engagement there is
    {total, mutual} =
      Enum.reduce(engagement_matrix, {0, 0}, fn {attacker, targets}, {total_acc, mutual_acc} ->
        Enum.reduce(targets, {total_acc, mutual_acc}, fn {target, count}, {t_acc, m_acc} ->
          new_total = t_acc + count
          # Check if target also attacked attacker (mutual)
          reverse_count = get_in(engagement_matrix, [target, attacker]) || 0
          new_mutual = if count > 0 && reverse_count > 0, do: m_acc + count, else: m_acc
          {new_total, new_mutual}
        end)
      end)

    if total > 0, do: mutual / total, else: 0.0
  end

  defp perform_advanced_side_classification(attackers, victims, engagement_analysis) do
    # Use engagement analysis to create sophisticated side classification
    alliance_clusters = engagement_analysis.alliance_clusters.clusters

    # Assign sides based on clusters and engagement patterns
    side_assignment = assign_sides_from_clusters(alliance_clusters, attackers, victims)

    # Calculate classification confidence
    confidence = calculate_classification_confidence(side_assignment, engagement_analysis)

    %{
      side_alpha: side_assignment.side_alpha,
      side_beta: side_assignment.side_beta,
      unclassified: side_assignment.unclassified,
      confidence: confidence,
      classification_method:
        determine_classification_method(alliance_clusters, engagement_analysis)
    }
  end

  defp assign_sides_from_clusters(clusters, attackers, victims) do
    if length(clusters) >= 2 do
      # Use the two largest clusters as the main sides
      sorted_clusters = Enum.sort_by(clusters, &length/1, :desc)
      cluster_alpha = List.first(sorted_clusters)
      cluster_beta = List.first(Enum.drop(sorted_clusters, 1))

      # Assign participants based on their alliance membership
      side_alpha = assign_participants_to_cluster(attackers ++ victims, cluster_alpha)
      side_beta = assign_participants_to_cluster(attackers ++ victims, cluster_beta)

      # Remaining participants are unclassified
      assigned = side_alpha ++ side_beta
      unclassified = (attackers ++ victims) -- assigned

      %{
        side_alpha: side_alpha,
        side_beta: side_beta,
        unclassified: unclassified
      }
    else
      # Fall back to traditional attacker/victim classification
      %{
        side_alpha: victims,
        side_beta: attackers,
        unclassified: []
      }
    end
  end

  defp assign_participants_to_cluster(participants, cluster_alliance_ids) do
    participants
    |> Enum.filter(fn p ->
      p.alliance_id in cluster_alliance_ids
    end)
  end

  defp calculate_classification_confidence(side_assignment, engagement_analysis) do
    # Calculate confidence based on various factors

    # Factor 1: Clear alliance clustering
    cluster_clarity =
      if length(engagement_analysis.alliance_clusters.clusters) >= 2 do
        0.8
      else
        0.3
      end

    # Factor 2: Mutual hostility score
    hostility_factor = engagement_analysis.mutual_hostility_score * 0.5

    # Factor 3: Side balance
    alpha_count = length(side_assignment.side_alpha)
    beta_count = length(side_assignment.side_beta)
    total_classified = alpha_count + beta_count

    balance_factor =
      if total_classified > 0 do
        balance_ratio = min(alpha_count, beta_count) / max(alpha_count, beta_count)
        balance_ratio * 0.3
      else
        0
      end

    # Factor 4: Unclassified penalty
    unclassified_penalty = length(side_assignment.unclassified) * 0.05

    confidence = cluster_clarity + hostility_factor + balance_factor - unclassified_penalty
    Float.round(max(0, min(1, confidence)), 2)
  end

  defp determine_classification_method(clusters, engagement_analysis) do
    cond do
      length(clusters) >= 2 -> :alliance_clustering
      engagement_analysis.mutual_hostility_score > 0.5 -> :mutual_hostility
      true -> :traditional_attacker_victim
    end
  end

  defp identify_sophisticated_neutrals(participants, side_classification) do
    # Identify neutral parties using multiple criteria
    potential_neutrals = side_classification.unclassified

    # Additional neutral identification logic
    additional_neutrals =
      (side_classification.side_alpha ++ side_classification.side_beta)
      |> Enum.filter(fn p ->
        # Check for neutral indicators
        is_likely_neutral?(p, participants)
      end)

    (potential_neutrals ++ additional_neutrals)
    |> Enum.uniq_by(& &1.character_id)
    |> Enum.map(&enrich_neutral_classification/1)
  end

  defp is_likely_neutral?(participant, all_participants) do
    # Calculate corp count first
    same_corp_count =
      Enum.count(all_participants, &(&1.corporation_id == participant.corporation_id))

    cond do
      # NPCs are often neutral
      participant.is_npc ->
        true

      # Solo participants from small corps might be neutral
      same_corp_count == 1 && is_nil(participant.alliance_id) ->
        true

      # Check for known neutral entity patterns
      is_known_neutral_corp?(participant.corporation_id) ->
        true

      # Default to false
      true ->
        false
    end
  end

  defp is_known_neutral_corp?(_corp_id) do
    # In a real implementation, would check against database of known neutral entities
    # For now, return false
    false
  end

  defp enrich_neutral_classification(participant) do
    Map.put(participant, :neutral_type, determine_neutral_type(participant))
  end

  defp determine_neutral_type(participant) do
    cond do
      participant.is_npc -> :npc
      is_nil(participant.alliance_id) -> :unaffiliated
      true -> :third_party
    end
  end

  defp refine_side_classification(classification, neutrals, engagement_analysis) do
    # Refine the classification based on additional analysis

    # Remove neutrals from sides
    neutral_character_ids = Enum.map(neutrals, & &1.character_id)

    refined_alpha =
      classification.side_alpha
      |> Enum.reject(&(&1.character_id in neutral_character_ids))

    refined_beta =
      classification.side_beta
      |> Enum.reject(&(&1.character_id in neutral_character_ids))

    # Recalculate confidence with neutrals removed
    refined_assignment = %{
      side_alpha: refined_alpha,
      side_beta: refined_beta,
      unclassified: classification.unclassified
    }

    refined_confidence =
      calculate_classification_confidence(refined_assignment, engagement_analysis)

    %{
      side_alpha: refined_alpha,
      side_beta: refined_beta,
      unclassified: classification.unclassified,
      confidence: refined_confidence
    }
  end

  defp analyze_inter_side_relationships(classification) do
    # Analyze relationships between the classified sides
    alpha_alliances =
      classification.side_alpha
      |> Enum.map(& &1.alliance_id)
      |> Enum.reject(&is_nil/1)
      |> Enum.uniq()

    beta_alliances =
      classification.side_beta
      |> Enum.map(& &1.alliance_id)
      |> Enum.reject(&is_nil/1)
      |> Enum.uniq()

    %{
      alpha_alliance_count: length(alpha_alliances),
      beta_alliance_count: length(beta_alliances),
      cross_alliance_conflicts: analyze_cross_alliance_conflicts(alpha_alliances, beta_alliances),
      size_imbalance: calculate_side_size_imbalance(classification),
      coordination_assessment: assess_side_coordination(classification)
    }
  end

  defp analyze_cross_alliance_conflicts(alpha_alliances, beta_alliances) do
    # Analyze conflicts between alliances on different sides
    %{
      potential_conflicts: length(alpha_alliances) * length(beta_alliances),
      major_alliances_alpha: Enum.take(alpha_alliances, 3),
      major_alliances_beta: Enum.take(beta_alliances, 3),
      conflict_complexity: determine_conflict_complexity(alpha_alliances, beta_alliances)
    }
  end

  defp determine_conflict_complexity(alpha_alliances, beta_alliances) do
    total_alliances = length(alpha_alliances) + length(beta_alliances)

    cond do
      total_alliances <= 2 -> :simple_bilateral
      total_alliances <= 4 -> :moderate_complexity
      total_alliances <= 8 -> :high_complexity
      true -> :massive_coalition_war
    end
  end

  defp calculate_side_size_imbalance(classification) do
    alpha_size = length(classification.side_alpha)
    beta_size = length(classification.side_beta)

    if alpha_size + beta_size > 0 do
      larger = max(alpha_size, beta_size)
      smaller = min(alpha_size, beta_size)

      imbalance_ratio = if smaller > 0, do: larger / smaller, else: larger

      %{
        ratio: Float.round(imbalance_ratio, 2),
        assessment: assess_imbalance(imbalance_ratio),
        larger_side: if(alpha_size > beta_size, do: :alpha, else: :beta)
      }
    else
      %{ratio: 1.0, assessment: :balanced, larger_side: :none}
    end
  end

  defp assess_imbalance(ratio) do
    cond do
      ratio <= 1.2 -> :balanced
      ratio <= 2.0 -> :slight_imbalance
      ratio <= 3.0 -> :moderate_imbalance
      ratio <= 5.0 -> :major_imbalance
      true -> :overwhelming_advantage
    end
  end

  defp assess_side_coordination(classification) do
    # Assess how coordinated each side appears to be
    alpha_coordination = assess_group_coordination(classification.side_alpha)
    beta_coordination = assess_group_coordination(classification.side_beta)

    %{
      side_alpha: alpha_coordination,
      side_beta: beta_coordination,
      coordination_advantage:
        determine_coordination_advantage(alpha_coordination, beta_coordination)
    }
  end

  defp assess_group_coordination(participants) do
    # Simple coordination assessment based on alliance/corp cohesion
    total = length(participants)

    if total > 0 do
      # Count unique alliances and corps
      alliance_count =
        participants
        |> Enum.map(& &1.alliance_id)
        |> Enum.reject(&is_nil/1)
        |> Enum.uniq()
        |> length()

      corp_count =
        participants
        |> Enum.map(& &1.corporation_id)
        |> Enum.reject(&is_nil/1)
        |> Enum.uniq()
        |> length()

      # More participants per alliance/corp suggests better coordination
      alliance_cohesion = if alliance_count > 0, do: total / alliance_count, else: 1
      corp_cohesion = if corp_count > 0, do: total / corp_count, else: 1

      coordination_score = (alliance_cohesion + corp_cohesion) / 2

      %{
        score: Float.round(coordination_score, 1),
        alliance_count: alliance_count,
        corp_count: corp_count,
        assessment: assess_coordination_level(coordination_score)
      }
    else
      %{score: 0, alliance_count: 0, corp_count: 0, assessment: :none}
    end
  end

  defp assess_coordination_level(score) do
    cond do
      score >= 10 -> :highly_coordinated
      score >= 5 -> :well_coordinated
      score >= 2 -> :moderately_coordinated
      score >= 1 -> :loosely_coordinated
      true -> :uncoordinated
    end
  end

  defp determine_coordination_advantage(alpha_coord, beta_coord) do
    alpha_score = alpha_coord.score
    beta_score = beta_coord.score

    cond do
      alpha_score > beta_score * 1.5 -> :alpha_advantage
      beta_score > alpha_score * 1.5 -> :beta_advantage
      true -> :balanced
    end
  end

  # Helper functions for sophisticated side classification

  defp find_mutual_hostility_pairs(engagement_matrix, alliances) do
    # Find alliances that attack common enemies (potential allies)
    for alliance1 <- alliances,
        alliance2 <- alliances,
        alliance1 != alliance2,
        have_common_enemies?(engagement_matrix, alliance1, alliance2) do
      {alliance1, alliance2}
    end
  end

  defp have_common_enemies?(engagement_matrix, alliance1, alliance2) do
    # Check if two alliances attack the same targets
    alliance1_targets =
      engagement_matrix
      |> Map.get(alliance1, %{})
      |> Enum.filter(fn {_target, count} -> count > 0 end)
      |> Enum.map(fn {target, _count} -> target end)
      |> MapSet.new()

    alliance2_targets =
      engagement_matrix
      |> Map.get(alliance2, %{})
      |> Enum.filter(fn {_target, count} -> count > 0 end)
      |> Enum.map(fn {target, _count} -> target end)
      |> MapSet.new()

    # They have common enemies if their target sets overlap
    common_targets = MapSet.intersection(alliance1_targets, alliance2_targets)
    MapSet.size(common_targets) > 0
  end

  defp identify_opposing_alliance_sides(engagement_matrix, clusters) do
    # Find clusters that primarily engage each other
    opposing_pairs =
      for cluster1 <- clusters,
          cluster2 <- clusters,
          cluster1 != cluster2,
          clusters_are_opposing?(engagement_matrix, cluster1, cluster2) do
        {cluster1, cluster2}
      end

    # Group opposing pairs into coherent sides
    case opposing_pairs do
      [] -> %{side_alpha: [], side_beta: [], confidence: 0.0}
      _ -> build_opposing_sides_from_pairs(opposing_pairs, clusters)
    end
  end

  defp clusters_are_opposing?(engagement_matrix, cluster1, cluster2) do
    # Check if members of cluster1 primarily attack members of cluster2
    {total_engagements, inter_cluster_engagements} =
      for alliance1 <- cluster1,
          alliance2 <- cluster2,
          reduce: {0, 0} do
        {total_acc, inter_acc} ->
          engagement_count = get_in(engagement_matrix, [alliance1, alliance2]) || 0
          reverse_engagement = get_in(engagement_matrix, [alliance2, alliance1]) || 0

          total_engagement = engagement_count + reverse_engagement

          {total_acc + total_engagement, inter_acc + total_engagement}
      end

    # Clusters are opposing if they have significant mutual engagement
    inter_cluster_engagements > 0 and
      inter_cluster_engagements / max(total_engagements, 1) > 0.5
  end

  defp build_opposing_sides_from_pairs(opposing_pairs, clusters) do
    # Find the two largest opposing cluster groups
    cluster_sizes = Enum.map(clusters, &{&1, length(&1)})
    sorted_clusters = Enum.sort_by(cluster_sizes, fn {_cluster, size} -> size end, :desc)

    case sorted_clusters do
      [{side_alpha, _size1}, {side_beta, _size2} | _rest] ->
        # Calculate confidence based on engagement patterns
        confidence =
          calculate_side_classification_confidence(opposing_pairs, [side_alpha, side_beta])

        %{
          side_alpha: side_alpha,
          side_beta: side_beta,
          confidence: confidence
        }

      [{single_side, _size}] ->
        # Only one major cluster found
        %{
          side_alpha: single_side,
          side_beta: [],
          confidence: 0.3
        }

      [] ->
        %{
          side_alpha: [],
          side_beta: [],
          confidence: 0.0
        }
    end
  end

  defp calculate_side_classification_confidence(opposing_pairs, _sides) do
    # Calculate confidence based on number and strength of opposing relationships
    base_confidence = min(length(opposing_pairs) * 0.2, 0.8)

    # Add bonus for clear opposition patterns
    pattern_bonus = if length(opposing_pairs) >= 2, do: 0.2, else: 0.0

    min(base_confidence + pattern_bonus, 1.0)
  end

  # Coalition identification and relationship mapping functions

  defp build_alliance_cooperation_matrix(participants) do
    # Build matrix showing which alliances cooperate (fight on same side)
    killmail_groups = Enum.group_by(participants, & &1.killmail_id)

    # Find alliances that consistently appear on the same side
    alliances =
      participants
      |> Enum.map(& &1.alliance_id)
      |> Enum.reject(&is_nil/1)
      |> Enum.uniq()

    # Initialize cooperation matrix
    cooperation_matrix =
      alliances
      |> Enum.map(fn alliance ->
        {alliance,
         alliances
         |> Enum.map(fn other -> {other, 0} end)
         |> Enum.into(%{})}
      end)
      |> Enum.into(%{})

    # For each killmail, increment cooperation score for alliances on same side
    killmail_groups
    |> Enum.reduce(cooperation_matrix, fn {_killmail_id, killmail_participants}, acc ->
      # Group by participant type (attackers cooperate with attackers, etc.)
      by_type = Enum.group_by(killmail_participants, & &1.participant_type)

      for {_type, type_participants} <- by_type,
          alliance1 <-
            Enum.map(type_participants, & &1.alliance_id) |> Enum.reject(&is_nil/1) |> Enum.uniq(),
          alliance2 <-
            Enum.map(type_participants, & &1.alliance_id) |> Enum.reject(&is_nil/1) |> Enum.uniq(),
          alliance1 != alliance2,
          reduce: acc do
        matrix_acc ->
          if Map.has_key?(matrix_acc, alliance1) do
            update_in(matrix_acc, [alliance1, alliance2], &(&1 + 1))
          else
            matrix_acc
          end
      end
    end)
  end

  defp identify_coalition_candidates(engagement_matrix, cooperation_matrix) do
    # Find groups of alliances that cooperate frequently and don't fight each other
    alliances = Map.keys(cooperation_matrix)

    # Build candidate groups based on cooperation and non-aggression
    coalition_candidates =
      for alliance1 <- alliances,
          alliance2 <- alliances,
          alliance1 != alliance2,
          are_potential_coalition_members?(
            alliance1,
            alliance2,
            engagement_matrix,
            cooperation_matrix
          ) do
        {alliance1, alliance2}
      end

    # Build connected components from coalition pairs
    build_coalition_groups_from_pairs(coalition_candidates, alliances)
  end

  defp are_potential_coalition_members?(
         alliance1,
         alliance2,
         engagement_matrix,
         cooperation_matrix
       ) do
    # Check if two alliances are likely coalition members
    cooperation_score = get_in(cooperation_matrix, [alliance1, alliance2]) || 0
    hostility_score = get_in(engagement_matrix, [alliance1, alliance2]) || 0
    reverse_hostility = get_in(engagement_matrix, [alliance2, alliance1]) || 0

    # High cooperation and low/no mutual hostility indicates coalition membership
    cooperation_score >= 2 and hostility_score == 0 and reverse_hostility == 0
  end

  defp build_coalition_groups_from_pairs(coalition_pairs, alliances) do
    # Build connected components representing coalitions
    initial_groups = Enum.map(alliances, &[&1])

    Enum.reduce(coalition_pairs, initial_groups, fn {alliance1, alliance2}, groups ->
      # Find groups containing each alliance
      group1_idx = Enum.find_index(groups, &(alliance1 in &1))
      group2_idx = Enum.find_index(groups, &(alliance2 in &1))

      cond do
        # Already in same group
        group1_idx == group2_idx ->
          groups

        group1_idx && group2_idx ->
          # Merge the two groups
          group1 = Enum.at(groups, group1_idx)
          group2 = Enum.at(groups, group2_idx)
          merged = (group1 ++ group2) |> Enum.uniq()

          groups
          |> List.delete_at(max(group1_idx, group2_idx))
          |> List.delete_at(min(group1_idx, group2_idx))
          |> List.insert_at(0, merged)

        # One or both not found
        true ->
          groups
      end
    end)
    # Only return actual coalitions (2+ members)
    |> Enum.filter(&(length(&1) > 1))
  end

  defp validate_coalitions_with_historical_data(coalition_candidates, participants) do
    # Validate coalition candidates against historical engagement patterns
    Enum.map(coalition_candidates, fn coalition ->
      coalition_strength = calculate_coalition_internal_strength(coalition, participants)
      historical_consistency = analyze_historical_coalition_consistency(coalition, participants)

      %{
        id: generate_coalition_id(coalition),
        members: coalition,
        member_count: length(coalition),
        strength_score: coalition_strength,
        consistency_score: historical_consistency,
        validated: coalition_strength > 0.3 and historical_consistency > 0.5,
        primary_alliance: find_primary_alliance_in_coalition(coalition, participants)
      }
    end)
    |> Enum.filter(& &1.validated)
  end

  defp calculate_coalition_internal_strength(coalition, participants) do
    # Calculate how well coalition members work together
    coalition_participants =
      Enum.filter(participants, &(&1.alliance_id in coalition))

    if length(coalition_participants) == 0 do
      0.0
    else
      # Analyze coordination patterns, fleet composition synergy, etc.
      coordination_score = analyze_coalition_coordination(coalition_participants)
      composition_synergy = analyze_coalition_fleet_synergy(coalition_participants)

      (coordination_score + composition_synergy) / 2
    end
  end

  defp analyze_historical_coalition_consistency(coalition, participants) do
    # Analyze how consistently these alliances appear together across battles
    killmail_groups = Enum.group_by(participants, & &1.killmail_id)

    coalition_appearances =
      Enum.count(killmail_groups, fn {_killmail_id, killmail_participants} ->
        killmail_alliances =
          killmail_participants
          |> Enum.map(& &1.alliance_id)
          |> Enum.reject(&is_nil/1)
          |> Enum.uniq()

        # Check if multiple coalition members appear together
        coalition_members_present = Enum.filter(coalition, &(&1 in killmail_alliances))
        length(coalition_members_present) >= 2
      end)

    total_appearances =
      Enum.count(killmail_groups, fn {_killmail_id, killmail_participants} ->
        killmail_alliances =
          killmail_participants
          |> Enum.map(& &1.alliance_id)
          |> Enum.reject(&is_nil/1)
          |> Enum.uniq()

        # Any coalition member appears
        Enum.any?(coalition, &(&1 in killmail_alliances))
      end)

    if total_appearances > 0 do
      coalition_appearances / total_appearances
    else
      0.0
    end
  end

  defp build_coalition_relationship_map(coalitions, engagement_matrix) do
    # Build comprehensive relationship strength mapping between coalitions
    coalition_pairs =
      for coalition1 <- coalitions,
          coalition2 <- coalitions,
          coalition1.id != coalition2.id do
        {coalition1, coalition2}
      end

    Enum.map(coalition_pairs, fn {coalition1, coalition2} ->
      relationship_strength =
        calculate_inter_coalition_relationship(coalition1, coalition2, engagement_matrix)

      relationship_type = classify_coalition_relationship(relationship_strength)

      %{
        coalition1_id: coalition1.id,
        coalition2_id: coalition2.id,
        relationship_strength: relationship_strength,
        relationship_type: relationship_type,
        engagement_frequency:
          calculate_engagement_frequency(coalition1, coalition2, engagement_matrix)
      }
    end)
  end

  defp calculate_inter_coalition_relationship(coalition1, coalition2, engagement_matrix) do
    # Calculate relationship strength between two coalitions
    total_possible_engagements = length(coalition1.members) * length(coalition2.members)

    if total_possible_engagements == 0 do
      0.0
    else
      actual_engagements =
        for member1 <- coalition1.members,
            member2 <- coalition2.members do
          (get_in(engagement_matrix, [member1, member2]) || 0) +
            (get_in(engagement_matrix, [member2, member1]) || 0)
        end
        |> Enum.sum()

      # Normalize by possible engagements
      actual_engagements / total_possible_engagements
    end
  end

  defp classify_coalition_relationship(strength) when is_number(strength) do
    cond do
      strength >= 2.0 -> :hostile
      strength >= 1.0 -> :competitive
      strength >= 0.5 -> :occasional_conflict
      strength > 0.0 -> :minor_tensions
      true -> :neutral
    end
  end

  defp find_largest_coalition(coalitions) do
    if length(coalitions) > 0 do
      Enum.max_by(coalitions, & &1.member_count)
    else
      nil
    end
  end

  defp calculate_coalition_coverage(coalitions, participants) do
    # Calculate what percentage of participants are in identified coalitions
    total_participants = length(participants)

    if total_participants == 0 do
      0.0
    else
      coalition_members =
        coalitions
        |> Enum.flat_map(& &1.members)
        |> Enum.uniq()

      coalition_participant_count =
        Enum.count(participants, &(&1.alliance_id in coalition_members))

      coalition_participant_count / total_participants
    end
  end

  defp analyze_alliance_relationships(participants) do
    # Comprehensive analysis of alliance relationships across all battles
    alliances =
      participants
      |> Enum.map(& &1.alliance_id)
      |> Enum.reject(&is_nil/1)
      |> Enum.uniq()

    # Build relationship matrix with multiple dimensions
    Enum.map(alliances, fn alliance ->
      alliance_participants = Enum.filter(participants, &(&1.alliance_id == alliance))

      {alliance,
       %{
         cooperation_partners: find_cooperation_partners(alliance, participants),
         frequent_enemies: find_frequent_enemies(alliance, participants),
         battle_participation: calculate_battle_participation_rate(alliance_participants),
         average_fleet_size: calculate_average_fleet_size(alliance_participants),
         preferred_engagement_types: analyze_preferred_engagement_types(alliance_participants)
       }}
    end)
    |> Enum.into(%{})
  end

  defp analyze_side_for_advanced_coalitions(side_participants, alliance_relationships) do
    # Advanced coalition analysis incorporating relationship data
    alliances =
      side_participants
      |> Enum.reject(&is_nil(&1.alliance_id))
      |> Enum.group_by(& &1.alliance_id)

    # Use relationship data to identify actual coalitions
    coalition_groups =
      identify_coalition_groups_from_relationships(alliances, alliance_relationships)

    Enum.map(coalition_groups, fn coalition_alliances ->
      %{
        coalition_id: generate_coalition_id(coalition_alliances),
        member_alliances: coalition_alliances,
        total_participants:
          calculate_total_coalition_participants(coalition_alliances, alliances),
        coordination_score:
          calculate_coalition_coordination_score(coalition_alliances, alliance_relationships),
        fleet_composition: analyze_coalition_fleet_composition(coalition_alliances, alliances)
      }
    end)
  end

  # Helper functions for coalition analysis

  defp generate_coalition_id(alliance_list) do
    # Generate a consistent ID for a coalition based on member alliances
    alliance_list
    |> Enum.sort()
    |> Enum.join("-")
    |> :erlang.phash2(32)
    |> Integer.to_string(16)
  end

  defp find_primary_alliance_in_coalition(coalition, participants) do
    # Find the most active/largest alliance in the coalition
    coalition_participants =
      Enum.filter(participants, &(&1.alliance_id in coalition))

    coalition
    |> Enum.map(fn alliance_id ->
      member_count = Enum.count(coalition_participants, &(&1.alliance_id == alliance_id))
      {alliance_id, member_count}
    end)
    |> Enum.max_by(fn {_alliance_id, count} -> count end, fn -> {nil, 0} end)
    |> elem(0)
  end


  defp calculate_engagement_frequency(coalition1, coalition2, engagement_matrix) do
    # Calculate how often these coalitions engage each other
    total_engagements =
      for member1 <- coalition1.members,
          member2 <- coalition2.members do
        (get_in(engagement_matrix, [member1, member2]) || 0) +
          (get_in(engagement_matrix, [member2, member1]) || 0)
      end
      |> Enum.sum()

    total_engagements
  end

  defp find_cooperation_partners(alliance, participants) do
    # Find alliances that frequently cooperate with this alliance
    alliance_participants = Enum.filter(participants, &(&1.alliance_id == alliance))

    # Group by killmails to find alliances on same side
    killmail_groups = Enum.group_by(alliance_participants, & &1.killmail_id)

    partner_counts =
      killmail_groups
      |> Enum.flat_map(fn {killmail_id, _} ->
        # Find other alliances in same killmail on same side
        same_killmail_participants = Enum.filter(participants, &(&1.killmail_id == killmail_id))

        same_side_participants =
          Enum.filter(same_killmail_participants, fn p ->
            # Same participant type (all attackers or all victims)
            participant_types =
              Enum.map(alliance_participants, & &1.participant_type) |> Enum.uniq()

            p.participant_type in participant_types and p.alliance_id != alliance
          end)

        Enum.map(same_side_participants, & &1.alliance_id)
      end)
      |> Enum.reject(&is_nil/1)
      |> Enum.frequencies()

    # Return alliances with cooperation frequency >= 2
    partner_counts
    |> Enum.filter(fn {_alliance_id, count} -> count >= 2 end)
    |> Enum.map(fn {alliance_id, count} -> {alliance_id, count} end)
  end

  defp find_frequent_enemies(alliance, participants) do
    # Find alliances that frequently fight against this alliance
    alliance_participants = Enum.filter(participants, &(&1.alliance_id == alliance))

    # Group by killmails to find opposing alliances
    killmail_groups = Enum.group_by(alliance_participants, & &1.killmail_id)

    enemy_counts =
      killmail_groups
      |> Enum.flat_map(fn {killmail_id, alliance_killmail_participants} ->
        # Find opposing alliances in same killmail
        same_killmail_participants = Enum.filter(participants, &(&1.killmail_id == killmail_id))

        # Get alliance participant types
        alliance_types =
          Enum.map(alliance_killmail_participants, & &1.participant_type) |> Enum.uniq()

        opposing_participants =
          Enum.filter(same_killmail_participants, fn p ->
            p.participant_type not in alliance_types and p.alliance_id != alliance
          end)

        Enum.map(opposing_participants, & &1.alliance_id)
      end)
      |> Enum.reject(&is_nil/1)
      |> Enum.frequencies()

    # Return enemies with hostility frequency >= 2
    enemy_counts
    |> Enum.filter(fn {_alliance_id, count} -> count >= 2 end)
    |> Enum.map(fn {alliance_id, count} -> {alliance_id, count} end)
  end

  defp calculate_battle_participation_rate(alliance_participants) do
    # Calculate how often this alliance participates in battles
    unique_killmails =
      alliance_participants
      |> Enum.map(& &1.killmail_id)
      |> Enum.uniq()
      |> length()

    # Normalize by total participants (proxy for battle frequency)
    if length(alliance_participants) > 0 do
      unique_killmails / length(alliance_participants)
    else
      0.0
    end
  end

  defp calculate_average_fleet_size(alliance_participants) do
    # Calculate average fleet size for this alliance
    killmail_groups = Enum.group_by(alliance_participants, & &1.killmail_id)

    if map_size(killmail_groups) > 0 do
      total_participants =
        killmail_groups
        |> Map.values()
        |> Enum.map(&length/1)
        |> Enum.sum()

      total_participants / map_size(killmail_groups)
    else
      0.0
    end
  end

  defp analyze_preferred_engagement_types(alliance_participants) do
    # Analyze what types of engagements this alliance prefers
    ship_classes =
      alliance_participants
      |> Enum.map(fn p ->
        EveDmv.StaticData.ShipTypes.classify_ship_type(p.ship_type_id)
      end)
      |> Enum.frequencies()

    # Determine preferred engagement type based on ship composition
    cond do
      Map.get(ship_classes, :capital, 0) > 0 -> :capital_warfare
      Map.get(ship_classes, :battleship, 0) > Map.get(ship_classes, :frigate, 0) -> :large_scale
      Map.get(ship_classes, :frigate, 0) > 0 -> :small_gang
      true -> :mixed
    end
  end

  defp identify_coalition_groups_from_relationships(alliances, alliance_relationships) do
    # Use relationship data to identify actual coalition groupings
    alliance_ids = Map.keys(alliances)

    # Build coalition candidates based on cooperation partners
    coalition_pairs =
      for alliance_id <- alliance_ids,
          {partner_id, _count} <-
            get_in(alliance_relationships, [alliance_id, :cooperation_partners]) || [],
          partner_id in alliance_ids do
        {alliance_id, partner_id}
      end

    # Build connected components
    build_coalition_groups_from_pairs(coalition_pairs, alliance_ids)
    # Include single-alliance "coalitions"
    |> Enum.filter(&(length(&1) >= 1))
  end

  defp calculate_total_coalition_participants(coalition_alliances, alliance_participant_map) do
    coalition_alliances
    |> Enum.map(&length(Map.get(alliance_participant_map, &1, [])))
    |> Enum.sum()
  end

  defp calculate_coalition_coordination_score(coalition_alliances, alliance_relationships) do
    # Calculate how well coordinated this coalition appears to be
    if length(coalition_alliances) <= 1 do
      1.0
    else
      # Average cooperation strength between coalition members
      cooperation_scores =
        for alliance1 <- coalition_alliances,
            alliance2 <- coalition_alliances,
            alliance1 != alliance2 do
          partners = get_in(alliance_relationships, [alliance1, :cooperation_partners]) || []

          case Enum.find(partners, fn {partner_id, _count} -> partner_id == alliance2 end) do
            # Normalize cooperation count
            {_partner, count} -> min(count / 5.0, 1.0)
            nil -> 0.0
          end
        end

      if length(cooperation_scores) > 0 do
        Enum.sum(cooperation_scores) / length(cooperation_scores)
      else
        0.0
      end
    end
  end

  defp analyze_coalition_fleet_composition(coalition_alliances, alliance_participant_map) do
    # Analyze the combined fleet composition of the coalition
    all_participants =
      coalition_alliances
      |> Enum.flat_map(&Map.get(alliance_participant_map, &1, []))

    ship_types =
      all_participants
      |> Enum.map(fn p ->
        EveDmv.StaticData.ShipTypes.classify_ship_type(p.ship_type_id)
      end)
      |> Enum.frequencies()

    %{
      total_ships: length(all_participants),
      ship_class_distribution: ship_types,
      diversity_score: min(map_size(ship_types) / 8, 1.0),
      dominant_class:
        if(map_size(ship_types) > 0,
          do: Enum.max_by(ship_types, fn {_class, count} -> count end) |> elem(0),
          else: nil
        )
    }
  end

  defp analyze_cross_coalition_conflicts(
         attacker_coalitions,
         victim_coalitions,
         alliance_relationships
       ) do
    # Analyze conflicts between coalitions on opposing sides
    %{
      total_coalition_conflicts: length(attacker_coalitions) * length(victim_coalitions),
      major_rivalry_pairs:
        identify_major_coalition_rivalries(
          attacker_coalitions,
          victim_coalitions,
          alliance_relationships
        ),
      conflict_intensity_distribution:
        calculate_conflict_intensity_distribution(attacker_coalitions, victim_coalitions)
    }
  end

  defp identify_major_coalition_rivalries(
         attacker_coalitions,
         victim_coalitions,
         alliance_relationships
       ) do
    # Find coalition pairs that frequently fight each other
    for attacker_coalition <- attacker_coalitions,
        victim_coalition <- victim_coalitions do
      rivalry_strength =
        calculate_coalition_rivalry_strength(
          attacker_coalition,
          victim_coalition,
          alliance_relationships
        )

      if rivalry_strength > 0.3 do
        %{
          attacker_coalition_id: attacker_coalition.coalition_id,
          victim_coalition_id: victim_coalition.coalition_id,
          rivalry_strength: rivalry_strength
        }
      else
        nil
      end
    end
    |> Enum.reject(&is_nil/1)
  end

  defp calculate_coalition_rivalry_strength(
         attacker_coalition,
         victim_coalition,
         alliance_relationships
       ) do
    # Calculate how strong the rivalry is between two coalitions
    total_possible_rivalries =
      length(attacker_coalition.member_alliances) * length(victim_coalition.member_alliances)

    if total_possible_rivalries == 0 do
      0.0
    else
      actual_rivalries =
        for attacker_alliance <- attacker_coalition.member_alliances,
            victim_alliance <- victim_coalition.member_alliances do
          enemies = get_in(alliance_relationships, [attacker_alliance, :frequent_enemies]) || []

          case Enum.find(enemies, fn {enemy_id, _count} -> enemy_id == victim_alliance end) do
            {_enemy, count} -> count
            nil -> 0
          end
        end
        |> Enum.sum()

      # Normalize
      actual_rivalries / (total_possible_rivalries * 5)
    end
  end

  defp calculate_conflict_intensity_distribution(attacker_coalitions, victim_coalitions) do
    # Calculate distribution of conflict intensities
    intensities =
      for attacker_coalition <- attacker_coalitions,
          victim_coalition <- victim_coalitions do
        attacker_coalition.total_participants + victim_coalition.total_participants
      end

    if length(intensities) > 0 do
      %{
        min_intensity: Enum.min(intensities),
        max_intensity: Enum.max(intensities),
        average_intensity: Enum.sum(intensities) / length(intensities),
        total_conflicts: length(intensities)
      }
    else
      %{min_intensity: 0, max_intensity: 0, average_intensity: 0, total_conflicts: 0}
    end
  end

  defp analyze_coalition_strengths(attacker_coalitions, victim_coalitions) do
    # Analyze the relative strengths of coalitions
    all_coalitions = attacker_coalitions ++ victim_coalitions

    %{
      largest_coalition: find_largest_coalition_by_participants(all_coalitions),
      most_coordinated_coalition: find_most_coordinated_coalition(all_coalitions),
      coalition_size_distribution: calculate_coalition_size_distribution(all_coalitions),
      average_coalition_size: calculate_average_coalition_size(all_coalitions)
    }
  end

  defp find_largest_coalition_by_participants(coalitions) do
    if length(coalitions) > 0 do
      Enum.max_by(coalitions, & &1.total_participants)
    else
      nil
    end
  end

  defp find_most_coordinated_coalition(coalitions) do
    if length(coalitions) > 0 do
      Enum.max_by(coalitions, & &1.coordination_score)
    else
      nil
    end
  end

  defp calculate_coalition_size_distribution(coalitions) do
    sizes = Enum.map(coalitions, & &1.total_participants)

    if length(sizes) > 0 do
      %{
        min_size: Enum.min(sizes),
        max_size: Enum.max(sizes),
        median_size: calculate_median(sizes)
      }
    else
      %{min_size: 0, max_size: 0, median_size: 0}
    end
  end

  defp calculate_average_coalition_size(coalitions) do
    if length(coalitions) > 0 do
      total_participants = Enum.sum(Enum.map(coalitions, & &1.total_participants))
      total_participants / length(coalitions)
    else
      0.0
    end
  end

  defp calculate_median(list) when is_list(list) do
    sorted = Enum.sort(list)
    length = length(sorted)

    if length == 0 do
      0
    else
      middle = div(length, 2)

      if rem(length, 2) == 0 do
        (Enum.at(sorted, middle - 1) + Enum.at(sorted, middle)) / 2
      else
        Enum.at(sorted, middle)
      end
    end
  end

  # Role effectiveness calculation functions

  defp determine_participant_tactical_role(participant) do
    # Determine tactical role based on ship type and actual performance
    ship_class = EveDmv.StaticData.ShipTypes.classify_ship_type(participant.ship_type_id)
    damage_done = participant[:damage_done] || 0
    damage_taken = participant[:damage_taken] || 0

    cond do
      # Logistics ships identified by ship type
      EveDmv.StaticData.ShipTypes.is_logistics?(participant.ship_type_id) -> :logistics
      # EWAR ships identified by ship type  
      EveDmv.StaticData.ShipTypes.is_ewar?(participant.ship_type_id) -> :ewar
      # Interceptors and tackle ships
      EveDmv.StaticData.ShipTypes.is_interceptor?(participant.ship_type_id) -> :tackle
      ship_class in [:frigate, :destroyer] and damage_done < 1000 -> :tackle
      # High damage output indicates DPS role
      damage_done >= 5000 -> :dps
      ship_class in [:battleship, :battlecruiser] -> :dps
      # Support roles based on damage patterns
      damage_done > 0 and damage_taken > damage_done * 2 -> :tank
      # Default to DPS for combat ships
      ship_class in [:cruiser, :frigate] -> :dps
      # Industrial/mining ships
      ship_class in [:industrial, :mining] -> :support
      # Default classification
      true -> :dps
    end
  end

  defp calculate_role_specific_effectiveness(role, participants) do
    # Calculate effectiveness metrics specific to each tactical role
    case role do
      :dps -> calculate_dps_effectiveness(participants)
      :logistics -> calculate_logistics_effectiveness(participants)
      :tackle -> calculate_tackle_effectiveness(participants)
      :ewar -> calculate_ewar_effectiveness(participants)
      :tank -> calculate_tank_effectiveness(participants)
      :support -> calculate_support_effectiveness(participants)
      _ -> calculate_generic_combat_effectiveness(participants)
    end
  end

  defp calculate_dps_effectiveness(participants) do
    # Calculate DPS role effectiveness based on damage output and survival
    total_damage = Enum.sum(Enum.map(participants, &(&1[:damage_done] || 0)))
    participant_count = length(participants)
    survivors = Enum.count(participants, &(&1.participant_type == :attacker))

    if participant_count == 0 do
      0.0
    else
      # Average damage per participant
      avg_damage_per_participant = total_damage / participant_count

      # Survival rate
      survival_rate = survivors / participant_count

      # DPS effectiveness formula: damage output (70%) + survival (30%)
      # Normalize against 8k damage
      damage_score = min(avg_damage_per_participant / 8000, 1.0)
      effectiveness = damage_score * 0.7 + survival_rate * 0.3

      min(effectiveness, 1.0)
    end
  end

  defp calculate_logistics_effectiveness(participants) do
    # Calculate logistics effectiveness based on fleet survival and support metrics
    participant_count = length(participants)
    survivors = Enum.count(participants, &(&1.participant_type == :attacker))

    if participant_count == 0 do
      0.0
    else
      # Logistics effectiveness primarily measured by survival of the fleet they support
      # Higher survival rate of logistics ships indicates better positioning/effectiveness
      survival_rate = survivors / participant_count

      # Logistics ships that survive are more effective
      # Additional factors could include fleet members saved, but require more complex data
      base_effectiveness = survival_rate

      # Bonus for having multiple logistics (redundancy)
      redundancy_bonus = if participant_count >= 2, do: 0.1, else: 0.0

      min(base_effectiveness + redundancy_bonus, 1.0)
    end
  end

  defp calculate_tackle_effectiveness(participants) do
    # Calculate tackle effectiveness based on engagement success and survival
    participant_count = length(participants)
    survivors = Enum.count(participants, &(&1.participant_type == :attacker))

    if participant_count == 0 do
      0.0
    else
      # Tackle effectiveness measured by engagement initiation and target control
      survival_rate = survivors / participant_count

      # Tackle ships often die but their effectiveness is in engagement success
      # Lower survival penalty for tackle role
      # Base score for participating in tackle
      engagement_score = 0.7
      survival_bonus = survival_rate * 0.3

      min(engagement_score + survival_bonus, 1.0)
    end
  end

  defp calculate_ewar_effectiveness(participants) do
    # Calculate EWAR effectiveness based on survival and force multiplication
    participant_count = length(participants)
    survivors = Enum.count(participants, &(&1.participant_type == :attacker))

    if participant_count == 0 do
      0.0
    else
      # EWAR effectiveness based on survival (staying alive to provide ongoing disruption)
      survival_rate = survivors / participant_count

      # EWAR ships are most effective when they survive to provide ongoing disruption
      base_effectiveness = survival_rate * 0.8

      # Bonus for force multiplication (having EWAR present)
      presence_bonus = 0.2

      min(base_effectiveness + presence_bonus, 1.0)
    end
  end

  defp calculate_tank_effectiveness(participants) do
    # Calculate tank effectiveness based on damage absorption and survival
    total_damage_taken = Enum.sum(Enum.map(participants, &(&1[:damage_taken] || 0)))
    participant_count = length(participants)
    survivors = Enum.count(participants, &(&1.participant_type == :attacker))

    if participant_count == 0 do
      0.0
    else
      # Tank effectiveness: damage absorbed per ship + survival rate
      avg_damage_absorbed = total_damage_taken / participant_count
      survival_rate = survivors / participant_count

      # Normalize damage absorption (tanks should absorb significant damage)
      # 15k damage threshold
      absorption_score = min(avg_damage_absorbed / 15000, 1.0)

      # Tank effectiveness: absorption (60%) + survival (40%)
      effectiveness = absorption_score * 0.6 + survival_rate * 0.4

      min(effectiveness, 1.0)
    end
  end

  defp calculate_support_effectiveness(participants) do
    # Calculate support role effectiveness based on survival and utility
    participant_count = length(participants)
    survivors = Enum.count(participants, &(&1.participant_type == :attacker))

    if participant_count == 0 do
      0.0
    else
      # Support effectiveness primarily based on survival (staying alive to provide utility)
      survival_rate = survivors / participant_count

      # Support ships are most effective when they survive
      base_effectiveness = survival_rate * 0.9

      # Small bonus for participation
      participation_bonus = 0.1

      min(base_effectiveness + participation_bonus, 1.0)
    end
  end

  defp calculate_generic_combat_effectiveness(participants) do
    # Generic combat effectiveness for unclassified roles
    participant_count = length(participants)

    if participant_count == 0 do
      0.0
    else
      total_damage = Enum.sum(Enum.map(participants, &(&1[:damage_done] || 0)))
      survivors = Enum.count(participants, &(&1.participant_type == :attacker))

      # Balance between damage output and survival
      avg_damage = total_damage / participant_count
      survival_rate = survivors / participant_count

      # 5k damage threshold for generic
      damage_score = min(avg_damage / 5000, 1.0)
      effectiveness = damage_score * 0.5 + survival_rate * 0.5

      min(effectiveness, 1.0)
    end
  end

  defp calculate_role_diversity_bonus(role_groups) do
    # Calculate bonus for having diverse tactical roles
    unique_roles = map_size(role_groups)

    case unique_roles do
      # No diversity
      1 -> 0.0
      # Some diversity
      2 -> 0.02
      # Good diversity  
      3 -> 0.05
      # Very good diversity
      4 -> 0.08
      # Excellent diversity (5+ roles)
      _ -> 0.10
    end
  end

  # Key player identification functions

  defp identify_performance_leaders(participants) do
    # Identify top performers based on combat effectiveness
    participants
    |> Enum.map(fn p ->
      performance_score = calculate_combat_performance_score(p)

      %{
        character_id: p.character_id,
        character_name: p.character_name,
        corporation_id: p.corporation_id,
        alliance_id: p.alliance_id,
        ship_type_id: p.ship_type_id,
        ship_name: p.ship_name,
        tactical_role: determine_participant_tactical_role(p),
        damage_dealt: p[:damage_done] || 0,
        damage_taken: p[:damage_taken] || 0,
        final_blow: p[:final_blow] || false,
        survived: p.participant_type == :attacker,
        performance_score: performance_score,
        key_player_category: :performance_leader,
        overall_key_player_score: performance_score
      }
    end)
    |> Enum.sort_by(& &1.performance_score, :desc)
    # Top 3 performance leaders
    |> Enum.take(3)
  end

  defp identify_tactical_leaders(participants) do
    # Identify leaders based on tactical importance and positioning
    participants
    |> Enum.map(fn p ->
      tactical_score = calculate_tactical_leadership_score(p, participants)

      %{
        character_id: p.character_id,
        character_name: p.character_name,
        corporation_id: p.corporation_id,
        alliance_id: p.alliance_id,
        ship_type_id: p.ship_type_id,
        ship_name: p.ship_name,
        tactical_role: determine_participant_tactical_role(p),
        damage_dealt: p[:damage_done] || 0,
        damage_taken: p[:damage_taken] || 0,
        final_blow: p[:final_blow] || false,
        survived: p.participant_type == :attacker,
        tactical_leadership_score: tactical_score,
        key_player_category: :tactical_leader,
        overall_key_player_score: tactical_score
      }
    end)
    |> Enum.sort_by(& &1.tactical_leadership_score, :desc)
    # Top 2 tactical leaders
    |> Enum.take(2)
  end

  defp identify_influence_leaders(participants) do
    # Identify players with significant influence on battle outcome
    participants
    |> Enum.map(fn p ->
      influence_score = calculate_influence_score(p, participants)

      %{
        character_id: p.character_id,
        character_name: p.character_name,
        corporation_id: p.corporation_id,
        alliance_id: p.alliance_id,
        ship_type_id: p.ship_type_id,
        ship_name: p.ship_name,
        tactical_role: determine_participant_tactical_role(p),
        damage_dealt: p[:damage_done] || 0,
        damage_taken: p[:damage_taken] || 0,
        final_blow: p[:final_blow] || false,
        survived: p.participant_type == :attacker,
        influence_score: influence_score,
        key_player_category: :influence_leader,
        overall_key_player_score: influence_score
      }
    end)
    |> Enum.sort_by(& &1.influence_score, :desc)
    # Top 3 influence leaders
    |> Enum.take(3)
  end

  defp identify_specialist_leaders(participants) do
    # Identify specialists who excel in their specific roles
    role_groups = Enum.group_by(participants, &determine_participant_tactical_role/1)

    Enum.flat_map(role_groups, fn {role, role_participants} ->
      if length(role_participants) > 0 do
        specialist_score_fn = get_specialist_scoring_function(role)

        role_participants
        |> Enum.map(fn p ->
          specialist_score = specialist_score_fn.(p, role_participants)

          %{
            character_id: p.character_id,
            character_name: p.character_name,
            corporation_id: p.corporation_id,
            alliance_id: p.alliance_id,
            ship_type_id: p.ship_type_id,
            ship_name: p.ship_name,
            tactical_role: role,
            damage_dealt: p[:damage_done] || 0,
            damage_taken: p[:damage_taken] || 0,
            final_blow: p[:final_blow] || false,
            survived: p.participant_type == :attacker,
            specialist_score: specialist_score,
            key_player_category: :specialist_leader,
            specialist_category: role,
            overall_key_player_score: specialist_score
          }
        end)
        |> Enum.sort_by(& &1.specialist_score, :desc)
        # Top 1 specialist per role
        |> Enum.take(1)
      else
        []
      end
    end)
  end

  defp calculate_combat_performance_score(participant) do
    # Calculate comprehensive combat performance score
    base_damage = participant[:damage_done] || 0
    damage_taken = participant[:damage_taken] || 0
    final_blow = participant[:final_blow] || false
    survived = participant.participant_type == :attacker

    # Damage effectiveness (normalized)
    # Up to 40 points
    damage_score = min(base_damage / 10000, 1.0) * 40

    # Survival bonus
    # Up to 20 points
    survival_score = if survived, do: 20, else: 0

    # Final blow bonus
    # Up to 15 points
    final_blow_score = if final_blow, do: 15, else: 0

    # Damage efficiency (damage dealt vs taken)
    efficiency_score =
      if damage_taken > 0 do
        # Up to 20 points
        min(base_damage / damage_taken, 2.0) * 10
      else
        if base_damage > 0, do: 20, else: 0
      end

    # Role-specific performance bonus
    # Up to 5 points
    role_bonus = calculate_role_performance_bonus(participant)

    damage_score + survival_score + final_blow_score + efficiency_score + role_bonus
  end

  defp calculate_tactical_leadership_score(participant, all_participants) do
    # Calculate tactical leadership based on fleet coordination indicators
    base_score = 0

    # Command ship bonus
    ship_class = EveDmv.StaticData.ShipTypes.classify_ship_type(participant.ship_type_id)

    command_bonus =
      case ship_class do
        # Command ships are often battlecruisers
        :battlecruiser -> 10
        # Battleships often anchor fleets
        :battleship -> 8
        # Capital ships are high-value tactical assets
        :capital -> 15
        _ -> 0
      end

    # Fleet size influence (larger fleets need more coordination)
    same_side_participants =
      Enum.filter(all_participants, &(&1.participant_type == participant.participant_type))

    fleet_size = length(same_side_participants)

    fleet_coordination_score =
      if fleet_size >= 10 do
        # Bonus for coordinating larger fleets
        5
      else
        0
      end

    # Alliance/Corporation leadership (more members = potential FC)
    same_alliance_count =
      Enum.count(same_side_participants, &(&1.alliance_id == participant.alliance_id))

    leadership_score =
      if same_alliance_count >= 5 do
        # Up to 15 points for leading large groups
        min(same_alliance_count / 5, 3) * 5
      else
        0
      end

    # Survival importance for tactical leaders
    survival_score = if participant.participant_type == :attacker, do: 10, else: 0

    base_score + command_bonus + fleet_coordination_score + leadership_score + survival_score
  end

  defp calculate_influence_score(participant, _all_participants) do
    # Calculate influence on battle outcome
    base_damage = participant[:damage_done] || 0
    damage_taken = participant[:damage_taken] || 0

    # High-value target bonus (expensive ships have more influence)
    ship_value_bonus = calculate_ship_value_influence(participant.ship_type_id)

    # Force multiplication for support roles
    tactical_role = determine_participant_tactical_role(participant)

    force_multiplier_bonus =
      case tactical_role do
        # High influence through fleet sustainment
        :logistics -> 20
        # High influence through enemy disruption
        :ewar -> 15
        # Moderate influence through engagement control
        :tackle -> 10
        _ -> 0
      end

    # Battle timing influence (early participants have more influence)
    # Simplified - would need killmail timestamps for real implementation
    timing_bonus = 5

    # Damage influence (normalized)
    damage_influence = min(base_damage / 15000, 1.0) * 25

    # Target priority (being primaried indicates importance)
    target_priority_score = if damage_taken >= 10000, do: 10, else: 0

    ship_value_bonus + force_multiplier_bonus + timing_bonus + damage_influence +
      target_priority_score
  end

  defp get_specialist_scoring_function(role) do
    # Return role-specific scoring function
    case role do
      :dps -> &calculate_dps_specialist_score/2
      :logistics -> &calculate_logistics_specialist_score/2
      :tackle -> &calculate_tackle_specialist_score/2
      :ewar -> &calculate_ewar_specialist_score/2
      :tank -> &calculate_tank_specialist_score/2
      _ -> &calculate_generic_specialist_score/2
    end
  end

  defp calculate_dps_specialist_score(participant, role_participants) do
    # DPS specialist scoring
    participant_damage = participant[:damage_done] || 0

    average_role_damage =
      role_participants
      |> Enum.map(&(&1[:damage_done] || 0))
      |> Enum.sum()
      |> case do
        0 -> 0
        total -> total / length(role_participants)
      end

    if average_role_damage > 0 do
      # Relative to role average
      participant_damage / average_role_damage * 50
    else
      0
    end
  end

  defp calculate_logistics_specialist_score(participant, role_participants) do
    # Logistics specialist scoring based on survival and positioning
    base_score = if participant.participant_type == :attacker, do: 40, else: 0

    # Bonus for being one of few logistics
    scarcity_bonus = if length(role_participants) <= 2, do: 20, else: 10

    base_score + scarcity_bonus
  end

  defp calculate_tackle_specialist_score(participant, _role_participants) do
    # Tackle specialist scoring
    # Base score for tackle participation
    base_engagement_score = 30

    # Interceptor bonus
    interceptor_bonus =
      if EveDmv.StaticData.ShipTypes.is_interceptor?(participant.ship_type_id) do
        15
      else
        0
      end

    # Survival bonus (tackle that survives is especially effective)
    survival_bonus = if participant.participant_type == :attacker, do: 25, else: 5

    base_engagement_score + interceptor_bonus + survival_bonus
  end

  defp calculate_ewar_specialist_score(participant, _role_participants) do
    # EWAR specialist scoring
    # Base score for EWAR participation
    base_disruption_score = 35

    # Survival critical for EWAR
    survival_score = if participant.participant_type == :attacker, do: 30, else: 0

    # EWAR ship type bonus
    ewar_ship_bonus =
      if EveDmv.StaticData.ShipTypes.is_ewar?(participant.ship_type_id) do
        10
      else
        0
      end

    base_disruption_score + survival_score + ewar_ship_bonus
  end

  defp calculate_tank_specialist_score(participant, role_participants) do
    # Tank specialist scoring based on damage absorption
    participant_damage_taken = participant[:damage_taken] || 0

    average_role_damage_taken =
      role_participants
      |> Enum.map(&(&1[:damage_taken] || 0))
      |> Enum.sum()
      |> case do
        0 -> 0
        total -> total / length(role_participants)
      end

    if average_role_damage_taken > 0 do
      absorption_score = participant_damage_taken / average_role_damage_taken * 30
      survival_bonus = if participant.participant_type == :attacker, do: 20, else: 0
      absorption_score + survival_bonus
    else
      0
    end
  end

  defp calculate_generic_specialist_score(participant, _role_participants) do
    # Generic specialist scoring
    damage_score = min((participant[:damage_done] || 0) / 5000, 1.0) * 25
    survival_score = if participant.participant_type == :attacker, do: 15, else: 0

    damage_score + survival_score
  end

  defp calculate_role_performance_bonus(participant) do
    # Role-specific performance bonuses
    tactical_role = determine_participant_tactical_role(participant)

    case tactical_role do
      :logistics -> if participant.participant_type == :attacker, do: 5, else: 0
      :ewar -> if participant.participant_type == :attacker, do: 4, else: 0
      # Tackle gets bonus regardless of survival
      :tackle -> 3
      :tank -> if (participant[:damage_taken] || 0) >= 10000, do: 4, else: 0
      _ -> 0
    end
  end

  defp calculate_ship_value_influence(ship_type_id) do
    # Estimate ship value influence based on ship class
    ship_class = EveDmv.StaticData.ShipTypes.classify_ship_type(ship_type_id)

    case ship_class do
      :supercapital -> 25
      :capital -> 20
      :battleship -> 10
      :battlecruiser -> 8
      :cruiser -> 5
      :destroyer -> 3
      :frigate -> 2
      _ -> 1
    end
  end

  # Simple implementations for functions that are still called
  defp analyze_coalition_coordination(participants) do
    if length(participants) > 1, do: 0.7, else: 0.0
  end

  defp analyze_coalition_fleet_synergy(participants) do
    ship_types = Enum.map(participants, & &1.ship_type_id) |> Enum.frequencies()
    diversity_score = min(map_size(ship_types) / 10, 1.0)
    diversity_score
  end


  defp classify_participants_by_experience(participants, _experience_data) do
    participants
    |> Enum.map(fn participant ->
      {participant, :intermediate}
    end)
  end

  defp calculate_experience_distribution_counts(classified_participants) do
    counts = Enum.frequencies_by(classified_participants, fn {_participant, classification} -> classification end)
    %{
      veteran: Map.get(counts, :veteran, 0),
      experienced: Map.get(counts, :experienced, 0),
      intermediate: Map.get(counts, :intermediate, 0),
      novice: Map.get(counts, :novice, 0),
      unclassified: Map.get(counts, :unclassified, 0)
    }
  end

  defp calculate_experience_statistics(_classified_participants, _experience_data) do
    %{average_experience: 0.5, experience_variance: 0.2}
  end

  defp analyze_experience_distribution_patterns(_classified_participants) do
    %{balance: :moderate, diversity: :mixed}
  end

  defp create_detailed_experience_breakdown(_classified_participants) do
    %{}
  end

  defp determine_fleet_experience_level(_distribution_counts) do
    :mixed
  end

  defp analyze_experience_by_side(_classified_participants) do
    %{attacker_advantage: :neutral}
  end
end
