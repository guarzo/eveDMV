  defp calculate_performance_consistency(performance_data) do
    monthly_data = Map.get(performance_data, :monthly_performance, [])
    
    if length(monthly_data) < 3 do
      %{consistency: :insufficient_data, score: 0.0}
    else
      kd_ratios = Enum.map(monthly_data, & &1.kd_ratio)
      efficiencies = Enum.map(monthly_data, & &1.kill_efficiency)
      
      kd_variance = calculate_variance(kd_ratios)
      efficiency_variance = calculate_variance(efficiencies)
      
      # Lower variance = higher consistency
      consistency_score = 1.0 - min(1.0, (kd_variance + efficiency_variance) / 2)
      
      consistency_level = cond do
        consistency_score >= 0.8 -> :very_high
        consistency_score >= 0.6 -> :high
        consistency_score >= 0.4 -> :moderate
        consistency_score >= 0.2 -> :low
        true -> :very_low
      end
      
      %{consistency: consistency_level, score: Float.round(consistency_score, 2)}
    end
  end

  defp identify_peak_performance_periods(performance_data) do
    monthly_data = Map.get(performance_data, :monthly_performance, [])
    
    if length(monthly_data) == 0 do
      []
    else
      # Identify months with above-average performance
      avg_kd = Enum.sum(Enum.map(monthly_data, & &1.kd_ratio)) / length(monthly_data)
      avg_efficiency = Enum.sum(Enum.map(monthly_data, & &1.kill_efficiency)) / length(monthly_data)
      
      monthly_data
      |> Enum.filter(fn month ->
        month.kd_ratio > avg_kd and month.kill_efficiency > avg_efficiency
      end)
      |> Enum.map(fn month ->
        %{
          month: month.month,
          kd_ratio: month.kd_ratio,
          kill_efficiency: month.kill_efficiency,
          engagements: month.engagements
        }
      end)
      |> Enum.sort_by(& &1.kd_ratio, :desc)
      |> Enum.take(3)  # Top 3 peak periods
    end
  end

  defp identify_performance_decline_indicators(performance_data) do
    monthly_data = Map.get(performance_data, :monthly_performance, [])
    
    if length(monthly_data) < 3 do
      %{indicators: [], risk_level: :unknown}
    else
      indicators = []
      
      # Check for declining KD ratio trend
      recent_kd = Enum.take(monthly_data, 3) |> Enum.map(& &1.kd_ratio)
      if calculate_trend(recent_kd) == :declining do
        indicators = indicators ++ [:declining_kd_ratio]
      end
      
      # Check for declining activity
      recent_activity = Enum.take(monthly_data, 3) |> Enum.map(& &1.engagements)
      if calculate_trend(recent_activity) == :declining do
        indicators = indicators ++ [:declining_activity]
      end
      
      # Check for declining efficiency
      recent_efficiency = Enum.take(monthly_data, 3) |> Enum.map(& &1.kill_efficiency)
      if calculate_trend(recent_efficiency) == :declining do
        indicators = indicators ++ [:declining_efficiency]
      end
      
      risk_level = case length(indicators) do
        0 -> :low
        1 -> :moderate
        2 -> :high
        _ -> :very_high
      end
      
      %{indicators: indicators, risk_level: risk_level}
    end
  end

  defp generate_comparative_performance_analysis(performance_data, participant) do
    # Simplified comparative analysis
    %{
      analysis: "Comparative performance analysis",
      percentile_ranking: :unknown,
      peer_comparison: :above_average,
      strengths: [:tactical_awareness, :ship_handling],
      weaknesses: [:target_selection, :situational_awareness]
    }
  end

  defp identify_primary_threat_factors(historical_data, participant) do
    factors = []
    
    # High kill count
    if Map.get(historical_data, :total_kills, 0) >= 100 do
      factors = factors ++ [:high_kill_count]
    end
    
    # Good KD ratio
    total_kills = Map.get(historical_data, :total_kills, 0)
    total_deaths = Map.get(historical_data, :total_deaths, 0)
    if total_deaths > 0 and total_kills / total_deaths >= 2.0 do
      factors = factors ++ [:excellent_kd_ratio]
    end
    
    # Solo capability
    if Map.get(historical_data, :solo_engagements, 0) >= 20 do
      factors = factors ++ [:solo_capability]
    end
    
    # High-value targets
    if Map.get(historical_data, :avg_kill_value, 0) >= 50_000_000 do
      factors = factors ++ [:high_value_targets]
    end
    
    # Dangerous space activity
    space_dist = Map.get(historical_data, :space_distribution, %{})
    total_activity = Map.get(space_dist, :highsec, 0) + Map.get(space_dist, :lowsec, 0) + Map.get(space_dist, :nullsec, 0)
    if total_activity > 0 do
      dangerous_ratio = (Map.get(space_dist, :lowsec, 0) + Map.get(space_dist, :nullsec, 0)) / total_activity
      if dangerous_ratio >= 0.7 do
        factors = factors ++ [:dangerous_space_preference]
      end
    end
    
    if length(factors) == 0, do: [:standard_threat], else: factors
  end

  defp analyze_threat_trend(historical_data) do
    recent_activity = Map.get(historical_data, :recent_metrics, %{})
    recent_kills = Map.get(recent_activity, :recent_kills, 0)
    total_kills = Map.get(historical_data, :total_kills, 0)
    
    if total_kills > 0 do
      recent_ratio = recent_kills / total_kills * 30  # Scale to monthly
      
      cond do
        recent_ratio >= 0.3 -> :escalating
        recent_ratio >= 0.1 -> :stable
        recent_ratio >= 0.05 -> :declining
        true -> :dormant
      end
    else
      :unknown
    end
  end

  defp generate_threat_mitigation_recommendations(threat_level, historical_data) do
    base_recommendations = case threat_level do
      :extreme -> [
        "EXTREME THREAT - Avoid engagement unless overwhelming advantage",
        "Use maximum range tactics and electronic warfare",
        "Consider alternative routes to avoid this pilot"
      ]
      :very_high -> [
        "High priority threat - Engage with caution and support",
        "Use coordinated tactics and avoid solo encounters"
      ]
      :high -> [
        "Moderate threat - Standard engagement protocols with backup",
        "Monitor pilot movements and engagement patterns"
      ]
      :moderate -> [
        "Standard threat protocols",
        "Maintain situational awareness"
      ]
      _ -> ["Standard engagement protocols appropriate"]
    end
    
    # Add specific recommendations based on threat factors
    space_dist = Map.get(historical_data, :space_distribution, %{})
    if Map.get(space_dist, :nullsec, 0) > Map.get(space_dist, :highsec, 0) do
      base_recommendations ++ ["Pilot prefers nullsec - expect advanced tactics"]
    else
      base_recommendations
    end
  end

  # Helper functions for trend and statistical analysis
  defp calculate_trend(values) when length(values) < 2, do: :insufficient_data
  defp calculate_trend(values) do
    first_half = Enum.take(values, div(length(values), 2))
    second_half = Enum.drop(values, div(length(values), 2))
    
    first_avg = Enum.sum(first_half) / max(length(first_half), 1)
    second_avg = Enum.sum(second_half) / max(length(second_half), 1)
    
    cond do
      second_avg > first_avg * 1.1 -> :improving
      second_avg < first_avg * 0.9 -> :declining
      true -> :stable
    end
  end

  defp determine_overall_trend(kd_trend, activity_trend, efficiency_trend) do
    trends = [kd_trend, activity_trend, efficiency_trend]
    improving_count = Enum.count(trends, &(&1 == :improving))
    declining_count = Enum.count(trends, &(&1 == :declining))
    
    cond do
      improving_count >= 2 -> :improving
      declining_count >= 2 -> :declining
      true -> :stable
    end
  end

  defp calculate_trend_strength(monthly_data) do
    if length(monthly_data) < 3 do
      :weak
    else
      kd_ratios = Enum.map(monthly_data, & &1.kd_ratio)
      variance = calculate_variance(kd_ratios)
      
      cond do
        variance <= 0.1 -> :very_strong
        variance <= 0.3 -> :strong
        variance <= 0.6 -> :moderate
        variance <= 1.0 -> :weak
        true -> :very_weak
      end
    end
  end

  defp calculate_average_kd(monthly_data) do
    if length(monthly_data) == 0 do
      0.0
    else
      Enum.sum(Enum.map(monthly_data, & &1.kd_ratio)) / length(monthly_data)
    end
  end

  defp identify_peak_month(monthly_data) do
    if length(monthly_data) == 0 do
      nil
    else
      Enum.max_by(monthly_data, fn month ->
        # Composite score: KD ratio + kill efficiency
        month.kd_ratio + month.kill_efficiency
      end)
    end
  end

  defp calculate_consistency_score(monthly_data) do
    if length(monthly_data) < 2 do
      0.0
    else
      kd_ratios = Enum.map(monthly_data, & &1.kd_ratio)
      1.0 - min(1.0, calculate_variance(kd_ratios))
    end
  end

  defp calculate_performance_volatility(monthly_data) do
    if length(monthly_data) < 2 do
      :unknown
    else
      kd_ratios = Enum.map(monthly_data, & &1.kd_ratio)
      variance = calculate_variance(kd_ratios)
      
      cond do
        variance <= 0.2 -> :very_low
        variance <= 0.5 -> :low
        variance <= 1.0 -> :moderate
        variance <= 2.0 -> :high
        true -> :very_high
      end
    end
  end

  # Placeholder functions for advanced analysis features
  defp analyze_detailed_activity_patterns(participant) do
    # Enhanced detailed activity pattern analysis
    activity_patterns = analyze_activity_patterns(participant)
    
