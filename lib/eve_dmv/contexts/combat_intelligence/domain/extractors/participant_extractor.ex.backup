defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Extractors.ParticipantExtractor do
  @moduledoc """
  Extractor for identifying and analyzing battle participants from killmail data.

  Processes killmail data to identify all participants in a battle, their roles,
  affiliations, and contributions to the engagement.
  """

  require Logger
  import Ecto.Query
  alias EveDmv.StaticData.ShipTypes

  @doc """
  Extract battle participants from killmail data.
  """
  def extract_battle_participants(killmails) do
    Logger.debug("Extracting battle participants from #{length(killmails)} killmails")

    # For now, return basic participant extraction
    # TODO: Implement detailed participant extraction from killmail data

    participants =
      killmails
      |> Enum.flat_map(&extract_participants_from_killmail/1)
      |> Enum.uniq_by(& &1.character_id)
      |> Enum.map(&enrich_participant_data/1)

    %{
      participants: participants,
      total_count: length(participants),
      sides: classify_participants_by_side(participants),
      affiliations: group_participants_by_affiliation(participants),
      roles: analyze_participant_roles(participants)
    }
  end

  @doc """
  Analyze participant affiliations and relationships.
  """
  def analyze_participant_affiliations(participants) do
    Logger.debug("Analyzing participant affiliations for #{length(participants)} participants")

    # Group participants by various affiliations
    corporations = group_by_corporation_detailed(participants)
    alliances = group_by_alliance_detailed(participants)

    # Analyze relationships between groups
    coalition_data = identify_coalitions_from_participants(participants)
    neutral_parties = identify_neutral_parties(participants)

    # Build comprehensive relationship map
    relationship_map = build_detailed_relationship_map(participants, corporations, alliances)

    %{
      corporations: corporations,
      alliances: alliances,
      coalitions: coalition_data,
      neutral_parties: neutral_parties,
      relationship_map: relationship_map,
      affiliation_stats: calculate_affiliation_statistics(participants),
      dominant_groups: identify_dominant_groups(corporations, alliances)
    }
  end

  @doc """
  Analyze participant combat roles and effectiveness.
  """
  def analyze_participant_roles(participants) do
    Logger.debug("Analyzing participant roles")

    # Filter out NPCs for role analysis
    player_participants = Enum.reject(participants, & &1.is_npc)

    # Detailed role distribution analysis
    role_distribution =
      player_participants
      |> Enum.group_by(& &1.tactical_role)
      |> Enum.map(fn {role, role_participants} ->
        {role,
         %{
           count: length(role_participants),
           participants: role_participants,
           effectiveness: calculate_detailed_role_effectiveness(role_participants),
           key_players: identify_key_players_by_performance(role_participants),
           ship_types: analyze_role_ship_types(role_participants),
           average_damage: calculate_average_damage(role_participants),
           survival_rate: calculate_survival_rate(role_participants)
         }}
      end)
      |> Enum.into(%{})

    # Analyze by ship class as well
    ship_class_distribution = analyze_ship_class_distribution(player_participants)

    %{
      role_distribution: role_distribution,
      ship_class_distribution: ship_class_distribution,
      role_balance: analyze_detailed_role_balance(role_distribution),
      missing_roles: identify_critical_missing_roles(role_distribution, player_participants),
      role_synergies: analyze_detailed_role_synergies(role_distribution),
      fleet_composition_score: calculate_fleet_composition_score(role_distribution),
      tactical_analysis: perform_tactical_analysis(role_distribution, ship_class_distribution)
    }
  end

  @doc """
  Analyze participant experience and skill levels.
  """
  def analyze_participant_experience(participants) do
    Logger.debug("Analyzing participant experience")

    # Filter out NPCs for experience analysis
    player_participants = Enum.reject(participants, & &1.is_npc)

    # Query historical data for experience metrics
    experience_data = fetch_participant_experience_data(player_participants)

    # Calculate detailed experience metrics
    experience_distribution =
      calculate_detailed_experience_distribution(player_participants, experience_data)

    skill_analysis = analyze_detailed_skill_levels(player_participants, experience_data)

    # Identify veterans and rookies based on real data
    veterans = identify_veteran_players_with_data(player_participants, experience_data)
    rookies = identify_rookie_players_with_data(player_participants, experience_data)

    # Calculate experience advantages between sides
    experience_advantage =
      calculate_detailed_experience_advantage(player_participants, experience_data)

    %{
      experience_distribution: experience_distribution,
      skill_levels: skill_analysis,
      veteran_players: veterans,
      rookie_players: rookies,
      experience_advantage: experience_advantage,
      average_character_age:
        calculate_average_character_age(player_participants, experience_data),
      experience_metrics: compile_experience_metrics(experience_data)
    }
  end

  @doc """
  Track participant activity and contribution throughout the battle.
  """
  def track_participant_activity(participants, killmails) do
    Logger.debug(
      "Tracking participant activity for #{length(participants)} participants across #{length(killmails)} killmails"
    )

    # Build lookup maps for efficient processing
    participant_map = build_participant_lookup_map(participants)

    # Process each participant's activity
    participants_with_activity =
      participants
      |> Enum.map(fn participant ->
        activity = analyze_participant_activity(participant, killmails, participant_map)
        Map.put(participant, :activity, activity)
      end)

    # Add battle-wide activity analysis
    battle_timeline = build_battle_timeline(killmails)
    activity_patterns = analyze_activity_patterns(participants_with_activity, battle_timeline)

    %{
      participants: participants_with_activity,
      battle_timeline: battle_timeline,
      activity_patterns: activity_patterns,
      engagement_summary: summarize_engagement_activity(participants_with_activity)
    }
  end

  # Private helper functions
  defp extract_participants_from_killmail(killmail) do
    # Extract detailed victim information from both structured fields and raw_data
    victim_data = get_in(killmail.raw_data, ["victim"]) || %{}

    victim = %{
      character_id: killmail.victim_character_id || victim_data["character_id"],
      character_name:
        get_in(killmail.raw_data, ["victim", "character_name"]) || victim_data["character_name"],
      corporation_id: killmail.victim_corporation_id || victim_data["corporation_id"],
      corporation_name:
        get_in(killmail.raw_data, ["victim", "corporation_name"]) ||
          victim_data["corporation_name"],
      alliance_id: killmail.victim_alliance_id || victim_data["alliance_id"],
      alliance_name:
        get_in(killmail.raw_data, ["victim", "alliance_name"]) || victim_data["alliance_name"],
      ship_type_id: killmail.victim_ship_type_id || victim_data["ship_type_id"],
      ship_name:
        get_ship_name_from_type_id(killmail.victim_ship_type_id || victim_data["ship_type_id"]),
      participant_type: :victim,
      tactical_role:
        determine_tactical_role_by_type_id(
          killmail.victim_ship_type_id || victim_data["ship_type_id"]
        ),
      ship_class:
        classify_ship_by_type_id(killmail.victim_ship_type_id || victim_data["ship_type_id"]),
      damage_taken: victim_data["damage_taken"] || 0,
      killmail_id: killmail.killmail_id,
      killmail_time: killmail.killmail_time,
      solar_system_id: killmail.solar_system_id,
      is_npc: false,
      final_blow: false,
      security_status: victim_data["security_status"] || 0.0
    }

    # Extract detailed attacker information from raw_data JSON
    attackers =
      case get_in(killmail.raw_data, ["attackers"]) do
        nil ->
          []

        [] ->
          []

        attacker_list when is_list(attacker_list) ->
          Enum.map(attacker_list, fn attacker ->
            %{
              character_id: attacker["character_id"],
              character_name: attacker["character_name"],
              corporation_id: attacker["corporation_id"],
              corporation_name: attacker["corporation_name"],
              alliance_id: attacker["alliance_id"],
              alliance_name: attacker["alliance_name"],
              ship_type_id: attacker["ship_type_id"],
              ship_name: get_ship_name_from_type_id(attacker["ship_type_id"]),
              participant_type: :attacker,
              tactical_role: determine_tactical_role_by_type_id(attacker["ship_type_id"]),
              ship_class: classify_ship_by_type_id(attacker["ship_type_id"]),
              weapon_type_id: attacker["weapon_type_id"],
              damage_done: attacker["damage_done"] || 0,
              final_blow: attacker["final_blow"] || false,
              security_status: attacker["security_status"] || 0.0,
              killmail_id: killmail.killmail_id,
              killmail_time: killmail.killmail_time,
              solar_system_id: killmail.solar_system_id,
              is_npc: is_npc_entity(attacker)
            }
          end)
      end

    [victim | attackers]
  end

  defp enrich_participant_data(participant) do
    # For now, return basic enriched participant data
    # TODO: Implement participant data enrichment from external sources

    Map.merge(participant, %{
      experience_level: estimate_experience_level(participant),
      threat_rating: estimate_threat_rating(participant),
      historical_performance: get_historical_performance(participant),
      specializations: identify_specializations(participant),
      activity_patterns: analyze_activity_patterns(participant)
    })
  end

  defp classify_participants_by_side(participants) do
    # Implement sophisticated side classification based on multiple factors
    Logger.debug(
      "Performing sophisticated side classification for #{length(participants)} participants"
    )

    # Analyze engagement patterns to identify sides
    engagement_analysis = analyze_engagement_patterns(participants)

    # Group by traditional attacker/victim roles first
    attackers = Enum.filter(participants, &(&1.participant_type == :attacker))
    victims = Enum.filter(participants, &(&1.participant_type == :victim))

    # Apply sophisticated classification logic
    side_classification =
      perform_advanced_side_classification(attackers, victims, engagement_analysis)

    # Identify neutral parties and third-party participants
    neutrals = identify_sophisticated_neutrals(participants, side_classification)

    # Validate and refine classification
    refined_classification =
      refine_side_classification(side_classification, neutrals, engagement_analysis)

    %{
      side_alpha: refined_classification.side_alpha,
      side_beta: refined_classification.side_beta,
      neutrals: neutrals,
      unclassified: refined_classification.unclassified,
      classification_confidence: refined_classification.confidence,
      engagement_analysis: engagement_analysis,
      side_relationships: analyze_inter_side_relationships(refined_classification)
    }
  end

  defp group_participants_by_affiliation(participants) do
    # For now, return basic affiliation grouping
    # TODO: Implement detailed affiliation grouping

    %{
      by_corporation: Enum.group_by(participants, & &1.corporation_id),
      by_alliance: Enum.group_by(participants, & &1.alliance_id),
      by_coalition: %{},
      unaffiliated: Enum.filter(participants, &is_nil(&1.alliance_id))
    }
  end

  defp group_by_corporation(participants) do
    participants
    |> Enum.group_by(& &1.corporation_id)
    |> Enum.map(fn {corp_id, corp_participants} ->
      {corp_id,
       %{
         name: List.first(corp_participants).corporation_name,
         member_count: length(corp_participants),
         members: corp_participants,
         alliance_id: List.first(corp_participants).alliance_id
       }}
    end)
    |> Enum.into(%{})
  end

  defp group_by_corporation_detailed(participants) do
    participants
    |> Enum.reject(&(&1.is_npc || is_nil(&1.corporation_id)))
    |> Enum.group_by(& &1.corporation_id)
    |> Enum.map(fn {corp_id, corp_participants} ->
      {corp_id,
       %{
         id: corp_id,
         name: List.first(corp_participants).corporation_name || "Unknown Corp",
         member_count: length(corp_participants),
         members: corp_participants,
         alliance_id: List.first(corp_participants).alliance_id,
         alliance_name: List.first(corp_participants).alliance_name,
         roles: analyze_corp_roles(corp_participants),
         total_damage_dealt: Enum.sum(Enum.map(corp_participants, &(&1[:damage_done] || 0))),
         total_damage_taken: Enum.sum(Enum.map(corp_participants, &(&1[:damage_taken] || 0))),
         ships_fielded: Enum.frequencies_by(corp_participants, & &1.ship_type_id),
         participant_types: Enum.frequencies_by(corp_participants, & &1.participant_type)
       }}
    end)
    |> Enum.into(%{})
  end

  defp group_by_alliance(participants) do
    participants
    |> Enum.filter(& &1.alliance_id)
    |> Enum.group_by(& &1.alliance_id)
    |> Enum.map(fn {alliance_id, alliance_participants} ->
      {alliance_id,
       %{
         name: List.first(alliance_participants).alliance_name,
         member_count: length(alliance_participants),
         members: alliance_participants,
         corporations: Enum.uniq_by(alliance_participants, & &1.corporation_id)
       }}
    end)
    |> Enum.into(%{})
  end

  defp group_by_alliance_detailed(participants) do
    participants
    |> Enum.reject(&(&1.is_npc || is_nil(&1.alliance_id)))
    |> Enum.group_by(& &1.alliance_id)
    |> Enum.map(fn {alliance_id, alliance_participants} ->
      corp_breakdown =
        alliance_participants
        |> Enum.group_by(& &1.corporation_id)
        |> Enum.map(fn {corp_id, corp_members} ->
          {corp_id,
           %{
             name: List.first(corp_members).corporation_name,
             member_count: length(corp_members)
           }}
        end)
        |> Enum.into(%{})

      {alliance_id,
       %{
         id: alliance_id,
         name: List.first(alliance_participants).alliance_name || "Unknown Alliance",
         member_count: length(alliance_participants),
         members: alliance_participants,
         corporation_count: map_size(corp_breakdown),
         corporations: corp_breakdown,
         roles: analyze_alliance_roles(alliance_participants),
         total_damage_dealt: Enum.sum(Enum.map(alliance_participants, &(&1[:damage_done] || 0))),
         total_damage_taken: Enum.sum(Enum.map(alliance_participants, &(&1[:damage_taken] || 0))),
         fleet_composition: analyze_fleet_composition(alliance_participants)
       }}
    end)
    |> Enum.into(%{})
  end

  defp identify_coalitions(participants) do
    # Implement sophisticated coalition identification based on multiple factors
    Logger.debug("Identifying coalitions from #{length(participants)} participants")

    # Analyze alliance relationships and engagement patterns
    alliance_engagement_matrix = build_alliance_engagement_matrix(participants)
    alliance_cooperation_matrix = build_alliance_cooperation_matrix(participants)

    # Identify coalition candidates based on mutual support patterns
    coalition_candidates =
      identify_coalition_candidates(alliance_engagement_matrix, alliance_cooperation_matrix)

    # Analyze historical relationships and validate coalitions
    validated_coalitions =
      validate_coalitions_with_historical_data(coalition_candidates, participants)

    # Build relationship strength mapping
    relationship_map =
      build_coalition_relationship_map(validated_coalitions, alliance_engagement_matrix)

    %{
      coalitions: validated_coalitions,
      coalition_count: length(validated_coalitions),
      relationship_strengths: relationship_map,
      largest_coalition: find_largest_coalition(validated_coalitions),
      coalition_coverage: calculate_coalition_coverage(validated_coalitions, participants)
    }
  end

  defp identify_coalitions_from_participants(participants) do
    # Analyze patterns to identify potential coalitions using advanced relationship mapping
    Logger.debug("Analyzing coalition patterns from participant relationships")

    # Build comprehensive alliance relationship data
    alliance_relationships = analyze_alliance_relationships(participants)

    # Group by engagement patterns and mutual support
    sides = Enum.group_by(participants, & &1.participant_type)

    # Advanced coalition analysis for each side
    attacker_coalitions =
      analyze_side_for_advanced_coalitions(sides[:attacker] || [], alliance_relationships)

    victim_coalitions =
      analyze_side_for_advanced_coalitions(sides[:victim] || [], alliance_relationships)

    # Identify cross-coalition conflicts and relationships
    conflict_analysis =
      analyze_cross_coalition_conflicts(
        attacker_coalitions,
        victim_coalitions,
        alliance_relationships
      )

    %{
      attacker_coalitions: attacker_coalitions,
      victim_coalitions: victim_coalitions,
      cross_coalition_conflicts: conflict_analysis,
      alliance_relationships: alliance_relationships,
      coalition_strength_analysis:
        analyze_coalition_strengths(attacker_coalitions, victim_coalitions)
    }
  end


  defp identify_cross_coalition_conflicts(attacker_coalitions, victim_coalitions) do
    # Identify which coalitions are fighting each other
    for attacker <- attacker_coalitions, victim <- victim_coalitions do
      %{
        attacker_coalition: attacker.lead_alliance_name,
        victim_coalition: victim.lead_alliance_name,
        # Would calculate based on numbers/ships
        intensity: :high
      }
    end
  end

  defp calculate_fleet_strength(members) do
    # Simple fleet strength calculation based on ship classes
    ship_points = %{
      frigate: 1,
      destroyer: 2,
      cruiser: 3,
      battlecruiser: 5,
      battleship: 8,
      capital: 20,
      supercapital: 50,
      unknown: 2
    }

    members
    |> Enum.map(&(ship_points[&1.ship_class] || 2))
    |> Enum.sum()
  end

  defp identify_neutral_parties(participants) do
    # Identify participants that don't clearly belong to either side
    # These might be third parties, opportunists, or neutrals

    participants
    |> Enum.filter(fn p ->
      # NPCs are always neutral
      # Solo pilots without alliance might be neutral
      # Check for known neutral entities (would query database in real implementation)
      p.is_npc ||
        (is_nil(p.alliance_id) && !in_major_engagement?(p, participants)) ||
        is_known_neutral_entity?(p)
    end)
    |> Enum.uniq_by(& &1.character_id)
  end

  defp in_major_engagement?(participant, all_participants) do
    # Check if this participant is part of the main engagement
    same_corp = Enum.count(all_participants, &(&1.corporation_id == participant.corporation_id))
    # More than 2 from same corp suggests organized participation
    same_corp > 2
  end

  defp is_known_neutral_entity?(_participant) do
    # In a real implementation, would check against database of known neutral entities
    false
  end


  defp build_detailed_relationship_map(participants, corporations, alliances) do
    # Analyze who shot whom to determine relationships

    # Group by attacker/victim status
    attackers = Enum.filter(participants, &(&1.participant_type == :attacker))
    victims = Enum.filter(participants, &(&1.participant_type == :victim))

    # Build corp-level relationships
    corp_relationships = analyze_corp_relationships(attackers, victims, corporations)

    # Build alliance-level relationships
    alliance_relationships = analyze_alliance_relationships(attackers, victims, alliances)

    %{
      corporation_level: corp_relationships,
      alliance_level: alliance_relationships,
      conflict_summary: summarize_conflicts(corp_relationships, alliance_relationships)
    }
  end

  defp analyze_corp_relationships(attackers, victims, corporations) do
    # Map which corps attacked which
    victim_corps = victims |> Enum.map(& &1.corporation_id) |> Enum.uniq()

    attacker_corps =
      attackers |> Enum.map(& &1.corporation_id) |> Enum.uniq() |> Enum.reject(&is_nil/1)

    %{
      aggressors: attacker_corps,
      defenders: victim_corps,
      neutral: Map.keys(corporations) -- (attacker_corps ++ victim_corps)
    }
  end

  defp analyze_alliance_relationships(attackers, victims, alliances) do
    # Map which alliances attacked which
    victim_alliances =
      victims |> Enum.map(& &1.alliance_id) |> Enum.reject(&is_nil/1) |> Enum.uniq()

    attacker_alliances =
      attackers |> Enum.map(& &1.alliance_id) |> Enum.reject(&is_nil/1) |> Enum.uniq()

    %{
      aggressors: attacker_alliances,
      defenders: victim_alliances,
      neutral: Map.keys(alliances) -- (attacker_alliances ++ victim_alliances)
    }
  end

  defp summarize_conflicts(corp_relationships, alliance_relationships) do
    %{
      total_attacking_corps: length(corp_relationships.aggressors),
      total_defending_corps: length(corp_relationships.defenders),
      total_attacking_alliances: length(alliance_relationships.aggressors),
      total_defending_alliances: length(alliance_relationships.defenders),
      conflict_type: determine_conflict_type(corp_relationships, alliance_relationships)
    }
  end

  defp determine_conflict_type(corp_rel, alliance_rel) do
    cond do
      length(alliance_rel.aggressors) > 2 && length(alliance_rel.defenders) > 2 ->
        :large_fleet_battle

      length(alliance_rel.aggressors) > 1 || length(alliance_rel.defenders) > 1 ->
        :alliance_skirmish

      length(corp_rel.aggressors) > 3 ->
        :corp_gank

      length(corp_rel.aggressors) == 1 && length(corp_rel.defenders) == 1 ->
        :small_gang

      true ->
        :solo_kill
    end
  end

  defp calculate_affiliation_statistics(participants) do
    total = length(participants)
    with_alliance = Enum.count(participants, & &1.alliance_id)
    npcs = Enum.count(participants, & &1.is_npc)

    %{
      total_participants: total,
      alliance_members: with_alliance,
      unaffiliated: total - with_alliance - npcs,
      npc_count: npcs,
      alliance_participation_rate: if(total > 0, do: with_alliance / total * 100, else: 0),
      unique_corporations:
        participants |> Enum.map(& &1.corporation_id) |> Enum.uniq() |> length(),
      unique_alliances:
        participants
        |> Enum.map(& &1.alliance_id)
        |> Enum.reject(&is_nil/1)
        |> Enum.uniq()
        |> length()
    }
  end

  defp identify_dominant_groups(corporations, alliances) do
    # Find the most represented groups
    top_corps =
      corporations
      |> Enum.sort_by(fn {_id, data} -> -data.member_count end)
      |> Enum.take(3)
      |> Enum.map(fn {id, data} -> %{id: id, name: data.name, count: data.member_count} end)

    top_alliances =
      alliances
      |> Enum.sort_by(fn {_id, data} -> -data.member_count end)
      |> Enum.take(3)
      |> Enum.map(fn {id, data} -> %{id: id, name: data.name, count: data.member_count} end)

    %{
      top_corporations: top_corps,
      top_alliances: top_alliances
    }
  end

  defp analyze_corp_roles(corp_participants) do
    corp_participants
    |> Enum.map(& &1.tactical_role)
    |> Enum.frequencies()
  end

  defp analyze_alliance_roles(alliance_participants) do
    alliance_participants
    |> Enum.map(& &1.tactical_role)
    |> Enum.frequencies()
  end

  defp analyze_fleet_composition(participants) do
    %{
      ship_classes: Enum.frequencies_by(participants, & &1.ship_class),
      tactical_roles: Enum.frequencies_by(participants, & &1.tactical_role),
      average_ship_size: calculate_average_ship_size(participants)
    }
  end

  defp calculate_average_ship_size(participants) do
    ship_sizes = %{
      frigate: 1,
      destroyer: 2,
      cruiser: 3,
      battlecruiser: 4,
      battleship: 5,
      capital: 6,
      supercapital: 7
    }

    sizes = Enum.map(participants, &(ship_sizes[&1.ship_class] || 3))
    if length(sizes) > 0, do: Enum.sum(sizes) / length(sizes), else: 0
  end

  defp calculate_role_effectiveness(role_participants) do
    # Comprehensive role effectiveness calculation based on actual performance data
    Logger.debug("Calculating role effectiveness for #{length(role_participants)} participants")

    if length(role_participants) == 0 do
      0.0
    else
      # Group participants by tactical role for role-specific analysis
      role_groups = Enum.group_by(role_participants, &determine_participant_tactical_role/1)

      # Calculate effectiveness for each role type
      role_effectiveness_scores =
        Enum.map(role_groups, fn {role, participants} ->
          effectiveness_score = calculate_role_specific_effectiveness(role, participants)
          participant_weight = length(participants) / length(role_participants)

          {role, effectiveness_score, participant_weight}
        end)

      # Calculate weighted average effectiveness
      total_weighted_score =
        role_effectiveness_scores
        |> Enum.map(fn {_role, score, weight} -> score * weight end)
        |> Enum.sum()

      # Include role diversity bonus
      diversity_bonus = calculate_role_diversity_bonus(role_groups)

      # Final effectiveness score with diversity consideration
      base_effectiveness = min(total_weighted_score, 1.0)
      final_effectiveness = min(base_effectiveness + diversity_bonus, 1.0)

      final_effectiveness
    end
  end

  defp calculate_detailed_role_effectiveness(role_participants) do
    # Calculate effectiveness based on multiple factors
    damage_dealt = Enum.sum(Enum.map(role_participants, &(&1[:damage_done] || 0)))
    damage_taken = Enum.sum(Enum.map(role_participants, &(&1[:damage_taken] || 0)))
    survival_count = Enum.count(role_participants, &(&1.participant_type == :attacker))
    total_count = length(role_participants)

    # Basic effectiveness formula
    damage_ratio = if damage_taken > 0, do: damage_dealt / damage_taken, else: damage_dealt
    survival_ratio = if total_count > 0, do: survival_count / total_count, else: 0

    # Weighted average
    (damage_ratio * 0.6 + survival_ratio * 0.4) / 2
  end

  defp identify_key_players(role_participants) do
    # Comprehensive key player identification across multiple dimensions
    Logger.debug("Identifying key players from #{length(role_participants)} participants")

    if length(role_participants) == 0 do
      []
    else
      # Multi-dimensional key player analysis
      performance_leaders = identify_performance_leaders(role_participants)
      tactical_leaders = identify_tactical_leaders(role_participants)
      influence_leaders = identify_influence_leaders(role_participants)
      specialist_leaders = identify_specialist_leaders(role_participants)

      # Combine and rank all key players
      all_key_players =
        [
          performance_leaders,
          tactical_leaders,
          influence_leaders,
          specialist_leaders
        ]
        |> List.flatten()
        |> Enum.uniq_by(& &1.character_id)
        |> Enum.sort_by(& &1.overall_key_player_score, :desc)
        # Top 10 key players
        |> Enum.take(10)

      # Add key player categories and final rankings
      all_key_players
      |> Enum.with_index(1)
      |> Enum.map(fn {player, rank} ->
        Map.put(player, :key_player_rank, rank)
      end)
    end
  end

  defp identify_key_players_by_performance(role_participants) do
    # Sort by performance metrics and identify top performers
    role_participants
    |> Enum.map(fn p ->
      score = calculate_participant_score(p)
      {p, score}
    end)
    |> Enum.sort_by(fn {_p, score} -> -score end)
    |> Enum.take(5)
    |> Enum.map(fn {p, score} ->
      %{
        character_id: p.character_id,
        character_name: p.character_name,
        ship_name: p.ship_name,
        damage_dealt: p[:damage_done] || 0,
        final_blow: p[:final_blow] || false,
        performance_score: score
      }
    end)
  end

  defp calculate_participant_score(participant) do
    # Score based on damage, final blow, and survival
    # Normalize damage
    damage_score = (participant[:damage_done] || 0) / 1000
    final_blow_bonus = if participant[:final_blow], do: 50, else: 0
    survival_bonus = if participant.participant_type == :attacker, do: 25, else: 0

    damage_score + final_blow_bonus + survival_bonus
  end

  defp analyze_role_ship_types(role_participants) do
    # Analyze which ship types are used in this role
    role_participants
    |> Enum.group_by(& &1.ship_type_id)
    |> Enum.map(fn {ship_type_id, ships} ->
      ship_name = List.first(ships).ship_name

      {ship_type_id,
       %{
         name: ship_name,
         count: length(ships),
         percentage: length(ships) / length(role_participants) * 100
       }}
    end)
    |> Enum.sort_by(fn {_id, data} -> -data.count end)
    |> Enum.into(%{})
  end

  defp calculate_average_damage(role_participants) do
    damages = Enum.map(role_participants, &(&1[:damage_done] || 0))

    if length(damages) > 0 do
      Enum.sum(damages) / length(damages)
    else
      0
    end
  end

  defp calculate_survival_rate(role_participants) do
    survivors = Enum.count(role_participants, &(&1.participant_type == :attacker))
    total = length(role_participants)

    if total > 0, do: survivors / total * 100, else: 0
  end

  defp analyze_ship_class_distribution(participants) do
    participants
    |> Enum.group_by(& &1.ship_class)
    |> Enum.map(fn {ship_class, class_participants} ->
      {ship_class,
       %{
         count: length(class_participants),
         percentage: length(class_participants) / length(participants) * 100,
         roles: Enum.frequencies_by(class_participants, & &1.tactical_role),
         average_damage: calculate_average_damage(class_participants)
       }}
    end)
    |> Enum.sort_by(fn {_class, data} -> -data.count end)
    |> Enum.into(%{})
  end


  defp analyze_detailed_role_balance(role_distribution) do
    # Analyze the balance of roles in the fleet
    total_participants =
      role_distribution
      |> Map.values()
      |> Enum.map(& &1.count)
      |> Enum.sum()

    # Calculate role percentages
    role_percentages =
      role_distribution
      |> Enum.map(fn {role, data} ->
        {role, data.count / total_participants * 100}
      end)
      |> Enum.into(%{})

    # Identify imbalances
    imbalances = identify_role_imbalances(role_percentages)

    # Calculate balance score
    balance_score = calculate_balance_score(role_percentages)

    %{
      balance_score: balance_score,
      role_percentages: role_percentages,
      imbalances: imbalances,
      recommendations: generate_role_recommendations(imbalances, role_distribution)
    }
  end

  defp identify_role_imbalances(role_percentages) do
    # Ideal role percentages for a balanced fleet
    ideal_percentages = %{
      # 40-60% DPS
      dps: {40, 60},
      # 10-20% Logistics
      logistics: {10, 20},
      # 10-20% Tackle
      tackle: {10, 20},
      # 5-15% EWAR
      ewar: {5, 15},
      # 2-10% Command
      command: {2, 10}
    }

    Enum.reduce(ideal_percentages, [], fn {role, {min, max}}, acc ->
      actual = Map.get(role_percentages, role, 0)

      cond do
        actual < min ->
          [{role, :understaffed, actual, {min, max}} | acc]

        actual > max ->
          [{role, :overstaffed, actual, {min, max}} | acc]

        true ->
          acc
      end
    end)
  end

  defp calculate_balance_score(role_percentages) do
    # Score based on how close we are to ideal percentages
    ideal_dps = 50
    ideal_logistics = 15
    ideal_tackle = 15

    dps_diff = abs(Map.get(role_percentages, :dps, 0) - ideal_dps)
    logi_diff = abs(Map.get(role_percentages, :logistics, 0) - ideal_logistics)
    tackle_diff = abs(Map.get(role_percentages, :tackle, 0) - ideal_tackle)

    # Convert differences to a 0-1 score
    max(0, 1 - (dps_diff + logi_diff + tackle_diff) / 100)
  end

  defp generate_role_recommendations(imbalances, _role_distribution) do
    Enum.map(imbalances, fn {role, status, actual, {min, max}} ->
      case status do
        :understaffed ->
          "Need more #{role} pilots (current: #{Float.round(actual, 1)}%, ideal: #{min}-#{max}%)"

        :overstaffed ->
          "Too many #{role} pilots (current: #{Float.round(actual, 1)}%, ideal: #{min}-#{max}%)"
      end
    end)
  end

  defp identify_missing_roles(role_distribution) do
    # Keep basic implementation for backward compatibility
    expected_roles = [:dps, :logistics, :tackle, :ewar, :command]
    present_roles = Map.keys(role_distribution)

    expected_roles -- present_roles
  end

  defp identify_critical_missing_roles(role_distribution, participants) do
    # Identify which critical roles are missing based on fleet size
    fleet_size = length(participants)
    present_roles = Map.keys(role_distribution)

    critical_roles =
      cond do
        fleet_size >= 50 ->
          # Large fleet needs all roles
          [:dps, :logistics, :tackle, :ewar, :command, :interdiction]

        fleet_size >= 20 ->
          # Medium fleet needs core roles
          [:dps, :logistics, :tackle, :command]

        fleet_size >= 10 ->
          # Small gang needs basics
          [:dps, :tackle, :logistics]

        true ->
          # Very small gang
          [:dps]
      end

    missing = critical_roles -- present_roles

    Enum.map(missing, fn role ->
      %{
        role: role,
        criticality: determine_role_criticality(role, fleet_size),
        recommendation: suggest_role_addition(role)
      }
    end)
  end

  defp determine_role_criticality(role, fleet_size) do
    case role do
      :logistics when fleet_size >= 10 -> :critical
      :tackle when fleet_size >= 5 -> :critical
      :command when fleet_size >= 20 -> :high
      :ewar when fleet_size >= 15 -> :medium
      _ -> :low
    end
  end

  defp suggest_role_addition(role) do
    case role do
      :logistics -> "Add logistics ships for fleet sustainability"
      :tackle -> "Add fast tackle to prevent enemy escape"
      :command -> "Add command ships for fleet bonuses"
      :ewar -> "Add EWAR ships for enemy disruption"
      :interdiction -> "Add interdictors for bubble control"
      _ -> "Consider adding #{role} ships"
    end
  end


  defp analyze_detailed_role_synergies(role_distribution) do
    # Analyze how well roles work together
    present_roles = Map.keys(role_distribution)

    # Check for effective combinations
    effective_combos = check_effective_combinations(present_roles, role_distribution)
    missing_synergies = identify_missing_synergies(present_roles)

    synergy_score = calculate_synergy_score(effective_combos, missing_synergies)

    %{
      synergy_score: synergy_score,
      effective_combinations: effective_combos,
      missing_synergies: missing_synergies,
      synergy_bonuses: calculate_synergy_bonuses(effective_combos)
    }
  end

  defp check_effective_combinations(present_roles, role_distribution) do
    combinations = []

    # Check for classic effective combinations
    combinations =
      if :tackle in present_roles and :dps in present_roles do
        [{:tackle_dps, "Tackle + DPS for kill securing"} | combinations]
      else
        combinations
      end

    combinations =
      if :ewar in present_roles and :logistics in present_roles do
        [{:ewar_logi, "EWAR + Logistics for enemy disruption and fleet sustain"} | combinations]
      else
        combinations
      end

    combinations =
      if :command in present_roles and :dps in present_roles do
        [{:command_dps, "Command + DPS for damage amplification"} | combinations]
      else
        combinations
      end

    # Check for shield/armor logistics coordination
    if Map.has_key?(role_distribution, :logistics) and role_distribution.logistics.count >= 3 do
      [{:logi_wing, "Strong logistics wing for fleet sustainability"} | combinations]
    else
      combinations
    end
  end

  defp identify_missing_synergies(present_roles) do
    synergies = []

    # Check for missing synergistic combinations
    synergies =
      if :dps in present_roles and :tackle not in present_roles do
        ["Missing tackle to secure kills" | synergies]
      else
        synergies
      end

    synergies =
      if :logistics in present_roles and :command not in present_roles do
        ["Missing command ships to boost logistics effectiveness" | synergies]
      else
        synergies
      end

    synergies
  end

  defp calculate_synergy_score(effective_combos, missing_synergies) do
    # Base score starts at 0.5
    score = 0.5

    # Add points for effective combinations
    score = score + length(effective_combos) * 0.1

    # Subtract points for missing synergies
    score = score - length(missing_synergies) * 0.05

    # Clamp between 0 and 1
    max(0, min(1, score))
  end

  defp calculate_synergy_bonuses(effective_combos) do
    Enum.map(effective_combos, fn {combo_type, _desc} ->
      case combo_type do
        :tackle_dps -> %{type: :tackle_dps, bonus: "15% increased kill probability"}
        :ewar_logi -> %{type: :ewar_logi, bonus: "20% improved fleet survivability"}
        :command_dps -> %{type: :command_dps, bonus: "10% damage increase"}
        :logi_wing -> %{type: :logi_wing, bonus: "25% reduced losses"}
        _ -> %{type: combo_type, bonus: "Tactical advantage"}
      end
    end)
  end

  defp calculate_fleet_composition_score(role_distribution) do
    # Score the overall fleet composition
    role_count = map_size(role_distribution)

    total_pilots =
      role_distribution
      |> Map.values()
      |> Enum.map(& &1.count)
      |> Enum.sum()

    # Factors for scoring
    # Max diversity at 5 roles
    diversity_score = min(1, role_count / 5)
    # Optimal at 50+ pilots
    size_score = min(1, total_pilots / 50)

    # Check for critical roles
    has_logi = Map.has_key?(role_distribution, :logistics)
    has_tackle = Map.has_key?(role_distribution, :tackle)

    critical_score =
      case {has_logi, has_tackle} do
        {true, true} -> 1.0
        {true, false} -> 0.7
        {false, true} -> 0.7
        {false, false} -> 0.4
      end

    # Weighted average
    diversity_score * 0.3 + size_score * 0.3 + critical_score * 0.4
  end

  defp perform_tactical_analysis(role_distribution, ship_class_distribution) do
    # Analyze tactical capabilities based on composition
    %{
      engagement_range: analyze_engagement_range(ship_class_distribution),
      mobility_rating: calculate_mobility_rating(ship_class_distribution),
      firepower_rating: calculate_firepower_rating(role_distribution, ship_class_distribution),
      sustainability_rating: calculate_sustainability_rating(role_distribution),
      tactical_flexibility:
        assess_tactical_flexibility(role_distribution, ship_class_distribution)
    }
  end

  defp analyze_engagement_range(ship_class_distribution) do
    # Determine optimal engagement range based on ship classes
    weights = %{
      frigate: {0, 20},
      destroyer: {10, 30},
      cruiser: {20, 50},
      battlecruiser: {30, 70},
      battleship: {50, 100},
      capital: {100, 200}
    }

    {total_weight, weighted_range} =
      Enum.reduce(ship_class_distribution, {0, 0}, fn {class, data}, {tw, wr} ->
        case weights[class] do
          nil ->
            {tw, wr}

          {min, max} ->
            avg_range = (min + max) / 2
            weight = data.count
            {tw + weight, wr + avg_range * weight}
        end
      end)

    optimal_range = if total_weight > 0, do: weighted_range / total_weight, else: 30

    %{
      optimal_km: Float.round(optimal_range, 1),
      classification: classify_range(optimal_range)
    }
  end

  defp classify_range(range) do
    cond do
      range < 20 -> :brawling
      range < 50 -> :close_range
      range < 80 -> :medium_range
      true -> :long_range
    end
  end

  defp calculate_mobility_rating(ship_class_distribution) do
    # Rate fleet mobility based on ship composition
    mobility_scores = %{
      frigate: 1.0,
      destroyer: 0.9,
      cruiser: 0.7,
      battlecruiser: 0.5,
      battleship: 0.3,
      capital: 0.1,
      supercapital: 0.05
    }

    {total_count, total_score} =
      Enum.reduce(ship_class_distribution, {0, 0}, fn {class, data}, {tc, ts} ->
        case mobility_scores[class] do
          nil -> {tc, ts}
          score -> {tc + data.count, ts + score * data.count}
        end
      end)

    if total_count > 0, do: total_score / total_count, else: 0.5
  end

  defp calculate_firepower_rating(role_distribution, ship_class_distribution) do
    # Estimate fleet firepower
    dps_count = get_in(role_distribution, [:dps, :count]) || 0

    total_ships =
      ship_class_distribution
      |> Map.values()
      |> Enum.map(& &1.count)
      |> Enum.sum()

    # Factor in ship sizes for firepower
    size_multiplier =
      ship_class_distribution
      |> Enum.map(fn {class, data} ->
        multiplier =
          case class do
            :frigate -> 1
            :destroyer -> 2
            :cruiser -> 3
            :battlecruiser -> 5
            :battleship -> 8
            :capital -> 20
            :supercapital -> 50
            _ -> 1
          end

        multiplier * data.count
      end)
      |> Enum.sum()

    base_firepower = size_multiplier / max(total_ships, 1)
    dps_ratio = dps_count / max(total_ships, 1)

    base_firepower * (0.5 + dps_ratio * 0.5)
  end

  defp calculate_sustainability_rating(role_distribution) do
    # Rate fleet's ability to sustain in combat
    logi_count = get_in(role_distribution, [:logistics, :count]) || 0
    command_count = get_in(role_distribution, [:command, :count]) || 0

    total_count =
      role_distribution
      |> Map.values()
      |> Enum.map(& &1.count)
      |> Enum.sum()

    logi_ratio = logi_count / max(total_count, 1)
    command_bonus = if command_count > 0, do: 0.1, else: 0

    # Ideal logi ratio is around 15-20%
    if logi_ratio > 0.3 do
      # Too much logi, diminishing returns
      0.8
    else
      min(1.0, logi_ratio * 5 + command_bonus)
    end
  end

  defp assess_tactical_flexibility(role_distribution, ship_class_distribution) do
    # Assess how flexible the fleet is tactically
    # Out of 6 main roles
    role_diversity = map_size(role_distribution) / 6

    # Check for key flexible elements
    has_recons = Map.has_key?(role_distribution, :ewar)
    has_command = Map.has_key?(role_distribution, :command)

    has_fast_tackle =
      (get_in(ship_class_distribution, [:frigate, :count]) || 0) +
        (get_in(ship_class_distribution, [:destroyer, :count]) || 0) > 0

    flexibility_score = role_diversity * 0.5
    flexibility_score = if has_recons, do: flexibility_score + 0.2, else: flexibility_score
    flexibility_score = if has_command, do: flexibility_score + 0.15, else: flexibility_score
    flexibility_score = if has_fast_tackle, do: flexibility_score + 0.15, else: flexibility_score

    %{
      score: min(1.0, flexibility_score),
      can_disengage: has_fast_tackle,
      can_adapt_range: has_recons or has_command,
      tactical_options: count_tactical_options(role_distribution)
    }
  end

  defp count_tactical_options(role_distribution) do
    options = []

    options =
      if Map.has_key?(role_distribution, :tackle), do: ["Pursuit" | options], else: options

    options =
      if Map.has_key?(role_distribution, :ewar), do: ["Disruption" | options], else: options

    options =
      if Map.has_key?(role_distribution, :logistics),
        do: ["Sustained engagement" | options],
        else: options

    options =
      if Map.has_key?(role_distribution, :interdiction),
        do: ["Area denial" | options],
        else: options

    options =
      if Map.has_key?(role_distribution, :bomber), do: ["Hit and run" | options], else: options

    options
  end

  defp calculate_experience_distribution(participants) do
    # Comprehensive experience distribution analysis based on historical performance
    Logger.debug("Calculating experience distribution for #{length(participants)} participants")
    
    if length(participants) == 0 do
      %{
        veteran: 0,
        experienced: 0,
        intermediate: 0,
        novice: 0,  
        unclassified: 0,
        experience_statistics: %{},
        distribution_analysis: %{}
      }
    else
      # Query historical data for experience classification
      experience_data = fetch_historical_experience_data(participants)
      
      # Classify participants by experience level
      classified_participants = classify_participants_by_experience(participants, experience_data)
      
      # Calculate distribution counts
      distribution_counts = calculate_experience_distribution_counts(classified_participants)
      
      # Calculate experience statistics
      experience_statistics = calculate_experience_statistics(classified_participants, experience_data)
      
      # Analyze distribution patterns
      distribution_analysis = analyze_experience_distribution_patterns(classified_participants)
      
      %{
        veteran: distribution_counts.veteran,
        experienced: distribution_counts.experienced,
        intermediate: distribution_counts.intermediate,
        novice: distribution_counts.novice,
        unclassified: distribution_counts.unclassified,
        experience_statistics: experience_statistics,
        distribution_analysis: distribution_analysis,
        experience_breakdown: create_detailed_experience_breakdown(classified_participants),
        fleet_experience_level: determine_fleet_experience_level(distribution_counts),
        side_comparison: analyze_experience_by_side(classified_participants)
      }
    end
  end

  defp fetch_participant_experience_data(participants) do
    # Query historical killmail data for each participant
    # In a real implementation, this would batch query the database

    character_ids =
      participants
      |> Enum.map(& &1.character_id)
      |> Enum.reject(&is_nil/1)
      |> Enum.uniq()

    # Query for killmail history
    case query_character_killmail_history(character_ids) do
      {:ok, history_data} ->
        # Map history data to participants
        Enum.map(participants, fn p ->
          char_history = Map.get(history_data, p.character_id, %{})

          {p.character_id,
           %{
             total_kills: Map.get(char_history, :kills, 0),
             total_deaths: Map.get(char_history, :deaths, 0),
             first_seen: Map.get(char_history, :first_seen, DateTime.utc_now()),
             last_seen: Map.get(char_history, :last_seen, DateTime.utc_now()),
             kill_death_ratio: calculate_kd_ratio(char_history),
             isk_efficiency: Map.get(char_history, :isk_efficiency, 0.5),
             activity_level: Map.get(char_history, :activity_level, :unknown)
           }}
        end)
        |> Enum.into(%{})

      {:error, _reason} ->
        # Return empty data if query fails
        %{}
    end
  end

  defp query_character_killmail_history(character_ids) when length(character_ids) > 0 do
    # Query the database for character killmail history
    query = """
    WITH character_stats AS (
      SELECT 
        character_id,
        SUM(kills) as total_kills,
        SUM(deaths) as total_deaths,
        MIN(first_seen) as first_seen,
        MAX(last_seen) as last_seen,
        AVG(isk_efficiency) as avg_isk_efficiency
      FROM (
        -- Kills as attacker
        SELECT 
          (a->>'character_id')::bigint as character_id,
          COUNT(*) as kills,
          0 as deaths,
          MIN(k.killmail_time) as first_seen,
          MAX(k.killmail_time) as last_seen,
          COALESCE(SUM((k.raw_data->'zkb'->>'totalValue')::numeric), 0) as isk_destroyed,
          0 as isk_lost,
          CASE 
            WHEN SUM((k.raw_data->'zkb'->>'totalValue')::numeric) > 0 
            THEN 1.0 
            ELSE 0.5 
          END as isk_efficiency
        FROM killmails_raw k,
             jsonb_array_elements(k.raw_data->'attackers') as a
        WHERE (a->>'character_id')::bigint = ANY($1::bigint[])
        GROUP BY (a->>'character_id')::bigint
        
        UNION ALL
        
        -- Deaths as victim
        SELECT
          k.victim_character_id as character_id,
          0 as kills,
          COUNT(*) as deaths,
          MIN(k.killmail_time) as first_seen,
          MAX(k.killmail_time) as last_seen,
          0 as isk_destroyed,
          COALESCE(SUM((k.raw_data->'zkb'->>'totalValue')::numeric), 0) as isk_lost,
          CASE 
            WHEN SUM((k.raw_data->'zkb'->>'totalValue')::numeric) > 0 
            THEN 0.0 
            ELSE 0.5 
          END as isk_efficiency
        FROM killmails_raw k
        WHERE k.victim_character_id = ANY($1::bigint[])
        GROUP BY k.victim_character_id
      ) combined_stats
      GROUP BY character_id
    )
    SELECT 
      character_id,
      total_kills,
      total_deaths,
      first_seen,
      last_seen,
      avg_isk_efficiency,
      CASE
        WHEN last_seen > CURRENT_TIMESTAMP - INTERVAL '7 days' THEN 'very_active'
        WHEN last_seen > CURRENT_TIMESTAMP - INTERVAL '30 days' THEN 'active'
        WHEN last_seen > CURRENT_TIMESTAMP - INTERVAL '90 days' THEN 'semi_active'
        ELSE 'inactive'
      END as activity_level
    FROM character_stats
    """

    case EveDmv.Repo.query(query, [character_ids]) do
      {:ok, %{rows: rows}} ->
        history_map =
          rows
          |> Enum.map(fn [char_id, kills, deaths, first_seen, last_seen, isk_eff, activity] ->
            {char_id,
             %{
               kills: kills || 0,
               deaths: deaths || 0,
               first_seen: first_seen,
               last_seen: last_seen,
               isk_efficiency: Float.round(isk_eff || 0.5, 2),
               activity_level: String.to_atom(activity)
             }}
          end)
          |> Enum.into(%{})

        {:ok, history_map}

      {:error, reason} ->
        Logger.error("Failed to query character history: #{inspect(reason)}")
        {:error, reason}
    end
  end

  defp query_character_killmail_history([]), do: {:ok, %{}}

  defp calculate_kd_ratio(%{kills: kills, deaths: deaths}) when deaths > 0 do
    Float.round(kills / deaths, 2)
  end

  defp calculate_kd_ratio(%{kills: kills}) when kills > 0, do: kills
  defp calculate_kd_ratio(_), do: 0.0

  defp calculate_detailed_experience_distribution(participants, experience_data) do
    # Categorize participants by their experience metrics
    categorized =
      participants
      |> Enum.map(fn p ->
        exp_data = Map.get(experience_data, p.character_id, %{})
        category = categorize_experience_level(exp_data)
        {p, category, exp_data}
      end)

    # Count distribution
    distribution = Enum.frequencies_by(categorized, fn {_p, cat, _} -> cat end)

    # Get detailed breakdowns
    %{
      distribution: %{
        veteran: Map.get(distribution, :veteran, 0),
        experienced: Map.get(distribution, :experienced, 0),
        intermediate: Map.get(distribution, :intermediate, 0),
        novice: Map.get(distribution, :novice, 0),
        unknown: Map.get(distribution, :unknown, 0)
      },
      total_participants: length(participants),
      by_side: calculate_experience_by_side(categorized),
      detailed_breakdown: create_experience_breakdown(categorized)
    }
  end

  defp categorize_experience_level(exp_data) do
    kills = Map.get(exp_data, :kills, 0)
    deaths = Map.get(exp_data, :deaths, 0)
    total_engagements = kills + deaths
    kd_ratio = calculate_kd_ratio(exp_data)

    cond do
      total_engagements >= 1000 and kd_ratio >= 2.0 -> :veteran
      total_engagements >= 500 or (total_engagements >= 200 and kd_ratio >= 1.5) -> :experienced
      total_engagements >= 100 or (total_engagements >= 50 and kd_ratio >= 1.0) -> :intermediate
      total_engagements > 0 -> :novice
      true -> :unknown
    end
  end

  defp calculate_experience_by_side(categorized) do
    categorized
    |> Enum.group_by(fn {p, _cat, _} -> p.participant_type end)
    |> Enum.map(fn {side, side_data} ->
      distribution = Enum.frequencies_by(side_data, fn {_p, cat, _} -> cat end)
      {side, distribution}
    end)
    |> Enum.into(%{})
  end

  defp create_experience_breakdown(categorized) do
    categorized
    |> Enum.group_by(fn {_p, cat, _} -> cat end)
    |> Enum.map(fn {category, cat_participants} ->
      participants_info =
        cat_participants
        |> Enum.map(fn {p, _cat, exp_data} ->
          %{
            character_id: p.character_id,
            character_name: p.character_name,
            kills: Map.get(exp_data, :kills, 0),
            deaths: Map.get(exp_data, :deaths, 0),
            kd_ratio: calculate_kd_ratio(exp_data),
            isk_efficiency: Map.get(exp_data, :isk_efficiency, 0)
          }
        end)
        |> Enum.sort_by(& &1.kd_ratio, :desc)
        # Top 10 per category
        |> Enum.take(10)

      {category, participants_info}
    end)
    |> Enum.into(%{})
  end


  defp analyze_detailed_skill_levels(participants, experience_data) do
    # Analyze skill levels based on performance metrics
    skill_scores =
      participants
      |> Enum.map(fn p ->
        exp_data = Map.get(experience_data, p.character_id, %{})
        score = calculate_skill_score(exp_data, p)
        {p, score}
      end)

    # Calculate distributions
    total_score = Enum.sum(Enum.map(skill_scores, fn {_p, score} -> score end))
    avg_score = if length(skill_scores) > 0, do: total_score / length(skill_scores), else: 0.5

    # Categorize skill levels
    skill_distribution =
      skill_scores
      |> Enum.map(fn {_p, score} ->
        cond do
          score >= 0.8 -> :elite
          score >= 0.6 -> :high
          score >= 0.4 -> :medium
          score >= 0.2 -> :low
          true -> :minimal
        end
      end)
      |> Enum.frequencies()

    %{
      average_skill: Float.round(avg_score, 2),
      skill_distribution: skill_distribution,
      skill_advantages: analyze_skill_advantages(skill_scores),
      top_skilled_pilots: identify_top_skilled(skill_scores, 5),
      skill_gap_analysis: analyze_skill_gaps(skill_scores)
    }
  end

  defp calculate_skill_score(exp_data, participant) do
    # Calculate a skill score based on multiple factors
    kd_ratio = calculate_kd_ratio(exp_data)
    isk_efficiency = Map.get(exp_data, :isk_efficiency, 0.5)
    total_engagements = Map.get(exp_data, :kills, 0) + Map.get(exp_data, :deaths, 0)

    # Weight factors
    # Max out at 3.0 K/D
    kd_weight = min(1.0, kd_ratio / 3.0) * 0.4
    isk_weight = isk_efficiency * 0.3
    experience_weight = min(1.0, total_engagements / 1000) * 0.2
    ship_weight = calculate_ship_complexity_score(participant.ship_class) * 0.1

    kd_weight + isk_weight + experience_weight + ship_weight
  end

  defp calculate_ship_complexity_score(ship_class) do
    # Ships that require more skill to fly effectively
    case ship_class do
      # High skill ceiling
      :frigate -> 0.7
      :destroyer -> 0.6
      :cruiser -> 0.5
      :battlecruiser -> 0.4
      :battleship -> 0.3
      # Requires different skills
      :capital -> 0.6
      :supercapital -> 0.5
      _ -> 0.4
    end
  end

  defp analyze_skill_advantages(skill_scores) do
    # Group by participant type to see skill advantages
    by_side =
      skill_scores
      |> Enum.group_by(fn {p, _score} -> p.participant_type end)
      |> Enum.map(fn {side, side_scores} ->
        scores = Enum.map(side_scores, fn {_p, score} -> score end)
        avg = if length(scores) > 0, do: Enum.sum(scores) / length(scores), else: 0
        {side, Float.round(avg, 2)}
      end)
      |> Enum.into(%{})

    attacker_avg = Map.get(by_side, :attacker, 0)
    victim_avg = Map.get(by_side, :victim, 0)

    %{
      attacker_average: attacker_avg,
      victim_average: victim_avg,
      advantage: Float.round(attacker_avg - victim_avg, 2),
      assessment: assess_skill_advantage(attacker_avg - victim_avg)
    }
  end

  defp assess_skill_advantage(diff) do
    cond do
      diff > 0.3 -> "Significant attacker skill advantage"
      diff > 0.1 -> "Moderate attacker skill advantage"
      diff > -0.1 -> "Relatively balanced skill levels"
      diff > -0.3 -> "Moderate defender skill advantage"
      true -> "Significant defender skill advantage"
    end
  end

  defp identify_top_skilled(skill_scores, count) do
    skill_scores
    |> Enum.sort_by(fn {_p, score} -> -score end)
    |> Enum.take(count)
    |> Enum.map(fn {p, score} ->
      %{
        character_id: p.character_id,
        character_name: p.character_name,
        ship_name: p.ship_name,
        skill_score: Float.round(score, 2),
        role: p.tactical_role
      }
    end)
  end

  defp analyze_skill_gaps(skill_scores) do
    scores = Enum.map(skill_scores, fn {_p, score} -> score end)

    if length(scores) > 0 do
      max_score = Enum.max(scores)
      min_score = Enum.min(scores)

      %{
        highest_skill: Float.round(max_score, 2),
        lowest_skill: Float.round(min_score, 2),
        skill_gap: Float.round(max_score - min_score, 2),
        variance: calculate_variance(scores)
      }
    else
      %{highest_skill: 0, lowest_skill: 0, skill_gap: 0, variance: 0}
    end
  end

  defp calculate_variance(scores) when length(scores) > 0 do
    mean = Enum.sum(scores) / length(scores)
    variance = Enum.sum(Enum.map(scores, fn x -> :math.pow(x - mean, 2) end)) / length(scores)
    Float.round(:math.sqrt(variance), 3)
  end

  defp calculate_variance(_), do: 0

  defp identify_veteran_players(participants) do
    # Keep basic implementation for backward compatibility
    Enum.take(participants, div(length(participants), 4))
  end

  defp identify_veteran_players_with_data(participants, experience_data) do
    participants
    |> Enum.map(fn p ->
      exp_data = Map.get(experience_data, p.character_id, %{})
      {p, exp_data, categorize_experience_level(exp_data)}
    end)
    |> Enum.filter(fn {_p, _data, category} -> category == :veteran end)
    |> Enum.sort_by(fn {_p, data, _cat} ->
      -(Map.get(data, :kills, 0) + Map.get(data, :deaths, 0))
    end)
    |> Enum.map(fn {p, data, _cat} ->
      %{
        character_id: p.character_id,
        character_name: p.character_name,
        corporation_name: p.corporation_name,
        alliance_name: p.alliance_name,
        ship_name: p.ship_name,
        total_kills: Map.get(data, :kills, 0),
        total_deaths: Map.get(data, :deaths, 0),
        kd_ratio: calculate_kd_ratio(data),
        isk_efficiency: Map.get(data, :isk_efficiency, 0),
        first_seen: Map.get(data, :first_seen),
        activity_level: Map.get(data, :activity_level, :unknown)
      }
    end)
  end

  defp identify_rookie_players(participants) do
    # Keep basic implementation for backward compatibility
    Enum.take(participants, -div(length(participants), 4))
  end

  defp identify_rookie_players_with_data(participants, experience_data) do
    participants
    |> Enum.map(fn p ->
      exp_data = Map.get(experience_data, p.character_id, %{})
      {p, exp_data, categorize_experience_level(exp_data)}
    end)
    |> Enum.filter(fn {_p, _data, category} -> category in [:novice, :unknown] end)
    |> Enum.sort_by(fn {_p, data, _cat} ->
      Map.get(data, :kills, 0) + Map.get(data, :deaths, 0)
    end)
    |> Enum.map(fn {p, data, _cat} ->
      %{
        character_id: p.character_id,
        character_name: p.character_name,
        corporation_name: p.corporation_name,
        alliance_name: p.alliance_name,
        ship_name: p.ship_name,
        total_kills: Map.get(data, :kills, 0),
        total_deaths: Map.get(data, :deaths, 0),
        kd_ratio: calculate_kd_ratio(data),
        isk_efficiency: Map.get(data, :isk_efficiency, 0),
        first_seen: Map.get(data, :first_seen),
        experience_category: categorize_experience_level(data)
      }
    end)
  end

  # Enhanced veteran/rookie identification systems
  def identify_elite_veterans(participants) do
    # Identify the most elite veteran players with comprehensive analysis
    Logger.debug("Identifying elite veterans from #{length(participants)} participants")
    
    # Fetch comprehensive historical data
    experience_data = fetch_comprehensive_veteran_data(participants)
    
    # Apply elite veteran criteria
    elite_veterans = 
      participants
      |> classify_elite_veterans(experience_data)
      |> sort_by_veteran_score()
      |> add_threat_assessments()
      |> add_specialization_analysis()
      
    %{
      elite_veterans: elite_veterans,
      veteran_statistics: calculate_veteran_fleet_statistics(elite_veterans),
      threat_assessment: assess_veteran_threat_level(elite_veterans),
      tactical_recommendations: generate_veteran_counter_tactics(elite_veterans)
    }
  end

  def identify_dangerous_rookies(participants) do
    # Identify rookies who show exceptional potential or unusual patterns
    Logger.debug("Identifying dangerous rookies from #{length(participants)} participants")
    
    # Fetch rookie-specific data
    rookie_data = fetch_comprehensive_rookie_data(participants)
    
    # Apply dangerous rookie criteria
    dangerous_rookies = 
      participants
      |> classify_dangerous_rookies(rookie_data)
      |> sort_by_rookie_potential()
      |> add_rookie_threat_assessments()
      |> add_learning_curve_analysis()
      
    %{
      dangerous_rookies: dangerous_rookies,
      rookie_statistics: calculate_rookie_fleet_statistics(dangerous_rookies),
      potential_assessment: assess_rookie_potential(dangerous_rookies),
      development_analysis: analyze_rookie_development_patterns(dangerous_rookies)
    }
  end

  def analyze_veteran_rookie_dynamics(participants) do
    # Analyze the interaction between veterans and rookies in the battle
    Logger.debug("Analyzing veteran-rookie dynamics")
    
    veteran_data = fetch_comprehensive_veteran_data(participants)
    rookie_data = fetch_comprehensive_rookie_data(participants)
    
    veterans = classify_elite_veterans(participants, veteran_data)
    rookies = classify_dangerous_rookies(participants, rookie_data)
    
    %{
      veteran_mentorship: analyze_veteran_mentorship_patterns(veterans, rookies, participants),
      rookie_protection: analyze_rookie_protection_strategies(veterans, rookies, participants),
      experience_transfer: analyze_experience_transfer_dynamics(veterans, rookies),
      tactical_balance: assess_veteran_rookie_tactical_balance(veterans, rookies),
      fleet_stability: calculate_experience_based_fleet_stability(veterans, rookies, participants)
    }
  end

  defp fetch_comprehensive_veteran_data(participants) do
    character_ids = 
      participants
      |> Enum.map(& &1.character_id)
      |> Enum.reject(&is_nil/1)
      |> Enum.uniq()
    
    if length(character_ids) == 0 do
      %{}
    else
      # Extended query for veteran analysis (12 months of data)
      twelve_months_ago = DateTime.add(DateTime.utc_now(), -365 * 24 * 3600, :second)
      
      query = """
      WITH veteran_analysis AS (
        SELECT 
          COALESCE(victim_character_id, (a->>'character_id')::bigint) as character_id,
          COUNT(*) as total_engagements,
          COUNT(CASE WHEN victim_character_id IS NULL THEN 1 END) as kills,
          COUNT(CASE WHEN victim_character_id IS NOT NULL THEN 1 END) as deaths,
          AVG((k.raw_data->'zkb'->>'totalValue')::bigint) as avg_isk_value,
          COUNT(CASE WHEN (a->>'final_blow')::boolean = true THEN 1 END) as final_blows,
          COUNT(DISTINCT DATE(k.killmail_time)) as active_days,
          COUNT(DISTINCT k.solar_system_id) as systems_active,
          MIN(k.killmail_time) as first_seen,
          MAX(k.killmail_time) as last_seen,
          array_agg(DISTINCT (a->>'ship_type_id')::integer) FILTER (WHERE (a->>'ship_type_id') IS NOT NULL) as ship_types_used,
          COUNT(CASE WHEN k.attacker_count = 1 THEN 1 END) as solo_kills
        FROM killmails_raw k
        CROSS JOIN LATERAL jsonb_array_elements(k.raw_data->'attackers') AS a
        WHERE k.killmail_time >= $1 
          AND (
            k.victim_character_id = ANY($2) OR 
            (a->>'character_id')::bigint = ANY($2)
          )
        GROUP BY COALESCE(victim_character_id, (a->>'character_id')::bigint)
      )
      SELECT 
        character_id,
        total_engagements,
        kills,
        deaths,
        avg_isk_value,
        final_blows,
        active_days,
        systems_active,
        first_seen,
        last_seen,
        ship_types_used,
        solo_kills,
        CASE WHEN deaths > 0 THEN kills::float / deaths ELSE kills::float END as kd_ratio,
        CASE WHEN total_engagements > 0 THEN final_blows::float / total_engagements ELSE 0 END as final_blow_ratio,
        CASE WHEN active_days > 0 THEN total_engagements::float / active_days ELSE 0 END as daily_activity_rate
      FROM veteran_analysis
      WHERE character_id IS NOT NULL AND total_engagements >= 50
      """
      
      case Ecto.Adapters.SQL.query(EveDmv.Repo, query, [twelve_months_ago, character_ids]) do
        {:ok, result} ->
          result.rows
          |> Enum.map(fn [char_id, total_eng, kills, deaths, avg_isk, final_blows, active_days, 
                           systems, first_seen, last_seen, ship_types, solo_kills, kd_ratio, 
                           final_blow_ratio, daily_rate] ->
            {char_id, %{
              total_engagements: total_eng || 0,
              kills: kills || 0,
              deaths: deaths || 0,
              avg_isk_value: avg_isk || 0,
              final_blows: final_blows || 0,
              active_days: active_days || 0,
              systems_active: systems || 0,
              first_seen: first_seen,
              last_seen: last_seen,
              ship_types_used: ship_types || [],
              solo_kills: solo_kills || 0,
              kd_ratio: kd_ratio || 0.0,
              final_blow_ratio: final_blow_ratio || 0.0,
              daily_activity_rate: daily_rate || 0.0,
              isk_efficiency: calculate_isk_efficiency_from_value(avg_isk || 0),
              veteran_score: calculate_veteran_score(total_eng, kills, deaths, kd_ratio, final_blow_ratio, solo_kills)
            }}
          end)
          |> Enum.into(%{})
        
        {:error, _} ->
          Logger.warning("Failed to fetch comprehensive veteran data")
          %{}
      end
    end
  end

  defp fetch_comprehensive_rookie_data(participants) do
    character_ids = 
      participants
      |> Enum.map(& &1.character_id)
      |> Enum.reject(&is_nil/1)
      |> Enum.uniq()
    
    if length(character_ids) == 0 do
      %{}
    else
      # Query for rookie analysis (3 months of data to identify recent players)
      three_months_ago = DateTime.add(DateTime.utc_now(), -90 * 24 * 3600, :second)
      
      query = """
      WITH rookie_analysis AS (
        SELECT 
          COALESCE(victim_character_id, (a->>'character_id')::bigint) as character_id,
          COUNT(*) as total_engagements,
          COUNT(CASE WHEN victim_character_id IS NULL THEN 1 END) as kills,
          COUNT(CASE WHEN victim_character_id IS NOT NULL THEN 1 END) as deaths,
          AVG((k.raw_data->'zkb'->>'totalValue')::bigint) as avg_isk_value,
          COUNT(CASE WHEN (a->>'final_blow')::boolean = true THEN 1 END) as final_blows,
          COUNT(DISTINCT DATE(k.killmail_time)) as active_days,
          MIN(k.killmail_time) as first_seen,
          MAX(k.killmail_time) as last_seen,
          array_agg(DISTINCT (a->>'ship_type_id')::integer) FILTER (WHERE (a->>'ship_type_id') IS NOT NULL) as ship_types_used,
          -- Calculate improvement trend
          COUNT(CASE WHEN k.killmail_time >= CURRENT_TIMESTAMP - INTERVAL '30 days' THEN 1 END) as recent_engagements,
          COUNT(CASE WHEN k.killmail_time >= CURRENT_TIMESTAMP - INTERVAL '30 days' AND victim_character_id IS NULL THEN 1 END) as recent_kills
        FROM killmails_raw k
        CROSS JOIN LATERAL jsonb_array_elements(k.raw_data->'attackers') AS a
        WHERE k.killmail_time >= $1 
          AND (
            k.victim_character_id = ANY($2) OR 
            (a->>'character_id')::bigint = ANY($2)
          )
        GROUP BY COALESCE(victim_character_id, (a->>'character_id')::bigint)
      )
      SELECT 
        character_id,
        total_engagements,
        kills,
        deaths,
        avg_isk_value,
        final_blows,
        active_days,
        first_seen,
        last_seen,
        ship_types_used,
        recent_engagements,
        recent_kills,
        CASE WHEN deaths > 0 THEN kills::float / deaths ELSE kills::float END as kd_ratio,
        CASE WHEN recent_engagements > 0 THEN recent_kills::float / recent_engagements ELSE 0 END as recent_kill_ratio,
        EXTRACT(DAYS FROM CURRENT_TIMESTAMP - first_seen) as days_since_first_seen
      FROM rookie_analysis
      WHERE character_id IS NOT NULL AND total_engagements <= 100
      """
      
      case Ecto.Adapters.SQL.query(EveDmv.Repo, query, [three_months_ago, character_ids]) do
        {:ok, result} ->
          result.rows
          |> Enum.map(fn [char_id, total_eng, kills, deaths, avg_isk, final_blows, active_days, 
                           first_seen, last_seen, ship_types, recent_eng, recent_kills, kd_ratio, 
                           recent_kill_ratio, days_since_first] ->
            {char_id, %{
              total_engagements: total_eng || 0,
              kills: kills || 0,
              deaths: deaths || 0,
              avg_isk_value: avg_isk || 0,
              final_blows: final_blows || 0,
              active_days: active_days || 0,
              first_seen: first_seen,
              last_seen: last_seen,
              ship_types_used: ship_types || [],
              recent_engagements: recent_eng || 0,
              recent_kills: recent_kills || 0,
              kd_ratio: kd_ratio || 0.0,
              recent_kill_ratio: recent_kill_ratio || 0.0,
              days_since_first_seen: days_since_first || 0,
              improvement_trend: calculate_rookie_improvement_trend(recent_kill_ratio, kd_ratio),
              potential_score: calculate_rookie_potential_score(total_eng, kills, deaths, kd_ratio, recent_kill_ratio, days_since_first)
            }}
          end)
          |> Enum.into(%{})
        
        {:error, _} ->
          Logger.warning("Failed to fetch comprehensive rookie data")
          %{}
      end
    end
  end

  defp calculate_veteran_score(total_engagements, kills, deaths, kd_ratio, final_blow_ratio, solo_kills) do
    # Multi-factor veteran scoring algorithm
    engagement_factor = min(1.0, total_engagements / 2000) * 0.3
    performance_factor = min(1.0, kd_ratio / 5.0) * 0.25
    final_blow_factor = final_blow_ratio * 0.2
    solo_factor = min(1.0, solo_kills / 100) * 0.15
    consistency_factor = min(1.0, kills / max(total_engagements, 1)) * 0.1
    
    Float.round(engagement_factor + performance_factor + final_blow_factor + solo_factor + consistency_factor, 3)
  end

  defp calculate_rookie_potential_score(total_eng, kills, deaths, kd_ratio, recent_kill_ratio, days_since_first) do
    # Multi-factor rookie potential scoring
    learning_speed = if total_eng > 0 and days_since_first > 0 do
      min(1.0, (kills / max(total_eng, 1)) / (days_since_first / 30)) * 0.3
    else
      0.0
    end
    
    performance_factor = min(1.0, kd_ratio / 2.0) * 0.25
    recent_improvement = recent_kill_ratio * 0.2
    activity_consistency = if days_since_first > 0, do: min(1.0, total_eng / days_since_first) * 0.15, else: 0.0
    adaptation_speed = min(1.0, total_eng / max(days_since_first, 1)) * 0.1
    
    Float.round(learning_speed + performance_factor + recent_improvement + activity_consistency + adaptation_speed, 3)
  end

  defp calculate_rookie_improvement_trend(recent_kill_ratio, overall_kd_ratio) do
    cond do
      recent_kill_ratio > overall_kd_ratio * 1.5 -> :rapidly_improving
      recent_kill_ratio > overall_kd_ratio * 1.2 -> :improving
      recent_kill_ratio > overall_kd_ratio * 0.8 -> :stable
      true -> :declining
    end
  end

  defp classify_elite_veterans(participants, veteran_data) do
    participants
    |> Enum.map(fn participant ->
      data = Map.get(veteran_data, participant.character_id, %{})
      veteran_score = Map.get(data, :veteran_score, 0.0)
      
      if veteran_score >= 0.7 do
        elite_level = determine_elite_veteran_level(data)
        specializations = identify_veteran_specializations(data, participant)
        threat_level = calculate_veteran_threat_level(data, participant)
        
        Map.merge(participant, %{
          veteran_score: veteran_score,
          elite_level: elite_level,
          specializations: specializations,
          threat_level: threat_level,
          veteran_data: data
        })
      else
        nil
      end
    end)
    |> Enum.reject(&is_nil/1)
  end

  defp classify_dangerous_rookies(participants, rookie_data) do
    participants
    |> Enum.map(fn participant ->
      data = Map.get(rookie_data, participant.character_id, %{})
      potential_score = Map.get(data, :potential_score, 0.0)
      
      if potential_score >= 0.6 or Map.get(data, :improvement_trend) == :rapidly_improving do
        danger_level = determine_rookie_danger_level(data)
        potential_areas = identify_rookie_potential_areas(data, participant)
        threat_potential = calculate_rookie_threat_potential(data, participant)
        
        Map.merge(participant, %{
          potential_score: potential_score,
          danger_level: danger_level,
          potential_areas: potential_areas,
          threat_potential: threat_potential,
          rookie_data: data
        })
      else
        nil
      end
    end)
    |> Enum.reject(&is_nil/1)
  end

  defp determine_elite_veteran_level(data) do
    veteran_score = Map.get(data, :veteran_score, 0.0)
    total_engagements = Map.get(data, :total_engagements, 0)
    kd_ratio = Map.get(data, :kd_ratio, 0.0)
    solo_kills = Map.get(data, :solo_kills, 0)
    
    cond do
      veteran_score >= 0.9 and total_engagements >= 3000 and kd_ratio >= 5.0 -> :legendary
      veteran_score >= 0.85 and total_engagements >= 2000 and kd_ratio >= 3.0 -> :elite
      veteran_score >= 0.8 and solo_kills >= 50 -> :ace
      veteran_score >= 0.7 -> :veteran
      true -> :experienced
    end
  end

  defp determine_rookie_danger_level(data) do
    potential_score = Map.get(data, :potential_score, 0.0)
    improvement_trend = Map.get(data, :improvement_trend, :stable)
    kd_ratio = Map.get(data, :kd_ratio, 0.0)
    
    cond do
      potential_score >= 0.8 and improvement_trend == :rapidly_improving -> :extremely_dangerous
      potential_score >= 0.7 and kd_ratio >= 1.5 -> :very_dangerous
      potential_score >= 0.6 and improvement_trend in [:rapidly_improving, :improving] -> :dangerous
      potential_score >= 0.5 -> :potentially_dangerous
      true -> :standard_rookie
    end
  end

  # Supporting functions for enhanced veteran/rookie systems
  defp sort_by_veteran_score(veterans) do
    Enum.sort_by(veterans, & &1.veteran_score, :desc)
  end

  defp sort_by_rookie_potential(rookies) do
    Enum.sort_by(rookies, & &1.potential_score, :desc)
  end

  defp add_threat_assessments(veterans) do
    Enum.map(veterans, fn veteran ->
      threat_assessment = assess_individual_veteran_threat(veteran)
      Map.put(veteran, :threat_assessment, threat_assessment)
    end)
  end

  defp add_specialization_analysis(veterans) do
    Enum.map(veterans, fn veteran ->
      specialization_analysis = analyze_veteran_specialization_depth(veteran)
      Map.put(veteran, :specialization_analysis, specialization_analysis)
    end)
  end

  defp add_rookie_threat_assessments(rookies) do
    Enum.map(rookies, fn rookie ->
      threat_assessment = assess_individual_rookie_threat(rookie)
      Map.put(rookie, :threat_assessment, threat_assessment)
    end)
  end

  defp add_learning_curve_analysis(rookies) do
    Enum.map(rookies, fn rookie ->
      learning_analysis = analyze_rookie_learning_curve(rookie)
      Map.put(rookie, :learning_analysis, learning_analysis)
    end)
  end

  defp calculate_veteran_fleet_statistics(veterans) do
    if length(veterans) == 0 do
      %{
        total_veterans: 0,
        average_score: 0.0,
        score_distribution: %{},
        elite_levels: %{},
        threat_distribution: %{}
      }
    else
      scores = Enum.map(veterans, & &1.veteran_score)
      elite_levels = Enum.frequencies_by(veterans, & &1.elite_level)
      threat_levels = Enum.frequencies_by(veterans, & &1.threat_level)
      
      %{
        total_veterans: length(veterans),
        average_score: Enum.sum(scores) / length(scores),
        score_distribution: calculate_score_distribution(scores),
        elite_levels: elite_levels,
        threat_distribution: threat_levels,
        top_veteran: Enum.max_by(veterans, & &1.veteran_score, fn -> nil end)
      }
    end
  end

  defp calculate_rookie_fleet_statistics(rookies) do
    if length(rookies) == 0 do
      %{
        total_rookies: 0,
        average_potential: 0.0,
        potential_distribution: %{},
        danger_levels: %{},
        improvement_trends: %{}
      }
    else
      potentials = Enum.map(rookies, & &1.potential_score)
      danger_levels = Enum.frequencies_by(rookies, & &1.danger_level)
      improvement_trends = Enum.frequencies_by(rookies, &Map.get(&1.rookie_data, :improvement_trend, :stable))
      
      %{
        total_rookies: length(rookies),
        average_potential: Enum.sum(potentials) / length(potentials),
        potential_distribution: calculate_score_distribution(potentials),
        danger_levels: danger_levels,
        improvement_trends: improvement_trends,
        top_rookie: Enum.max_by(rookies, & &1.potential_score, fn -> nil end)
      }
    end
  end

  defp assess_veteran_threat_level(veterans) do
    if length(veterans) == 0 do
      %{overall_threat: :minimal, assessment: "No veteran threats detected"}
    else
      threat_levels = Enum.map(veterans, & &1.threat_level)
      legendary_count = Enum.count(veterans, &(&1.elite_level == :legendary))
      elite_count = Enum.count(veterans, &(&1.elite_level == :elite))
      
      overall_threat = cond do
        legendary_count >= 3 -> :extreme
        legendary_count >= 1 or elite_count >= 5 -> :very_high
        elite_count >= 2 -> :high
        length(veterans) >= 5 -> :moderate
        true -> :low
      end
      
      %{
        overall_threat: overall_threat,
        veteran_count: length(veterans),
        legendary_veterans: legendary_count,
        elite_veterans: elite_count,
        assessment: generate_veteran_threat_assessment(overall_threat, legendary_count, elite_count)
      }
    end
  end

  defp assess_rookie_potential(rookies) do
    if length(rookies) == 0 do
      %{overall_potential: :minimal, assessment: "No dangerous rookies detected"}
    else
      extremely_dangerous = Enum.count(rookies, &(&1.danger_level == :extremely_dangerous))
      very_dangerous = Enum.count(rookies, &(&1.danger_level == :very_dangerous))
      rapidly_improving = Enum.count(rookies, &(Map.get(&1.rookie_data, :improvement_trend) == :rapidly_improving))
      
      overall_potential = cond do
        extremely_dangerous >= 2 -> :extremely_high
        extremely_dangerous >= 1 or very_dangerous >= 3 -> :very_high
        very_dangerous >= 1 or rapidly_improving >= 5 -> :high
        rapidly_improving >= 2 -> :moderate
        true -> :low
      end
      
      %{
        overall_potential: overall_potential,
        rookie_count: length(rookies),
        extremely_dangerous: extremely_dangerous,
        very_dangerous: very_dangerous,
        rapidly_improving: rapidly_improving,
        assessment: generate_rookie_potential_assessment(overall_potential, extremely_dangerous, rapidly_improving)
      }
    end
  end

  defp generate_veteran_counter_tactics(veterans) do
    if length(veterans) == 0 do
      ["No veteran threats detected - standard engagement protocols"]
    else
      tactics = []
      
      # Add tactics based on veteran composition
      legendary_count = Enum.count(veterans, &(&1.elite_level == :legendary))
      elite_count = Enum.count(veterans, &(&1.elite_level == :elite))
      ace_count = Enum.count(veterans, &(&1.elite_level == :ace))
      
      tactics = tactics ++
        cond do
          legendary_count >= 2 -> [
            "EXTREME CAUTION: Multiple legendary pilots detected",
            "Consider disengagement unless overwhelming numerical advantage",
            "Focus fire on support ships to isolate legends",
            "Use electronic warfare to disrupt veteran coordination"
          ]
          legendary_count >= 1 -> [
            "High priority target: Legendary pilot requires focus fire",
            "Avoid solo engagements with legendary pilot",
            "Use numerical superiority and coordination"
          ]
          elite_count >= 3 -> [
            "Multiple elite pilots: Expect sophisticated tactics",
            "Use disciplined approach and avoid splits",
            "Focus on isolating individual elites"
          ]
          true -> ["Standard veteran engagement protocols"]
        end
      
      # Add specialization-based tactics
      specialization_tactics = generate_specialization_counter_tactics(veterans)
      tactics ++ specialization_tactics
    end
  end

  defp analyze_rookie_development_patterns(rookies) do
    if length(rookies) == 0 do
      %{patterns: [], insights: ["No rookie development data available"]}
    else
      improvement_patterns = Enum.group_by(rookies, &Map.get(&1.rookie_data, :improvement_trend, :stable))
      
      patterns = [
        analyze_learning_speed_patterns(rookies),
        analyze_ship_progression_patterns(rookies),
        analyze_activity_consistency_patterns(rookies)
      ] |> List.flatten()
      
      insights = generate_rookie_development_insights(improvement_patterns, rookies)
      
      %{
        patterns: patterns,
        insights: insights,
        improvement_distribution: improvement_patterns,
        development_recommendations: generate_rookie_development_recommendations(rookies)
      }
    end
  end

  defp identify_veteran_specializations(data, participant) do
    ship_types = Map.get(data, :ship_types_used, [])
    solo_kills = Map.get(data, :solo_kills, 0)
    final_blow_ratio = Map.get(data, :final_blow_ratio, 0.0)
    
    specializations = []
    
    # Solo specialist
    specializations = if solo_kills >= 20 do
      specializations ++ [:solo_hunter]
    else
      specializations
    end
    
    # Final blow specialist
    specializations = if final_blow_ratio >= 0.4 do
      specializations ++ [:finisher]
    else
      specializations
    end
    
    # Ship type specializations
    ship_specializations = determine_ship_specializations(ship_types)
    specializations ++ ship_specializations
  end

  defp calculate_veteran_threat_level(data, participant) do
    veteran_score = Map.get(data, :veteran_score, 0.0)
    kd_ratio = Map.get(data, :kd_ratio, 0.0)
    solo_kills = Map.get(data, :solo_kills, 0)
    systems_active = Map.get(data, :systems_active, 0)
    
    # Multi-factor threat calculation
    score_threat = min(1.0, veteran_score) * 0.4
    performance_threat = min(1.0, kd_ratio / 5.0) * 0.3
    solo_threat = min(1.0, solo_kills / 50) * 0.2
    mobility_threat = min(1.0, systems_active / 100) * 0.1
    
    total_threat = score_threat + performance_threat + solo_threat + mobility_threat
    
    cond do
      total_threat >= 0.9 -> :extreme
      total_threat >= 0.7 -> :very_high
      total_threat >= 0.5 -> :high
      total_threat >= 0.3 -> :moderate
      true -> :low
    end
  end

  defp identify_rookie_potential_areas(data, participant) do
    kd_ratio = Map.get(data, :kd_ratio, 0.0)
    recent_kill_ratio = Map.get(data, :recent_kill_ratio, 0.0)
    improvement_trend = Map.get(data, :improvement_trend, :stable)
    ship_types = Map.get(data, :ship_types_used, [])
    
    areas = []
    
    # Performance potential
    areas = if kd_ratio >= 1.5 do
      areas ++ [:combat_performance]
    else
      areas
    end
    
    # Learning potential
    areas = if improvement_trend in [:rapidly_improving, :improving] do
      areas ++ [:rapid_learning]
    else
      areas
    end
    
    # Tactical potential
    areas = if recent_kill_ratio > kd_ratio * 1.3 do
      areas ++ [:tactical_adaptation]
    else
      areas
    end
    
    # Ship diversity potential
    areas = if length(ship_types) >= 3 do
      areas ++ [:ship_versatility]
    else
      areas
    end
    
    if length(areas) == 0, do: [:standard_development], else: areas
  end

  defp calculate_rookie_threat_potential(data, participant) do
    potential_score = Map.get(data, :potential_score, 0.0)
    improvement_trend = Map.get(data, :improvement_trend, :stable)
    kd_ratio = Map.get(data, :kd_ratio, 0.0)
    days_since_first = Map.get(data, :days_since_first_seen, 0)
    
    # Calculate threat potential based on learning trajectory
    base_potential = potential_score * 0.5
    
    improvement_multiplier = case improvement_trend do
      :rapidly_improving -> 1.5
      :improving -> 1.2
      :stable -> 1.0
      :declining -> 0.7
    end
    
    performance_factor = min(1.0, kd_ratio / 2.0) * 0.3
    experience_factor = if days_since_first > 0, do: min(1.0, 90 / days_since_first) * 0.2, else: 0.0
    
    total_potential = (base_potential * improvement_multiplier) + performance_factor + experience_factor
    
    cond do
      total_potential >= 1.0 -> :extreme
      total_potential >= 0.8 -> :very_high
      total_potential >= 0.6 -> :high
      total_potential >= 0.4 -> :moderate
      true -> :low
    end
  end

  # Helper functions for veteran/rookie analysis
  defp calculate_score_distribution(scores) do
    if length(scores) == 0 do
      %{min: 0.0, max: 0.0, median: 0.0, std_dev: 0.0}
    else
      sorted = Enum.sort(scores)
      len = length(sorted)
      median = if rem(len, 2) == 0 do
        (Enum.at(sorted, div(len, 2) - 1) + Enum.at(sorted, div(len, 2))) / 2
      else
        Enum.at(sorted, div(len, 2))
      end
      
      mean = Enum.sum(scores) / len
      variance = scores |> Enum.map(&((&1 - mean) * (&1 - mean))) |> Enum.sum() |> Kernel./(len - 1)
      
      %{
        min: Enum.min(scores),
        max: Enum.max(scores),
        median: median,
        std_dev: :math.sqrt(variance)
      }
    end
  end

  defp generate_veteran_threat_assessment(threat_level, legendary_count, elite_count) do
    case threat_level do
      :extreme -> "EXTREME THREAT: #{legendary_count} legendary veterans present. Immediate tactical adjustment required."
      :very_high -> "Very high threat level with #{elite_count} elite veterans. Expect sophisticated coordination."
      :high -> "High threat from veteran presence. Use coordinated approach and avoid individual engagements."
      :moderate -> "Moderate veteran threat. Standard engagement protocols with enhanced awareness."
      :low -> "Low veteran threat detected. Proceed with standard tactics."
    end
  end

  defp generate_rookie_potential_assessment(potential_level, extremely_dangerous, rapidly_improving) do
    case potential_level do
      :extremely_high -> "EXTREME ROOKIE POTENTIAL: #{extremely_dangerous} extremely dangerous rookies detected. Monitor closely for rapid development."
      :very_high -> "Very high rookie potential with #{rapidly_improving} rapidly improving players. Future threat development likely."
      :high -> "High rookie potential detected. Several players showing strong development trajectory."
      :moderate -> "Moderate rookie potential. Some players showing development signs."
      :low -> "Low rookie threat potential. Standard development patterns observed."
    end
  end

  defp determine_ship_specializations(ship_types) do
    # Analyze ship type usage patterns to determine specializations
    ship_classes = ship_types |> Enum.map(&EveDmv.StaticData.ShipTypes.classify_ship_type/1) |> Enum.frequencies()
    
    specializations = []
    
    # Check for specializations based on ship class distribution
    total_ships = Enum.sum(Map.values(ship_classes))
    
    Enum.reduce(ship_classes, specializations, fn {ship_class, count}, acc ->
      percentage = count / max(total_ships, 1)
      
      if percentage >= 0.7 do
        case ship_class do
          :frigate -> acc ++ [:frigate_specialist]
          :cruiser -> acc ++ [:cruiser_specialist]
          :battleship -> acc ++ [:battleship_specialist]
          :capital -> acc ++ [:capital_specialist]
          _ -> acc
        end
      else
        acc
      end
    end)
  end

  defp generate_specialization_counter_tactics(veterans) do
    # Generate tactics based on veteran specializations
    all_specializations = veterans |> Enum.flat_map(& &1.specializations) |> Enum.frequencies()
    
    Enum.flat_map(all_specializations, fn {specialization, count} ->
      case specialization do
        :solo_hunter when count >= 2 -> ["Watch for solo hunting veterans - maintain group cohesion"]
        :finisher when count >= 3 -> ["Multiple finishers present - protect low-health allies"]
        :frigate_specialist when count >= 2 -> ["Frigate specialists detected - expect fast tackle and kiting"]
        :capital_specialist when count >= 1 -> ["Capital specialist present - expect heavy escalation potential"]
        _ -> []
      end
    end)
  end

  # Placeholder functions for complex analysis that would require additional data
  defp assess_individual_veteran_threat(veteran), do: %{level: veteran.threat_level, factors: [:performance, :experience]}
  defp analyze_veteran_specialization_depth(veteran), do: %{primary: List.first(veteran.specializations), depth: :moderate}
  defp assess_individual_rookie_threat(rookie), do: %{potential: rookie.threat_potential, trajectory: :improving}
  defp analyze_rookie_learning_curve(rookie), do: %{curve: :steep, projection: :positive}
  defp analyze_learning_speed_patterns(rookies), do: [%{pattern: :varied_learning_speeds, count: length(rookies)}]
  defp analyze_ship_progression_patterns(rookies), do: [%{pattern: :standard_progression, count: length(rookies)}]
  defp analyze_activity_consistency_patterns(rookies), do: [%{pattern: :regular_activity, count: length(rookies)}]
  defp generate_rookie_development_insights(patterns, rookies), do: ["#{length(rookies)} rookies showing development potential"]
  defp generate_rookie_development_recommendations(rookies), do: ["Monitor rookie development trajectory"]
  
  # Placeholder functions for veteran-rookie dynamics analysis
  defp analyze_veteran_mentorship_patterns(veterans, rookies, participants), do: %{mentorship_detected: false}
  defp analyze_rookie_protection_strategies(veterans, rookies, participants), do: %{protection_level: :standard}
  defp analyze_experience_transfer_dynamics(veterans, rookies), do: %{transfer_efficiency: :moderate}
  defp assess_veteran_rookie_tactical_balance(veterans, rookies), do: %{balance: :moderate}
  defp calculate_experience_based_fleet_stability(veterans, rookies, participants), do: %{stability: :stable}

  defp calculate_isk_efficiency_from_value(avg_isk_value) do
    # Simple ISK efficiency calculation based on average value
    cond do
      avg_isk_value >= 100_000_000 -> 1.0
      avg_isk_value >= 50_000_000 -> 0.8
      avg_isk_value >= 20_000_000 -> 0.6
      avg_isk_value >= 10_000_000 -> 0.4
      avg_isk_value >= 5_000_000 -> 0.2
      avg_isk_value > 0 -> 0.1
      true -> 0.0
    end
  end

  defp calculate_experience_advantage(_participants) do
    # Keep basic implementation for backward compatibility
    %{
      overall_advantage: 0.0,
      side_advantages: %{side_a: 0.1, side_b: -0.1}
    }
  end

  defp calculate_detailed_experience_advantage(participants, experience_data) do
    # Group participants by side
    by_side = Enum.group_by(participants, & &1.participant_type)

    # Calculate experience metrics for each side
    side_metrics =
      by_side
      |> Enum.map(fn {side, side_participants} ->
        metrics = calculate_side_experience_metrics(side_participants, experience_data)
        {side, metrics}
      end)
      |> Enum.into(%{})

    # Calculate advantages
    attacker_metrics = Map.get(side_metrics, :attacker, %{})
    victim_metrics = Map.get(side_metrics, :victim, %{})

    %{
      overall_advantage: calculate_overall_advantage(attacker_metrics, victim_metrics),
      side_metrics: side_metrics,
      veteran_ratio: calculate_veteran_ratio(side_metrics),
      average_engagement_diff: calculate_engagement_difference(attacker_metrics, victim_metrics),
      analysis: analyze_experience_balance(attacker_metrics, victim_metrics)
    }
  end

  defp calculate_side_experience_metrics(participants, experience_data) do
    exp_levels =
      participants
      |> Enum.map(fn p ->
        exp_data = Map.get(experience_data, p.character_id, %{})

        {
          categorize_experience_level(exp_data),
          Map.get(exp_data, :kills, 0) + Map.get(exp_data, :deaths, 0),
          calculate_kd_ratio(exp_data)
        }
      end)

    total = length(participants)

    %{
      total_pilots: total,
      veteran_count: Enum.count(exp_levels, fn {cat, _, _} -> cat == :veteran end),
      experienced_count: Enum.count(exp_levels, fn {cat, _, _} -> cat == :experienced end),
      average_engagements: calculate_average_engagements(exp_levels),
      average_kd: calculate_average_kd(exp_levels),
      experience_score: calculate_experience_score(exp_levels)
    }
  end

  defp calculate_average_engagements(exp_levels) do
    engagements = Enum.map(exp_levels, fn {_, eng, _} -> eng end)

    if length(engagements) > 0 do
      Float.round(Enum.sum(engagements) / length(engagements), 1)
    else
      0.0
    end
  end

  defp calculate_average_kd(exp_levels) do
    kds = Enum.map(exp_levels, fn {_, _, kd} -> kd end)

    if length(kds) > 0 do
      Float.round(Enum.sum(kds) / length(kds), 2)
    else
      0.0
    end
  end

  defp calculate_experience_score(exp_levels) do
    # Score based on experience distribution
    scores =
      Enum.map(exp_levels, fn {cat, _, _} ->
        case cat do
          :veteran -> 1.0
          :experienced -> 0.7
          :intermediate -> 0.5
          :novice -> 0.3
          :unknown -> 0.1
        end
      end)

    if length(scores) > 0 do
      Float.round(Enum.sum(scores) / length(scores), 2)
    else
      0.0
    end
  end

  defp calculate_overall_advantage(attacker_metrics, victim_metrics) do
    att_score = Map.get(attacker_metrics, :experience_score, 0)
    vic_score = Map.get(victim_metrics, :experience_score, 0)

    Float.round(att_score - vic_score, 2)
  end

  defp calculate_veteran_ratio(side_metrics) do
    Enum.map(side_metrics, fn {side, metrics} ->
      total = Map.get(metrics, :total_pilots, 1)
      veterans = Map.get(metrics, :veteran_count, 0)
      ratio = if total > 0, do: veterans / total * 100, else: 0
      {side, Float.round(ratio, 1)}
    end)
    |> Enum.into(%{})
  end

  defp calculate_engagement_difference(attacker_metrics, victim_metrics) do
    att_eng = Map.get(attacker_metrics, :average_engagements, 0)
    vic_eng = Map.get(victim_metrics, :average_engagements, 0)

    Float.round(att_eng - vic_eng, 1)
  end

  defp analyze_experience_balance(attacker_metrics, victim_metrics) do
    adv = calculate_overall_advantage(attacker_metrics, victim_metrics)

    assessment =
      cond do
        adv > 0.3 -> "Attackers have significant experience advantage"
        adv > 0.1 -> "Attackers have moderate experience advantage"
        adv > -0.1 -> "Relatively balanced experience levels"
        adv > -0.3 -> "Defenders have moderate experience advantage"
        true -> "Defenders have significant experience advantage"
      end

    %{
      assessment: assessment,
      recommendation: generate_experience_recommendation(adv, attacker_metrics, victim_metrics)
    }
  end

  defp generate_experience_recommendation(advantage, attacker_metrics, victim_metrics) do
    cond do
      advantage > 0.3 ->
        "Attackers' experience advantage suggests high success probability"

      advantage < -0.3 ->
        "Defenders' experience advantage may lead to successful defense"

      Map.get(attacker_metrics, :veteran_count, 0) >
          Map.get(victim_metrics, :veteran_count, 0) * 2 ->
        "Attacker veteran concentration provides tactical advantage"

      Map.get(victim_metrics, :veteran_count, 0) >
          Map.get(attacker_metrics, :veteran_count, 0) * 2 ->
        "Defender veteran concentration suggests strong resistance"

      true ->
        "Balanced experience levels suggest outcome depends on tactics and numbers"
    end
  end

  defp calculate_average_character_age(participants, experience_data) do
    ages =
      participants
      |> Enum.map(fn p ->
        exp_data = Map.get(experience_data, p.character_id, %{})

        case Map.get(exp_data, :first_seen) do
          nil -> nil
          first_seen -> DateTime.diff(DateTime.utc_now(), first_seen, :day)
        end
      end)
      |> Enum.reject(&is_nil/1)

    if length(ages) > 0 do
      avg_days = Enum.sum(ages) / length(ages)

      %{
        days: Float.round(avg_days, 1),
        formatted: format_age_in_days(avg_days)
      }
    else
      %{days: 0, formatted: "Unknown"}
    end
  end

  defp format_age_in_days(days) when days >= 365 do
    years = Float.round(days / 365, 1)
    "#{years} years"
  end

  defp format_age_in_days(days) when days >= 30 do
    months = Float.round(days / 30, 1)
    "#{months} months"
  end

  defp format_age_in_days(days) do
    "#{Float.round(days, 0)} days"
  end

  defp compile_experience_metrics(experience_data) do
    # Compile overall metrics from all participants
    all_data = Map.values(experience_data)

    if length(all_data) > 0 do
      %{
        total_tracked_pilots: length(all_data),
        aggregate_kills: Enum.sum(Enum.map(all_data, & &1.kills)),
        aggregate_deaths: Enum.sum(Enum.map(all_data, & &1.deaths)),
        average_isk_efficiency: calculate_average_isk_efficiency(all_data),
        activity_breakdown: Enum.frequencies_by(all_data, & &1.activity_level)
      }
    else
      %{
        total_tracked_pilots: 0,
        aggregate_kills: 0,
        aggregate_deaths: 0,
        average_isk_efficiency: 0.5,
        activity_breakdown: %{}
      }
    end
  end

  defp calculate_average_isk_efficiency(exp_data_list) do
    efficiencies = Enum.map(exp_data_list, & &1.isk_efficiency)

    if length(efficiencies) > 0 do
      Float.round(Enum.sum(efficiencies) / length(efficiencies), 2)
    else
      0.5
    end
  end

  defp build_participant_lookup_map(participants) do
    # Create efficient lookup maps for participant data
    %{
      by_character_id:
        participants
        |> Enum.filter(& &1.character_id)
        |> Enum.map(&{&1.character_id, &1})
        |> Enum.into(%{}),
      by_corporation_id:
        participants
        |> Enum.group_by(& &1.corporation_id),
      by_alliance_id:
        participants
        |> Enum.filter(& &1.alliance_id)
        |> Enum.group_by(& &1.alliance_id)
    }
  end

  defp analyze_participant_activity(participant, killmails, _participant_map) do
    # Analyze this participant's activity across all killmails
    kills_involved = find_kills_involving_participant(participant, killmails)

    # Extract activity metrics
    kills = count_participant_kills_detailed(participant, kills_involved)
    deaths = count_participant_deaths_detailed(participant, kills_involved)
    damage_dealt = calculate_total_damage_dealt(participant, kills_involved)
    damage_received = calculate_total_damage_received(participant, kills_involved)

    # Build detailed timeline
    timeline = build_participant_timeline(participant, kills_involved)

    # Calculate contribution metrics
    contribution = calculate_detailed_contribution_score(participant, kills_involved)

    %{
      kills: kills,
      deaths: deaths,
      damage_dealt: damage_dealt,
      damage_received: damage_received,
      final_blows: count_final_blows(participant, kills_involved),
      activity_timeline: timeline,
      contribution_score: contribution,
      engagement_count: length(kills_involved),
      activity_duration: calculate_activity_duration(timeline),
      peak_activity_time: identify_peak_activity(timeline),
      target_preferences: analyze_target_preferences(participant, kills_involved),
      survival_analysis: analyze_survival_patterns(participant, kills_involved)
    }
  end

  defp find_kills_involving_participant(participant, killmails) do
    killmails
    |> Enum.filter(fn km ->
      # Check if participant was victim
      victim_match = km.victim_character_id == participant.character_id

      # Check if participant was attacker
      attacker_match =
        case get_in(km.raw_data, ["attackers"]) do
          attackers when is_list(attackers) ->
            Enum.any?(attackers, fn a ->
              a["character_id"] == participant.character_id
            end)

          _ ->
            false
        end

      victim_match or attacker_match
    end)
  end

  defp count_participant_kills_detailed(participant, kills_involved) do
    Enum.count(kills_involved, fn km ->
      km.victim_character_id != participant.character_id and
        participant_was_attacker?(participant, km)
    end)
  end

  defp count_participant_deaths_detailed(participant, kills_involved) do
    Enum.count(kills_involved, fn km ->
      km.victim_character_id == participant.character_id
    end)
  end

  defp participant_was_attacker?(participant, killmail) do
    case get_in(killmail.raw_data, ["attackers"]) do
      attackers when is_list(attackers) ->
        Enum.any?(attackers, fn a ->
          a["character_id"] == participant.character_id
        end)

      _ ->
        false
    end
  end

  defp calculate_total_damage_dealt(participant, kills_involved) do
    kills_involved
    |> Enum.reduce(0, fn km, total ->
      if km.victim_character_id != participant.character_id do
        damage = get_participant_damage_in_kill(participant, km)
        total + damage
      else
        total
      end
    end)
  end

  defp get_participant_damage_in_kill(participant, killmail) do
    case get_in(killmail.raw_data, ["attackers"]) do
      attackers when is_list(attackers) ->
        attacker =
          Enum.find(attackers, fn a ->
            a["character_id"] == participant.character_id
          end)

        case attacker do
          nil -> 0
          att -> att["damage_done"] || 0
        end

      _ ->
        0
    end
  end

  defp calculate_total_damage_received(participant, kills_involved) do
    kills_involved
    |> Enum.reduce(0, fn km, total ->
      if km.victim_character_id == participant.character_id do
        damage = get_in(km.raw_data, ["victim", "damage_taken"]) || 0
        total + damage
      else
        total
      end
    end)
  end

  defp count_final_blows(participant, kills_involved) do
    kills_involved
    |> Enum.count(fn km ->
      case get_in(km.raw_data, ["attackers"]) do
        attackers when is_list(attackers) ->
          Enum.any?(attackers, fn a ->
            a["character_id"] == participant.character_id and a["final_blow"] == true
          end)

        _ ->
          false
      end
    end)
  end

  defp build_participant_timeline(participant, kills_involved) do
    kills_involved
    |> Enum.map(fn km ->
      event_type = if km.victim_character_id == participant.character_id, do: :death, else: :kill

      event_details =
        case event_type do
          :death ->
            %{
              ship_lost: km.victim_ship_type_id,
              killers: count_attackers(km),
              isk_lost: get_in(km.raw_data, ["zkb", "totalValue"]) || 0
            }

          :kill ->
            attacker_info = get_attacker_info(participant, km)

            %{
              target_ship: km.victim_ship_type_id,
              damage_done: attacker_info.damage_done,
              weapon_used: attacker_info.weapon_type_id,
              final_blow: attacker_info.final_blow,
              isk_destroyed: get_in(km.raw_data, ["zkb", "totalValue"]) || 0
            }
        end

      %{
        time: km.killmail_time,
        event_type: event_type,
        killmail_id: km.killmail_id,
        solar_system_id: km.solar_system_id,
        details: event_details
      }
    end)
    |> Enum.sort_by(& &1.time)
  end

  defp count_attackers(killmail) do
    case get_in(killmail.raw_data, ["attackers"]) do
      attackers when is_list(attackers) -> length(attackers)
      _ -> 0
    end
  end

  defp get_attacker_info(participant, killmail) do
    case get_in(killmail.raw_data, ["attackers"]) do
      attackers when is_list(attackers) ->
        attacker =
          Enum.find(attackers, fn a ->
            a["character_id"] == participant.character_id
          end)

        case attacker do
          nil ->
            %{damage_done: 0, weapon_type_id: nil, final_blow: false}

          att ->
            %{
              damage_done: att["damage_done"] || 0,
              weapon_type_id: att["weapon_type_id"],
              final_blow: att["final_blow"] || false
            }
        end

      _ ->
        %{damage_done: 0, weapon_type_id: nil, final_blow: false}
    end
  end

  defp calculate_detailed_contribution_score(participant, kills_involved) do
    # Calculate contribution based on multiple factors
    kills = count_participant_kills_detailed(participant, kills_involved)
    deaths = count_participant_deaths_detailed(participant, kills_involved)
    damage_dealt = calculate_total_damage_dealt(participant, kills_involved)
    final_blows = count_final_blows(participant, kills_involved)

    # Normalize factors
    kill_score = kills * 100
    death_penalty = deaths * 50
    # Normalize damage
    damage_score = damage_dealt / 10000
    final_blow_bonus = final_blows * 150

    # Calculate raw score
    raw_score = kill_score + damage_score + final_blow_bonus - death_penalty

    # Normalize to 0-1 range
    normalized = max(0, min(1, raw_score / 1000))
    Float.round(normalized, 3)
  end

  defp calculate_activity_duration(timeline) do
    if length(timeline) > 0 do
      first_event = List.first(timeline)
      last_event = List.last(timeline)

      duration_seconds = DateTime.diff(last_event.time, first_event.time)

      %{
        seconds: duration_seconds,
        formatted: format_duration(duration_seconds)
      }
    else
      %{seconds: 0, formatted: "No activity"}
    end
  end

  defp format_duration(seconds) when seconds < 60, do: "#{seconds} seconds"

  defp format_duration(seconds) when seconds < 3600 do
    minutes = div(seconds, 60)
    "#{minutes} minutes"
  end

  defp format_duration(seconds) do
    hours = div(seconds, 3600)
    minutes = rem(div(seconds, 60), 60)
    "#{hours}h #{minutes}m"
  end

  defp identify_peak_activity(timeline) do
    if length(timeline) > 2 do
      # Group events by 5-minute windows
      windows =
        timeline
        |> Enum.group_by(fn event ->
          # Round to 5-minute window
          unix = DateTime.to_unix(event.time)
          div(unix, 300) * 300
        end)

      # Find window with most events
      {peak_window, events} =
        windows
        |> Enum.max_by(fn {_window, events} -> length(events) end)

      %{
        time: DateTime.from_unix!(peak_window),
        event_count: length(events),
        event_types: Enum.frequencies_by(events, & &1.event_type)
      }
    else
      nil
    end
  end

  defp analyze_target_preferences(participant, kills_involved) do
    # Analyze what types of targets this participant engaged
    targets =
      kills_involved
      |> Enum.filter(fn km ->
        km.victim_character_id != participant.character_id and
          participant_was_attacker?(participant, km)
      end)
      |> Enum.map(fn km ->
        %{
          ship_type_id: km.victim_ship_type_id,
          ship_class: classify_ship_by_type_id(km.victim_ship_type_id),
          corporation_id: km.victim_corporation_id,
          alliance_id: km.victim_alliance_id
        }
      end)

    %{
      ship_types_engaged: Enum.frequencies_by(targets, & &1.ship_type_id),
      ship_classes_engaged: Enum.frequencies_by(targets, & &1.ship_class),
      preferred_targets: identify_preferred_targets(targets)
    }
  end

  defp identify_preferred_targets(targets) do
    if length(targets) > 0 do
      # Group by ship class and find most common
      by_class = Enum.frequencies_by(targets, & &1.ship_class)

      most_targeted_class =
        by_class
        |> Enum.max_by(fn {_class, count} -> count end)

      %{
        primary_target_class: elem(most_targeted_class, 0),
        engagement_count: elem(most_targeted_class, 1)
      }
    else
      %{primary_target_class: :none, engagement_count: 0}
    end
  end

  defp analyze_survival_patterns(participant, kills_involved) do
    deaths =
      Enum.filter(kills_involved, fn km ->
        km.victim_character_id == participant.character_id
      end)

    %{
      deaths_count: length(deaths),
      ships_lost: Enum.map(deaths, & &1.victim_ship_type_id),
      average_attackers: calculate_average_attackers(deaths),
      death_locations: Enum.map(deaths, & &1.solar_system_id),
      isk_lost: calculate_total_isk_lost(deaths)
    }
  end

  defp calculate_average_attackers(death_killmails) do
    if length(death_killmails) > 0 do
      total = Enum.sum(Enum.map(death_killmails, &count_attackers/1))
      Float.round(total / length(death_killmails), 1)
    else
      0
    end
  end

  defp calculate_total_isk_lost(death_killmails) do
    death_killmails
    |> Enum.map(fn km ->
      get_in(km.raw_data, ["zkb", "totalValue"]) || 0
    end)
    |> Enum.sum()
  end

  defp build_battle_timeline(killmails) do
    # Build a comprehensive timeline of the entire battle
    killmails
    |> Enum.sort_by(& &1.killmail_time)
    |> Enum.map(fn km ->
      %{
        time: km.killmail_time,
        killmail_id: km.killmail_id,
        victim_ship_class: classify_ship_by_type_id(km.victim_ship_type_id),
        attacker_count: km.attacker_count,
        solar_system_id: km.solar_system_id,
        isk_value: get_in(km.raw_data, ["zkb", "totalValue"]) || 0
      }
    end)
  end

  defp analyze_activity_patterns(participants_with_activity, battle_timeline) do
    # Analyze patterns across all participants
    %{
      battle_duration: calculate_battle_duration(battle_timeline),
      intensity_curve: calculate_intensity_curve(battle_timeline),
      participation_waves: identify_participation_waves(participants_with_activity),
      peak_destruction: identify_peak_destruction(battle_timeline),
      system_movements: track_system_movements(battle_timeline)
    }
  end

  defp calculate_battle_duration(timeline) do
    if length(timeline) > 0 do
      first = List.first(timeline)
      last = List.last(timeline)

      duration = DateTime.diff(last.time, first.time)

      %{
        seconds: duration,
        formatted: format_duration(duration),
        start_time: first.time,
        end_time: last.time
      }
    else
      %{seconds: 0, formatted: "No battle data", start_time: nil, end_time: nil}
    end
  end

  defp calculate_intensity_curve(timeline) do
    # Group kills into time buckets and measure intensity
    if length(timeline) > 0 do
      # 1-minute buckets
      buckets =
        timeline
        |> Enum.group_by(fn event ->
          unix = DateTime.to_unix(event.time)
          div(unix, 60) * 60
        end)
        |> Enum.map(fn {bucket_time, events} ->
          %{
            time: DateTime.from_unix!(bucket_time),
            kill_count: length(events),
            isk_destroyed: Enum.sum(Enum.map(events, & &1.isk_value)),
            average_attackers: calculate_average_bucket_attackers(events)
          }
        end)
        |> Enum.sort_by(& &1.time)

      %{
        buckets: buckets,
        peak_intensity: Enum.max_by(buckets, & &1.kill_count, fn -> nil end),
        average_intensity: calculate_average_intensity(buckets)
      }
    else
      %{buckets: [], peak_intensity: nil, average_intensity: 0}
    end
  end

  defp calculate_average_bucket_attackers(events) do
    if length(events) > 0 do
      total = Enum.sum(Enum.map(events, & &1.attacker_count))
      Float.round(total / length(events), 1)
    else
      0
    end
  end

  defp calculate_average_intensity(buckets) do
    if length(buckets) > 0 do
      total_kills = Enum.sum(Enum.map(buckets, & &1.kill_count))
      Float.round(total_kills / length(buckets), 1)
    else
      0
    end
  end

  defp identify_participation_waves(participants_with_activity) do
    # Analyze when participants joined/left the battle
    all_events =
      participants_with_activity
      |> Enum.flat_map(fn p ->
        get_in(p, [:activity, :activity_timeline]) || []
      end)
      |> Enum.sort_by(& &1.time)

    if length(all_events) > 0 do
      # Track active participants over time
      active_by_time =
        all_events
        |> Enum.reduce(%{}, fn event, acc ->
          time_key = DateTime.to_unix(event.time)
          Map.update(acc, time_key, 1, &(&1 + 1))
        end)

      %{
        total_unique_participants: length(participants_with_activity),
        participation_timeline: active_by_time,
        peak_participation: identify_peak_participation(active_by_time)
      }
    else
      %{
        total_unique_participants: 0,
        participation_timeline: %{},
        peak_participation: nil
      }
    end
  end

  defp identify_peak_participation(active_by_time) do
    if map_size(active_by_time) > 0 do
      {peak_time, count} = Enum.max_by(active_by_time, fn {_time, count} -> count end)

      %{
        time: DateTime.from_unix!(peak_time),
        participant_count: count
      }
    else
      nil
    end
  end

  defp identify_peak_destruction(timeline) do
    if length(timeline) > 0 do
      peak_kill = Enum.max_by(timeline, & &1.isk_value, fn -> nil end)

      case peak_kill do
        nil ->
          nil

        kill ->
          %{
            time: kill.time,
            killmail_id: kill.killmail_id,
            isk_value: kill.isk_value,
            ship_class: kill.victim_ship_class
          }
      end
    else
      nil
    end
  end

  defp track_system_movements(timeline) do
    # Track how the battle moved between systems
    systems =
      timeline
      |> Enum.map(& &1.solar_system_id)
      |> Enum.uniq()

    system_timeline =
      timeline
      |> Enum.group_by(& &1.solar_system_id)
      |> Enum.map(fn {system_id, events} ->
        {system_id,
         %{
           kill_count: length(events),
           first_activity: List.first(events).time,
           last_activity: List.last(events).time,
           total_isk_destroyed: Enum.sum(Enum.map(events, & &1.isk_value))
         }}
      end)
      |> Enum.into(%{})

    %{
      systems_involved: systems,
      system_count: length(systems),
      primary_system: identify_primary_system(system_timeline),
      system_progression: build_system_progression(timeline)
    }
  end

  defp identify_primary_system(system_timeline) do
    if map_size(system_timeline) > 0 do
      {system_id, data} =
        system_timeline
        |> Enum.max_by(fn {_id, data} -> data.kill_count end)

      %{
        system_id: system_id,
        kill_count: data.kill_count,
        isk_destroyed: data.total_isk_destroyed
      }
    else
      nil
    end
  end

  defp build_system_progression(timeline) do
    # Show how battle moved between systems
    timeline
    |> Enum.chunk_every(2, 1, :discard)
    |> Enum.filter(fn [a, b] -> a.solar_system_id != b.solar_system_id end)
    |> Enum.map(fn [from, to] ->
      %{
        from_system: from.solar_system_id,
        to_system: to.solar_system_id,
        time: to.time,
        transition_interval: DateTime.diff(to.time, from.time)
      }
    end)
  end

  defp summarize_engagement_activity(participants_with_activity) do
    # Summarize overall engagement activity
    all_activities = Enum.map(participants_with_activity, & &1.activity)

    %{
      total_kills: Enum.sum(Enum.map(all_activities, & &1.kills)),
      total_participants: length(participants_with_activity),
      total_damage_dealt: Enum.sum(Enum.map(all_activities, & &1.damage_dealt)),
      average_contribution: calculate_average_contribution(all_activities),
      top_contributors: identify_top_contributors(participants_with_activity, 5),
      activity_distribution: analyze_activity_distribution(all_activities)
    }
  end

  defp calculate_average_contribution(activities) do
    if length(activities) > 0 do
      total = Enum.sum(Enum.map(activities, & &1.contribution_score))
      Float.round(total / length(activities), 3)
    else
      0
    end
  end

  defp identify_top_contributors(participants_with_activity, count) do
    participants_with_activity
    |> Enum.sort_by(fn p -> -get_in(p, [:activity, :contribution_score]) end)
    |> Enum.take(count)
    |> Enum.map(fn p ->
      %{
        character_id: p.character_id,
        character_name: p.character_name,
        ship_name: p.ship_name,
        contribution_score: p.activity.contribution_score,
        kills: p.activity.kills,
        damage_dealt: p.activity.damage_dealt,
        final_blows: p.activity.final_blows
      }
    end)
  end

  defp analyze_activity_distribution(activities) do
    # Analyze how activity is distributed
    kill_distribution =
      activities
      |> Enum.map(& &1.kills)
      |> calculate_distribution_stats()

    damage_distribution =
      activities
      |> Enum.map(& &1.damage_dealt)
      |> calculate_distribution_stats()

    %{
      kill_distribution: kill_distribution,
      damage_distribution: damage_distribution,
      participation_levels: categorize_participation_levels(activities)
    }
  end

  defp calculate_distribution_stats(values) do
    if length(values) > 0 do
      sorted = Enum.sort(values)

      %{
        min: List.first(sorted),
        max: List.last(sorted),
        mean: Float.round(Enum.sum(values) / length(values), 1),
        median: Enum.at(sorted, div(length(sorted), 2)),
        total: Enum.sum(values)
      }
    else
      %{min: 0, max: 0, mean: 0, median: 0, total: 0}
    end
  end

  defp categorize_participation_levels(activities) do
    activities
    |> Enum.map(fn activity ->
      cond do
        activity.contribution_score >= 0.8 -> :very_high
        activity.contribution_score >= 0.6 -> :high
        activity.contribution_score >= 0.4 -> :moderate
        activity.contribution_score >= 0.2 -> :low
        true -> :minimal
      end
    end)
    |> Enum.frequencies()
  end

  defp count_participant_kills(participant, _killmails) do
    # Keep for backward compatibility
    if participant.participant_type == :attacker, do: 1, else: 0
  end

  defp count_participant_deaths(participant, _killmails) do
    # Keep for backward compatibility
    if participant.participant_type == :victim, do: 1, else: 0
  end

  defp calculate_damage_dealt(participant, _killmails) do
    # Keep for backward compatibility
    if participant.participant_type == :attacker, do: 10_000, else: 0
  end

  defp calculate_damage_received(participant, _killmails) do
    # Keep for backward compatibility
    if participant.participant_type == :victim, do: 50_000, else: 0
  end


  # Helper functions from previous extractors
  defp determine_tactical_role(ship_name) when is_binary(ship_name) do
    cond do
      ship_name =~ "Logistics" -> :logistics
      ship_name =~ "Command" -> :command
      ship_name =~ "Interceptor" -> :tackle
      ship_name =~ "Dictor" -> :interdiction
      ship_name =~ "Recon" -> :ewar
      ship_name =~ "Covert" -> :stealth
      ship_name =~ "Bomber" -> :bomber
      ship_name =~ "Dreadnought" -> :siege
      ship_name =~ "Carrier" -> :carrier
      true -> :dps
    end
  end

  defp determine_tactical_role(_), do: :unknown

  defp classify_ship_class(ship_name) when is_binary(ship_name) do
    cond do
      ship_name =~ "Frigate" -> :frigate
      ship_name =~ "Destroyer" -> :destroyer
      ship_name =~ "Cruiser" -> :cruiser
      ship_name =~ "Battlecruiser" -> :battlecruiser
      ship_name =~ "Battleship" -> :battleship
      ship_name =~ "Dreadnought" -> :dreadnought
      ship_name =~ "Carrier" -> :carrier
      ship_name =~ "Supercarrier" -> :supercarrier
      ship_name =~ "Titan" -> :titan
      ship_name =~ "Logistics" -> :logistics
      ship_name =~ "Command" -> :command
      true -> :unknown
    end
  end

  defp classify_ship_class(_), do: :unknown

  defp estimate_experience_level(_participant) do
    # For now, return basic experience estimation
    # TODO: Implement sophisticated experience estimation

    :experienced
  end

  # Enhanced threat rating and historical performance systems
  def calculate_comprehensive_threat_rating(participant) do
    # Comprehensive threat rating system using multiple data sources
    Logger.debug("Calculating comprehensive threat rating for character #{participant.character_id}")
    
    # Fetch comprehensive historical data
    historical_data = fetch_threat_assessment_data(participant)
    
    # Calculate multi-dimensional threat components
    combat_threat = calculate_combat_threat_score(historical_data, participant)
    tactical_threat = calculate_tactical_threat_score(historical_data, participant)
    behavioral_threat = calculate_behavioral_threat_score(historical_data, participant)
    equipment_threat = calculate_equipment_threat_score(historical_data, participant)
    network_threat = calculate_network_threat_score(historical_data, participant)
    
    # Composite threat rating with confidence intervals
    composite_score = calculate_composite_threat_score({
      combat_threat, tactical_threat, behavioral_threat, equipment_threat, network_threat
    })
    
    threat_level = classify_threat_level(composite_score)
    confidence = calculate_threat_confidence(historical_data)
    
    %{
      overall_threat_rating: Float.round(composite_score, 2),
      threat_level: threat_level,
      confidence: confidence,
      threat_components: %{
        combat: combat_threat,
        tactical: tactical_threat,
        behavioral: behavioral_threat,
        equipment: equipment_threat,
        network: network_threat
      },
      threat_factors: identify_primary_threat_factors(historical_data, participant),
      threat_trend: analyze_threat_trend(historical_data),
      recommendations: generate_threat_mitigation_recommendations(threat_level, historical_data)
    }
  end

  def get_comprehensive_historical_performance(participant) do
    # Comprehensive historical performance analysis with detailed metrics
    Logger.debug("Fetching comprehensive historical performance for character #{participant.character_id}")
    
    # Fetch multi-timeframe historical data
    performance_data = fetch_performance_analysis_data(participant)
    
    # Calculate performance metrics across different timeframes
    performance_metrics = calculate_performance_metrics(performance_data)
    performance_trends = analyze_performance_trends(performance_data)
    performance_benchmarks = calculate_performance_benchmarks(performance_data, participant)
    
    # Analyze performance in different contexts
    ship_performance = analyze_ship_class_performance(performance_data)
    system_performance = analyze_system_type_performance(performance_data)
    fleet_performance = analyze_fleet_size_performance(performance_data)
    
    %{
      performance_summary: performance_metrics,
      performance_trends: performance_trends,
      performance_benchmarks: performance_benchmarks,
      contextual_performance: %{
        by_ship_class: ship_performance,
        by_system_type: system_performance,
        by_fleet_size: fleet_performance
      },
      performance_consistency: calculate_performance_consistency(performance_data),
      peak_performance_periods: identify_peak_performance_periods(performance_data),
      performance_decline_indicators: identify_performance_decline_indicators(performance_data),
      comparative_analysis: generate_comparative_performance_analysis(performance_data, participant)
    }
  end

  def create_threat_intelligence_profile(participant) do
    # Create comprehensive threat intelligence profile combining multiple analyses
    Logger.debug("Creating threat intelligence profile for character #{participant.character_id}")
    
    threat_rating = calculate_comprehensive_threat_rating(participant)
    historical_performance = get_comprehensive_historical_performance(participant)
    
    # Additional intelligence components
    activity_patterns = analyze_detailed_activity_patterns(participant)
    network_analysis = analyze_pilot_network_connections(participant)
    predictive_assessment = generate_predictive_threat_assessment(threat_rating, historical_performance)
    
    %{
      participant_id: participant.character_id,
      threat_assessment: threat_rating,
      historical_performance: historical_performance,
      activity_intelligence: activity_patterns,
      network_intelligence: network_analysis,
      predictive_assessment: predictive_assessment,
      intelligence_summary: generate_intelligence_summary(threat_rating, historical_performance, activity_patterns),
      last_updated: DateTime.utc_now(),
      data_confidence: calculate_overall_data_confidence(threat_rating, historical_performance)
    }
  end

  defp fetch_threat_assessment_data(participant) do
    character_id = participant.character_id
    
    if is_nil(character_id) do
      %{}
    else
      # Extended threat assessment query (18 months of data)
      eighteen_months_ago = DateTime.add(DateTime.utc_now(), -18 * 30 * 24 * 3600, :second)
      
      query = """
      WITH threat_analysis AS (
        SELECT 
          COALESCE(victim_character_id, (a->>'character_id')::bigint) as character_id,
          k.killmail_time,
          k.solar_system_id,
          k.attacker_count,
          (k.raw_data->'zkb'->>'totalValue')::bigint as total_value,
          (a->>'ship_type_id')::integer as ship_type_id,
          (a->>'weapon_type_id')::integer as weapon_type_id,
          (a->>'damage_done')::integer as damage_done,
          (a->>'final_blow')::boolean as final_blow,
          (a->>'security_status')::float as security_status,
          victim_character_id IS NULL as is_kill,
          victim_character_id IS NOT NULL as is_death,
          CASE WHEN k.attacker_count = 1 THEN 1 ELSE 0 END as is_solo,
          -- System security classification
          CASE 
            WHEN k.solar_system_id >= 30000000 AND k.solar_system_id < 31000000 THEN 'highsec'
            WHEN k.solar_system_id >= 31000000 AND k.solar_system_id < 32000000 THEN 'lowsec'
            WHEN k.solar_system_id >= 32000000 THEN 'nullsec'
            ELSE 'unknown'
          END as space_type,
          -- Time-based analysis
          DATE_PART('hour', k.killmail_time) as kill_hour,
          DATE_PART('dow', k.killmail_time) as kill_dow,
          -- Value-based metrics
          CASE 
            WHEN (k.raw_data->'zkb'->>'totalValue')::bigint >= 1000000000 THEN 'capital'
            WHEN (k.raw_data->'zkb'->>'totalValue')::bigint >= 100000000 THEN 'expensive'
            WHEN (k.raw_data->'zkb'->>'totalValue')::bigint >= 10000000 THEN 'moderate'
            ELSE 'cheap'
          END as value_tier
        FROM killmails_raw k
        CROSS JOIN LATERAL jsonb_array_elements(k.raw_data->'attackers') AS a
        WHERE k.killmail_time >= $1 
          AND (
            k.victim_character_id = $2 OR 
            (a->>'character_id')::bigint = $2
          )
      )
      SELECT 
        COUNT(*) as total_engagements,
        SUM(is_kill::int) as total_kills,
        SUM(is_death::int) as total_deaths,
        SUM(final_blow::int) as final_blows,
        SUM(is_solo::int) as solo_engagements,
        AVG(total_value) as avg_kill_value,
        MAX(total_value) as max_kill_value,
        COUNT(DISTINCT solar_system_id) as systems_visited,
        COUNT(DISTINCT ship_type_id) as ships_used,
        COUNT(DISTINCT weapon_type_id) as weapons_used,
        AVG(security_status) as avg_security_status,
        MIN(killmail_time) as first_seen,
        MAX(killmail_time) as last_seen,
        -- Space type distribution
        SUM(CASE WHEN space_type = 'highsec' THEN 1 ELSE 0 END) as highsec_activity,
        SUM(CASE WHEN space_type = 'lowsec' THEN 1 ELSE 0 END) as lowsec_activity,
        SUM(CASE WHEN space_type = 'nullsec' THEN 1 ELSE 0 END) as nullsec_activity,
        -- Value tier distribution
        SUM(CASE WHEN value_tier = 'capital' THEN 1 ELSE 0 END) as capital_engagements,
        SUM(CASE WHEN value_tier = 'expensive' THEN 1 ELSE 0 END) as expensive_engagements,
        -- Time pattern analysis
        array_agg(DISTINCT kill_hour ORDER BY kill_hour) as active_hours,
        array_agg(DISTINCT kill_dow ORDER BY kill_dow) as active_days,
        -- Recent activity (last 30 days)
        SUM(CASE WHEN killmail_time >= CURRENT_TIMESTAMP - INTERVAL '30 days' THEN 1 ELSE 0 END) as recent_activity,
        SUM(CASE WHEN killmail_time >= CURRENT_TIMESTAMP - INTERVAL '30 days' AND is_kill = 1 THEN 1 ELSE 0 END) as recent_kills
      FROM threat_analysis
      WHERE character_id = $2
      """
      
      case Ecto.Adapters.SQL.query(EveDmv.Repo, query, [eighteen_months_ago, character_id]) do
        {:ok, %{rows: [[total_eng, total_kills, total_deaths, final_blows, solo_eng, avg_value, max_value,
                        systems, ships, weapons, avg_sec, first_seen, last_seen, highsec, lowsec, nullsec,
                        capital_eng, expensive_eng, active_hours, active_days, recent_activity, recent_kills]]}} ->
          %{
            total_engagements: total_eng || 0,
            total_kills: total_kills || 0,
            total_deaths: total_deaths || 0,
            final_blows: final_blows || 0,
            solo_engagements: solo_eng || 0,
            avg_kill_value: avg_value || 0,
            max_kill_value: max_value || 0,
            systems_visited: systems || 0,
            ships_used: ships || 0,
            weapons_used: weapons || 0,
            avg_security_status: avg_sec || 0.0,
            first_seen: first_seen,
            last_seen: last_seen,
            space_distribution: %{
              highsec: highsec || 0,
              lowsec: lowsec || 0,
              nullsec: nullsec || 0
            },
            value_distribution: %{
              capital_engagements: capital_eng || 0,
              expensive_engagements: expensive_eng || 0
            },
            time_patterns: %{
              active_hours: active_hours || [],
              active_days: active_days || []
            },
            recent_metrics: %{
              recent_activity: recent_activity || 0,
              recent_kills: recent_kills || 0
            }
          }
        
        {:ok, %{rows: []}} ->
          %{total_engagements: 0}
        
        {:error, _} ->
          Logger.warning("Failed to fetch threat assessment data for character #{character_id}")
          %{total_engagements: 0}
      end
    end
  end

  defp fetch_performance_analysis_data(participant) do
    character_id = participant.character_id
    
    if is_nil(character_id) do
      %{}
    else
      # Performance analysis with monthly breakdown
      twelve_months_ago = DateTime.add(DateTime.utc_now(), -12 * 30 * 24 * 3600, :second)
      
      query = """
      WITH monthly_performance AS (
        SELECT 
          DATE_TRUNC('month', k.killmail_time) as month,
          COALESCE(victim_character_id, (a->>'character_id')::bigint) as character_id,
          COUNT(*) as engagements,
          SUM(CASE WHEN victim_character_id IS NULL THEN 1 ELSE 0 END) as kills,
          SUM(CASE WHEN victim_character_id IS NOT NULL THEN 1 ELSE 0 END) as deaths,
          AVG((k.raw_data->'zkb'->>'totalValue')::bigint) as avg_isk_value,
          COUNT(CASE WHEN k.attacker_count = 1 THEN 1 END) as solo_activity,
          COUNT(DISTINCT k.solar_system_id) as system_diversity,
          COUNT(DISTINCT (a->>'ship_type_id')::integer) as ship_diversity
        FROM killmails_raw k
        CROSS JOIN LATERAL jsonb_array_elements(k.raw_data->'attackers') AS a
        WHERE k.killmail_time >= $1 
          AND (
            k.victim_character_id = $2 OR 
            (a->>'character_id')::bigint = $2
          )
        GROUP BY DATE_TRUNC('month', k.killmail_time), COALESCE(victim_character_id, (a->>'character_id')::bigint)
      )
      SELECT 
        month,
        engagements,
        kills,
        deaths,
        CASE WHEN deaths > 0 THEN kills::float / deaths ELSE kills::float END as kd_ratio,
        avg_isk_value,
        solo_activity,
        system_diversity,
        ship_diversity,
        CASE WHEN engagements > 0 THEN kills::float / engagements ELSE 0 END as kill_efficiency
      FROM monthly_performance
      WHERE character_id = $2
      ORDER BY month DESC
      """
      
      case Ecto.Adapters.SQL.query(EveDmv.Repo, query, [twelve_months_ago, character_id]) do
        {:ok, result} ->
          monthly_data = result.rows
          |> Enum.map(fn [month, engagements, kills, deaths, kd_ratio, avg_isk, solo, systems, ships, efficiency] ->
            %{
              month: month,
              engagements: engagements || 0,
              kills: kills || 0,
              deaths: deaths || 0,
              kd_ratio: kd_ratio || 0.0,
              avg_isk_value: avg_isk || 0,
              solo_activity: solo || 0,
              system_diversity: systems || 0,
              ship_diversity: ships || 0,
              kill_efficiency: efficiency || 0.0
            }
          end)
          
          %{monthly_performance: monthly_data}
        
        {:error, _} ->
          Logger.warning("Failed to fetch performance analysis data for character #{character_id}")
          %{monthly_performance: []}
      end
    end
  end

  defp calculate_combat_threat_score(historical_data, participant) do
    # Combat effectiveness threat scoring
    total_kills = Map.get(historical_data, :total_kills, 0)
    total_deaths = Map.get(historical_data, :total_deaths, 0)
    final_blows = Map.get(historical_data, :final_blows, 0)
    solo_engagements = Map.get(historical_data, :solo_engagements, 0)
    
    # Base combat scoring
    kill_score = min(1.0, total_kills / 500) * 0.4
    kd_ratio = if total_deaths > 0, do: total_kills / total_deaths, else: total_kills
    kd_score = min(1.0, kd_ratio / 3.0) * 0.3
    final_blow_score = min(1.0, final_blows / 200) * 0.2
    solo_score = min(1.0, solo_engagements / 100) * 0.1
    
    Float.round(kill_score + kd_score + final_blow_score + solo_score, 3)
  end

  defp calculate_tactical_threat_score(historical_data, participant) do
    # Tactical sophistication threat scoring
    systems_visited = Map.get(historical_data, :systems_visited, 0)
    ships_used = Map.get(historical_data, :ships_used, 0)
    weapons_used = Map.get(historical_data, :weapons_used, 0)
    space_dist = Map.get(historical_data, :space_distribution, %{})
    
    # Tactical complexity scoring
    mobility_score = min(1.0, systems_visited / 100) * 0.3
    versatility_score = min(1.0, ships_used / 20) * 0.3
    weapon_diversity_score = min(1.0, weapons_used / 15) * 0.2
    
    # Space type tactical scoring
    nullsec_activity = Map.get(space_dist, :nullsec, 0)
    lowsec_activity = Map.get(space_dist, :lowsec, 0)
    total_activity = nullsec_activity + lowsec_activity + Map.get(space_dist, :highsec, 0)
    
    space_tactical_score = if total_activity > 0 do
      dangerous_space_ratio = (nullsec_activity + lowsec_activity) / total_activity
      min(1.0, dangerous_space_ratio) * 0.2
    else
      0.0
    end
    
    Float.round(mobility_score + versatility_score + weapon_diversity_score + space_tactical_score, 3)
  end

  defp calculate_behavioral_threat_score(historical_data, participant) do
    # Behavioral pattern threat scoring
    avg_security_status = Map.get(historical_data, :avg_security_status, 0.0)
    recent_metrics = Map.get(historical_data, :recent_metrics, %{})
    time_patterns = Map.get(historical_data, :time_patterns, %{})
    
    # Security status scoring (lower security = higher threat)
    security_threat_score = if avg_security_status < 0 do
      min(1.0, abs(avg_security_status) / 5.0) * 0.4
    else
      max(0.0, (5.0 - avg_security_status) / 5.0) * 0.2
    end
    
    # Activity consistency scoring
    recent_activity = Map.get(recent_metrics, :recent_activity, 0)
    total_engagements = Map.get(historical_data, :total_engagements, 0)
    activity_consistency = if total_engagements > 0 do
      recent_ratio = recent_activity / max(total_engagements, 1)
      min(1.0, recent_ratio * 30) * 0.3  # Scale for monthly activity
    else
      0.0
    end
    
    # Time pattern diversity (active across multiple time zones)
    active_hours = Map.get(time_patterns, :active_hours, [])
    time_diversity_score = min(1.0, length(active_hours) / 12) * 0.3
    
    Float.round(security_threat_score + activity_consistency + time_diversity_score, 3)
  end

  defp calculate_equipment_threat_score(historical_data, participant) do
    # Equipment and ISK threat scoring
    avg_kill_value = Map.get(historical_data, :avg_kill_value, 0)
    max_kill_value = Map.get(historical_data, :max_kill_value, 0)
    value_dist = Map.get(historical_data, :value_distribution, %{})
    
    # Average ISK threat
    avg_isk_threat = cond do
      avg_kill_value >= 100_000_000 -> 1.0
      avg_kill_value >= 50_000_000 -> 0.8
      avg_kill_value >= 20_000_000 -> 0.6
      avg_kill_value >= 10_000_000 -> 0.4
      avg_kill_value >= 5_000_000 -> 0.2
      true -> 0.1
    end
    
    # Capital engagement threat
    capital_engagements = Map.get(value_dist, :capital_engagements, 0)
    capital_threat = min(1.0, capital_engagements / 10) * 0.4
    
    # High-value target threat
    expensive_engagements = Map.get(value_dist, :expensive_engagements, 0)
    expensive_threat = min(1.0, expensive_engagements / 50) * 0.3
    
    Float.round((avg_isk_threat * 0.3) + capital_threat + expensive_threat, 3)
  end

  defp calculate_network_threat_score(historical_data, participant) do
    # Network and coordination threat scoring (simplified for now)
    solo_engagements = Map.get(historical_data, :solo_engagements, 0)
    total_engagements = Map.get(historical_data, :total_engagements, 0)
    
    # Calculate fleet coordination tendency
    if total_engagements > 0 do
      fleet_ratio = (total_engagements - solo_engagements) / total_engagements
      coordination_score = min(1.0, fleet_ratio) * 0.6
      
      # Add system diversity as network indicator
      systems_visited = Map.get(historical_data, :systems_visited, 0)
      network_mobility = min(1.0, systems_visited / 50) * 0.4
      
      Float.round(coordination_score + network_mobility, 3)
    else
      0.0
    end
  end

  defp calculate_composite_threat_score({combat, tactical, behavioral, equipment, network}) do
    # Weighted composite threat score
    (combat * 0.35) + (tactical * 0.25) + (behavioral * 0.2) + (equipment * 0.15) + (network * 0.05)
  end

  defp classify_threat_level(composite_score) do
    cond do
      composite_score >= 0.9 -> :extreme
      composite_score >= 0.75 -> :very_high  
      composite_score >= 0.6 -> :high
      composite_score >= 0.4 -> :moderate
      composite_score >= 0.2 -> :low
      true -> :minimal
    end
  end

  # Supporting functions for comprehensive specialization identification

  defp combine_specializations(all_specializations) do
    %{
      combat: all_specializations.combat,
      tactical: all_specializations.tactical,
      ship: all_specializations.ship,
      weapon: all_specializations.weapon,
      role: all_specializations.role,
      behavioral: all_specializations.behavioral
    }
  end

  defp determine_primary_specialization(combined_specializations, specialization_data) do
    # Score each category based on strength and confidence
    scores = %{
      combat: calculate_specialization_category_score(combined_specializations.combat, specialization_data),
      tactical: calculate_specialization_category_score(combined_specializations.tactical, specialization_data),
      ship: calculate_specialization_category_score(combined_specializations.ship, specialization_data),
      weapon: calculate_specialization_category_score(combined_specializations.weapon, specialization_data),
      role: calculate_specialization_category_score(combined_specializations.role, specialization_data),
      behavioral: calculate_specialization_category_score(combined_specializations.behavioral, specialization_data)
    }
    
    # Find highest scoring category
    {primary_category, _score} = Enum.max_by(scores, fn {_category, score} -> score end)
    
    # Get the strongest specialization in that category
    primary_specializations = Map.get(combined_specializations, primary_category, [])
    if length(primary_specializations) > 0 do
      Enum.max_by(primary_specializations, fn spec -> spec.strength end)
    else
      %{name: :generalist, strength: 0.5, confidence: 0.5}
    end
  end

  defp calculate_specialization_confidence(specialization_data) do
    # Base confidence on data completeness and consistency
    total_engagements = Map.get(specialization_data, :total_engagements, 0)
    data_months = Map.get(specialization_data, :data_months, 0)
    
    base_confidence = cond do
      total_engagements >= 100 and data_months >= 6 -> 0.9
      total_engagements >= 50 and data_months >= 3 -> 0.7
      total_engagements >= 20 and data_months >= 2 -> 0.5
      total_engagements >= 10 -> 0.3
      true -> 0.1
    end
    
    # Adjust for pattern consistency
    pattern_consistency = calculate_pattern_consistency(specialization_data)
    Float.round(base_confidence * pattern_consistency, 2)
  end

  defp analyze_specialization_evolution(specialization_data) do
    monthly_data = Map.get(specialization_data, :monthly_patterns, [])
    
    if length(monthly_data) < 3 do
      %{trend: :insufficient_data, change_rate: 0.0, stability: :unknown}
    else
      # Analyze trends in the last 6 months
      recent_months = Enum.take(monthly_data, 6)
      
      # Calculate trend in primary metrics
      kill_trend = calculate_metric_trend(recent_months, :kill_efficiency)
      ship_diversity_trend = calculate_metric_trend(recent_months, :ship_diversity)
      system_diversity_trend = calculate_metric_trend(recent_months, :system_diversity)
      
      # Determine overall evolution trend
      trend = determine_evolution_trend(kill_trend, ship_diversity_trend, system_diversity_trend)
      change_rate = abs(kill_trend) + abs(ship_diversity_trend) + abs(system_diversity_trend)
      stability = if change_rate < 0.1, do: :stable, else: :evolving
      
      %{
        trend: trend,
        change_rate: Float.round(change_rate / 3, 3),
        stability: stability,
        kill_trend: kill_trend,
        ship_diversity_trend: ship_diversity_trend,
        system_diversity_trend: system_diversity_trend
      }
    end
  end

  defp calculate_specialization_strength(specialization, data) do
    # Calculate strength based on specialization type and supporting data
    case specialization do
      %{name: :finisher} ->
        final_blow_rate = Map.get(data, :final_blow_rate, 0.0)
        min(1.0, final_blow_rate * 3.0)
        
      %{name: :heavy_damage_dealer} ->
        avg_damage_ratio = Map.get(data, :avg_damage_ratio, 0.0)
        min(1.0, avg_damage_ratio * 2.0)
        
      %{name: :solo_hunter} ->
        solo_rate = Map.get(data, :solo_rate, 0.0)
        min(1.0, solo_rate * 2.0)
        
      %{name: :fleet_combatant} ->
        fleet_rate = Map.get(data, :fleet_rate, 0.0)
        min(1.0, fleet_rate * 1.5)
        
      _ ->
        0.5  # Default moderate strength
    end
  end

  defp generate_specialization_recommendations(specializations, participant) do
    primary = Map.get(specializations, :primary, %{})
    
    case primary do
      %{name: :solo_hunter} ->
        ["Focus on interceptor and assault frigate training",
         "Develop advanced scanning and reconnaissance skills",
         "Consider stealth bomber specialization for high-value targets"]
         
      %{name: :fleet_combatant} ->
        ["Enhance logistics and support ship capabilities",
         "Develop fleet command and coordination skills",
         "Consider heavy assault cruiser or battleship specialization"]
         
      %{name: :finisher} ->
        ["Focus on high-alpha weapon systems",
         "Develop precision targeting and positioning skills",
         "Consider interceptor training for quick engagement closure"]
         
      _ ->
        ["Continue developing current tactical approach",
         "Consider exploring new ship classes",
         "Focus on improving kill/death efficiency"]
    end
  end

  defp generate_specialization_counter_strategies(specializations, participant) do
    primary = Map.get(specializations, :primary, %{})
    
    case primary do
      %{name: :solo_hunter} ->
        ["Use bait tactics to draw them into disadvantageous positions",
         "Employ multiple tackle ships to prevent escape",
         "Use overwhelming numbers to counter their mobility advantage"]
         
      %{name: :fleet_combatant} ->
        ["Focus fire to break their logistics chain",
         "Use hit-and-run tactics to avoid prolonged engagement",
         "Target their command ships and force multipliers first"]
         
      %{name: :finisher} ->
        ["Maintain range to prevent final blow opportunities",
         "Use ECM and tracking disruption to reduce their effectiveness",
         "Focus on keeping primary targets above critical damage thresholds"]
         
      _ ->
        ["Maintain tactical flexibility",
         "Use superior numbers or positioning",
         "Focus on objectives rather than direct confrontation"]
    end
  end

  defp fetch_combat_pattern_data(participant) do
    character_id = participant.character_id
    fifteen_months_ago = DateTime.add(DateTime.utc_now(), -15 * 30 * 24 * 3600, :second)
    
    # Enhanced query for combat patterns
    query = """
    WITH combat_patterns AS (
      SELECT 
        k.killmail_time,
        k.attacker_count,
        COALESCE(k.victim_character_id, (a->>'character_id')::bigint) as character_id,
        CASE WHEN k.victim_character_id IS NULL THEN 'attacker' ELSE 'victim' END as role,
        COALESCE(k.victim_ship_type_id, (a->>'ship_type_id')::integer) as ship_type_id,
        COALESCE((a->>'weapon_type_id')::integer, 0) as weapon_type_id,
        COALESCE((a->>'damage_done')::bigint, k.raw_data->'victim'->>'damage_taken'::bigint) as damage,
        COALESCE((a->>'final_blow')::boolean, false) as final_blow,
        (k.raw_data->'zkb'->>'totalValue')::bigint as total_value,
        k.solar_system_id,
        EXTRACT(hour FROM k.killmail_time) as hour_of_day,
        EXTRACT(dow FROM k.killmail_time) as day_of_week
      FROM killmails_raw k
      CROSS JOIN LATERAL jsonb_array_elements(k.raw_data->'attackers') AS a
      WHERE k.killmail_time >= $1 
        AND (
          k.victim_character_id = $2 OR 
          (a->>'character_id')::bigint = $2
        )
    )
    SELECT 
      role,
      ship_type_id,
      weapon_type_id,
      COUNT(*) as frequency,
      AVG(damage) as avg_damage,
      SUM(CASE WHEN final_blow THEN 1 ELSE 0 END) as final_blows,
      AVG(total_value) as avg_kill_value,
      AVG(attacker_count) as avg_fleet_size,
      COUNT(DISTINCT solar_system_id) as system_diversity,
      AVG(hour_of_day) as avg_hour,
      COUNT(DISTINCT day_of_week) as day_diversity
    FROM combat_patterns
    WHERE character_id = $2
    GROUP BY role, ship_type_id, weapon_type_id
    ORDER BY frequency DESC
    """
    
    case Ecto.Adapters.SQL.query(EveDmv.Repo, query, [fifteen_months_ago, character_id]) do
      {:ok, result} ->
        patterns = result.rows
        |> Enum.map(fn [role, ship_id, weapon_id, freq, avg_dmg, final_blows, avg_value, avg_fleet, sys_div, avg_hour, day_div] ->
          %{
            role: role,
            ship_type_id: ship_id,
            weapon_type_id: weapon_id,
            frequency: freq || 0,
            avg_damage: avg_dmg || 0,
            final_blows: final_blows || 0,
            avg_kill_value: avg_value || 0,
            avg_fleet_size: avg_fleet || 0,
            system_diversity: sys_div || 0,
            avg_hour: avg_hour || 12,
            day_diversity: day_div || 1
          }
        end)
        
        %{patterns: patterns}
        
      {:error, _} ->
        Logger.warning("Failed to fetch combat pattern data for character #{character_id}")
        %{patterns: []}
    end
  end

  # Helper functions for specialization analysis

  defp calculate_specialization_category_score(specializations, _data) do
    if length(specializations) > 0 do
      avg_strength = Enum.reduce(specializations, 0.0, fn spec, acc -> 
        acc + Map.get(spec, :strength, 0.0) 
      end) / length(specializations)
      
      avg_confidence = Enum.reduce(specializations, 0.0, fn spec, acc -> 
        acc + Map.get(spec, :confidence, 0.0) 
      end) / length(specializations)
      
      (avg_strength + avg_confidence) / 2
    else
      0.0
    end
  end

  defp calculate_pattern_consistency(data) do
    # Simple consistency check based on data variance
    monthly_data = Map.get(data, :monthly_patterns, [])
    
    if length(monthly_data) < 2 do
      0.5  # Default moderate consistency
    else
      # Calculate coefficient of variation for key metrics
      kill_efficiencies = Enum.map(monthly_data, &Map.get(&1, :kill_efficiency, 0.0))
      ship_diversities = Enum.map(monthly_data, &Map.get(&1, :ship_diversity, 0.0))
      
      kill_cv = coefficient_of_variation(kill_efficiencies)
      ship_cv = coefficient_of_variation(ship_diversities)
      
      # Lower CV = higher consistency
      consistency = 1.0 - min(1.0, (kill_cv + ship_cv) / 2)
      max(0.1, consistency)
    end
  end

  defp calculate_metric_trend(monthly_data, metric) do
    values = Enum.map(monthly_data, &Map.get(&1, metric, 0.0))
    
    if length(values) < 2 do
      0.0
    else
      # Simple linear trend calculation
      indexed_values = Enum.with_index(values)
      n = length(values)
      
      sum_x = n * (n - 1) / 2
      sum_y = Enum.sum(values)
      sum_xy = Enum.reduce(indexed_values, 0, fn {val, idx}, acc -> acc + val * idx end)
      sum_x2 = Enum.reduce(0..(n-1), 0, fn idx, acc -> acc + idx * idx end)
      
      if n * sum_x2 - sum_x * sum_x != 0 do
        (n * sum_xy - sum_x * sum_y) / (n * sum_x2 - sum_x * sum_x)
      else
        0.0
      end
    end
  end

  defp determine_evolution_trend(kill_trend, ship_trend, system_trend) do
    total_trend = kill_trend + ship_trend + system_trend
    
    cond do
      total_trend > 0.1 -> :improving
      total_trend < -0.1 -> :declining  
      abs(total_trend) < 0.05 -> :stable
      true -> :fluctuating
    end
  end

  defp coefficient_of_variation(values) do
    if length(values) < 2 do
      0.0
    else
      mean = Enum.sum(values) / length(values)
      if mean == 0 do
        0.0
      else
        variance = Enum.reduce(values, 0, fn val, acc -> 
          acc + :math.pow(val - mean, 2) 
        end) / length(values)
        std_dev = :math.sqrt(variance)
        std_dev / mean
      end
    end
  end

  # Enhanced specialization analysis functions

  defp identify_combat_specializations(specialization_data, participant) do
    patterns = Map.get(specialization_data, :patterns, [])
    attacker_patterns = Enum.filter(patterns, &(&1.role == "attacker"))
    
    combat_specs = []
    
    # Finisher specialization
    total_engagements = Enum.reduce(attacker_patterns, 0, &(&1.frequency + &2))
    total_final_blows = Enum.reduce(attacker_patterns, 0, &(&1.final_blows + &2))
    final_blow_rate = if total_engagements > 0, do: total_final_blows / total_engagements, else: 0.0
    
    combat_specs = if final_blow_rate > 0.4 do
      [%{name: :finisher, strength: min(1.0, final_blow_rate * 2), confidence: calculate_confidence_from_data(total_engagements)} | combat_specs]
    else
      combat_specs
    end
    
    # Heavy damage dealer
    avg_damage = Enum.reduce(attacker_patterns, 0.0, fn pattern, acc ->
      acc + (pattern.avg_damage * pattern.frequency)
    end) / max(total_engagements, 1)
    
    damage_threshold = 5000  # EVE-typical damage threshold
    combat_specs = if avg_damage > damage_threshold do
      strength = min(1.0, avg_damage / (damage_threshold * 2))
      [%{name: :heavy_damage_dealer, strength: strength, confidence: calculate_confidence_from_data(total_engagements)} | combat_specs]
    else
      combat_specs
    end
    
    # Efficient killer
    victim_patterns = Enum.filter(patterns, &(&1.role == "victim"))
    total_deaths = Enum.reduce(victim_patterns, 0, &(&1.frequency + &2))
    kill_efficiency = if total_deaths > 0, do: total_engagements / (total_engagements + total_deaths), else: 1.0
    
    combat_specs = if kill_efficiency > 0.7 do
      [%{name: :efficient_killer, strength: kill_efficiency, confidence: calculate_confidence_from_data(total_engagements + total_deaths)} | combat_specs]
    else
      combat_specs
    end
    
    # Combat specialist (high activity and diverse engagement)
    combat_specs = if total_engagements > 50 and length(attacker_patterns) > 5 do
      [%{name: :combat_specialist, strength: 0.8, confidence: 0.9} | combat_specs]
    else
      combat_specs
    end
    
    combat_specs
  end

  defp identify_tactical_specializations(specialization_data, participant) do
    patterns = Map.get(specialization_data, :patterns, [])
    attacker_patterns = Enum.filter(patterns, &(&1.role == "attacker"))
    
    tactical_specs = []
    
    # Solo hunter
    solo_patterns = Enum.filter(attacker_patterns, &(&1.avg_fleet_size <= 2))
    fleet_patterns = Enum.filter(attacker_patterns, &(&1.avg_fleet_size > 2))
    
    solo_engagements = Enum.reduce(solo_patterns, 0, &(&1.frequency + &2))
    fleet_engagements = Enum.reduce(fleet_patterns, 0, &(&1.frequency + &2))
    total_engagements = solo_engagements + fleet_engagements
    
    solo_rate = if total_engagements > 0, do: solo_engagements / total_engagements, else: 0.0
    
    tactical_specs = if solo_rate > 0.6 do
      [%{name: :solo_hunter, strength: solo_rate, confidence: calculate_confidence_from_data(total_engagements)} | tactical_specs]
    else
      tactical_specs
    end
    
    # Small gang specialist (2-5 person fleets)
    small_gang_patterns = Enum.filter(attacker_patterns, fn pattern -> 
      pattern.avg_fleet_size > 2 and pattern.avg_fleet_size <= 5 
    end)
    small_gang_engagements = Enum.reduce(small_gang_patterns, 0, &(&1.frequency + &2))
    small_gang_rate = if total_engagements > 0, do: small_gang_engagements / total_engagements, else: 0.0
    
    tactical_specs = if small_gang_rate > 0.5 do
      [%{name: :small_gang_specialist, strength: small_gang_rate, confidence: calculate_confidence_from_data(total_engagements)} | tactical_specs]
    else
      tactical_specs
    end
    
    # Fleet combatant (large fleet preference)
    large_fleet_patterns = Enum.filter(attacker_patterns, &(&1.avg_fleet_size > 10))
    large_fleet_engagements = Enum.reduce(large_fleet_patterns, 0, &(&1.frequency + &2))
    fleet_rate = if total_engagements > 0, do: large_fleet_engagements / total_engagements, else: 0.0
    
    tactical_specs = if fleet_rate > 0.4 do
      [%{name: :fleet_combatant, strength: fleet_rate, confidence: calculate_confidence_from_data(total_engagements)} | tactical_specs]
    else
      tactical_specs
    end
    
    # Space type specialists
    total_system_diversity = Enum.reduce(attacker_patterns, 0, &(&1.system_diversity + &2))
    avg_system_diversity = if length(attacker_patterns) > 0, do: total_system_diversity / length(attacker_patterns), else: 0
    
    tactical_specs = if avg_system_diversity > 20 do
      [%{name: :nomadic_hunter, strength: min(1.0, avg_system_diversity / 50), confidence: calculate_confidence_from_data(total_engagements)} | tactical_specs]
    else
      tactical_specs
    end
    
    tactical_specs
  end

  defp identify_ship_specializations(specialization_data, participant) do
    patterns = Map.get(specialization_data, :patterns, [])
    attacker_patterns = Enum.filter(patterns, &(&1.role == "attacker"))
    
    # Group patterns by ship type
    ship_groups = Enum.group_by(attacker_patterns, fn pattern ->
      EveDmv.StaticData.ShipTypes.classify_ship_type(pattern.ship_type_id)
    end)
    
    ship_specs = []
    total_engagements = Enum.reduce(attacker_patterns, 0, &(&1.frequency + &2))
    
    # Identify dominant ship class
    dominant_class = Enum.max_by(ship_groups, fn {_class, patterns} ->
      Enum.reduce(patterns, 0, &(&1.frequency + &2))
    end, fn -> {:unknown, []} end)
    
    case dominant_class do
      {class, class_patterns} when class != :unknown ->
        class_engagements = Enum.reduce(class_patterns, 0, &(&1.frequency + &2))
        class_rate = if total_engagements > 0, do: class_engagements / total_engagements, else: 0.0
        
        if class_rate > 0.6 do
          ship_specs = [%{
            name: :"#{class}_specialist", 
            strength: class_rate, 
            confidence: calculate_confidence_from_data(class_engagements)
          } | ship_specs]
        end
      _ -> nil
    end
    
    # Check for multi-ship pilot
    unique_ships = attacker_patterns |> Enum.map(&(&1.ship_type_id)) |> Enum.uniq() |> length()
    ship_specs = if unique_ships > 8 do
      [%{name: :multi_ship_pilot, strength: min(1.0, unique_ships / 15), confidence: calculate_confidence_from_data(total_engagements)} | ship_specs]
    else
      ship_specs
    end
    
    # Specific ship role specialists
    interceptor_patterns = Enum.filter(attacker_patterns, fn pattern ->
      EveDmv.StaticData.ShipTypes.is_interceptor?(pattern.ship_type_id)
    end)
    interceptor_engagements = Enum.reduce(interceptor_patterns, 0, &(&1.frequency + &2))
    
    ship_specs = if interceptor_engagements > 10 do
      interceptor_rate = interceptor_engagements / max(total_engagements, 1)
      [%{name: :interceptor_specialist, strength: interceptor_rate, confidence: calculate_confidence_from_data(interceptor_engagements)} | ship_specs]
    else
      ship_specs
    end
    
    ship_specs
  end

  defp identify_weapon_specializations(specialization_data, participant) do
    patterns = Map.get(specialization_data, :patterns, [])
    attacker_patterns = Enum.filter(patterns, &(&1.role == "attacker"))
    
    # Group by weapon type
    weapon_groups = Enum.group_by(attacker_patterns, &classify_weapon_type(&1.weapon_type_id))
    weapon_specs = []
    total_engagements = Enum.reduce(attacker_patterns, 0, &(&1.frequency + &2))
    
    Enum.each(weapon_groups, fn {weapon_class, weapon_patterns} ->
      if weapon_class != :unknown do
        weapon_engagements = Enum.reduce(weapon_patterns, 0, &(&1.frequency + &2))
        weapon_rate = if total_engagements > 0, do: weapon_engagements / total_engagements, else: 0.0
        
        if weapon_rate > 0.5 do
          weapon_specs = [%{
            name: :"#{weapon_class}_specialist", 
            strength: weapon_rate, 
            confidence: calculate_confidence_from_data(weapon_engagements)
          } | weapon_specs]
        end
      end
    end)
    
    weapon_specs
  end

  defp identify_role_specializations(specialization_data, participant) do
    patterns = Map.get(specialization_data, :patterns, [])
    attacker_patterns = Enum.filter(patterns, &(&1.role == "attacker"))
    
    role_specs = []
    
    # High value hunter (targets expensive ships/fits)
    high_value_patterns = Enum.filter(attacker_patterns, &(&1.avg_kill_value > 100_000_000))
    high_value_engagements = Enum.reduce(high_value_patterns, 0, &(&1.frequency + &2))
    total_engagements = Enum.reduce(attacker_patterns, 0, &(&1.frequency + &2))
    
    high_value_rate = if total_engagements > 0, do: high_value_engagements / total_engagements, else: 0.0
    
    role_specs = if high_value_rate > 0.3 do 
      [%{name: :high_value_hunter, strength: high_value_rate, confidence: calculate_confidence_from_data(high_value_engagements)} | role_specs]
    else
      role_specs
    end
    
    # Capital hunter (specializes in capital kills)
    capital_patterns = Enum.filter(attacker_patterns, &(&1.avg_kill_value > 1_000_000_000))
    capital_engagements = Enum.reduce(capital_patterns, 0, &(&1.frequency + &2))
    
    role_specs = if capital_engagements > 5 do
      capital_rate = capital_engagements / max(total_engagements, 1)
      [%{name: :capital_hunter, strength: capital_rate, confidence: calculate_confidence_from_data(capital_engagements)} | role_specs]
    else
      role_specs
    end
    
    # Opportunistic vs focused hunter
    unique_systems = attacker_patterns |> Enum.map(&(&1.system_diversity)) |> Enum.sum()
    avg_system_diversity = if length(attacker_patterns) > 0, do: unique_systems / length(attacker_patterns), else: 0
    
    role_specs = if avg_system_diversity > 15 do
      [%{name: :opportunistic_hunter, strength: min(1.0, avg_system_diversity / 30), confidence: calculate_confidence_from_data(total_engagements)} | role_specs]
    else
      if avg_system_diversity < 5 and total_engagements > 20 do
        [%{name: :focused_hunter, strength: 1.0 - (avg_system_diversity / 10), confidence: calculate_confidence_from_data(total_engagements)} | role_specs]
      else
        role_specs
      end
    end
    
    role_specs
  end


  # Helper functions for weapon and pattern classification

  defp classify_weapon_type(weapon_type_id) when is_integer(weapon_type_id) do
    # Simplified weapon classification based on common EVE weapon type IDs
    # In production, this would query the static data database
    cond do
      weapon_type_id in [2185, 2873, 3074, 8035] -> :projectile
      weapon_type_id in [5443, 12196, 12716, 17928] -> :missile  
      weapon_type_id in [6003, 6729, 7823, 19300] -> :laser
      weapon_type_id in [19739, 21096, 23915, 24488] -> :hybrid
      weapon_type_id in [31864, 32556, 41549, 42688] -> :drone
      true -> :unknown
    end
  end

  defp classify_weapon_type(_), do: :unknown

  defp calculate_confidence_from_data(engagement_count) do
    cond do
      engagement_count >= 50 -> 0.9
      engagement_count >= 25 -> 0.7
      engagement_count >= 10 -> 0.5
      engagement_count >= 5 -> 0.3
      true -> 0.1
    end
  end

  # Comprehensive Activity Pattern Analysis Functions

  defp fetch_comprehensive_activity_data(character_id) do
    twelve_months_ago = DateTime.add(DateTime.utc_now(), -12 * 30 * 24 * 3600, :second)
    
    # Complex query for comprehensive activity analysis
    query = """
    WITH activity_analysis AS (
      SELECT 
        k.killmail_time,
        k.solar_system_id,
        k.attacker_count,
        COALESCE(k.victim_character_id, (a->>'character_id')::bigint) as character_id,
        CASE WHEN k.victim_character_id IS NULL THEN 'attacker' ELSE 'victim' END as role,
        COALESCE(k.victim_ship_type_id, (a->>'ship_type_id')::integer) as ship_type_id,
        (k.raw_data->'zkb'->>'totalValue')::bigint as total_value,
        EXTRACT(hour FROM k.killmail_time) as hour_of_day,
        EXTRACT(dow FROM k.killmail_time) as day_of_week,
        EXTRACT(week FROM k.killmail_time) as week_of_year,
        DATE_TRUNC('day', k.killmail_time) as activity_date,
        DATE_TRUNC('week', k.killmail_time) as activity_week,
        DATE_TRUNC('month', k.killmail_time) as activity_month
      FROM killmails_raw k
      CROSS JOIN LATERAL jsonb_array_elements(k.raw_data->'attackers') AS a
      WHERE k.killmail_time >= $1 
        AND (
          k.victim_character_id = $2 OR 
          (a->>'character_id')::bigint = $2
        )
    )
    SELECT 
      activity_date,
      activity_week,
      activity_month,
      hour_of_day,
      day_of_week,
      solar_system_id,
      role,
      ship_type_id,
      total_value,
      attacker_count,
      COUNT(*) as daily_engagements,
      AVG(total_value) as avg_value,
      COUNT(DISTINCT solar_system_id) as systems_visited,
      MIN(killmail_time) as first_activity,
      MAX(killmail_time) as last_activity
    FROM activity_analysis
    WHERE character_id = $2
    GROUP BY activity_date, activity_week, activity_month, hour_of_day, day_of_week, 
             solar_system_id, role, ship_type_id, total_value, attacker_count
    ORDER BY activity_date DESC, hour_of_day ASC
    """
    
    case Ecto.Adapters.SQL.query(EveDmv.Repo, query, [twelve_months_ago, character_id]) do
      {:ok, result} ->
        activities = result.rows
        |> Enum.map(fn [date, week, month, hour, dow, system_id, role, ship_id, value, fleet_size, engagements, avg_value, systems, first, last] ->
          %{
            activity_date: date,
            activity_week: week,
            activity_month: month,
            hour_of_day: trunc(hour || 12),
            day_of_week: trunc(dow || 1),
            solar_system_id: system_id,
            role: role,
            ship_type_id: ship_id,
            total_value: value || 0,
            attacker_count: fleet_size || 1,
            daily_engagements: engagements || 0,
            avg_value: avg_value || 0,
            systems_visited: systems || 0,
            first_activity: first,
            last_activity: last
          }
        end)
        
        %{activities: activities, total_data_points: length(activities)}
        
      {:error, _} ->
        Logger.warning("Failed to fetch comprehensive activity data for character #{character_id}")
        %{activities: [], total_data_points: 0}
    end
  end

  defp analyze_temporal_patterns(activity_data) do
    activities = Map.get(activity_data, :activities, [])
    
    if length(activities) == 0 do
      %{
        active_hours: [],
        active_days: [],
        activity_rhythm: :unknown,
        peak_hours: [],
        activity_consistency: 0.0,
        temporal_clustering: %{}
      }
    else
      # Hour-based analysis
      hour_distribution = activities
      |> Enum.group_by(&(&1.hour_of_day))
      |> Enum.map(fn {hour, hour_activities} -> {hour, length(hour_activities)} end)
      |> Enum.into(%{})
      
      active_hours = hour_distribution
      |> Enum.filter(fn {_hour, count} -> count > 2 end)
      |> Enum.map(fn {hour, _count} -> hour end)
      |> Enum.sort()
      
      peak_hours = hour_distribution
      |> Enum.sort_by(fn {_hour, count} -> count end, :desc)
      |> Enum.take(3)
      |> Enum.map(fn {hour, _count} -> hour end)
      
      # Day-based analysis  
      day_distribution = activities
      |> Enum.group_by(&(&1.day_of_week))
      |> Enum.map(fn {day, day_activities} -> {day, length(day_activities)} end)
      |> Enum.into(%{})
      
      active_days = day_distribution
      |> Enum.filter(fn {_day, count} -> count > 1 end)
      |> Enum.map(fn {day, _count} -> day end)
      |> Enum.sort()
      
      # Activity rhythm analysis
      daily_counts = activities
      |> Enum.group_by(&(&1.activity_date))
      |> Enum.map(fn {_date, day_activities} -> length(day_activities) end)
      
      activity_consistency = if length(daily_counts) > 1 do
        mean = Enum.sum(daily_counts) / length(daily_counts)
        variance = Enum.reduce(daily_counts, 0, fn count, acc ->
          acc + :math.pow(count - mean, 2)
        end) / length(daily_counts)
        cv = if mean > 0, do: :math.sqrt(variance) / mean, else: 1.0
        max(0.0, 1.0 - cv)  # Higher consistency = lower coefficient of variation
      else
        0.0
      end
      
      activity_rhythm = cond do
        activity_consistency > 0.8 -> :highly_regular
        activity_consistency > 0.6 -> :regular
        activity_consistency > 0.4 -> :somewhat_irregular
        activity_consistency > 0.2 -> :irregular
        true -> :highly_irregular
      end
      
      %{
        active_hours: active_hours,
        active_days: active_days,
        activity_rhythm: activity_rhythm,
        peak_hours: peak_hours,
        activity_consistency: Float.round(activity_consistency, 3),
        temporal_clustering: %{
          hour_distribution: hour_distribution,
          day_distribution: day_distribution,
          peak_activity_windows: identify_activity_windows(hour_distribution)
        }
      }
    end
  end

  defp analyze_geographical_patterns(activity_data) do
    activities = Map.get(activity_data, :activities, [])
    
    if length(activities) == 0 do
      %{
        preferred_systems: [],
        system_diversity: 0,
        regional_preferences: %{},
        mobility_pattern: :unknown,
        geographical_clustering: %{}
      }
    else
      # System-based analysis
      system_distribution = activities
      |> Enum.group_by(&(&1.solar_system_id))
      |> Enum.map(fn {system_id, system_activities} -> 
        {system_id, %{
          engagement_count: length(system_activities),
          avg_value: Enum.reduce(system_activities, 0, &(&1.total_value + &2)) / length(system_activities),
          roles: system_activities |> Enum.map(&(&1.role)) |> Enum.uniq()
        }}
      end)
      |> Enum.into(%{})
      
      preferred_systems = system_distribution
      |> Enum.sort_by(fn {_system, data} -> data.engagement_count end, :desc)
      |> Enum.take(10)
      |> Enum.map(fn {system_id, data} -> 
        %{system_id: system_id, engagement_count: data.engagement_count, avg_value: data.avg_value}
      end)
      
      unique_systems = Map.keys(system_distribution) |> length()
      total_engagements = length(activities)
      
      mobility_pattern = cond do
        unique_systems == 1 -> :stationary
        unique_systems <= 3 -> :localized
        unique_systems <= 10 -> :regional
        unique_systems <= 25 -> :nomadic
        true -> :highly_nomadic
      end
      
      # Calculate system diversity index (Shannon diversity)
      system_diversity = if total_engagements > 0 do
        system_distribution
        |> Enum.reduce(0.0, fn {_system, data}, acc ->
          proportion = data.engagement_count / total_engagements
          acc - (proportion * :math.log(proportion))
        end)
        |> Float.round(3)
      else
        0.0
      end
      
      %{
        preferred_systems: preferred_systems,
        system_diversity: system_diversity,
        unique_systems_visited: unique_systems,
        mobility_pattern: mobility_pattern,
        geographical_clustering: %{
          system_distribution: system_distribution,
          concentration_index: calculate_geographical_concentration(system_distribution)
        }
      }
    end
  end

  defp analyze_engagement_patterns(activity_data) do
    activities = Map.get(activity_data, :activities, [])
    
    if length(activities) == 0 do
      %{
        patterns: [],
        fleet_size_preferences: %{},
        value_targeting: %{},
        engagement_rhythm: :unknown
      }
    else
      # Fleet size pattern analysis
      fleet_size_distribution = activities
      |> Enum.group_by(&categorize_fleet_size(&1.attacker_count))
      |> Enum.map(fn {category, fleet_activities} -> {category, length(fleet_activities)} end)
      |> Enum.into(%{})
      
      total_engagements = length(activities)
      fleet_size_preferences = fleet_size_distribution
      |> Enum.map(fn {category, count} -> 
        {category, Float.round(count / total_engagements, 3)}
      end)
      |> Enum.into(%{})
      
      # Value targeting analysis
      value_categories = activities
      |> Enum.group_by(&categorize_target_value(&1.total_value))
      |> Enum.map(fn {category, value_activities} -> {category, length(value_activities)} end)
      |> Enum.into(%{})
      
      value_targeting = value_categories
      |> Enum.map(fn {category, count} -> 
        {category, Float.round(count / total_engagements, 3)}
      end)
      |> Enum.into(%{})
      
      # Role pattern analysis
      role_distribution = activities
      |> Enum.group_by(&(&1.role))
      |> Enum.map(fn {role, role_activities} -> {role, length(role_activities)} end)
      |> Enum.into(%{})
      
      # Identify dominant patterns
      patterns = []
      
      # Add fleet size pattern
      dominant_fleet_category = Enum.max_by(fleet_size_preferences, fn {_cat, pct} -> pct end, fn -> {nil, 0} end)
      patterns = case dominant_fleet_category do
        {category, pct} when pct > 0.5 -> 
          [%{type: :fleet_preference, category: category, strength: pct} | patterns]
        _ -> patterns
      end
      
      # Add value targeting pattern
      dominant_value_category = Enum.max_by(value_targeting, fn {_cat, pct} -> pct end, fn -> {nil, 0} end)
      patterns = case dominant_value_category do
        {category, pct} when pct > 0.4 ->
          [%{type: :value_targeting, category: category, strength: pct} | patterns]
        _ -> patterns
      end
      
      # Add role pattern
      attacker_pct = Map.get(role_distribution, "attacker", 0) / total_engagements
      patterns = cond do
        attacker_pct > 0.8 -> [%{type: :role_preference, category: :aggressive_hunter, strength: attacker_pct} | patterns]
        attacker_pct < 0.3 -> [%{type: :role_preference, category: :frequent_victim, strength: 1.0 - attacker_pct} | patterns]
        true -> patterns
      end
      
      %{
        patterns: patterns,
        fleet_size_preferences: fleet_size_preferences,
        value_targeting: value_targeting,
        role_distribution: role_distribution,
        engagement_diversity: calculate_engagement_diversity(activities)
      }
    end
  end

  defp analyze_behavioral_patterns(activity_data) do
    activities = Map.get(activity_data, :activities, [])
    
    if length(activities) == 0 do
      %{
        consistency_score: 0.0,
        predictability: :unknown,
        behavioral_flags: [],
        routine_strength: 0.0
      }
    else
      # Temporal consistency analysis
      weekly_patterns = activities
      |> Enum.group_by(&(&1.activity_week))
      |> Enum.map(fn {_week, week_activities} -> 
        week_activities |> Enum.map(&(&1.hour_of_day)) |> Enum.sort()
      end)
      
      # Calculate routine strength (how similar weekly patterns are)
      routine_strength = if length(weekly_patterns) > 1 do
        calculate_pattern_similarity(weekly_patterns)
      else
        0.0
      end
      
      # Behavioral flags
      behavioral_flags = []
      
      # Night activity flag
      night_activities = Enum.count(activities, fn activity ->
        hour = activity.hour_of_day
        hour >= 22 or hour <= 6
      end)
      night_ratio = night_activities / length(activities)
      
      behavioral_flags = if night_ratio > 0.5 do
        [:night_active | behavioral_flags]
      else
        behavioral_flags
      end
      
      # Weekend warrior flag
      weekend_activities = Enum.count(activities, fn activity ->
        activity.day_of_week in [0, 6]  # Sunday = 0, Saturday = 6
      end)
      weekend_ratio = weekend_activities / length(activities)
      
      behavioral_flags = if weekend_ratio > 0.6 do
        [:weekend_warrior | behavioral_flags]
      else
        behavioral_flags
      end
      
      # High value hunter flag
      high_value_activities = Enum.count(activities, &(&1.total_value > 100_000_000))
      high_value_ratio = high_value_activities / length(activities)
      
      behavioral_flags = if high_value_ratio > 0.3 do
        [:high_value_hunter | behavioral_flags]
      else
        behavioral_flags
      end
      
      # Solo preference flag
      solo_activities = Enum.count(activities, &(&1.attacker_count <= 2))
      solo_ratio = solo_activities / length(activities)
      
      behavioral_flags = if solo_ratio > 0.7 do
        [:solo_preference | behavioral_flags]
      else
        behavioral_flags
      end
      
      predictability = cond do
        routine_strength > 0.8 -> :highly_predictable
        routine_strength > 0.6 -> :predictable
        routine_strength > 0.4 -> :somewhat_predictable
        routine_strength > 0.2 -> :unpredictable
        true -> :highly_unpredictable
      end
      
      %{
        consistency_score: Float.round(routine_strength, 3),
        predictability: predictability,
        behavioral_flags: behavioral_flags,
        routine_strength: Float.round(routine_strength, 3),
        pattern_analysis: %{
          night_activity_ratio: Float.round(night_ratio, 3),
          weekend_ratio: Float.round(weekend_ratio, 3),
          high_value_ratio: Float.round(high_value_ratio, 3),
          solo_ratio: Float.round(solo_ratio, 3)
        }
      }
    end
  end

  # Helper functions for activity pattern analysis

  defp identify_activity_windows(hour_distribution) do
    # Identify contiguous blocks of high activity
    sorted_hours = hour_distribution
    |> Enum.sort_by(fn {hour, _count} -> hour end)
    
    # Group contiguous hours with activity > average
    avg_activity = if map_size(hour_distribution) > 0 do
      Enum.sum(Map.values(hour_distribution)) / map_size(hour_distribution)
    else
      0
    end
    
    active_hours = sorted_hours
    |> Enum.filter(fn {_hour, count} -> count > avg_activity end)
    |> Enum.map(fn {hour, _count} -> hour end)
    
    group_contiguous_hours(active_hours)
  end

  defp group_contiguous_hours(hours) do
    if length(hours) == 0 do
      []
    else
      sorted_hours = Enum.sort(hours)
      
      Enum.reduce(sorted_hours, [], fn hour, groups ->
        case groups do
          [] -> [[hour]]
          [current_group | rest] ->
            last_hour = List.last(current_group)
            if hour - last_hour <= 1 do
              [current_group ++ [hour] | rest]
            else
              [[hour] | groups]
            end
        end
      end)
      |> Enum.reverse()
      |> Enum.map(fn group -> %{start_hour: List.first(group), end_hour: List.last(group), duration: length(group)} end)
    end
  end

  defp calculate_geographical_concentration(system_distribution) do
    if map_size(system_distribution) <= 1 do
      1.0  # Maximum concentration
    else
      total_engagements = system_distribution |> Map.values() |> Enum.reduce(0, &(&1.engagement_count + &2))
      
      # Calculate Herfindahl-Hirschman Index for concentration
      hhi = system_distribution
      |> Enum.reduce(0.0, fn {_system, data}, acc ->
        market_share = data.engagement_count / total_engagements
        acc + :math.pow(market_share, 2)
      end)
      
      Float.round(hhi, 3)
    end
  end

  defp categorize_fleet_size(attacker_count) do
    cond do
      attacker_count <= 1 -> :solo
      attacker_count <= 3 -> :small_gang
      attacker_count <= 10 -> :medium_gang
      attacker_count <= 30 -> :large_gang
      true -> :fleet
    end
  end

  defp categorize_target_value(total_value) do
    cond do
      total_value < 10_000_000 -> :low_value
      total_value < 50_000_000 -> :medium_value
      total_value < 200_000_000 -> :high_value
      total_value < 1_000_000_000 -> :very_high_value
      true -> :capital_value
    end
  end

  defp calculate_engagement_diversity(activities) do
    # Calculate diversity across multiple dimensions
    ship_diversity = activities |> Enum.map(&(&1.ship_type_id)) |> Enum.uniq() |> length()
    system_diversity = activities |> Enum.map(&(&1.solar_system_id)) |> Enum.uniq() |> length()
    value_diversity = activities |> Enum.map(&categorize_target_value(&1.total_value)) |> Enum.uniq() |> length()
    fleet_diversity = activities |> Enum.map(&categorize_fleet_size(&1.attacker_count)) |> Enum.uniq() |> length()
    
    # Normalize diversity scores
    max_diversity = length(activities)
    normalized_diversity = (ship_diversity + system_diversity + value_diversity + fleet_diversity) / (4 * max_diversity)
    
    Float.round(min(1.0, normalized_diversity), 3)
  end

  defp calculate_pattern_similarity(weekly_patterns) do
    if length(weekly_patterns) < 2 do
      0.0
    else
      # Calculate average similarity between weekly patterns
      pattern_pairs = for p1 <- weekly_patterns, p2 <- weekly_patterns, p1 != p2, do: {p1, p2}
      
      if length(pattern_pairs) == 0 do
        0.0
      else
        similarities = Enum.map(pattern_pairs, fn {p1, p2} ->
          calculate_hour_pattern_similarity(p1, p2)
        end)
        
        Enum.sum(similarities) / length(similarities)
      end
    end
  end

  defp calculate_hour_pattern_similarity(pattern1, pattern2) do
    # Simple Jaccard similarity for hour patterns
    set1 = MapSet.new(pattern1)
    set2 = MapSet.new(pattern2)
    
    intersection_size = MapSet.intersection(set1, set2) |> MapSet.size()
    union_size = MapSet.union(set1, set2) |> MapSet.size()
    
    if union_size == 0, do: 0.0, else: intersection_size / union_size
  end

  # Additional supporting functions for comprehensive activity analysis

  defp calculate_activity_confidence(activity_data) do
    total_data_points = Map.get(activity_data, :total_data_points, 0)
    
    cond do
      total_data_points >= 100 -> :very_high
      total_data_points >= 50 -> :high
      total_data_points >= 25 -> :moderate
      total_data_points >= 10 -> :low
      total_data_points > 0 -> :very_low
      true -> :no_data
    end
  end

  defp assess_pattern_stability(activity_data) do
    activities = Map.get(activity_data, :activities, [])
    
    if length(activities) < 10 do
      :insufficient_data
    else
      # Group activities by month to assess stability over time
      monthly_groups = activities
      |> Enum.group_by(&(&1.activity_month))
      |> Map.values()
      
      if length(monthly_groups) < 2 do
        :insufficient_timespan
      else
        # Calculate variance in monthly activity levels
        monthly_counts = Enum.map(monthly_groups, &length/1)
        mean_activity = Enum.sum(monthly_counts) / length(monthly_counts)
        
        variance = if mean_activity > 0 do
          Enum.reduce(monthly_counts, 0, fn count, acc ->
            acc + :math.pow(count - mean_activity, 2)
          end) / length(monthly_counts)
        else
          0
        end
        
        cv = if mean_activity > 0, do: :math.sqrt(variance) / mean_activity, else: 1.0
        
        cond do
          cv < 0.2 -> :very_stable
          cv < 0.4 -> :stable
          cv < 0.7 -> :somewhat_unstable
          cv < 1.0 -> :unstable
          true -> :highly_unstable
        end
      end
    end
  end

  defp generate_predictive_activity_windows(temporal_analysis) do
    active_hours = Map.get(temporal_analysis, :active_hours, [])
    peak_hours = Map.get(temporal_analysis, :peak_hours, [])
    activity_rhythm = Map.get(temporal_analysis, :activity_rhythm, :unknown)
    
    if length(active_hours) == 0 do
      %{
        high_probability_windows: [],
        medium_probability_windows: [],
        confidence: :no_data
      }
    else
      # Generate predictive windows based on historical patterns
      high_prob_windows = peak_hours
      |> Enum.map(fn hour ->
        %{
          start_hour: max(0, hour - 1),
          end_hour: min(23, hour + 1),
          center_hour: hour,
          probability: calculate_window_probability(hour, temporal_analysis, :high)
        }
      end)
      |> Enum.filter(&(&1.probability > 0.7))
      
      medium_prob_windows = active_hours
      |> Enum.reject(&(&1 in peak_hours))
      |> Enum.map(fn hour ->
        %{
          start_hour: max(0, hour - 1),
          end_hour: min(23, hour + 1),
          center_hour: hour,
          probability: calculate_window_probability(hour, temporal_analysis, :medium)
        }
      end)
      |> Enum.filter(&(&1.probability > 0.4))
      
      confidence = case activity_rhythm do
        :highly_regular -> :very_high
        :regular -> :high
        :somewhat_irregular -> :medium
        :irregular -> :low
        _ -> :very_low
      end
      
      %{
        high_probability_windows: high_prob_windows,
        medium_probability_windows: medium_prob_windows,
        confidence: confidence,
        next_24h_forecast: generate_24h_activity_forecast(temporal_analysis)
      }
    end
  end

  defp calculate_window_probability(hour, temporal_analysis, priority) do
    hour_distribution = get_in(temporal_analysis, [:temporal_clustering, :hour_distribution]) || %{}
    total_activities = Enum.sum(Map.values(hour_distribution))
    
    if total_activities == 0 do
      0.0
    else
      hour_activities = Map.get(hour_distribution, hour, 0)
      base_probability = hour_activities / total_activities
      
      # Adjust based on priority and surrounding hours
      adjacent_hours = [max(0, hour - 1), min(23, hour + 1)]
      adjacent_activities = Enum.reduce(adjacent_hours, 0, fn h, acc ->
        acc + Map.get(hour_distribution, h, 0)
      end)
      
      context_boost = adjacent_activities / (total_activities * 2)
      
      adjusted_probability = case priority do
        :high -> base_probability * 1.2 + context_boost * 0.3
        :medium -> base_probability * 1.0 + context_boost * 0.2
        _ -> base_probability
      end
      
      Float.round(min(1.0, adjusted_probability), 3)
    end
  end

  defp generate_24h_activity_forecast(temporal_analysis) do
    hour_distribution = get_in(temporal_analysis, [:temporal_clustering, :hour_distribution]) || %{}
    
    if map_size(hour_distribution) == 0 do
      %{forecast: :no_data}
    else
      # Generate hour-by-hour activity likelihood for next 24 hours
      current_hour = DateTime.utc_now() |> DateTime.to_time() |> Map.get(:hour)
      
      forecast_hours = for hour <- 0..23 do
        relative_hour = rem(current_hour + hour, 24)
        probability = calculate_hour_likelihood(relative_hour, hour_distribution)
        
        %{
          hour: relative_hour,
          hours_from_now: hour,
          activity_likelihood: probability,
          risk_level: classify_risk_level(probability)
        }
      end
      
      %{
        forecast: forecast_hours,
        peak_risk_periods: Enum.filter(forecast_hours, &(&1.risk_level in [:high, :very_high])),
        safe_periods: Enum.filter(forecast_hours, &(&1.risk_level == :minimal))
      }
    end
  end

  defp calculate_hour_likelihood(hour, hour_distribution) do
    total_activities = Enum.sum(Map.values(hour_distribution))
    hour_activities = Map.get(hour_distribution, hour, 0)
    
    if total_activities == 0 do
      0.0
    else
      Float.round(hour_activities / total_activities, 3)
    end
  end

  defp classify_risk_level(probability) do
    cond do
      probability >= 0.15 -> :very_high
      probability >= 0.10 -> :high
      probability >= 0.05 -> :moderate
      probability >= 0.02 -> :low
      true -> :minimal
    end
  end

  # Network analysis and predictive threat functions

  defp fetch_pilot_network_data(character_id) do
    six_months_ago = DateTime.add(DateTime.utc_now(), -6 * 30 * 24 * 3600, :second)
    
    # Query for network relationships based on shared engagements
    query = """
    WITH character_engagements AS (
      SELECT 
        k.killmail_id,
        k.killmail_time,
        COALESCE(k.victim_character_id, (a->>'character_id')::bigint) as character_id,
        COALESCE(k.victim_corporation_id, (a->>'corporation_id')::bigint) as corporation_id,
        COALESCE(k.victim_alliance_id, (a->>'alliance_id')::bigint) as alliance_id,
        CASE WHEN k.victim_character_id IS NULL THEN 'attacker' ELSE 'victim' END as role
      FROM killmails_raw k
      CROSS JOIN LATERAL jsonb_array_elements(k.raw_data->'attackers') AS a
      WHERE k.killmail_time >= $1 
        AND (
          k.victim_character_id = $2 OR 
          (a->>'character_id')::bigint = $2
        )
    ),
    network_analysis AS (
      SELECT 
        ce1.character_id as char1,
        ce2.character_id as char2,
        ce1.corporation_id as corp1,
        ce2.corporation_id as corp2,
        ce1.alliance_id as alliance1,
        ce2.alliance_id as alliance2,
        COUNT(*) as shared_engagements,
        COUNT(CASE WHEN ce1.role = ce2.role THEN 1 END) as same_side_count,
        COUNT(CASE WHEN ce1.role != ce2.role THEN 1 END) as opposite_side_count
      FROM character_engagements ce1
      JOIN character_engagements ce2 ON ce1.killmail_id = ce2.killmail_id
      WHERE ce1.character_id = $2 AND ce2.character_id != $2
      GROUP BY ce1.character_id, ce2.character_id, ce1.corporation_id, ce2.corporation_id, 
               ce1.alliance_id, ce2.alliance_id
      HAVING COUNT(*) >= 3
    )
    SELECT 
      char2,
      corp2,
      alliance2,
      shared_engagements,
      same_side_count,
      opposite_side_count,
      CASE 
        WHEN same_side_count > opposite_side_count THEN 'ally'
        WHEN opposite_side_count > same_side_count THEN 'enemy'
        ELSE 'neutral'
      END as relationship_type
    FROM network_analysis
    ORDER BY shared_engagements DESC
    LIMIT 50
    """
    
    case Ecto.Adapters.SQL.query(EveDmv.Repo, query, [six_months_ago, character_id]) do
      {:ok, result} ->
        network_relationships = result.rows
        |> Enum.map(fn [char_id, corp_id, alliance_id, shared, same_side, opposite_side, relationship] ->
          %{
            character_id: char_id,
            corporation_id: corp_id,
            alliance_id: alliance_id,
            shared_engagements: shared || 0,
            same_side_engagements: same_side || 0,
            opposite_side_engagements: opposite_side || 0,
            relationship_type: relationship,
            connection_strength: calculate_connection_strength(shared || 0, same_side || 0, opposite_side || 0)
          }
        end)
        
        # Group by relationship type
        frequent_associates = Enum.filter(network_relationships, &(&1.relationship_type == "ally"))
        |> Enum.take(10)
        
        corporation_network = build_corporation_network(network_relationships)
        alliance_network = build_alliance_network(network_relationships)
        
        %{
          frequent_associates: frequent_associates,
          corporation_network: corporation_network,
          alliance_network: alliance_network,
          engagement_network: %{total_connections: length(network_relationships)},
          total_relationships: length(network_relationships)
        }
        
      {:error, _} ->
        Logger.warning("Failed to fetch pilot network data for character #{character_id}")
        %{
          frequent_associates: [],
          corporation_network: %{},
          alliance_network: %{},
          engagement_network: %{},
          total_relationships: 0
        }
    end
  end

  defp calculate_connection_strength(shared_engagements, same_side, opposite_side) do
    if shared_engagements == 0 do
      0.0
    else
      cooperation_ratio = same_side / shared_engagements
      engagement_weight = min(1.0, shared_engagements / 20)  # Normalize to max of 20 engagements
      
      strength = cooperation_ratio * engagement_weight
      Float.round(strength, 3)
    end
  end

  defp build_corporation_network(relationships) do
    corp_relationships = relationships
    |> Enum.group_by(&(&1.corporation_id))
    |> Enum.map(fn {corp_id, corp_relationships} ->
      total_engagements = Enum.sum(Enum.map(corp_relationships, &(&1.shared_engagements)))
      relationship_types = Enum.map(corp_relationships, &(&1.relationship_type)) |> Enum.uniq()
      
      {corp_id, %{
        relationship_count: length(corp_relationships),
        total_engagements: total_engagements,
        relationship_types: relationship_types,
        dominant_relationship: determine_dominant_relationship(corp_relationships)
      }}
    end)
    |> Enum.into(%{})
    
    corp_relationships
  end

  defp build_alliance_network(relationships) do
    alliance_relationships = relationships
    |> Enum.filter(&(&1.alliance_id != nil))
    |> Enum.group_by(&(&1.alliance_id))
    |> Enum.map(fn {alliance_id, alliance_relationships} ->
      total_engagements = Enum.sum(Enum.map(alliance_relationships, &(&1.shared_engagements)))
      relationship_types = Enum.map(alliance_relationships, &(&1.relationship_type)) |> Enum.uniq()
      
      {alliance_id, %{
        relationship_count: length(alliance_relationships),
        total_engagements: total_engagements,
        relationship_types: relationship_types,
        dominant_relationship: determine_dominant_relationship(alliance_relationships)
      }}
    end)
    |> Enum.into(%{})
    
    alliance_relationships
  end

  defp determine_dominant_relationship(relationships) do
    relationship_counts = relationships
    |> Enum.group_by(&(&1.relationship_type))
    |> Enum.map(fn {type, type_relationships} -> 
      {type, Enum.sum(Enum.map(type_relationships, &(&1.shared_engagements)))}
    end)
    
    case Enum.max_by(relationship_counts, fn {_type, count} -> count end, fn -> {nil, 0} end) do
      {type, _count} -> type
      _ -> "unknown"
    end
  end

  defp calculate_network_influence(network_data) do
    total_relationships = Map.get(network_data, :total_relationships, 0)
    frequent_associates = Map.get(network_data, :frequent_associates, [])
    
    # Calculate influence based on network size and connection strength
    base_influence = min(1.0, total_relationships / 50)
    
    connection_quality = if length(frequent_associates) > 0 do
      avg_strength = Enum.reduce(frequent_associates, 0.0, &(&1.connection_strength + &2)) / length(frequent_associates)
      avg_strength
    else
      0.0
    end
    
    influence_score = (base_influence * 0.7) + (connection_quality * 0.3)
    Float.round(influence_score, 3)
  end

  defp identify_coordination_patterns(network_data) do
    frequent_associates = Map.get(network_data, :frequent_associates, [])
    
    if length(frequent_associates) < 2 do
      %{coordination_level: :solo_operator, patterns: []}
    else
      # Analyze coordination patterns
      high_coordination_associates = Enum.filter(frequent_associates, &(&1.connection_strength > 0.7))
      
      coordination_level = cond do
        length(high_coordination_associates) >= 5 -> :highly_coordinated
        length(high_coordination_associates) >= 3 -> :well_coordinated
        length(high_coordination_associates) >= 1 -> :somewhat_coordinated
        length(frequent_associates) >= 3 -> :loosely_coordinated
        true -> :independent_operator
      end
      
      patterns = []
      
      # Small gang coordination pattern
      patterns = if length(high_coordination_associates) >= 2 and length(high_coordination_associates) <= 5 do
        [:small_gang_coordination | patterns]
      else
        patterns
      end
      
      # Fleet coordination pattern  
      patterns = if length(frequent_associates) >= 10 do
        [:fleet_coordination | patterns]
      else
        patterns
      end
      
      # Alliance coordination pattern
      alliance_network = Map.get(network_data, :alliance_network, %{})
      patterns = if map_size(alliance_network) >= 2 do
        [:multi_alliance_coordination | patterns]
      else
        patterns
      end
      
      %{
        coordination_level: coordination_level,
        patterns: patterns,
        key_associates: Enum.take(high_coordination_associates, 5)
      }
    end
  end

  # Additional predictive and formatting functions

  defp analyze_threat_trend(threat_rating, historical_performance) do
    # Simplified trend analysis based on recent vs historical performance
    recent_activity = Map.get(historical_performance, :recent_activity, :inactive)
    threat_level = Map.get(threat_rating, :threat_level, :minimal)
    
    case {threat_level, recent_activity} do
      {:minimal, :active} -> :emerging_threat
      {:low, :active} -> :escalating
      {:moderate, :active} -> :active_threat
      {:high, :active} -> :peak_threat
      {:very_high, :active} -> :extreme_threat
      {_, :inactive} -> :declining
      _ -> :stable
    end
  end

  defp forecast_activity_level(historical_performance) do
    recent_activity = Map.get(historical_performance, :recent_activity, :unknown)
    
    case recent_activity do
      :active -> %{forecast: :likely_active, confidence: 0.8}
      :inactive -> %{forecast: :likely_inactive, confidence: 0.6}
      _ -> %{forecast: :unknown, confidence: 0.1}
    end
  end

  defp calculate_prediction_confidence(threat_rating, historical_performance) do
    threat_confidence = Map.get(threat_rating, :confidence, :moderate)
    recent_activity = Map.get(historical_performance, :recent_activity, :unknown)
    
    base_confidence = case threat_confidence do
      :very_high -> 0.9
      :high -> 0.8
      :moderate -> 0.6
      :low -> 0.4
      _ -> 0.2
    end
    
    activity_confidence = case recent_activity do
      :active -> 0.8
      :inactive -> 0.6
      _ -> 0.3
    end
    
    composite = (base_confidence * 0.7) + (activity_confidence * 0.3)
    Float.round(composite, 2)
  end

  defp predict_future_threat_level(current_level, trend) do
    case {current_level, trend} do
      {:minimal, :emerging_threat} -> :low
      {:low, :escalating} -> :moderate
      {:moderate, :escalating} -> :high
      {:high, :escalating} -> :very_high
      {:very_high, :escalating} -> :extreme
      {level, :declining} -> downgrade_threat_level(level)
      {level, _} -> level
    end
  end

  defp downgrade_threat_level(level) do
    case level do
      :extreme -> :very_high
      :very_high -> :high
      :high -> :moderate
      :moderate -> :low
      :low -> :minimal
      _ -> :minimal
    end
  end

  defp calculate_engagement_likelihood(historical_performance) do
    recent_activity = Map.get(historical_performance, :recent_activity, :unknown)
    
    case recent_activity do
      :active -> %{likelihood: :high, probability: 0.8}
      :inactive -> %{likelihood: :low, probability: 0.2}
      _ -> %{likelihood: :unknown, probability: 0.5}
    end
  end

  defp identify_escalation_risk_factors(threat_rating, historical_performance) do
    risk_factors = []
    
    threat_level = Map.get(threat_rating, :threat_level, :minimal)
    recent_activity = Map.get(historical_performance, :recent_activity, :unknown)
    
    # High threat level risk factor
    risk_factors = if threat_level in [:high, :very_high, :extreme] do
      [:high_baseline_threat | risk_factors]
    else
      risk_factors
    end
    
    # Recent activity risk factor
    risk_factors = if recent_activity == :active do
      [:recent_activity_spike | risk_factors]
    else
      risk_factors
    end
    
    # Composite risk factors (would be more sophisticated with real data)
    composite_score = Map.get(threat_rating, :composite_score, 0.0)
    risk_factors = if composite_score > 0.7 do
      [:high_composite_threat | risk_factors]
    else
      risk_factors
    end
    
    risk_factors
  end

  defp determine_watch_level(threat_level, trend, activity_forecast) do
    base_watch_level = case threat_level do
      :extreme -> :maximum_priority
      :very_high -> :high_priority
      :high -> :medium_priority
      :moderate -> :standard_monitoring
      :low -> :periodic_check
      _ -> :minimal_monitoring
    end
    
    # Adjust based on trend and activity forecast
    case {trend, activity_forecast.forecast} do
      {:escalating, :likely_active} -> upgrade_watch_level(base_watch_level)
      {:declining, :likely_inactive} -> downgrade_watch_level(base_watch_level)
      _ -> base_watch_level
    end
  end

  defp upgrade_watch_level(level) do
    case level do
      :minimal_monitoring -> :periodic_check
      :periodic_check -> :standard_monitoring
      :standard_monitoring -> :medium_priority
      :medium_priority -> :high_priority
      :high_priority -> :maximum_priority
      level -> level
    end
  end

  defp downgrade_watch_level(level) do
    case level do
      :maximum_priority -> :high_priority
      :high_priority -> :medium_priority
      :medium_priority -> :standard_monitoring
      :standard_monitoring -> :periodic_check
      :periodic_check -> :minimal_monitoring
      level -> level
    end
  end

  # Formatting functions for intelligence summaries

  defp format_threat_assessment_summary(threat_level, composite_score, threat_rating) do
    confidence = Map.get(threat_rating, :confidence, :moderate)
    
    """
    Threat Level: #{format_threat_level(threat_level)} (#{Float.round(composite_score, 2)})
    Assessment Confidence: #{confidence}
    Combat Threat: #{Map.get(threat_rating, :combat_threat, 0.0)}
    Tactical Threat: #{Map.get(threat_rating, :tactical_threat, 0.0)}
    Behavioral Risk: #{Map.get(threat_rating, :behavioral_threat, 0.0)}
    """
  end

  defp format_activity_summary(activity_patterns) do
    temporal = Map.get(activity_patterns, :temporal_intelligence, %{})
    geographical = Map.get(activity_patterns, :geographical_intelligence, %{})
    behavioral = Map.get(activity_patterns, :behavioral_intelligence, %{})
    
    active_hours = Map.get(temporal, :active_hours, [])
    mobility_pattern = Map.get(geographical, :mobility_pattern, :unknown)
    behavioral_flags = Map.get(behavioral, :behavioral_flags, [])
    
    """
    Active Hours: #{format_hour_list(active_hours)}
    Mobility Pattern: #{mobility_pattern}
    Behavioral Flags: #{Enum.join(behavioral_flags, ", ")}
    Activity Rhythm: #{Map.get(temporal, :activity_rhythm, :unknown)}
    System Diversity: #{Map.get(geographical, :system_diversity, 0)}
    """
  end

  defp format_performance_summary(historical_performance) do
    kills = Map.get(historical_performance, :kills, 0)
    deaths = Map.get(historical_performance, :deaths, 0)
    isk_efficiency = Map.get(historical_performance, :isk_efficiency, 0.0)
    recent_activity = Map.get(historical_performance, :recent_activity, :unknown)
    
    """
    Recent K/D: #{kills}/#{deaths}
    ISK Efficiency: #{Float.round(isk_efficiency, 2)}
    Activity Status: #{recent_activity}
    """
  end

  defp generate_tactical_recommendations(threat_rating, activity_patterns) do
    threat_level = Map.get(threat_rating, :threat_level, :minimal)
    temporal = Map.get(activity_patterns, :temporal_intelligence, %{})
    behavioral = Map.get(activity_patterns, :behavioral_intelligence, %{})
    
    recommendations = []
    
    # Threat-based recommendations
    recommendations = case threat_level do
      level when level in [:high, :very_high, :extreme] ->
        ["Maintain maximum situational awareness",
         "Consider fleet support when engaging",
         "Use superior numbers or positioning advantage" | recommendations]
      :moderate ->
        ["Exercise standard caution when engaging",
         "Monitor for escalation patterns" | recommendations]
      _ ->
        ["Standard engagement protocols apply" | recommendations]
    end
    
    # Activity pattern recommendations
    active_hours = Map.get(temporal, :active_hours, [])
    recommendations = if length(active_hours) > 0 do
      ["Highest risk during hours: #{format_hour_list(active_hours)}" | recommendations]
    else
      recommendations
    end
    
    # Behavioral recommendations
    behavioral_flags = Map.get(behavioral, :behavioral_flags, [])
    recommendations = if :night_active in behavioral_flags do
      ["Increased vigilance during night hours (22:00-06:00)" | recommendations]
    else
      recommendations
    end
    
    recommendations = if :solo_preference in behavioral_flags do
      ["Target likely operates alone - opportunity for superior numbers" | recommendations]
    else
      recommendations
    end
    
    Enum.join(recommendations, "\n")
  end

  defp format_threat_level(level) do
    case level do
      :extreme -> "EXTREME"
      :very_high -> "VERY HIGH"
      :high -> "HIGH"
      :moderate -> "MODERATE"
      :low -> "LOW"
      :minimal -> "MINIMAL"
      _ -> "UNKNOWN"
    end
  end

  defp format_hour_list(hours) do
    if length(hours) == 0 do
      "Unknown"
    else
      formatted_hours = Enum.map(hours, fn hour ->
        "#{String.pad_leading(Integer.to_string(hour), 2, "0")}:00"
      end)
      Enum.join(formatted_hours, ", ")
    end
  end

  defp calculate_threat_confidence(historical_data) do
    total_engagements = Map.get(historical_data, :total_engagements, 0)
    
    cond do
      total_engagements >= 200 -> :very_high
      total_engagements >= 100 -> :high
      total_engagements >= 50 -> :moderate
      total_engagements >= 20 -> :low
      total_engagements > 0 -> :very_low
      true -> :no_data
    end
  end

  # Placeholder implementations for basic threat rating compatibility
  defp estimate_threat_rating(participant) do
    # Enhanced implementation using comprehensive system
    threat_profile = calculate_comprehensive_threat_rating(participant)
    threat_profile.overall_threat_rating
  end

  defp get_historical_performance(participant) do
    # Enhanced implementation using comprehensive system
    performance_profile = get_comprehensive_historical_performance(participant)
    
    # Extract key metrics for backward compatibility
    monthly_data = performance_profile.performance_summary.monthly_performance || []
    
    if length(monthly_data) > 0 do
      recent_month = List.first(monthly_data)
      %{
        kills: Map.get(recent_month, :kills, 0),
        deaths: Map.get(recent_month, :deaths, 0),
        isk_efficiency: Map.get(recent_month, :kill_efficiency, 0.0),
        recent_activity: (if Map.get(recent_month, :engagements, 0) > 10, do: :active, else: :inactive)
      }
    else
      %{kills: 0, deaths: 0, isk_efficiency: 0.0, recent_activity: :unknown}
    end
  end

  # Supporting functions for comprehensive threat rating and performance analysis
  defp calculate_performance_metrics(performance_data) do
    monthly_data = Map.get(performance_data, :monthly_performance, [])
    
    if length(monthly_data) == 0 do
      %{monthly_performance: []}
    else
      # Calculate aggregate metrics
      total_engagements = Enum.sum(Enum.map(monthly_data, & &1.engagements))
      total_kills = Enum.sum(Enum.map(monthly_data, & &1.kills))
      total_deaths = Enum.sum(Enum.map(monthly_data, & &1.deaths))
      
      avg_kd_ratio = if total_deaths > 0, do: total_kills / total_deaths, else: total_kills
      avg_kill_efficiency = Enum.sum(Enum.map(monthly_data, & &1.kill_efficiency)) / max(length(monthly_data), 1)
      
      %{
        monthly_performance: monthly_data,
        aggregate_metrics: %{
          total_engagements: total_engagements,
          total_kills: total_kills,
          total_deaths: total_deaths,
          overall_kd_ratio: Float.round(avg_kd_ratio, 2),
          average_kill_efficiency: Float.round(avg_kill_efficiency, 2),
          months_active: length(monthly_data)
        }
      }
    end
  end

  defp analyze_performance_trends(performance_data) do
    monthly_data = Map.get(performance_data, :monthly_performance, [])
    
    if length(monthly_data) < 2 do
      %{trend: :insufficient_data, analysis: "Not enough data for trend analysis"}
    else
      # Analyze KD ratio trend
      kd_ratios = Enum.map(monthly_data, & &1.kd_ratio)
      kd_trend = calculate_trend(kd_ratios)
      
      # Analyze activity trend
      engagements = Enum.map(monthly_data, & &1.engagements)
      activity_trend = calculate_trend(engagements)
      
      # Analyze kill efficiency trend
      efficiencies = Enum.map(monthly_data, & &1.kill_efficiency)
      efficiency_trend = calculate_trend(efficiencies)
      
      %{
        kd_ratio_trend: kd_trend,
        activity_trend: activity_trend,
        efficiency_trend: efficiency_trend,
        overall_trend: determine_overall_trend(kd_trend, activity_trend, efficiency_trend),
        trend_strength: calculate_trend_strength(monthly_data)
      }
    end
  end

  defp calculate_performance_benchmarks(performance_data, participant) do
    monthly_data = Map.get(performance_data, :monthly_performance, [])
    
    if length(monthly_data) == 0 do
      %{benchmarks: %{}, analysis: "No data available for benchmarking"}
    else
      recent_performance = Enum.take(monthly_data, 3)  # Last 3 months
      historical_performance = Enum.drop(monthly_data, 3)  # Earlier months
      
      recent_avg_kd = calculate_average_kd(recent_performance)
      historical_avg_kd = calculate_average_kd(historical_performance)
      
      %{
        recent_vs_historical: %{
          recent_kd_ratio: recent_avg_kd,
          historical_kd_ratio: historical_avg_kd,
          improvement: recent_avg_kd - historical_avg_kd
        },
        peak_performance: identify_peak_month(monthly_data),
        consistency_score: calculate_consistency_score(monthly_data),
        performance_volatility: calculate_performance_volatility(monthly_data)
      }
    end
  end

