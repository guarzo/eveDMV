  defp generate_predictive_threat_assessment(threat_rating, historical_performance) do
    # Advanced predictive threat modeling
    threat_level = Map.get(threat_rating, :threat_level, :minimal)
    recent_activity = Map.get(historical_performance, :recent_activity, :inactive)
    
    threat_trend = analyze_threat_trend(threat_rating, historical_performance)
    activity_forecast = forecast_activity_level(historical_performance)
    
    prediction_confidence = calculate_prediction_confidence(threat_rating, historical_performance)
    
    %{
      predicted_threat_level: predict_future_threat_level(threat_level, threat_trend),
      threat_trajectory: threat_trend,
      activity_forecast: activity_forecast,
      engagement_likelihood: calculate_engagement_likelihood(historical_performance),
      prediction_confidence: prediction_confidence,
      risk_factors: identify_escalation_risk_factors(threat_rating, historical_performance),
      recommended_watch_level: determine_watch_level(threat_level, threat_trend, activity_forecast)
    }
  end

  defp generate_intelligence_summary(threat_rating, historical_performance, activity_patterns) do
    # Comprehensive intelligence summary generation
    threat_level = Map.get(threat_rating, :threat_level, :minimal)
    composite_score = Map.get(threat_rating, :composite_score, 0.0)
    
    # Generate threat assessment summary
    threat_summary = format_threat_assessment_summary(threat_level, composite_score, threat_rating)
    
    # Generate activity summary  
    activity_summary = format_activity_summary(activity_patterns)
    
    # Generate performance summary
    performance_summary = format_performance_summary(historical_performance)
    
    # Generate tactical recommendations
    tactical_recommendations = generate_tactical_recommendations(threat_rating, activity_patterns)
    
    """
    === INTELLIGENCE SUMMARY ===
    
    THREAT ASSESSMENT:
    #{threat_summary}
    
    ACTIVITY PATTERNS:
    #{activity_summary}
    
    HISTORICAL PERFORMANCE:
    #{performance_summary}
    
    TACTICAL RECOMMENDATIONS:
    #{tactical_recommendations}
    
    Intelligence confidence: #{Map.get(threat_rating, :confidence, :moderate)}
    Last updated: #{DateTime.utc_now() |> DateTime.to_string()}
    """
  end

  defp calculate_overall_data_confidence(threat_rating, historical_performance) do
    # Calculate composite data confidence score
    threat_confidence = case Map.get(threat_rating, :confidence, :moderate) do
      :very_high -> 0.9
      :high -> 0.8  
      :moderate -> 0.6
      :low -> 0.4
      :very_low -> 0.2
      _ -> 0.3
    end
    
    performance_confidence = case Map.get(historical_performance, :recent_activity, :unknown) do
      :active -> 0.8
      :inactive -> 0.6
      :unknown -> 0.3
    end
    
    # Composite confidence calculation
    composite_confidence = (threat_confidence * 0.6) + (performance_confidence * 0.4)
    
    cond do
      composite_confidence >= 0.8 -> :high
      composite_confidence >= 0.6 -> :moderate  
      composite_confidence >= 0.4 -> :low
      true -> :very_low
    end
  end

  # Enhanced specialization identification systems
  def identify_comprehensive_specializations(participant) do
    # Comprehensive specialization identification using multiple analysis methods
    Logger.debug("Identifying comprehensive specializations for character #{participant.character_id}")
    
    # Fetch specialized data for analysis
    specialization_data = fetch_specialization_analysis_data(participant)
    
    # Analyze different specialization dimensions
    combat_specializations = identify_combat_specializations(specialization_data, participant)
    tactical_specializations = identify_tactical_specializations(specialization_data, participant)
    ship_specializations = identify_ship_specializations(specialization_data, participant)
    weapon_specializations = identify_weapon_specializations(specialization_data, participant)
    role_specializations = identify_role_specializations(specialization_data, participant)
    behavioral_specializations = identify_behavioral_specializations(specialization_data, participant)
    
    # Calculate specialization confidence and primary focus
    all_specializations = combine_specializations([
      combat_specializations, tactical_specializations, ship_specializations,
      weapon_specializations, role_specializations, behavioral_specializations
    ])
    
    primary_specialization = determine_primary_specialization(all_specializations, specialization_data)
    specialization_confidence = calculate_specialization_confidence(all_specializations, specialization_data)
    specialization_evolution = analyze_specialization_evolution(specialization_data)
    
    %{
      primary_specialization: primary_specialization,
      all_specializations: all_specializations,
      specialization_breakdown: %{
        combat: combat_specializations,
        tactical: tactical_specializations,
        ship: ship_specializations,
        weapon: weapon_specializations,
        role: role_specializations,
        behavioral: behavioral_specializations
      },
      confidence: specialization_confidence,
      specialization_strength: calculate_specialization_strength(all_specializations, specialization_data),
      evolution_analysis: specialization_evolution,
      recommendations: generate_specialization_recommendations(primary_specialization, all_specializations),
      counter_strategies: generate_specialization_counter_strategies(primary_specialization, all_specializations)
    }
  end

  def analyze_pilot_combat_patterns(participant) do
    # Analyze detailed combat patterns to identify fighting styles
    Logger.debug("Analyzing combat patterns for character #{participant.character_id}")
    
    combat_data = fetch_combat_pattern_data(participant)
    
    # Analyze different combat pattern dimensions
    engagement_patterns = analyze_engagement_patterns(combat_data)
    damage_patterns = analyze_damage_patterns(combat_data)
    targeting_patterns = analyze_targeting_patterns(combat_data)
    positioning_patterns = analyze_positioning_patterns(combat_data)
    timing_patterns = analyze_timing_patterns(combat_data)
    
    %{
      combat_style: determine_combat_style(combat_data),
      engagement_patterns: engagement_patterns,
      damage_patterns: damage_patterns,
      targeting_patterns: targeting_patterns,
      positioning_patterns: positioning_patterns,
      timing_patterns: timing_patterns,
      combat_effectiveness: calculate_combat_effectiveness(combat_data),
      preferred_scenarios: identify_preferred_combat_scenarios(combat_data),
      weaknesses: identify_combat_weaknesses(combat_data)
    }
  end

  def create_pilot_specialization_profile(participant) do
    # Create comprehensive pilot specialization profile
    Logger.debug("Creating specialization profile for character #{participant.character_id}")
    
    specializations = identify_comprehensive_specializations(participant)
    combat_patterns = analyze_pilot_combat_patterns(participant)
    
    # Additional specialized analysis
    fleet_role_analysis = analyze_fleet_role_specialization(participant)
    situational_analysis = analyze_situational_specializations(participant)
    meta_analysis = analyze_meta_game_specializations(participant)
    
    %{
      participant_id: participant.character_id,
