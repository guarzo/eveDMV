defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.ShipClassificationAnalyzer do
  @moduledoc """
  Handles ship classification, fleet composition analysis, and ship-related metrics.

  Responsible for:
  - Classifying ships by type ID and capabilities
  - Analyzing fleet composition and ship distributions
  - Detecting doctrine patterns and fleet structures
  - Calculating ship-based ratios and metrics
  - Identifying ship roles and tactical functions
  - Analyzing ship diversity and effectiveness
  """

  require Logger

  @doc """
  Classify ship based on type ID.
  """
  def classify_ship(ship_type_id) do
    cond do
      # Frigates
      ship_type_id in [582, 583, 584, 585, 586, 587, 588, 589] -> :frigate
      # Destroyers
      ship_type_id in [16_236, 16_238, 16_240, 16_242] -> :destroyer
      # Cruisers
      ship_type_id in [620, 621, 622, 623, 624, 625, 626, 627] -> :cruiser
      # Battlecruisers
      ship_type_id in [16_227, 16_229, 16_231, 16_233] -> :battlecruiser
      # Battleships
      ship_type_id in [638, 639, 640, 641, 642, 643, 644, 645] -> :battleship
      # Strategic Cruisers (T3C)
      ship_type_id in [29_984, 29_986, 29_988, 29_990] -> :strategic_cruiser
      # Logistics Cruisers
      ship_type_id in [11_985, 11_987, 11_989, 12_003] -> :logistics
      # Recon Ships
      ship_type_id in [11_957, 11_959, 11_961, 11_963] -> :recon
      # Heavy Assault Cruisers
      ship_type_id in [11_991, 12_005, 11_993, 11_995] -> :heavy_assault_cruiser
      # Capital ships
      ship_type_id > 20_000 and ship_type_id < 30_000 -> :capital
      # Default
      true -> :unknown
    end
  end

  @doc """
  Analyze ship composition for a side's participants.
  """
  def analyze_side_ship_composition(participants) do
    participants
    |>     Enum.flat_map(&MapSet.to_list(&1.ships_used))
    Enum.frequencies()
  end

  @doc """
  Detect doctrine usage patterns from ship composition.
  """
  def detect_doctrine_usage(ship_composition) do
    if Enum.empty?(ship_composition) do
      %{
        detected_doctrines: [],
        confidence: 0.0,
        analysis: "No ship composition data available"
      }
    else
      # Analyze ship composition to detect doctrine patterns
      ship_analysis = analyze_ship_patterns(ship_composition)
      doctrine_matches = match_known_doctrines(ship_analysis)

      # Calculate overall confidence based on pattern strength
      overall_confidence = calculate_doctrine_confidence(doctrine_matches, ship_analysis)

      %{
        detected_doctrines: doctrine_matches,
        confidence: overall_confidence,
        analysis: generate_doctrine_analysis(doctrine_matches, ship_analysis),
        ship_composition_breakdown: ship_analysis.breakdown,
        total_ships: ship_analysis.total_ships,
        dominant_ship_classes: ship_analysis.dominant_classes
      }
    end
  end

  @doc """
  Calculate logistics ship ratio in fleet composition.
  """
  def calculate_logistics_ratio(ship_composition) do
    total_ships = Enum.sum(Map.values(ship_composition))

    if total_ships > 0 do
      logistics_ships =
        ship_composition
        |>         Enum.filter(fn {ship_type_id, _count} ->
          classify_ship(ship_type_id) == :logistics
        end)
        Enum.map(fn {_, count} -> count end) Enum.sum()

      Float.round(logistics_ships / total_ships, 3)
    else
      0.0
    end
  end

  @doc """
  Analyze ship patterns from composition data.
  """
  def analyze_ship_patterns(ship_composition) do
    if Enum.empty?(ship_composition) do
      %{
        breakdown: %{},
        total_ships: 0,
        dominant_classes: [],
        diversity_score: 0.0,
        mono_doctrine: false
      }
    else
      # Group ships by class
      ship_classes = group_ships_by_class(ship_composition)
      total_ships = Enum.sum(Map.values(ship_composition))

      # Calculate breakdown percentages
      breakdown =
        Enum.map(ship_classes, fn {class, ships} ->
          count = Enum.sum(Map.values(ships))
          percentage = Float.round(count / total_ships * 100, 1)
          {class, %{count: count, percentage: percentage, ships: ships}}
        end)
        Map.new()

      # Identify dominant classes (>20% of fleet)
      dominant_classes =
        breakdown
        Enum.filter(fn {_class, data} -> data.percentage > 20.0 end)
        Enum.map(fn {class, _data} -> class end)

      # Calculate diversity score (higher = more diverse)
      diversity_score = calculate_ship_diversity_score(breakdown)

      # Check if mono-doctrine (>80% single class)
      mono_doctrine =
        Enum.any?(breakdown, fn {_class, data} -> data.percentage > 80.0 end)

      %{
        breakdown: breakdown,
        total_ships: total_ships,
        dominant_classes: dominant_classes,
        diversity_score: diversity_score,
        mono_doctrine: mono_doctrine
      }
    end
  end

  @doc """
  Match ship composition against known doctrines.
  """
  def match_known_doctrines(ship_analysis) do

    # Alpha Fleet (Maelstrom/Tempest focused)
    doctrines = doctrines ++ check_alpha_fleet_doctrine(ship_analysis)

    # Muninn Fleet (HAC focused)
    doctrines = doctrines ++ check_muninn_fleet_doctrine(ship_analysis)

    # Cerberus Fleet (HAM Legion)
    doctrines = doctrines ++ check_cerberus_fleet_doctrine(ship_analysis)

    # Eagle Fleet (Rail HACs)
    doctrines = doctrines ++ check_eagle_fleet_doctrine(ship_analysis)

    # Ferox Fleet (Attack Battlecruisers)
    doctrines = doctrines ++ check_ferox_fleet_doctrine(ship_analysis)

    # Hurricane Fleet (Battlecruiser focused)
    doctrines = doctrines ++ check_hurricane_fleet_doctrine(ship_analysis)

    # Thorax Fleet (Medium rail cruisers)
    doctrines = doctrines ++ check_thorax_fleet_doctrine(ship_analysis)

    # Caracal Fleet (Medium missile cruisers)
    doctrines = doctrines ++ check_caracal_fleet_doctrine(ship_analysis)

    # Mixed doctrines and specialized fleets
    _doctrines = doctrines ++ check_mixed_doctrines(ship_analysis)

    # Sort by confidence and return top matches
    doctrines
    Enum.sort_by(& &1.confidence, :desc)
    Enum.take(3)
  end

  @doc """
  Group ships by their classification.
  """
  def group_ships_by_class(ship_composition) do
    ship_composition
    |>     Enum.group_by(fn {ship_type_id, _count} ->
      classify_ship(ship_type_id)
    end)
    Enum.map(fn {class, ships} ->
      ship_map = ships |> Enum.map(fn {ship_id, count} -> {ship_id, count} end) Map.new()
      {class, ship_map}
    end)
    Map.new()
  end

  @doc """
  Classify ship by type ID with detailed categories.
  """
  def classify_ship_type_id(ship_type_id) do
    case classify_ship(ship_type_id) do
      :frigate -> %{class: :frigate, size: :small, role: :support}
      :destroyer -> %{class: :destroyer, size: :small, role: :anti_frigate}
      :cruiser -> %{class: :cruiser, size: :medium, role: :mainline}
      :battlecruiser -> %{class: :battlecruiser, size: :large, role: :heavy_dps}
      :battleship -> %{class: :battleship, size: :large, role: :anchor}
      :strategic_cruiser -> %{class: :strategic_cruiser, size: :medium, role: :specialized}
      :logistics -> %{class: :logistics, size: :medium, role: :support}
      :recon -> %{class: :recon, size: :medium, role: :ewar}
      :heavy_assault_cruiser -> %{class: :heavy_assault_cruiser, size: :medium, role: :assault}
      :capital -> %{class: :capital, size: :extra_large, role: :strategic}
      _ -> %{class: :unknown, size: :unknown, role: :unknown}
    end
  end

  # Private helper functions

  defp calculate_doctrine_confidence(doctrine_matches, ship_analysis) do
    if Enum.empty?(doctrine_matches) do
      0.0
    else
      # Average confidence of top matches, weighted by ship count
      total_confidence = doctrine_matches |> Enum.map(& &1.confidence) Enum.sum()
      match_count = length(doctrine_matches)

      base_confidence = total_confidence / match_count

      # Boost confidence for larger fleets (more data)
      fleet_size_modifier = min(ship_analysis.total_ships / 20, 1.0)

      Float.round(base_confidence * (0.7 + 0.3 * fleet_size_modifier), 2)
    end
  end

  defp generate_doctrine_analysis(doctrine_matches, ship_analysis) do
    if Enum.empty?(doctrine_matches) do
      "No known doctrine patterns detected. Fleet composition: #{ship_analysis.total_ships} ships across #{length(ship_analysis.dominant_classes)} primary classes."
    else
      primary_doctrine = List.first(doctrine_matches)

      "Primary doctrine detected: #{primary_doctrine.name} (#{primary_doctrine.confidence}% confidence). Fleet of #{ship_analysis.total_ships} ships with dominant classes: #{Enum.join(ship_analysis.dominant_classes, ", ")}."
    end
  end

  defp calculate_ship_diversity_score(breakdown) do
    if Enum.empty?(breakdown) do
      0.0
    else
      # Calculate Shannon diversity index for ship classes
      total_ships = breakdown |> Enum.map(fn {_, data} -> data.count end) Enum.sum()

      diversity =
        breakdown
        |>         Enum.map(fn {_, data} ->
          proportion = data.count / total_ships
          if proportion > 0, do: -proportion * :math.log2(proportion), else: 0
        end) Enum.sum()

      # Normalize to 0-1 scale (max diversity for 6 ship classes)
      Float.round(diversity / :math.log2(6), 2)
    end
  end

  # Doctrine detection functions

  defp check_alpha_fleet_doctrine(ship_analysis) do
    battleship_pct = get_class_percentage(ship_analysis, :battleship)
    logistics_pct = get_class_percentage(ship_analysis, :logistics)

    if battleship_pct > 60 and logistics_pct > 10 do
      [
        %{
          name: "Alpha Fleet",
          type: :battleship_doctrine,
          confidence: calculate_doctrine_match_confidence(battleship_pct, logistics_pct),
          description: "Battleship-focused doctrine with logistics support"
        }
      ]
    else
      []
    end
  end

  defp check_muninn_fleet_doctrine(ship_analysis) do
    hac_pct = get_class_percentage(ship_analysis, :heavy_assault_cruiser)
    logistics_pct = get_class_percentage(ship_analysis, :logistics)

    if hac_pct > 50 and logistics_pct > 15 do
      [
        %{
          name: "Muninn Fleet",
          type: :hac_doctrine,
          confidence: calculate_doctrine_match_confidence(hac_pct, logistics_pct),
          description: "Heavy Assault Cruiser doctrine with strong logistics"
        }
      ]
    else
      []
    end
  end

  defp check_cerberus_fleet_doctrine(ship_analysis) do
    hac_pct = get_class_percentage(ship_analysis, :heavy_assault_cruiser)
    logistics_pct = get_class_percentage(ship_analysis, :logistics)

    if hac_pct > 45 and logistics_pct > 10 and ship_analysis.total_ships > 25 do
      [
        %{
          name: "Cerberus Fleet",
          type: :hac_doctrine,
          confidence: calculate_doctrine_match_confidence(hac_pct, logistics_pct) * 0.9,
          description: "Heavy Missile HAC doctrine"
        }
      ]
    else
      []
    end
  end

  defp check_eagle_fleet_doctrine(ship_analysis) do
    hac_pct = get_class_percentage(ship_analysis, :heavy_assault_cruiser)
    logistics_pct = get_class_percentage(ship_analysis, :logistics)

    if hac_pct > 45 and logistics_pct > 12 do
      [
        %{
          name: "Eagle Fleet",
          type: :hac_doctrine,
          confidence: calculate_doctrine_match_confidence(hac_pct, logistics_pct) * 0.95,
          description: "Rail HAC doctrine with long-range projection"
        }
      ]
    else
      []
    end
  end

  defp check_ferox_fleet_doctrine(ship_analysis) do
    bc_pct = get_class_percentage(ship_analysis, :battlecruiser)
    logistics_pct = get_class_percentage(ship_analysis, :logistics)

    if bc_pct > 55 and logistics_pct > 8 do
      [
        %{
          name: "Ferox Fleet",
          type: :battlecruiser_doctrine,
          confidence: calculate_doctrine_match_confidence(bc_pct, logistics_pct),
          description: "Rail Battlecruiser doctrine"
        }
      ]
    else
      []
    end
  end

  defp check_hurricane_fleet_doctrine(ship_analysis) do
    bc_pct = get_class_percentage(ship_analysis, :battlecruiser)

    if bc_pct > 50 do
      [
        %{
          name: "Hurricane Fleet",
          type: :battlecruiser_doctrine,
          confidence: min(bc_pct, 85.0),
          description: "Projectile Battlecruiser doctrine"
        }
      ]
    else
      []
    end
  end

  defp check_thorax_fleet_doctrine(ship_analysis) do
    cruiser_pct = get_class_percentage(ship_analysis, :cruiser)
    logistics_pct = get_class_percentage(ship_analysis, :logistics)

    if cruiser_pct > 60 and logistics_pct > 15 do
      [
        %{
          name: "Thorax Fleet",
          type: :cruiser_doctrine,
          confidence: calculate_doctrine_match_confidence(cruiser_pct, logistics_pct) * 0.8,
          description: "Rail Cruiser doctrine"
        }
      ]
    else
      []
    end
  end

  defp check_caracal_fleet_doctrine(ship_analysis) do
    cruiser_pct = get_class_percentage(ship_analysis, :cruiser)
    logistics_pct = get_class_percentage(ship_analysis, :logistics)

    if cruiser_pct > 55 and logistics_pct > 10 do
      [
        %{
          name: "Caracal Fleet",
          type: :cruiser_doctrine,
          confidence: calculate_doctrine_match_confidence(cruiser_pct, logistics_pct) * 0.85,
          description: "Missile Cruiser doctrine"
        }
      ]
    else
      []
    end
  end

  defp check_mixed_doctrines(ship_analysis) do

    # Kitchen sink (high diversity)
    doctrines =
      if ship_analysis.diversity_score > 0.7 do
        [
          %{
            name: "Kitchen Sink",
            type: :mixed_doctrine,
            confidence: ship_analysis.diversity_score * 80,
            description: "Mixed ship composition with high diversity"
          }
          | doctrines
        ]
      else
        doctrines
      end

    # Nano gang (frigate heavy)
    frigate_pct = get_class_percentage(ship_analysis, :frigate)

    _doctrines =
      if frigate_pct > 40 do
        [
          %{
            name: "Nano Gang",
            type: :frigate_doctrine,
            confidence: min(frigate_pct, 75.0),
            description: "Fast frigate-based composition"
          }
          | doctrines
        ]
      else
        doctrines
      end

    doctrines
  end

  defp get_class_percentage(ship_analysis, class) do
    case Map.get(ship_analysis.breakdown, class) do
      nil -> 0.0
      data -> data.percentage
    end
  end

  defp calculate_doctrine_match_confidence(primary_pct, support_pct) do
    # Base confidence on primary ship percentage
    base_confidence = min(primary_pct, 90.0)

    # Bonus for logistics support
    logistics_bonus = min(support_pct * 2, 10.0)

    Float.round(base_confidence + logistics_bonus, 1)
  end
end
