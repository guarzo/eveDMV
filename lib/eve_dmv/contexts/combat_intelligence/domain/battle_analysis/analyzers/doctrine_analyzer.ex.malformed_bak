defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.DoctrineAnalyzer do
  @moduledoc """
  Doctrine analysis engine for fleet doctrine detection and evaluation.

  Handles:
  - Fleet doctrine pattern recognition
  - Doctrine effectiveness analysis
  - Doctrine matching against known patterns
  - Doctrine confidence scoring
  - Capital, subcap, and specialized doctrine detection
  """

  alias EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.ShipCompositionAnalyzer

  require Logger

  @doc """
  Detect doctrine usage from ship composition.
  """
  def detect_doctrine_usage(ship_composition) do
    # Detect common doctrine patterns based on ship composition
    if Enum.empty?(ship_composition) do
      %{
        detected_doctrines: [],
        confidence: 0.0,
        analysis: "No ship composition data available"
      }
    else
      # Analyze ship composition to detect doctrine patterns
      ship_analysis = ShipCompositionAnalyzer.analyze_ship_patterns(ship_composition)
      doctrine_matches = match_known_doctrines(ship_analysis)

      # Calculate overall confidence based on pattern strength
      overall_confidence = calculate_doctrine_confidence(doctrine_matches, ship_analysis)

      %{
        detected_doctrines: doctrine_matches,
        confidence: overall_confidence,
        analysis: generate_doctrine_analysis(doctrine_matches, ship_analysis),
        ship_composition_breakdown: ship_analysis.breakdown,
        total_ships: ship_analysis.total_ships,
        dominant_ship_classes: ship_analysis.dominant_classes
      }
    end
  end

  @doc """
  Match ship analysis against known doctrine patterns.
  """
  def match_known_doctrines(ship_analysis) do
    capital_doctrines = analyze_capital_doctrines(ship_analysis)
    subcap_doctrines = analyze_subcap_doctrines(ship_analysis)
    specialized_doctrines = analyze_specialized_doctrines(ship_analysis)

    (capital_doctrines ++ subcap_doctrines ++ specialized_doctrines)
    Enum.sort_by(& &1.confidence, :desc)
  end

  @doc """
  Analyze capital doctrines from ship analysis.
  """
  def analyze_capital_doctrines(ship_analysis) do
    capital_classes = [:titan, :supercarrier, :carrier, :dreadnought, :force_auxiliary]

    capital_ships =
      capital_classes
      |>       Enum.map(fn class ->
        count = get_in(ship_analysis, [:breakdown, class, :count]) || 0
        percentage = get_in(ship_analysis, [:breakdown, class, :percentage]) || 0.0
        {class, %{count: count, percentage: percentage}}
      end)
      Enum.filter(fn {_class, data} -> data.count > 0 end)

    if Enum.empty?(capital_ships) do
      []
    else
      # Detect specific capital doctrines

      # Titan doctrine
      titan_data = List.keyfind(capital_ships, :titan, 0)
      if titan_data && elem(titan_data, 1).count >= 5 do
        doctrines = [%{
          name: "Titan Doctrine",
          type: :capital,
          confidence: min(95.0, elem(titan_data, 1).percentage * 2),
          key_ships: [:titan],
          description: "Titan-heavy capital doctrine"
        } | doctrines]
      end

      # Supercarrier doctrine
      super_data = List.keyfind(capital_ships, :supercarrier, 0)
      if super_data && elem(super_data, 1).count >= 3 do
        doctrines = [%{
          name: "Supercarrier Doctrine",
          type: :capital,
          confidence: min(90.0, elem(super_data, 1).percentage * 2),
          key_ships: [:supercarrier],
          description: "Supercarrier-focused capital doctrine"
        } | doctrines]
      end

      # Dread bomb
      dread_data = List.keyfind(capital_ships, :dreadnought, 0)
      if dread_data && elem(dread_data, 1).count >= 10 do
        doctrines = [%{
          name: "Dread Bomb",
          type: :capital,
          confidence: min(85.0, elem(dread_data, 1).percentage * 1.5),
          key_ships: [:dreadnought],
          description: "Dreadnought bombing doctrine"
        } | doctrines]
      end

      doctrines
    end
  end

  @doc """
  Analyze subcapital doctrines from ship analysis.
  """
  def analyze_subcap_doctrines(ship_analysis) do
    subcap_classes = [:battleship, :battlecruiser, :cruiser, :destroyer, :frigate]

    subcap_ships =
      subcap_classes
      |>       Enum.map(fn class ->
        count = get_in(ship_analysis, [:breakdown, class, :count]) || 0
        percentage = get_in(ship_analysis, [:breakdown, class, :percentage]) || 0.0
        {class, %{count: count, percentage: percentage}}
      end)
      Enum.filter(fn {_class, data} -> data.count > 0 end)

    if Enum.empty?(subcap_ships) do
      []
    else

      # Battleship doctrine
      bs_data = List.keyfind(subcap_ships, :battleship, 0)
      if bs_data && elem(bs_data, 1).percentage > 60 do
        doctrines = [%{
          name: "Battleship Doctrine",
          type: :subcap,
          confidence: min(80.0, elem(bs_data, 1).percentage),
          key_ships: [:battleship],
          description: "Battleship-heavy doctrine"
        } | doctrines]
      end

      # Cruiser doctrine
      cruiser_data = List.keyfind(subcap_ships, :cruiser, 0)
      if cruiser_data && elem(cruiser_data, 1).percentage > 50 do
        doctrines = [%{
          name: "Cruiser Doctrine",
          type: :subcap,
          confidence: min(75.0, elem(cruiser_data, 1).percentage),
          key_ships: [:cruiser],
          description: "Cruiser-focused doctrine"
        } | doctrines]
      end

      # Frigate swarm
      frigate_data = List.keyfind(subcap_ships, :frigate, 0)
      if frigate_data && elem(frigate_data, 1).percentage > 70 do
        doctrines = [%{
          name: "Frigate Swarm",
          type: :subcap,
          confidence: min(85.0, elem(frigate_data, 1).percentage),
          key_ships: [:frigate],
          description: "Frigate swarm tactics"
        } | doctrines]
      end

      doctrines
    end
  end

  @doc """
  Analyze specialized doctrines from ship analysis.
  """
  def analyze_specialized_doctrines(ship_analysis) do
    support_analysis = ship_analysis.support_analysis || %{}


    # EWAR doctrine
    if support_analysis[:ewar_count] && support_analysis.ewar_count >= 5 do
      ewar_percentage = (support_analysis.ewar_count / ship_analysis.total_ships) * 100
      if ewar_percentage > 25 do
        doctrines = [%{
          name: "EWAR Doctrine",
          type: :specialized,
          confidence: min(70.0, ewar_percentage * 2),
          key_ships: [:electronic_warfare, :recon],
          description: "Electronic warfare focused doctrine"
        } | doctrines]
      end
    end

    # Logistics heavy
    if support_analysis[:logistics_count] && support_analysis.logistics_count >= 3 do
      logi_percentage = (support_analysis.logistics_count / ship_analysis.total_ships) * 100
      if logi_percentage > 15 do
        doctrines = [%{
          name: "Logistics Heavy",
          type: :specialized,
          confidence: min(65.0, logi_percentage * 3),
          key_ships: [:logistics],
          description: "Logistics-heavy sustainable doctrine"
        } | doctrines]
      end
    end

    doctrines
  end

  @doc """
  Calculate overall doctrine confidence score.
  """
  def calculate_doctrine_confidence(doctrine_matches, ship_analysis) do
    if Enum.empty?(doctrine_matches) do
      0.0
    else
      # Weight confidence by ship diversity and match strength
      max_confidence = Enum.max_by(doctrine_matches, & &1.confidence).confidence
      match_count = length(doctrine_matches)
      diversity_factor = min(1.0, ship_analysis.ship_diversity / 100)

      # Higher diversity slightly reduces confidence, multiple matches increase it
      base_confidence = max_confidence * (0.8 + diversity_factor * 0.2)
      match_bonus = min(20.0, (match_count - 1) * 5)

      Float.round(min(100.0, base_confidence + match_bonus), 1)
    end
  end

  @doc """
  Generate doctrine analysis description.
  """
  def generate_doctrine_analysis(doctrine_matches, ship_analysis) do
    if Enum.empty?(doctrine_matches) do
      "No clear doctrine patterns detected in fleet composition"
    else
      primary_doctrine = Enum.max_by(doctrine_matches, & &1.confidence)
      total_ships = ship_analysis.total_ships

      analysis_parts = [
        "Primary doctrine: #{primary_doctrine.name} (#{Float.round(primary_doctrine.confidence, 1)}% confidence)",
        "Fleet size: #{total_ships} ships",
        "Ship diversity: #{Float.round(ship_analysis.ship_diversity, 1)}%"
      ]

      # Add secondary doctrines if present
      secondary_doctrines =
        doctrine_matches
        |>         Enum.reject(&(&1 == primary_doctrine))
        Enum.filter(&(&1.confidence > 30))
        Enum.take(2)

      analysis_parts = if not Enum.empty?(secondary_doctrines) do
        secondary_names = Enum.map(secondary_doctrines, & &1.name)
        ["Secondary patterns: #{Enum.join(secondary_names, ", ")}" | analysis_parts]
      else
        analysis_parts
      end

      # Add dominant ship classes
      analysis_parts = if not Enum.empty?(ship_analysis.dominant_classes) do
        dominant_classes = Enum.join(ship_analysis.dominant_classes, ", ")
        ["Dominant ship classes: #{dominant_classes}" | analysis_parts]
      else
        analysis_parts
      end

      analysis_parts = Enum.reverse(analysis_parts)

      Enum.join(analysis_parts, ". ")
    end
  end

  @doc """
  Compare doctrine usage across multiple battles.
  """
  def compare_doctrine_usage(battle_analyses) do
    # Extract doctrine usage from each battle
    doctrine_usage =
      battle_analyses
      |>       Enum.flat_map(fn battle ->
        fleet_analysis = battle.fleet_compositions || %{}

        fleet_analysis
        |>         Enum.flat_map(fn {_side, side_analysis} ->
          doctrine_info = side_analysis[:doctrine_detected] || %{}
          doctrine_info[:detected_doctrines] || []
        end)
      end)

    if Enum.empty?(doctrine_usage) do
      %{
        doctrine_trends: [],
        most_popular: nil,
        usage_diversity: 0.0,
        trend_analysis: "Insufficient data for doctrine trend analysis"
      }
    else
      # Count doctrine usage _frequency
      doctrine_counts = Enum.frequencies_by(doctrine_usage, & &1.name)

      # Calculate usage statistics
      total_usage = Enum.sum(Map.values(doctrine_counts))
      most_popular = Enum.max_by(doctrine_counts, fn {_name, count} -> count end)

      # Calculate doctrine diversity (Shannon index)
      usage_diversity = calculate_doctrine_diversity(doctrine_counts, total_usage)

      # Generate trend analysis
      doctrine_timeline = extract_doctrine_timeline(battle_analyses)
      trend_analysis = analyze_doctrine_evolution(doctrine_timeline)

      %{
        doctrine_trends: Map.to_list(doctrine_counts),
        most_popular: most_popular,
        usage_diversity: usage_diversity,
        trend_analysis: trend_analysis,
        total_battles: length(battle_analyses),
        unique_doctrines: map_size(doctrine_counts)
      }
    end
  end

  # Private helper functions

  defp calculate_doctrine_diversity(doctrine_counts, total_usage) do
    if total_usage == 0 do
      0.0
    else
      shannon_index =
        doctrine_counts
        |>         Enum.map(fn {_name, count} ->
          proportion = count / total_usage
          if proportion > 0, do: -proportion * :math.log(proportion), else: 0
        end)
        Enum.sum()

      # Normalize to 0-100 scale
      Float.round(shannon_index / :math.log(10) * 100, 1)
    end
  end

  defp extract_doctrine_timeline(battle_analyses) do
    battle_analyses
    Enum.sort_by(& &1.analyzed_at, DateTime)
    |>     Enum.map(fn battle ->
      doctrines = extract_doctrine_usage(battle)
      %{
        timestamp: battle.analyzed_at,
        doctrines: doctrines
      }
    end)
  end

  defp extract_doctrine_usage(battle) do
    fleet_analysis = battle.fleet_compositions || %{}

    fleet_analysis
    |>     Enum.flat_map(fn {_side, side_analysis} ->
      doctrine_info = side_analysis[:doctrine_detected] || %{}
      doctrine_info[:detected_doctrines] || []
    end)
    Enum.map(& &1.name)
  end

  defp analyze_doctrine_evolution(doctrine_timeline) do
    if length(doctrine_timeline) < 3 do
      "Insufficient timeline data for evolution analysis"
    else
      # Analyze how doctrine usage changes over time
      early_battles = Enum.take(doctrine_timeline, div(length(doctrine_timeline), 3))
      recent_battles = Enum.take(doctrine_timeline, -div(length(doctrine_timeline), 3))

      early_doctrines = early_battles |> Enum.flat_map(& &1.doctrines) Enum.frequencies()
      recent_doctrines = recent_battles |> Enum.flat_map(& &1.doctrines) Enum.frequencies()

      # Find emerging and declining doctrines
      all_doctrines = MapSet.union(MapSet.new(Map.keys(early_doctrines)), MapSet.new(Map.keys(recent_doctrines)))

      changes =
        all_doctrines
        |>         Enum.map(fn doctrine ->
          early_count = Map.get(early_doctrines, doctrine, 0)
          recent_count = Map.get(recent_doctrines, doctrine, 0)

          change = calculate_doctrine_change(early_count, recent_count)

          {doctrine, change}
        end)
        Enum.sort_by(fn {_doctrine, change} -> change end, :desc)

      # Summarize trends
      emerging = changes |> Enum.filter(fn {_d, c} -> c > 0.5 end) Enum.map(fn {d, _c} -> d end)
      declining = changes |> Enum.filter(fn {_d, c} -> c < -0.3 end) Enum.map(fn {d, _c} -> d end)


      if not Enum.empty?(emerging) do
        summary_parts = ["Emerging: #{Enum.join(emerging, ", ")}" | summary_parts]
      end

      if not Enum.empty?(declining) do
        summary_parts = ["Declining: #{Enum.join(declining, ", ")}" | summary_parts]
      end

      if Enum.empty?(summary_parts) do
        "Doctrine usage remains relatively stable over time"
      else
        Enum.join(summary_parts, ". ")
      end
    end
  end

  # Helper function to calculate doctrine usage change, reducing nesting depth
  defp calculate_doctrine_change(early_count, recent_count) do
    if early_count > 0 do
      (recent_count - early_count) / early_count
    else
      if recent_count > 0, do: 1.0, else: 0.0
    end
  end
end
