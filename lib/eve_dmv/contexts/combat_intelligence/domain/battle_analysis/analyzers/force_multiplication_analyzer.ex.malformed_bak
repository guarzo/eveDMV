defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.ForceMultiplicationAnalyzer do
  @moduledoc """
  Force multiplication analysis engine for fleet effectiveness evaluation.

  Responsible for:
  - Identifying force multiplication factors in fleet compositions
  - Analyzing EWAR, logistics, and command ship effectiveness
  - Calculating force multiplication impact on battle outcomes
  - Generating recommendations for force multiplication improvements
  - Evaluating intelligence and positioning advantages
  - Assessing support ship ratios and synergies
  """

  alias EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.EwarAnalysisEngine

  require Logger

  @doc """
  Identify force multipliers in fleet compositions and metrics.
  """
  def identify_force_multipliers(compositions, metrics) do
    %{
      ewar_effectiveness: EwarAnalysisEngine.analyze_ewar_impact(compositions),
      logi_multiplication: calculate_logistics_impact(compositions),
      command_boost_impact: estimate_command_boost_effect(compositions),
      intel_advantage: metrics.intel_quality || 0.5,
      positioning_advantage: analyze_positioning_advantages(compositions)
    }
  end

  @doc """
  Determine priority level for force multiplication improvements.
  """
  def determine_force_mult_priority(force_multipliers) do
    max_impact =
      force_multipliers
      Map.values()
      Enum.max()

    cond do
      max_impact > 0.8 -> :critical
      max_impact > 0.6 -> :high
      max_impact > 0.4 -> :medium
      true -> :low
    end
  end

  @doc """
  Generate action items for force multiplication improvements.
  """
  def generate_force_mult_actions(force_multipliers) do

    actions =
      if force_multipliers.ewar_effectiveness < 0.5 do
        ["Add EWAR support (Falcon, Rook, Blackbird)" | actions]
      else
        actions
      end

    actions =
      if force_multipliers.logi_multiplication < 0.6 do
        ["Increase logistics numbers or train T2 logi" | actions]
      else
        actions
      end

    actions =
      if force_multipliers.command_boost_impact < 0.4 do
        ["Add command ships for fleet boosts" | actions]
      else
        actions
      end

    _actions =
      if force_multipliers.intel_advantage < 0.7 do
        ["Improve intel coverage with scouts/spies" | actions]
      else
        actions
      end

    if Enum.empty?(actions) do
      ["Maintain current force multiplication levels"]
    else
      actions
    end
  end

  @doc """
  Calculate logistics impact on fleet effectiveness.
  """
  def calculate_logistics_impact(compositions) do
    logi_ratio =
      compositions
      Enum.flat_map(& &1.ships)
      Enum.count(&is_logistics_ship?/1)
      case do
        0 ->
          0.0

        logi_count ->
          total_ships = compositions |> Enum.flat_map(& &1.ships) length()

          if total_ships > 0 do
            ratio = logi_count / total_ships
            # Logistics effectiveness peaks around 10-15% of fleet
            cond do
              ratio < 0.05 -> ratio * 4
              ratio <= 0.15 -> 0.8 + ratio * 1.3
              true -> max(0.3, 1.0 - (ratio - 0.15) * 2)
            end
          else
            0.0
          end
      end

    min(1.0, logi_ratio)
  end

  @doc """
  Estimate command boost effect on fleet performance.
  """
  def estimate_command_boost_effect(compositions) do
    command_ships =
      compositions
      Enum.flat_map(& &1.ships)
      Enum.count(&is_command_ship?/1)

    total_ships = compositions |> Enum.flat_map(& &1.ships) length()

    if total_ships > 0 do
      # Command ships provide diminishing returns
      base_boost = min(1.0, command_ships / total_ships * 10)
      # Cap at 80% effectiveness for realism
      min(0.8, base_boost)
    else
      0.0
    end
  end

  @doc """
  Analyze positioning advantages in fleet compositions.
  """
  def analyze_positioning_advantages(_compositions) do
    # Simplified positioning analysis
    # Neutral positioning by default
    0.5
  end

  @doc """
  Check if a ship is a logistics ship by name.
  """
  def is_logistics_ship?(ship_name) when is_binary(ship_name) do
    logi_ships = [
      "Basilisk",
      "Guardian",
      "Scimitar",
      "Oneiros",
      "Osprey",
      "Exequror",
      "Burst",
      "Navitas"
    ]

    Enum.member?(logi_ships, ship_name)
  end

  def is_logistics_ship?(_), do: false

  @doc """
  Check if a ship is a command ship by name.
  """
  def is_command_ship?(ship_name) when is_binary(ship_name) do
    command_ships = [
      "Claymore",
      "Nighthawk",
      "Vulture",
      "Sleipnir",
      "Absolution",
      "Damnation",
      "Astarte",
      "Eos"
    ]

    Enum.member?(command_ships, ship_name)
  end

  def is_command_ship?(_), do: false

  @doc """
  Generate weakness-based training scenarios.
  """
  def generate_weakness_based_scenarios(weaknesses) do
    Enum.map(weaknesses, fn weakness ->
      case weakness.type do
        :low_tank ->
          %{
            name: "Tank Improvement Drill",
            focus: "Survivability training",
            ships: ["Buffer tanked ships", "Logistics support"],
            objectives: [
              "Broadcast for reps quickly",
              "Manage capacitor",
              "Overheat appropriately"
            ]
          }

        :poor_positioning ->
          %{
            name: "Fleet Positioning Practice",
            focus: "Anchor and movement training",
            ships: ["Standard fleet comp"],
            objectives: ["Maintain optimal range", "Follow anchor", "Avoid bumping"]
          }

        :target_calling ->
          %{
            name: "Target Priority Training",
            focus: "FC and DPS coordination",
            ships: ["Mixed fleet composition"],
            objectives: ["Quick target switches", "Primary/secondary calling", "Spread points"]
          }

        :lack_of_coordination ->
          %{
            name: "Fleet Coordination Drill",
            focus: "Communication and timing",
            ships: ["Full fleet composition"],
            objectives: [
              "Follow broadcasts",
              "Time warps together",
              "Coordinate special abilities"
            ]
          }

        _ ->
          %{
            name: "General Fleet Training",
            focus: "Basic fleet operations",
            ships: ["Standard composition"],
            objectives: ["Improve overall performance"]
          }
      end
    end)
  end

  @doc """
  Generate tactical drill scenarios based on insights.
  """
  def generate_tactical_drill_scenarios(insights) do

    # Add scenarios based on tactical patterns
    scenarios =
      case insights[:patterns] do
        patterns when is_list(patterns) ->
          pattern_scenarios =
            patterns
            Enum.take(3)
            |>             Enum.map(fn pattern ->
              %{
                name: "#{pattern.type} Practice",
                focus: "Tactical execution",
                description: "Practice #{pattern.type} maneuvers",
                objectives: generate_pattern_objectives(pattern)
              }
            end)

          base_scenarios ++ pattern_scenarios

        _ ->
          base_scenarios
      end

    # Add scenarios based on weaknesses
    _scenarios =
      case insights[:weaknesses] do
        weaknesses when is_list(weaknesses) ->
          weakness_scenarios = generate_weakness_based_scenarios(weaknesses)
          scenarios ++ weakness_scenarios

        _ ->
          scenarios
      end

    if Enum.empty?(scenarios) do
      [
        %{
          name: "Standard Fleet Practice",
          focus: "General improvement",
          description: "Basic fleet operations and coordination",
          objectives: ["Improve communication", "Practice basic maneuvers", "Team building"]
        }
      ]
    else
      Enum.take(scenarios, 5)
    end
  end

  # Private helper functions

  defp generate_pattern_objectives(pattern) do
    case pattern.type do
      :alpha_strike ->
        ["Coordinate damage application", "Focus fire discipline", "Timing synchronization"]

      :kiting ->
        ["Maintain optimal range", "Speed management", "Transversal control"]

      :brawling ->
        ["Close-range positioning", "Tank management", "Target prioritization"]

      :hit_and_run ->
        ["Quick engagement/disengagement", "Mobility tactics", "Target selection"]

      _ ->
        ["Practice tactical execution", "Improve coordination", "Apply learned techniques"]
    end
  end
end
