defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.DecisiveMomentAnalyzer do
  @moduledoc """
  Decisive moment analyzer for identifying critical battle turning points.

  Handles:
  - Identifying decisive moments in battles
  - Analyzing impact of key events
  - Logistics kill impact assessment
  - Coordination loss estimation
  - Battle momentum shifts
  """

  require Logger

  @doc """
  Identify decisive moments in the battle.
  """
  def identify_decisive_moments(tactical_analysis) do
    # Collect all potential decisive moments

    # Check for logistics kills
    logistics_moments = identify_logistics_kill_moments(tactical_analysis)
    additional_moments = moments ++ logistics_moments

    # Check for FC/command ship losses
    command_additional_moments = identify_command_loss_moments(tactical_analysis)
    additional_moments = moments ++ command_moments

    # Check for mass casualties events
    mass_casualty_additional_moments = identify_mass_casualty_moments(tactical_analysis)
    additional_moments = moments ++ mass_casualty_moments

    # Check for tactical shifts
    tactical_shift_additional_moments = identify_tactical_shift_moments(tactical_analysis)
    additional_moments = moments ++ tactical_shift_moments

    # Check for morale breaks
    morale_break_additional_moments = identify_morale_break_moments(tactical_analysis)
    _additional_moments = moments ++ morale_break_moments

    # Sort by timestamp and impact
    moments
    |>     Enum.sort_by(fn moment -> {moment.timestamp, impact_to_number(moment.impact)} end)
    Enum.take(5)  # Top 5 most decisive moments
  end

  @doc """
  Calculate the impact of logistics kills on battle outcome.
  """
  def calculate_logistics_kill_impact(_killmail, battle_context) do
    # Base impact from logistics removal
    base_impact = 0.3

    # Adjust for fleet size
    fleet_size = Map.get(battle_context, :affected_fleet_size, 10)
    size_multiplier = cond do
      fleet_size < 10 -> 2.0
      fleet_size < 25 -> 1.5
      fleet_size < 50 -> 1.2
      true -> 1.0
    end

    # Adjust for remaining logistics
    remaining_logi = Map.get(battle_context, :remaining_logistics, 0)
    scarcity_multiplier = cond do
      remaining_logi == 0 -> 2.0
      remaining_logi == 1 -> 1.5
      remaining_logi <= 3 -> 1.2
      true -> 1.0
    end

    # Adjust for battle phase
    phase = Map.get(battle_context, :battle_phase, :mid)
    phase_multiplier = case phase do
      :opening -> 1.5
      :mid -> 1.2
      :closing -> 0.8
      _ -> 1.0
    end

    # Calculate total impact
    total_impact = base_impact * size_multiplier * scarcity_multiplier * phase_multiplier

    %{
      impact_score: Float.round(total_impact, 2),
      factors: %{
        base_impact: base_impact,
        fleet_size_effect: size_multiplier,
        scarcity_effect: scarcity_multiplier,
        timing_effect: phase_multiplier
      },
      projected_casualties: estimate_post_logi_casualties(battle_context)
    }
  end

  @doc """
  Analyze the effects after a logistics kill.
  """
  def analyze_post_logistics_kill(pre_kill_metrics, post_kill_metrics) do
    # Calculate immediate effects
    kill_rate_change = calculate_kill_rate_change(pre_kill_metrics, post_kill_metrics)
    survival_rate_change = calculate_survival_rate_change(pre_kill_metrics, post_kill_metrics)

    # Analyze tactical adjustments
    tactical_adjustments = identify_tactical_adjustments(pre_kill_metrics, post_kill_metrics)

    # Measure effectiveness change
    effectiveness_change = measure_effectiveness_change(pre_kill_metrics, post_kill_metrics)

    %{
      immediate_impact: %{
        kill_rate_increase: kill_rate_change,
        survival_rate_decrease: survival_rate_change,
        ships_lost_within_2min: count_rapid_losses(post_kill_metrics)
      },
      tactical_response: tactical_adjustments,
      long_term_effects: %{
        fleet_effectiveness_change: effectiveness_change,
        morale_impact: estimate_morale_impact(post_kill_metrics),
        strategic_position_change: analyze_strategic_change(pre_kill_metrics, post_kill_metrics)
      }
    }
  end

  @doc """
  Estimate coordination loss from command ship destruction.
  """
  def estimate_coordination_loss(command_ship_loss, fleet_context) do
    # Base coordination loss
    base_loss = case command_ship_loss.ship_role do
      :fleet_commander -> 0.5
      :wing_commander -> 0.3
      :squad_commander -> 0.2
      _ -> 0.1
    end

    # Adjust for fleet experience
    experience_multiplier = case fleet_context.average_experience do
      :veteran -> 0.6
      :experienced -> 0.8
      :standard -> 1.0
      :novice -> 1.3
      _ -> 1.0
    end

    # Adjust for backup command
    backup_multiplier = if fleet_context.has_backup_fc, do: 0.5, else: 1.0

    # Calculate total coordination loss
    total_loss = base_loss * experience_multiplier * backup_multiplier

    %{
      coordination_loss: Float.round(total_loss, 2),
      recovery_time_estimate: estimate_recovery_time(total_loss, fleet_context),
      immediate_effects: [
        "Target calling disruption",
        "Anchor loss",
        "Broadcast delays",
        "Formation breakdown"
      ],
      mitigation_available: fleet_context.has_backup_fc
    }
  end

  # Private helper functions

  defp identify_logistics_kill_moments(tactical_analysis) do
    logistics_kills = get_in(tactical_analysis, [:key_events, :logistics_kills]) || []

    Enum.map(logistics_kills, fn kill ->
      %{
        timestamp: kill.timestamp,
        type: :logistics_kill,
        impact: determine_logi_kill_impact(kill),
        description: "Logistics ship destroyed: #{kill.ship_name}",
        affected_side: kill.victim_side,
        details: %{
          ship_type: kill.ship_type,
          pilot: kill.victim_name,
          remaining_logistics: kill.remaining_logi_count
        }
      }
    end)
  end

  defp identify_command_loss_moments(tactical_analysis) do
    command_losses = get_in(tactical_analysis, [:key_events, :command_losses]) || []

    Enum.map(command_losses, fn loss ->
      %{
        timestamp: loss.timestamp,
        type: :command_loss,
        impact: determine_command_loss_impact(loss),
        description: "Command ship/FC lost: #{loss.ship_name}",
        affected_side: loss.victim_side,
        details: %{
          role: loss.command_role,
          ship_type: loss.ship_type,
          coordination_impact: loss.coordination_impact
        }
      }
    end)
  end

  defp identify_mass_casualty_moments(tactical_analysis) do
    timeline = get_in(tactical_analysis, [:battle_timeline]) || []

    # Look for time windows with unusually high kill rates
    timeline
    Enum.chunk_every(3, 1, :discard)
    |>     Enum.filter(fn window ->
      kills_in_window = Enum.map(window, & &1.kills) Enum.sum()
      kills_in_window >= 5  # 5+ kills in 3 time units
    end)
    Enum.map(fn window ->
      %{
        timestamp: List.first(window).timestamp,
        type: :mass_casualties,
        impact: :high,
        description: "Mass casualties event",
        affected_side: determine_affected_side(window),
        details: %{
          ships_lost: Enum.map(window, & &1.kills) Enum.sum(),
          duration: 3,
          primary_targets: extract_primary_targets(window)
        }
      }
    end)
  end

  defp identify_tactical_shift_moments(tactical_analysis) do
    shifts = get_in(tactical_analysis, [:tactical_shifts]) || []

    Enum.map(shifts, fn shift ->
      %{
        timestamp: shift.timestamp,
        type: :tactical_shift,
        impact: shift.significance,
        description: "Tactical shift: #{shift.from_tactic} to #{shift.to_tactic}",
        affected_side: shift.initiating_side,
        details: %{
          previous_tactic: shift.from_tactic,
          new_tactic: shift.to_tactic,
          effectiveness_change: shift.effectiveness_change
        }
      }
    end)
  end

  defp identify_morale_break_moments(tactical_analysis) do
    morale_events = get_in(tactical_analysis, [:morale_events]) || []

    morale_events
    Enum.filter(& &1.type == :morale_break)
    |>     Enum.map(fn event ->
      %{
        timestamp: event.timestamp,
        type: :morale_break,
        impact: :critical,
        description: "Morale break detected",
        affected_side: event.affected_side,
        details: %{
          trigger: event.trigger,
          ships_disengaging: event.disengaging_count,
          cascade_risk: event.cascade_probability
        }
      }
    end)
  end

  defp impact_to_number(impact) do
    case impact do
      :critical -> 4
      :high -> 3
      :medium -> 2
      :low -> 1
      _ -> 0
    end
  end

  defp determine_logi_kill_impact(kill) do
    remaining = kill.remaining_logi_count
    cond do
      remaining == 0 -> :critical
      remaining == 1 -> :high
      remaining <= 3 -> :medium
      true -> :low
    end
  end

  defp determine_command_loss_impact(loss) do
    case loss.command_role do
      :fleet_commander -> :critical
      :wing_commander -> :high
      :squad_commander -> :medium
      _ -> :low
    end
  end

  defp determine_affected_side(window) do
    # Determine which side suffered more losses
    side_losses = window
      Enum.flat_map(& &1.losses_by_side || [])
      Enum.group_by(& &1.side)
      |>       Enum.map(fn {side, losses} -> {side, length(losses)} end)
      Enum.max_by(fn {_side, count} -> count end, fn -> {:unknown, 0} end)
      elem(0)
  end

  defp extract_primary_targets(window) do
    window
    Enum.flat_map(& &1.killed_ships || [])
    Enum.take(3)
    Enum.map(& &1.ship_type)
  end

  defp estimate_post_logi_casualties(battle_context) do
    base_rate = Map.get(battle_context, :current_kill_rate, 1.0)
    logi_multiplier = case Map.get(battle_context, :remaining_logistics, 0) do
      0 -> 3.0
      1 -> 2.0
      2 -> 1.5
      _ -> 1.2
    end

    base_rate * logi_multiplier
  end

  defp calculate_kill_rate_change(pre_metrics, post_metrics) do
    pre_rate = Map.get(pre_metrics, :kill_rate, 0.0)
    post_rate = Map.get(post_metrics, :kill_rate, 0.0)

    if pre_rate > 0 do
      Float.round((post_rate - pre_rate) / pre_rate * 100, 1)
    else
      0.0
    end
  end

  defp calculate_survival_rate_change(pre_metrics, post_metrics) do
    pre_survival = Map.get(pre_metrics, :survival_rate, 1.0)
    post_survival = Map.get(post_metrics, :survival_rate, 1.0)

    Float.round((pre_survival - post_survival) * 100, 1)
  end

  defp identify_tactical_adjustments(pre_metrics, post_metrics) do

    # Check for range changes
    if Map.get(post_metrics, :average_range) > Map.get(pre_metrics, :average_range) * 1.2 do
      adjustments = ["Increased engagement range" | adjustments]
    end

    # Check for target switching
    if Map.get(post_metrics, :target_switches) > Map.get(pre_metrics, :target_switches) * 1.5 do
      adjustments = ["Increased target switching" | adjustments]
    end

    # Check for defensive positioning
    if Map.get(post_metrics, :defensive_formations) > Map.get(pre_metrics, :defensive_formations) do
      adjustments = ["Adopted defensive positioning" | adjustments]
    end

    adjustments
  end

  defp measure_effectiveness_change(pre_metrics, post_metrics) do
    pre_effectiveness = Map.get(pre_metrics, :fleet_effectiveness, 1.0)
    post_effectiveness = Map.get(post_metrics, :fleet_effectiveness, 1.0)

    Float.round((post_effectiveness - pre_effectiveness) / pre_effectiveness * 100, 1)
  end

  defp count_rapid_losses(post_kill_metrics) do
    Map.get(post_kill_metrics, :rapid_losses, 0)
  end

  defp estimate_morale_impact(post_kill_metrics) do
    rapid_losses = Map.get(post_kill_metrics, :rapid_losses, 0)

    cond do
      rapid_losses >= 5 -> :severe
      rapid_losses >= 3 -> :significant
      rapid_losses >= 1 -> :moderate
      true -> :minimal
    end
  end

  defp analyze_strategic_change(pre_metrics, post_metrics) do
    pre_position = Map.get(pre_metrics, :strategic_position, 0.5)
    post_position = Map.get(post_metrics, :strategic_position, 0.5)

    change = post_position - pre_position

    cond do
      change < -0.3 -> :major_deterioration
      change < -0.1 -> :minor_deterioration
      change > 0.3 -> :major_improvement
      change > 0.1 -> :minor_improvement
      true -> :stable
    end
  end

  defp estimate_recovery_time(coordination_loss, fleet_context) do
    base_time = coordination_loss * 120  # seconds

    # Adjust for fleet experience
    experience_multiplier = case fleet_context.average_experience do
      :veteran -> 0.5
      :experienced -> 0.7
      :standard -> 1.0
      :novice -> 1.5
      _ -> 1.0
    end

    Float.round(base_time * experience_multiplier, 0)
  end
end
