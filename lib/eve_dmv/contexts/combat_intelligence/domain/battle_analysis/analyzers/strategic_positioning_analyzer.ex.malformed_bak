defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.StrategicPositioningAnalyzer do
  @moduledoc """
  Analyzes strategic positioning effectiveness in fleet battles.

  Provides comprehensive analysis of positioning, range control, formation integrity,
  fleet mobility, and tactical positioning recommendations.

  Handles:
  - Positioning effectiveness calculation based on survival rates
  - Range control analysis using long-range ship capabilities
  - Escape route utilization and tactical positioning
  - Formation integrity based on logistics support
  - Fleet mobility analysis and ratings
  - Engagement zone identification and intensity calculation
  - Positioning advantage identification
  - Strategic positioning recommendations
  """

  require Logger
  alias EveDmv.Contexts.CorporationIntelligence.Domain.CorpIntelligenceUtils

  @doc """
  Extract participants from battle analysis data.
  """
  def get_participants_from_battle_analysis(battle_analysis) do
    Map.get(battle_analysis, :participants, [])
  end

  @doc """
  Extract killmails from battle analysis data.
  """
  def get_killmails_from_battle_analysis(battle_analysis) do
    Map.get(battle_analysis, :killmails, [])
  end

  @doc """
  Calculate positioning effectiveness based on survival rates.
  """
  def calculate_positioning_effectiveness(participants, killmails) do
    if Enum.empty?(participants) do
      0.0
    else
      total_participants = length(participants)
      losses = count_total_losses(killmails)

      if total_participants > 0 do
        survival_rate = (total_participants - losses) / total_participants
        Float.round(survival_rate, 2)
      else
        0.0
      end
    end
  end

  @doc """
  Count total losses from killmail data.
  """
  def count_total_losses(killmails) do
    length(killmails)
  end

  @doc """
  Analyze range control effectiveness based on long-range ship presence.
  """
  def analyze_range_control(participants, _killmails) do
    if Enum.empty?(participants) do
      0.0
    else
      long_range_ships = count_long_range_ships(participants)
      total_participants = length(participants)

      if total_participants > 0 do
        range_control_ratio = long_range_ships / total_participants
        Float.round(range_control_ratio, 2)
      else
        0.0
      end
    end
  end

  @doc """
  Count ships with long-range combat capabilities.
  """
  def count_long_range_ships(participants) do
    participants
    |>     Enum.count(fn participant ->
      ship_name = Map.get(participant, :ship_name, "")
      # Ships typically used for long-range combat
      |>       String.contains?(String.downcase(ship_name), [
        "tornado",
        "naga",
        "talos",
        "oracle",
        "sniper"
      ])
    end)
  end

  @doc """
  Analyze escape route utilization effectiveness.
  """
  def analyze_escape_route_utilization(participants, killmails) do
    if Enum.empty?(participants) or Enum.empty?(killmails) do
      0.0
    else
      total_participants = length(participants)
      losses = length(killmails)

      if total_participants > 0 do
        escape_rate = (total_participants - losses) / total_participants
        Float.round(escape_rate, 2)
      else
        0.0
      end
    end
  end

  @doc """
  Analyze tactical positioning effectiveness combining multiple factors.
  """
  def analyze_tactical_positioning_effectiveness(participants, killmails) do
    if Enum.empty?(participants) do
      0.0
    else
      survival_rate = calculate_positioning_effectiveness(participants, killmails)
      range_control = analyze_range_control(participants, killmails)

      tactical_score = (survival_rate + range_control) / 2
      Float.round(tactical_score, 2)
    end
  end

  @doc """
  Analyze formation integrity based on logistics support.
  """
  def analyze_formation_integrity(participants, _killmails) do
    if Enum.empty?(participants) do
      0.0
    else
      logistics_ships = count_logistics_ships(participants)
      total_participants = length(participants)

      if total_participants > 0 do
        logistics_ratio = logistics_ships / total_participants
        # Scale logistics ratio to formation integrity score
        integrity_updated_score = min(1.0, logistics_ratio * 5)
        Float.round(integrity_score, 2)
      else
        0.0
      end
    end
  end

  @doc """
  Count logistics ships in the fleet.
  """
  def count_logistics_ships(participants) do
    participants
    |>     Enum.count(fn participant ->
      ship_name = Map.get(participant, :ship_name, "")

      String.contains?(String.downcase(ship_name), [
        "guardian",
        "basilisk",
        "oneiros",
        "scimitar"
      ])
    end)
  end

  @doc """
  Analyze engagement zones and their characteristics.
  """
  def analyze_engagement_zones(participants, killmails) do
    if Enum.empty?(killmails) do
      []
    else
      [
        %{
          zone_type: :primary_engagement,
          participant_count: length(participants),
          kill_count: length(killmails),
          intensity: calculate_zone_intensity(participants, killmails)
        }
      ]
    end
  end

  @doc """
  Calculate the intensity of an engagement zone.
  """
  def calculate_zone_intensity(participants, killmails) do
    if length(participants) > 0 do
      Float.round(length(killmails) / length(participants), 2)
    else
      0.0
    end
  end

  @doc """
  Identify positioning advantages based on fleet composition.
  """
  def identify_positioning_advantages(participants, _killmails) do
    if Enum.empty?(participants) do
      []
    else
      # Range advantage
      long_range_count = count_long_range_ships(participants)

      range_advantages =
        if long_range_count > length(participants) * 0.3 do
          [%{advantage: :range_superiority, strength: :moderate}]
        else
          []
        end

      # Logistics advantage
      logistics_count = count_logistics_ships(participants)

      logistics_advantages =
        if logistics_count > length(participants) * 0.15 do
          [%{advantage: :logistics_support, strength: :good}]
        else
          []
        end

      range_advantages ++ logistics_advantages
    end
  end

  @doc """
  Analyze overall fleet mobility capabilities.
  """
  def analyze_fleet_mobility(participants, _killmails) do
    if Enum.empty?(participants) do
      %{mobility_score: 0.0, mobility_rating: :unknown}
    else
      fast_ships = count_fast_ships(participants)
      total_participants = length(participants)

      if total_participants > 0 do
        mobility_ratio = fast_ships / total_participants
        mobility_updated_score = Float.round(mobility_ratio, 2)
        mobility_rating = rate_mobility(mobility_score)

        %{
          mobility_score: mobility_score,
          mobility_rating: mobility_rating,
          fast_ships: fast_ships,
          total_ships: total_participants
        }
      else
        %{mobility_score: 0.0, mobility_rating: :unknown}
      end
    end
  end

  @doc """
  Count fast ships (frigates, destroyers, cruisers) in the fleet.
  """
  def count_fast_ships(participants) do
    participants
    |>     Enum.count(fn participant ->
      ship_type_id =
        Map.get(participant, :ship_type_id) || Map.get(participant, :victim_ship_type_id)

      # Create participant map for classification
      participant = %{ship_type_id: ship_type_id, ship_name: ""}
      ship_class = CorpIntelligenceUtils.classify_ship_type(participant.ship_type_id)
      ship_class in [:frigate, :destroyer, :cruiser]
    end)
  end

  @doc """
  Rate mobility based on fast ship ratio.
  """
  def rate_mobility(mobility_score) do
    cond do
      mobility_score >= 0.8 -> :excellent
      mobility_score >= 0.6 -> :good
      mobility_score >= 0.4 -> :moderate
      mobility_score >= 0.2 -> :poor
      true -> :minimal
    end
  end

  @doc """
  Generate positioning recommendations based on analysis results.
  """
  def generate_positioning_recommendations(
        positioning_effectiveness,
        range_control,
        tactical_positioning
      ) do
    # Positioning effectiveness recommendations
    positioning_effectiveness_recommendations =
      if positioning_effectiveness < 0.5 do
        ["Improve defensive positioning and formation discipline"]
      else
        []
      end

    # Range control recommendations
    range_control_recommendations =
      if range_control < 0.3 do
        ["Increase long-range capability for better range control"]
      else
        []
      end

    # Tactical positioning recommendations
    tactical_positioning_recommendations =
      if tactical_positioning < 0.6 do
        ["Enhance tactical positioning awareness and coordination"]
      else
        []
      end

    # Combine all recommendations
    recommendations =
      positioning_effectiveness_recommendations ++
        range_control_recommendations ++ tactical_positioning_recommendations

    recommendations
  end
end
