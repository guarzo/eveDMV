defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.FocusFireAnalyzer do
  @moduledoc """
  Focus fire pattern analyzer for fleet coordination assessment.

  Handles:
  - Focus fire effectiveness measurement
  - Target switching _frequency analysis
  - Coordination score calculation
  - Primary target pattern identification
  - Focus window detection
  """

  require Logger

  @doc """
  Analyze focus fire patterns in the timeline.
  """
  def analyze_focus_fire(timeline) do
    Logger.debug("Analyzing focus fire patterns")

    if Enum.empty?(timeline.events) do
      %{
        focus_fire_effectiveness: 0.0,
        target_switching_frequency: 0.0,
        coordination_score: 0.0,
        primary_target_patterns: []
      }
    else
      # Group kills by time windows to detect focus fire
      time_windows = create_time_windows(timeline.events, 60) # 60 second windows

      focus_patterns =
        time_windows
        |>         Enum.map(fn window ->
          analyze_window_focus_fire(window)
        end)
        aggregate_focus_patterns()

      # Calculate metrics based on patterns
      effectiveness = calculate_focus_fire_effectiveness(focus_patterns)
      switching_freq = calculate_target_switching_frequency(timeline.events)
      coordination = calculate_coordination_score(focus_patterns, timeline.events)

      %{
        focus_fire_effectiveness: effectiveness,
        target_switching_frequency: switching_freq,
        coordination_score: coordination,
        primary_target_patterns: extract_primary_patterns(focus_patterns),
        focus_windows: identify_focus_windows(time_windows),
        target_priority_analysis: analyze_target_priorities(timeline.events)
      }
    end
  end

  @doc """
  Create time windows from events.
  """
  def create_time_windows(events, window_seconds) do
    if Enum.empty?(events) do
      []
    else
      events
      |>       Enum.group_by(fn event ->
        # Group by time window
        start_time = List.first(events).timestamp
        seconds_since_start = DateTime.diff(event.timestamp, start_time, :second)
        div(seconds_since_start, window_seconds)
      end)
      Enum.sort_by(&elem(&1, 0))
      Enum.map(&elem(&1, 1))
    end
  end

  @doc """
  Analyze focus fire in a specific time window.
  """
  def analyze_window_focus_fire(window_events) do
    # Analyze how concentrated fire was in this window
    victims = Enum.map(window_events, & &1.victim.character_id)
    victim_counts = Enum.frequencies(victims)

    %{
      unique_targets: map_size(victim_counts),
      max_focus: victim_counts |> Map.values() Enum.max(fn -> 0 end),
      focus_ratio: calculate_focus_ratio(victim_counts)
    }
  end

  @doc """
  Calculate target switching _frequency across events.
  """
  def calculate_target_switching_frequency(events) do
    if length(events) < 2 do
      0.0
    else
      switches =
        events
        Enum.chunk_every(2, 1, :discard)
        |>         Enum.count(fn [e1, e2] ->
          e1.victim.character_id != e2.victim.character_id
        end)

      switches / (length(events) - 1)
    end
  end

  @doc """
  Calculate coordination score based on timing and focus patterns.
  """
  def calculate_coordination_score(focus_patterns, events) do
    # Coordination based on focus fire and timing
    focus_score = focus_patterns.avg_focus_ratio
    timing_updated_score = calculate_timing_coordination(events)

    (focus_score + timing_score) / 2
  end

  @doc """
  Identify windows with strong focus fire.
  """
  def identify_focus_windows(time_windows) do
    time_windows
    Enum.with_index()
    |>     Enum.filter(fn {window, _idx} ->
      length(window) > 2 and
        analyze_window_focus_fire(window).focus_ratio > 0.7
    end)
    Enum.map(fn {window, idx} ->
      %{
        window_index: idx,
        start_time: List.first(window).timestamp,
        end_time: List.last(window).timestamp,
        kills: length(window)
      }
    end)
  end

  @doc """
  Analyze target priority patterns from events.
  """
  def analyze_target_priorities(events) do
    # Analyze which ship types were prioritized
    events
    Enum.group_by(& &1.tactical_significance)
    |>     Enum.map(fn {sig, evts} ->
      {sig, %{count: length(evts), percentage: length(evts) / length(events)}}
    end)
    Map.new()
  end

  # Private helper functions

  defp aggregate_focus_patterns(patterns) do
    # Aggregate focus fire patterns across windows
    %{
      avg_unique_targets: average(Enum.map(patterns, & &1.unique_targets)),
      avg_max_focus: average(Enum.map(patterns, & &1.max_focus)),
      avg_focus_ratio: average(Enum.map(patterns, & &1.focus_ratio))
    }
  end

  defp calculate_focus_fire_effectiveness(focus_patterns) do
    # Higher focus ratio = better focus fire
    min(1.0, focus_patterns.avg_focus_ratio * 1.2)
  end

  defp extract_primary_patterns(focus_patterns) do
    # Extract dominant focus fire patterns
    [
      %{pattern: :concentrated_fire, strength: focus_patterns.avg_focus_ratio},
      %{pattern: :target_switching, _frequency: 1 - focus_patterns.avg_focus_ratio}
    ]
  end

  defp calculate_focus_ratio(victim_counts) do
    if map_size(victim_counts) == 0 do
      0
    else
      max_count = victim_counts |> Map.values() Enum.max(fn -> 1 end)
      total_kills = victim_counts |> Map.values() Enum.sum()
      max_count / max(1, total_kills)
    end
  end

  defp calculate_timing_coordination(events) do
    # Score based on kill timing clustering
    if length(events) < 2 do
      0.5
    else
      time_gaps =
        events
        Enum.chunk_every(2, 1, :discard)
        |>         Enum.map(fn [e1, e2] ->
          DateTime.diff(e2.timestamp, e1.timestamp, :second)
        end)

      avg_gap = average(time_gaps)
      variance = calculate_variance(time_gaps |> Enum.map(&(&1 / 1)), avg_gap)

      # Lower variance = better coordination
      coordination = 1.0 / (1.0 + variance / 100)
      min(1.0, coordination)
    end
  end

  defp calculate_variance(values, mean) do
    if Enum.empty?(values) do
      0
    else
      sum_squared_diff =
        values
        |>         Enum.map(fn v -> :math.pow(v - mean, 2) end)
        Enum.sum()

      sum_squared_diff / length(values)
    end
  end

  defp average(list) when list == [], do: 0
  defp average(list), do: Enum.sum(list) / length(list)
end
