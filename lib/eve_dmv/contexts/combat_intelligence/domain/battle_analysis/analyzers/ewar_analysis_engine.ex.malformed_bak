  @doc """
  Calculate EWAR intensity based on ship analysis.
  """
  def calculate_ewar_intensity(ewar_analysis, total_ships) do
    if Enum.empty?(ewar_analysis.ewar_ships) or total_ships == 0 do
      0.0
    else
      # Calculate based on EWAR ship percentage and strength
      ewar_count = length(ewar_analysis.ewar_ships)
      ewar_percentage = ewar_count / total_ships

      # Weight by EWAR strength
      strength_bonus =
        ewar_analysis.ewar_ships
        |>         Enum.map(fn ewar_ship ->
          case ewar_ship.ewar_strength do
            :very_high -> 2.0
            :high -> 1.5
            :medium -> 1.0
            :low -> 0.5
            _ -> 0.3
          end
        end) Enum.sum()
        Kernel./(ewar_count)

      # Calculate final intensity (0-100)
      base_intensity = ewar_percentage * 100
      weighted_intensity = base_intensity * strength_bonus

      Float.round(min(100, weighted_intensity), 1)
    end
  end

  @doc """
  Calculate EWAR percentage in fleet.
  """
  def calculate_ewar_percentage(ewar_ships, all_ships) do
    if Enum.empty?(all_ships) do
      0.0
    else
      percentage = length(ewar_ships) / length(all_ships) * 100
      Float.round(percentage, 1)
    end
  end

  @doc """
  Generate human-readable EWAR analysis.
  """
  def generate_ewar_analysis(ewar_analysis, ewar_intensity) do
    if Enum.empty?(ewar_analysis.ewar_ships) do
      "No electronic warfare ships detected in fleet composition."
    else
      ewar_count = length(ewar_analysis.ewar_ships)
      ewar_types_str = Enum.join(ewar_analysis.ewar_types, ", ")

      # Analyze breakdown by ship class
      ship_classes =
        ewar_analysis.ewar_ships
        Enum.group_by(& &1.ship_class)
        |>         Enum.map(fn {class, ships} -> "#{length(ships)} #{class}" end)
        Enum.join(", ")

      # Determine intensity description
      intensity_desc =
        case ewar_intensity do
          ewar_intensity when ewar_intensity >= 80 -> "very high"
          ewar_intensity when ewar_intensity >= 60 -> "high"
          ewar_intensity when ewar_intensity >= 40 -> "moderate"
          ewar_intensity when ewar_intensity >= 20 -> "low"
          true -> "minimal"
        end

      "#{ewar_count} EWAR ships detected with #{intensity_desc} intensity (#{ewar_intensity}%). " <>
        "Types: #{ewar_types_str}. Composition: #{ship_classes}."
    end
  end

  @doc """
  Analyze support ship ratios including EWAR.
  """
  def analyze_support_ratios(ship_composition) do
    if Enum.empty?(ship_composition) do
      %{logistics_ratio: 0, ewar_ratio: 0, support_adequate: false}
    else
      ship_counts = analyze_ship_role_distribution(ship_composition)
      total_ships = Enum.sum(Map.values(ship_counts))

      logi_count = Map.get(ship_counts, :logistics, 0)
      ewar_count = Map.get(ship_counts, :ewar, 0)

      %{
        logistics_ratio: logi_count / total_ships,
        ewar_ratio: ewar_count / total_ships,
        support_adequate: logi_count / total_ships >= 0.1
      }
    end
  end

  # Private helper functions

  defp extract_ship_type_id(ship) do
    case ship do
      %{ship_type_id: id} when is_integer(id) -> id
      %{type_id: id} when is_integer(id) -> id
      %{"ship_type_id" => id} when is_integer(id) -> id
      %{"type_id" => id} when is_integer(id) -> id
      id when is_integer(id) -> id
      _ -> 0
    end
  end

  defp analyze_ship_role_distribution(ship_composition) do
    all_ships = Enum.flat_map(ship_composition, fn {_side, ships} -> ships end)

    all_ships
    |>     Enum.map(fn ship ->
      ship_type_id = extract_ship_type_id(ship)
      classify_ship_role(ship_type_id)
    end)
    Enum.frequencies()
  end

  defp classify_ship_role(ship_type_id) do
    ewar_info = classify_ship_ewar_capability(ship_type_id)

    cond do
      ewar_info.has_ewar and :warp_disruption in ewar_info.ewar_types -> :tackle
      ewar_info.has_ewar -> :ewar
      ship_type_id in [11_987, 11_989, 12_015, 12_019] -> :logistics
      ship_type_id in [638, 639, 640, 641] -> :dps
      true -> :other
    end
  end
