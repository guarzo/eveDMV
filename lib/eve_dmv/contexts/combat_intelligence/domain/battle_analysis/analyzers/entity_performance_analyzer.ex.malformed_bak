defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.EntityPerformanceAnalyzer do
  @moduledoc """
  Entity performance analyzer for tracking battle performance of specific entities.

  Handles:
  - Character performance analysis
  - Corporation performance tracking
  - Alliance performance metrics
  - Ship performance statistics
  - Performance trend analysis
  """

  require Logger

  @doc """
  Analyze battle performance for a specific entity (character, corp, alliance).
  """
  def analyze_entity_performance(entity_id, entity_type, opts \\ []) do
    Logger.debug("Analyzing #{entity_type} performance for entity #{entity_id}")

    time_range = Keyword.get(opts, :time_range, :last_30_days)

    with {:ok, battles} <- fetch_entity_battles(entity_id, entity_type, time_range),
         {:ok, performance_data} <- calculate_entity_performance(entity_id, entity_type, battles) do

      analysis = %{
        entity_id: entity_id,
        entity_type: entity_type,
        time_range: time_range,

        # Overall statistics
        total_battles: length(battles),
        total_kills: performance_data.total_kills,
        total_losses: performance_data.total_losses,

        # Performance metrics
        kill_death_ratio: performance_data.kd_ratio,
        isk_efficiency: performance_data.isk_efficiency,
        average_damage_share: performance_data.avg_damage_share,

        # Ship preferences
        preferred_ships: performance_data.ship_preferences,
        ship_effectiveness: performance_data.ship_effectiveness,

        # Battle performance
        win_rate: performance_data.win_rate,
        survival_rate: performance_data.survival_rate,

        # Trends
        performance_trend: calculate_performance_trend(battles, entity_id, entity_type),
        recent_improvement: analyze_recent_improvement(performance_data),

        # Detailed metrics
        metrics_by_battle_type: performance_data.by_battle_type,
        metrics_by_ship_class: performance_data.by_ship_class,
        preferred_engagement_size: performance_data.preferred_size
      }

      {:ok, analysis}
    end
  end

  @doc """
  Calculate detailed performance metrics for an entity.
  """
  def calculate_entity_performance(entity_id, entity_type, battles) do
    if Enum.empty?(battles) do
      {:ok, empty_performance_data()}
    else
      # Extract killmails involving the entity
      entity_kills = extract_entity_kills(battles, entity_id, entity_type)
      entity_losses = extract_entity_losses(battles, entity_id, entity_type)

      # Calculate core metrics
      kd_ratio = calculate_kd_ratio(entity_kills, entity_losses)
      isk_efficiency = calculate_isk_efficiency(entity_kills, entity_losses)
      avg_damage_share = calculate_average_damage_share(entity_kills)

      # Ship analysis
      ship_preferences = analyze_ship_preferences(entity_kills, entity_losses)
      ship_effectiveness = calculate_ship_effectiveness(entity_kills, entity_losses)

      # Battle outcomes
      win_rate = calculate_win_rate(battles, entity_id, entity_type)
      survival_rate = calculate_survival_rate(entity_kills, entity_losses)

      # Breakdown by categories
      by_battle_type = calculate_metrics_by_battle_type(battles, entity_id, entity_type)
      by_ship_class = calculate_metrics_by_ship_class(entity_kills, entity_losses)
      preferred_size = determine_preferred_engagement_size(battles, entity_id, entity_type)

      performance_data = %{
        total_kills: length(entity_kills),
        total_losses: length(entity_losses),
        kd_ratio: kd_ratio,
        isk_efficiency: isk_efficiency,
        avg_damage_share: avg_damage_share,
        ship_preferences: ship_preferences,
        ship_effectiveness: ship_effectiveness,
        win_rate: win_rate,
        survival_rate: survival_rate,
        by_battle_type: by_battle_type,
        by_ship_class: by_ship_class,
        preferred_size: preferred_size
      }

      {:ok, performance_data}
    end
  end

  @doc """
  Calculate performance trend over time.
  """
  def calculate_performance_trend(battles, entity_id, entity_type) do
    if length(battles) < 5 do
      :insufficient_data
    else
      # Sort battles by time and group into periods
      time_periods = battles
      Enum.sort_by(& &1.analyzed_at)
      |>       Enum.chunk_every(max(1, div(length(battles), 4)))

      # Calculate metrics for each period
      period_metrics = time_periods
      |>       Enum.map(fn period_battles ->
        {:ok, metrics} = calculate_entity_performance(entity_id, entity_type, period_battles)
        %{
          period_start: List.first(period_battles).analyzed_at,
          kd_ratio: metrics.kd_ratio,
          isk_efficiency: metrics.isk_efficiency,
          win_rate: metrics.win_rate
        }
      end)

      # Analyze trend
      analyze_metric_trends(period_metrics)
    end
  end

  # Private helper functions

  defp fetch_entity_battles(entity_id, entity_type, time_range) do
    # This would normally query the database
    # For now, return mock data
    {:ok, []}
  end

  defp empty_performance_data do
    %{
      total_kills: 0,
      total_losses: 0,
      kd_ratio: 0.0,
      isk_efficiency: 0.0,
      avg_damage_share: 0.0,
      ship_preferences: [],
      ship_effectiveness: %{},
      win_rate: 0.0,
      survival_rate: 0.0,
      by_battle_type: %{},
      by_ship_class: %{},
      preferred_size: :unknown
    }
  end

  defp extract_entity_kills(battles, entity_id, entity_type) do
    battles
    |>     Enum.flat_map(fn battle ->
      battle.killmails
      |>       Enum.filter(fn km ->
        case entity_type do
          :character ->
            km.final_blow_character_id == entity_id or
            entity_in_attackers?(km, entity_id, :character)
          :corporation ->
            km.final_blow_corporation_id == entity_id or
            entity_in_attackers?(km, entity_id, :corporation)
          :alliance ->
            km.final_blow_alliance_id == entity_id or
            entity_in_attackers?(km, entity_id, :alliance)
        end
      end)
    end)
  end

  defp extract_entity_losses(battles, entity_id, entity_type) do
    battles
    Enum.flat_map(& &1.killmails)
    |>     Enum.filter(fn km ->
      case entity_type do
        :character -> km.victim_character_id == entity_id
        :corporation -> km.victim_corporation_id == entity_id
        :alliance -> km.victim_alliance_id == entity_id
      end
    end)
  end

  defp entity_in_attackers?(_killmail, entity_id, entity_type) do
    attackers = Map.get(_killmail, :attackers, [])

    Enum.any?(attackers, fn attacker ->
      case entity_type do
        :character -> attacker.character_id == entity_id
        :corporation -> attacker.corporation_id == entity_id
        :alliance -> attacker.alliance_id == entity_id
      end
    end)
  end

  defp calculate_kd_ratio(kills, losses) do
    kill_count = length(kills)
    loss_count = length(losses)

    if loss_count == 0 do
      kill_count * 1.0
    else
      Float.round(kill_count / loss_count, 2)
    end
  end

  defp calculate_isk_efficiency(kills, losses) do
    isk_destroyed = kills |> Enum.map(& &1.total_value) Enum.sum()
    isk_lost = losses |> Enum.map(& &1.total_value) Enum.sum()

    total_isk = isk_destroyed + isk_lost

    if total_isk == 0 do
      0.0
    else
      Float.round(isk_destroyed / total_isk * 100, 1)
    end
  end

  defp calculate_average_damage_share(kills) do
    if Enum.empty?(kills) do
      0.0
    else
      damage_shares = kills
      |>       Enum.map(fn kill ->
        total_damage = kill.damage_taken || 0
        # In real implementation, would calculate attacker's specific damage
        # For now, estimate based on attacker count
        attacker_count = kill.attacker_count || 1
        100.0 / attacker_count
      end)

      Float.round(Enum.sum(damage_shares) / length(damage_shares), 1)
    end
  end

  defp analyze_ship_preferences(kills, losses) do
    # Count ship usage in kills and losses
    all_ships = (kills ++ losses)
    Enum.map(& &1.victim_ship_type_id)
    Enum.frequencies()
    Enum.sort_by(fn {_ship, count} -> count end, :desc)
    Enum.take(10)
    |>     Enum.map(fn {ship_id, count} ->
      %{
        ship_type_id: ship_id,
        usage_count: count,
        percentage: Float.round(count / (length(kills) + length(losses)) * 100, 1)
      }
    end)
  end

  defp calculate_ship_effectiveness(kills, losses) do
    # Group by ship type and calculate effectiveness
    ship_performance = (kills ++ losses)
    Enum.group_by(& &1.victim_ship_type_id)
    |>     Enum.map(fn {ship_id, kms} ->
      ship_kills = Enum.count(kms, fn km -> km in kills end)
      ship_losses = Enum.count(kms, fn km -> km in losses end)

      effectiveness = if ship_losses == 0 do
        100.0
      else
        Float.round(ship_kills / (ship_kills + ship_losses) * 100, 1)
      end

      {ship_id, %{
        kills: ship_kills,
        losses: ship_losses,
        effectiveness: effectiveness
      }}
    end)
    Map.new()
  end

  defp calculate_win_rate(battles, entity_id, entity_type) do
    if Enum.empty?(battles) do
      0.0
    else
      wins = battles
      |>       Enum.count(fn battle ->
        winning_side = Map.get(battle, :winner)
        entity_on_winning_side?(entity_id, entity_type, winning_side, battle)
      end)

      Float.round(wins / length(battles) * 100, 1)
    end
  end

  defp entity_on_winning_side?(_entity_id, _entity_type, nil, _battle), do: false
  defp entity_on_winning_side?(entity_id, entity_type, winning_side, battle) do
    # Check if entity was on the winning side
    # This is simplified - would need proper side determination
    participants = Map.get(battle, :participants, %{})

    winning_participants = Map.get(participants, winning_side, [])

    Enum.any?(winning_participants, fn participant ->
      case entity_type do
        :character -> participant.character_id == entity_id
        :corporation -> participant.corporation_id == entity_id
        :alliance -> participant.alliance_id == entity_id
      end
    end)
  end

  defp calculate_survival_rate(kills, losses) do
    total_engagements = length(kills) + length(losses)

    if total_engagements == 0 do
      0.0
    else
      Float.round(length(kills) / total_engagements * 100, 1)
    end
  end

  defp calculate_metrics_by_battle_type(battles, entity_id, entity_type) do
    battles
    Enum.group_by(& &1.battle_type)
    |>     Enum.map(fn {battle_type, type_battles} ->
      {:ok, metrics} = calculate_entity_performance(entity_id, entity_type, type_battles)

      {battle_type, %{
        battles: length(type_battles),
        kd_ratio: metrics.kd_ratio,
        isk_efficiency: metrics.isk_efficiency,
        win_rate: metrics.win_rate
      }}
    end)
    Map.new()
  end

  defp calculate_metrics_by_ship_class(kills, losses) do
    all_events = kills ++ losses

    all_events
    Enum.group_by(&classify_ship_type_id/1)
    |>     Enum.map(fn {ship_class, events} ->
      class_kills = Enum.count(events, fn e -> e in kills end)
      class_losses = Enum.count(events, fn e -> e in losses end)

      {ship_class, %{
        kills: class_kills,
        losses: class_losses,
        kd_ratio: calculate_kd_ratio_simple(class_kills, class_losses),
        usage_rate: Float.round(length(events) / length(all_events) * 100, 1)
      }}
    end)
    Map.new()
  end

  defp determine_preferred_engagement_size(battles, entity_id, entity_type) do
    size_performance = battles
    Enum.group_by(& &1.engagement_scale)
    |>     Enum.map(fn {scale, scale_battles} ->
      {:ok, metrics} = calculate_entity_performance(entity_id, entity_type, scale_battles)

      score = metrics.kd_ratio * 0.4 +
              metrics.isk_efficiency * 0.3 +
              metrics.win_rate * 0.3

      {scale, score}
    end)
    Enum.sort_by(fn {_scale, score} -> score end, :desc)

    case List.first(size_performance) do
      {scale, _score} -> scale
      nil -> :unknown
    end
  end

  defp analyze_recent_improvement(performance_data) do
    # This would compare recent performance to historical average
    # Simplified for now
    %{
      improving: performance_data.kd_ratio > 1.0,
      metrics: %{
        kd_trend: if(performance_data.kd_ratio > 1.0, do: :positive, else: :negative),
        isk_trend: if(performance_data.isk_efficiency > 50, do: :positive, else: :negative)
      }
    }
  end

  defp analyze_metric_trends(period_metrics) do
    if length(period_metrics) < 2 do
      %{
        overall: :insufficient_data,
        kd_ratio: :stable,
        isk_efficiency: :stable,
        win_rate: :stable
      }
    else
      %{
        overall: determine_overall_trend(period_metrics),
        kd_ratio: analyze_single_metric_trend(period_metrics, :kd_ratio),
        isk_efficiency: analyze_single_metric_trend(period_metrics, :isk_efficiency),
        win_rate: analyze_single_metric_trend(period_metrics, :win_rate)
      }
    end
  end

  defp determine_overall_trend(period_metrics) do
    trends = [
      analyze_single_metric_trend(period_metrics, :kd_ratio),
      analyze_single_metric_trend(period_metrics, :isk_efficiency),
      analyze_single_metric_trend(period_metrics, :win_rate)
    ]

    improving_count = Enum.count(trends, & &1 == :improving)
    declining_count = Enum.count(trends, & &1 == :declining)

    cond do
      improving_count >= 2 -> :improving
      declining_count >= 2 -> :declining
      true -> :stable
    end
  end

  defp analyze_single_metric_trend(period_metrics, metric_key) do
    values = Enum.map(period_metrics, &Map.get(&1, metric_key))

    first_half_avg = period_metrics
    |>     Enum.take(div(length(period_metrics), 2))
    Enum.map(&Map.get(&1, metric_key))
    average()

    second_half_avg = period_metrics
    |>     Enum.drop(div(length(period_metrics), 2))
    Enum.map(&Map.get(&1, metric_key))
    average()

    cond do
      second_half_avg > first_half_avg * 1.1 -> :improving
      second_half_avg < first_half_avg * 0.9 -> :declining
      true -> :stable
    end
  end

  defp classify_ship_type_id(_killmail) do
    ship_type_id = _killmail.victim_ship_type_id

    cond do
      ship_type_id in 590..609 -> :frigate
      ship_type_id in 610..629 -> :destroyer
      ship_type_id in 630..649 -> :cruiser
      ship_type_id in 650..669 -> :battlecruiser
      ship_type_id in 670..689 -> :battleship
      ship_type_id > 20000 -> :capital
      true -> :other
    end
  end

  defp calculate_kd_ratio_simple(kills, losses) do
    if losses == 0, do: kills * 1.0, else: Float.round(kills / losses, 2)
  end

  defp average([]), do: 0
  defp average(values), do: Enum.sum(values) / length(values)
end
