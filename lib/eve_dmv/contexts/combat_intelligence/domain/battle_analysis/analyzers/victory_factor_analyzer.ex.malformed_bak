defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.VictoryFactorAnalyzer do
  @moduledoc """
  Victory factor analysis engine for identifying what led to battle outcomes.

  Handles:
  - Primary and secondary victory factor identification
  - Factor weight calculations
  - Victory probability assessment
  - Counterfactual analysis
  - Actionable lesson extraction
  """

  require Logger

  @doc """
  Identify primary victory factors from tactical and performance analysis.
  """
  def identify_primary_victory_factors(tactical_analysis, performance_metrics) do

    # Start with numerical superiority factors
    factors_acc = add_numerical_factors(factors_acc, tactical_analysis)

    # Add kill efficiency factors
    kd_ratio = calculate_average_kd_ratio(performance_metrics)
    factors_acc = add_kill_efficiency_factors(factors_acc, kd_ratio)

    # Add logistics effectiveness
    factors_acc = add_logistics_effectiveness_factors(factors_acc, tactical_analysis)

    # Add target prioritization
    _factors_acc = add_target_prioritization_factors(factors_acc, tactical_analysis)

    factors_acc
    Enum.sort_by(& &1.impact_score, :desc)
    Enum.take(5)  # Top 5 primary factors
  end

  @doc """
  Identify secondary victory factors.
  """
  def identify_secondary_victory_factors(tactical_analysis, performance_metrics) do

    # Add tactical positioning factors
    factors_acc = add_positioning_factors(factors_acc, tactical_analysis)

    # Add timing factors
    factors_acc = add_timing_factors(factors_acc, tactical_analysis)

    # Add coordination factors
    factors_acc = add_coordination_factors(factors_acc, performance_metrics)

    # Add EWAR factors
    factors_acc = add_ewar_factors(factors_acc, tactical_analysis)

    # Add intelligence factors
    _factors_acc = add_intelligence_factors(factors_acc, tactical_analysis)

    factors_acc
    Enum.sort_by(& &1.impact_score, :desc)
    Enum.take(3)  # Top 3 secondary factors
  end

  @doc """
  Calculate factor weights based on battle characteristics.
  """
  def calculate_factor_weights(tactical_analysis, performance_metrics) do
    # Base weights for different factor categories
    base_weights = %{
      numerical_superiority: 0.25,
      kill_efficiency: 0.20,
      logistics_effectiveness: 0.15,
      target_prioritization: 0.15,
      tactical_positioning: 0.10,
      timing: 0.05,
      coordination: 0.05,
      ewar_usage: 0.03,
      intelligence: 0.02
    }

    # Adjust weights based on battle characteristics
    fleet_size = get_fleet_size(performance_metrics)
    battle_duration = get_battle_duration(tactical_analysis)

    adjusted_weights = adjust_weights_for_battle_type(base_weights, fleet_size, battle_duration)

    # Further adjust based on actual factor presence
    final_weights = adjust_weights_for_factor_presence(adjusted_weights, tactical_analysis, performance_metrics)

    final_weights
  end

  @doc """
  Calculate victory probability based on identified factors.
  """
  def calculate_victory_probability(primary_factors, secondary_factors) do
    if Enum.empty?(primary_factors) and Enum.empty?(secondary_factors) do
      %{probability: 0.5, confidence: :very_low, reasoning: "Insufficient factor data"}
    else
      # Weight primary factors more heavily
      primary_score =
        primary_factors
        Enum.map(& &1.impact_score)
        Enum.sum()
        Kernel.*(0.7)

      secondary_score =
        secondary_factors
        Enum.map(& &1.impact_score)
        Enum.sum()
        Kernel.*(0.3)

      total_score = primary_score + secondary_score

      # Normalize to probability (0.0 to 1.0)
      probability = min(1.0, max(0.0, total_score / 100))

      # Calculate confidence based on factor count and consistency
      confidence = calculate_probability_confidence(primary_factors, secondary_factors)

      reasoning = generate_probability_reasoning(primary_factors, secondary_factors)

      %{
        probability: Float.round(probability, 2),
        confidence: confidence,
        reasoning: reasoning,
        primary_factor_score: Float.round(primary_score, 1),
        secondary_factor_score: Float.round(secondary_score, 1)
      }
    end
  end

  @doc """
  Analyze counterfactual scenarios - what if key factors were different.
  """
  def analyze_counterfactuals(tactical_analysis, decisive_moments) do
    if Enum.empty?(decisive_moments) do
      []
    else
      decisive_moments
      Enum.take(3)  # Top 3 most decisive moments
      Enum.map(&generate_counterfactual_scenario/1)
      |>       Enum.filter(&(&1 != nil))
    end
  end

  # Private helper functions

  defp add_numerical_factors(factors_acc, tactical_analysis) do
    fleet_size_advantage = get_fleet_size_advantage(tactical_analysis)

    if fleet_size_advantage > 1.5 do
      factor = %{
        type: :numerical_superiority,
        description: "Significant numerical advantage (#{Float.round(fleet_size_advantage, 1)}:1)",
        impact_score: min(90, fleet_size_advantage * 30),
        category: :primary
      }
      [factor | factors_acc]
    else
      factors_acc
    end
  end

  defp add_kill_efficiency_factors(factors_acc, kd_ratio) do
    if kd_ratio > 2.0 do
      factor = %{
        type: :kill_efficiency,
        description: "Superior kill/death ratio (#{Float.round(kd_ratio, 1)}:1)",
        impact_score: min(85, kd_ratio * 25),
        category: :primary
      }
      [factor | factors_acc]
    else
      factors_acc
    end
  end

  defp add_logistics_effectiveness_factors(factors_acc, tactical_analysis) do
    logistics_survival = get_logistics_survival_rate(tactical_analysis)

    if logistics_survival > 0.8 do
      factor = %{
        type: :logistics_effectiveness,
        description: "Excellent logistics survival (#{Float.round(logistics_survival * 100, 1)}%)",
        impact_score: logistics_survival * 75,
        category: :primary
      }
      [factor | factors_acc]
    else
      factors_acc
    end
  end

  defp add_target_prioritization_factors(factors_acc, tactical_analysis) do
    priority_target_kills = get_priority_target_kills(tactical_analysis)

    if priority_target_kills > 3 do
      factor = %{
        type: :target_prioritization,
        description: "Effective target prioritization (#{priority_target_kills} priority targets)",
        impact_score: min(80, priority_target_kills * 15),
        category: :primary
      }
      [factor | factors_acc]
    else
      factors_acc
    end
  end

  defp add_positioning_factors(factors_acc, tactical_analysis) do
    positioning_advantage = get_positioning_advantage(tactical_analysis)

    if positioning_advantage > 0.7 do
      factor = %{
        type: :tactical_positioning,
        description: "Superior tactical positioning",
        impact_score: positioning_advantage * 60,
        category: :secondary
      }
      [factor | factors_acc]
    else
      factors_acc
    end
  end

  defp add_timing_factors(factors_acc, tactical_analysis) do
    timing_advantage = get_timing_advantage(tactical_analysis)

    if timing_advantage > 0.6 do
      factor = %{
        type: :timing,
        description: "Effective engagement timing",
        impact_score: timing_advantage * 40,
        category: :secondary
      }
      [factor | factors_acc]
    else
      factors_acc
    end
  end

  defp add_coordination_factors(factors_acc, performance_metrics) do
    coordination_updated_score = get_coordination_score(performance_metrics)

    if coordination_score > 0.8 do
      factor = %{
        type: :coordination,
        description: "Excellent fleet coordination",
        impact_score: coordination_score * 50,
        category: :secondary
      }
      [factor | factors_acc]
    else
      factors_acc
    end
  end

  defp add_ewar_factors(factors_acc, tactical_analysis) do
    ewar_effectiveness = get_ewar_effectiveness(tactical_analysis)

    if ewar_effectiveness > 0.7 do
      factor = %{
        type: :ewar_usage,
        description: "Effective EWAR deployment",
        impact_score: ewar_effectiveness * 35,
        category: :secondary
      }
      [factor | factors_acc]
    else
      factors_acc
    end
  end

  defp add_intelligence_factors(factors_acc, tactical_analysis) do
    intelligence_advantage = get_intelligence_advantage(tactical_analysis)

    if intelligence_advantage > 0.6 do
      factor = %{
        type: :intelligence,
        description: "Intelligence and information advantage",
        impact_score: intelligence_advantage * 30,
        category: :secondary
      }
      [factor | factors_acc]
    else
      factors_acc
    end
  end

  defp calculate_average_kd_ratio(performance_metrics) do
    side_performance = performance_metrics[:by_side] || %{}

    if map_size(side_performance) < 2 do
      1.0
    else
      kd_ratios =
        side_performance
        |>         Enum.map(fn {_side, metrics} ->
          kills = metrics[:kills] || 0
          deaths = metrics[:deaths] || metrics[:losses] || 0
          if deaths > 0, do: kills / deaths, else: kills
        end)

      if Enum.empty?(kd_ratios) do
        1.0
      else
        Enum.sum(kd_ratios) / length(kd_ratios)
      end
    end
  end

  defp get_fleet_size_advantage(tactical_analysis) do
    # Simplified - in real implementation would extract from participant data
    tactical_analysis[:fleet_size_ratio] || 1.0
  end

  defp get_logistics_survival_rate(tactical_analysis) do
    tactical_analysis[:logistics_survival_rate] || 0.5
  end

  defp get_priority_target_kills(tactical_analysis) do
    tactical_analysis[:priority_target_kills] || 0
  end

  defp get_positioning_advantage(tactical_analysis) do
    tactical_analysis[:positioning_advantage] || 0.5
  end

  defp get_timing_advantage(tactical_analysis) do
    tactical_analysis[:timing_advantage] || 0.5
  end

  defp get_coordination_score(performance_metrics) do
    performance_metrics[:coordination_score] || 0.5
  end

  defp get_ewar_effectiveness(tactical_analysis) do
    tactical_analysis[:ewar_effectiveness] || 0.5
  end

  defp get_intelligence_advantage(tactical_analysis) do
    tactical_analysis[:intelligence_advantage] || 0.5
  end

  defp get_fleet_size(performance_metrics) do
    side_performance = performance_metrics[:by_side] || %{}

    side_performance
    Enum.map(fn {_side, metrics} -> metrics[:participants] || 0 end)
    Enum.sum()
  end

  defp get_battle_duration(tactical_analysis) do
    tactical_analysis[:duration_minutes] || 30
  end

  defp adjust_weights_for_battle_type(base_weights, fleet_size, duration) do
    # Adjust weights based on battle characteristics
    cond do
      fleet_size < 20 ->
        # Small gang: increase importance of coordination and individual skill
        base_weights
        |>         Map.update(:coordination, 0.05, &(&1 * 2))
        Map.update(:kill_efficiency, 0.20, &(&1 * 1.5))

      fleet_size > 100 ->
        # Large fleet: increase importance of numerical superiority and logistics
        base_weights
        |>         Map.update(:numerical_superiority, 0.25, &(&1 * 1.3))
        Map.update(:logistics_effectiveness, 0.15, &(&1 * 1.4))

      duration < 10 ->
        # Quick battle: timing and alpha strike more important
        base_weights
        |>         Map.update(:timing, 0.05, &(&1 * 2))
        Map.update(:target_prioritization, 0.15, &(&1 * 1.2))

      true ->
        base_weights
    end
  end

  defp adjust_weights_for_factor_presence(weights, tactical_analysis, performance_metrics) do
    # Reduce weights for factors that weren't significantly present
    if get_ewar_effectiveness(tactical_analysis) < 0.3 do
      weights = Map.update(weights, :ewar_usage, 0.03, &(&1 * 0.5))
    end

    if get_logistics_survival_rate(tactical_analysis) < 0.2 do
      weights = Map.update(weights, :logistics_effectiveness, 0.15, &(&1 * 0.7))
    end

    weights
  end

  defp calculate_probability_confidence(primary_factors, secondary_factors) do
    total_factors = length(primary_factors) + length(secondary_factors)

    # Calculate consistency of impact scores
    all_scores =
      (primary_factors ++ secondary_factors)
      Enum.map(& &1.impact_score)

    if Enum.empty?(all_scores) do
      :very_low
    else
      mean_updated_score = Enum.sum(all_scores) / length(all_scores)
      variance =
        all_scores
        |>         Enum.map(fn score -> :math.pow(score - mean_score, 2) end)
        Enum.sum()
        Kernel./(length(all_scores))

      std_dev = :math.sqrt(variance)
      coefficient_of_variation = if mean_score > 0, do: std_dev / mean_score, else: 1.0

      cond do
        total_factors >= 5 and coefficient_of_variation < 0.3 -> :high
        total_factors >= 4 and coefficient_of_variation < 0.5 -> :medium
        total_factors >= 3 -> :low
        true -> :very_low
      end
    end
  end

  defp generate_probability_reasoning(primary_factors, secondary_factors) do
    if Enum.empty?(primary_factors) and Enum.empty?(secondary_factors) do
      "Insufficient data to determine clear victory factors"
    else
      top_primary = Enum.take(primary_factors, 2)
      top_secondary = Enum.take(secondary_factors, 1)


      if not Enum.empty?(top_primary) do
        primary_types = Enum.map(top_primary, & &1.type)
        reasoning_parts = ["Primary factors: #{Enum.join(primary_types, ", ")}" | reasoning_parts]
      end

      if not Enum.empty?(top_secondary) do
        secondary_types = Enum.map(top_secondary, & &1.type)
        reasoning_parts = ["Supporting factors: #{Enum.join(secondary_types, ", ")}" | reasoning_parts]
      end

      Enum.join(reasoning_parts, ". ")
    end
  end

  defp generate_counterfactual_scenario(decisive_moment) do
    case decisive_moment.type do
      :logistics_loss ->
        %{
          scenario: "If logistics ships had been better protected",
          impact: "Battle duration could have extended 2-3x longer",
          probability_change: "+15-25% victory chance",
          lesson: "Prioritize logistics ship positioning and protection"
        }

      :alpha_strike ->
        %{
          scenario: "If initial alpha strike had been coordinated differently",
          impact: "Enemy could have lost 20-30% more ships in opening",
          probability_change: "+10-20% victory chance",
          lesson: "Better target calling and focus fire discipline"
        }

      :tackle_failure ->
        %{
          scenario: "If tackle had been maintained on key targets",
          impact: "Could have prevented 3-5 high-value ships from escaping",
          probability_change: "+5-15% victory chance",
          lesson: "Dedicate more ships to tackle role and backup tackle"
        }

      _ ->
        nil
    end
  end
end
