defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.FleetEffectivenessAnalyzer do
  @moduledoc """
  Fleet effectiveness analysis engine for evaluating fleet performance and potential.

  Handles:
  - Fleet effectiveness scoring
  - Firepower potential calculations
  - Survivability assessments
  - Force multiplier analysis
  - Mobility scoring
  - Role synergy evaluation
  """

  require Logger

  @doc """
  Estimate overall fleet effectiveness.
  """
  def estimate_fleet_effectiveness(participants) do
    if Enum.empty?(participants) do
      %{
        overall_score: 0.0,
        firepower_score: 0.0,
        survivability_score: 0.0,
        force_multiplier_score: 0.0,
        mobility_score: 0.0,
        effectiveness_rating: :very_poor
      }
    else
      firepower_score = calculate_firepower_potential(participants)
      survivability_updated_score = calculate_survivability_score(participants)
      force_multiplier_updated_score = calculate_force_multiplier_score(participants)
      mobility_updated_score = calculate_mobility_score(participants)

      # Weighted average for overall effectiveness
      overall_score =
        (firepower_score * 0.3 +
         survivability_score * 0.25 +
         force_multiplier_score * 0.25 +
         mobility_score * 0.2)

      effectiveness_rating = classify_effectiveness_rating(overall_score)

      %{
        overall_score: Float.round(overall_score, 1),
        firepower_score: Float.round(firepower_score, 1),
        survivability_score: Float.round(survivability_score, 1),
        force_multiplier_score: Float.round(force_multiplier_score, 1),
        mobility_score: Float.round(mobility_score, 1),
        effectiveness_rating: effectiveness_rating,
        participant_count: length(participants)
      }
    end
  end

  @doc """
  Calculate firepower potential of the fleet.
  """
  def calculate_firepower_potential(participants) do
    if Enum.empty?(participants) do
      0.0
    else
      # Calculate weighted DPS based on ship types and estimated capabilities
      total_dps_weight =
        participants
        Enum.map(&estimate_ship_dps_weight/1)
        Enum.sum()

      fleet_size = length(participants)

      # Normalize to 0-100 scale based on fleet size expectations
      expected_dps_for_size = fleet_size * 300  # Average 300 DPS per ship
      dps_ratio = total_dps_weight / expected_dps_for_size

      min(100.0, dps_ratio * 100)
    end
  end

  @doc """
  Calculate survivability score of the fleet.
  """
  def calculate_survivability_score(participants) do
    if Enum.empty?(participants) do
      0.0
    else
      ship_classes = classify_ships_by_class(participants)
      total_ships = length(participants)

      # Calculate average tankiness by ship class
      tankiness_updated_score = calculate_average_tankiness(ship_classes, total_ships)

      # Factor in logistics presence
      logistics_count = length(Map.get(ship_classes, :logistics, []))
      logistics_ratio = logistics_count / total_ships
      logistics_bonus = min(25.0, logistics_ratio * 100)  # Up to 25% bonus

      # Factor in capital ship presence (high EHP)
      capital_count =
        (length(Map.get(ship_classes, :carrier, [])) +
         length(Map.get(ship_classes, :dreadnought, [])) +
         length(Map.get(ship_classes, :supercarrier, [])) +
         length(Map.get(ship_classes, :titan, [])))

      capital_bonus = min(20.0, (capital_count / total_ships) * 80)

      base_updated_score = tankiness_score + logistics_bonus + capital_bonus
      min(100.0, base_score)
    end
  end

  @doc """
  Calculate force multiplier score (EWAR, command, etc.).
  """
  def calculate_force_multiplier_score(participants) do
    if Enum.empty?(participants) do
      0.0
    else
      total_ships = length(participants)
      ship_classes = classify_ships_by_class(participants)

      # Calculate multiplier factors
      ewar_count = length(Map.get(ship_classes, :electronic_warfare, []))
      recon_count = length(Map.get(ship_classes, :recon, []))
      command_count = length(Map.get(ship_classes, :command_ship, []))
      logistics_count = length(Map.get(ship_classes, :logistics, []))

      # Each type contributes to force multiplication
      ewar_updated_score = min(25.0, (ewar_count / total_ships) * 100)
      recon_updated_score = min(20.0, (recon_count / total_ships) * 100)
      command_updated_score = min(15.0, (command_count / total_ships) * 60)
      logistics_updated_score = min(30.0, (logistics_count / total_ships) * 80)

      ewar_score + recon_score + command_score + logistics_score
    end
  end

  @doc """
  Calculate mobility score of the fleet.
  """
  def calculate_mobility_score(participants) do
    if Enum.empty?(participants) do
      0.0
    else
      ship_classes = classify_ships_by_class(participants)
      total_ships = length(participants)

      # Different ship classes have different mobility characteristics
      mobility_weights = %{
        frigate: 95,
        destroyer: 85,
        cruiser: 70,
        battlecruiser: 55,
        battleship: 40,
        carrier: 25,
        dreadnought: 20,
        supercarrier: 15,
        titan: 10
      }

      total_mobility_weight =
        ship_classes
        |>         Enum.reduce(0, fn {class, ships}, acc ->
          weight = Map.get(mobility_weights, class, 50)
          acc + (length(ships) * weight)
        end)

      if total_ships > 0 do
        total_mobility_weight / total_ships
      else
        0.0
      end
    end
  end

  @doc """
  Calculate fleet synergy between different components.
  """
  def calculate_fleet_synergy(participants) do
    if Enum.empty?(participants) do
      %{
        overall_synergy: 0.0,
        dps_logi_synergy: 0.0,
        tackle_dps_synergy: 0.0,
        ewar_synergy: 0.0,
        range_coherence: 0.0
      }
    else
      role_distribution = calculate_role_distribution(participants)

      dps_logi_synergy = calculate_dps_logi_synergy(role_distribution)
      tackle_dps_synergy = calculate_tackle_dps_synergy(role_distribution)
      ewar_synergy = calculate_ewar_synergy(role_distribution)
      range_coherence = calculate_range_coherence(participants)

      overall_synergy =
        (dps_logi_synergy + tackle_dps_synergy + ewar_synergy + range_coherence) / 4

      %{
        overall_synergy: Float.round(overall_synergy, 1),
        dps_logi_synergy: Float.round(dps_logi_synergy, 1),
        tackle_dps_synergy: Float.round(tackle_dps_synergy, 1),
        ewar_synergy: Float.round(ewar_synergy, 1),
        range_coherence: Float.round(range_coherence, 1)
      }
    end
  end

  # Private helper functions

  defp classify_effectiveness_rating(score) do
    cond do
      score >= 85 -> :excellent
      score >= 70 -> :very_good
      score >= 55 -> :good
      score >= 40 -> :average
      score >= 25 -> :below_average
      score >= 15 -> :poor
      true -> :very_poor
    end
  end

  defp estimate_ship_dps_weight(participant) do
    # Estimate DPS based on ship type - simplified implementation
    ship_type_id = participant.ship_type_id || 0

    cond do
      # Titans
      ship_type_id in [11_567, 22_444, 23_757] -> 15_000
      # Supercarriers
      ship_type_id in [19_720, 19_722, 19_724] -> 8_000
      # Dreadnoughts
      ship_type_id in [17_132, 17_738, 28_665] -> 12_000
      # Carriers
      ship_type_id in [19_726, 24_483] -> 2_000
      # Battleships
      ship_type_id in [640..644] -> 800
      # Battlecruisers
      ship_type_id in [16_227..16_240] -> 600
      # Cruisers
      ship_type_id in [358..400] -> 400
      # Destroyers
      ship_type_id in [420..441] -> 300
      # Frigates
      ship_type_id in [1..100] -> 200
      # Default
      true -> 300
    end
  end

  defp classify_ships_by_class(participants) do
    participants
    Enum.group_by(&classify_ship_by_participant/1)
    Map.delete(:unknown)
  end

  defp classify_ship_by_participant(participant) do
    ship_type_id = participant.ship_type_id || 0

    cond do
      # Titans
      ship_type_id in [11_567, 22_444, 23_757] -> :titan
      # Supercarriers
      ship_type_id in [19_720, 19_722, 19_724] -> :supercarrier
      # Carriers
      ship_type_id in [19_726, 24_483] -> :carrier
      # Dreadnoughts
      ship_type_id in [17_132, 17_738, 28_665] -> :dreadnought
      # Battleships
      ship_type_id in [640..644] -> :battleship
      # Battlecruisers
      ship_type_id in [16_227..16_240] -> :battlecruiser
      # Cruisers
      ship_type_id in [358..400] -> :cruiser
      # Destroyers
      ship_type_id in [420..441] -> :destroyer
      # Frigates
      ship_type_id in [1..100] -> :frigate
      # Logistics (simplified detection)
      ship_type_id in [11_978, 11_987] -> :logistics
      # Default
      true -> :unknown
    end
  end

  defp calculate_average_tankiness(ship_classes, total_ships) do
    # Assign tankiness scores to ship classes
    tankiness_scores = %{
      titan: 95,
      supercarrier: 90,
      carrier: 75,
      dreadnought: 85,
      battleship: 60,
      battlecruiser: 45,
      cruiser: 35,
      destroyer: 20,
      frigate: 15,
      logistics: 40
    }

    total_tankiness =
      ship_classes
      |>       Enum.reduce(0, fn {class, ships}, acc ->
        updated_score = Map.get(tankiness_scores, class, 30)
        acc + (length(ships) * score)
      end)

    if total_ships > 0 do
      total_tankiness / total_ships
    else
      0.0
    end
  end

  defp calculate_role_distribution(participants) do
    total_participants = length(participants)

    if total_participants == 0 do
      %{}
    else
      roles = classify_participants_by_role(participants)

      roles
      |>       Enum.map(fn {role, role_participants} ->
        count = length(role_participants)
        percentage = (count / total_participants) * 100
        {role, %{count: count, percentage: Float.round(percentage, 1)}}
      end)
      Map.new()
    end
  end

  defp classify_participants_by_role(participants) do
    participants
    Enum.group_by(&determine_participant_role/1)
  end

  defp determine_participant_role(participant) do
    ship_class = classify_ship_by_participant(participant)

    case ship_class do
      class when class in [:titan, :supercarrier, :carrier, :dreadnought] -> :capital_dps
      class when class in [:battleship, :battlecruiser] -> :heavy_dps
      class when class in [:cruiser] -> :medium_dps
      class when class in [:destroyer, :frigate] -> :light_dps
      :logistics -> :logistics
      :electronic_warfare -> :ewar
      :recon -> :recon
      _ -> :support
    end
  end

  defp calculate_dps_logi_synergy(role_distribution) do
    dps_roles = [:capital_dps, :heavy_dps, :medium_dps, :light_dps]
    logi_role = :logistics

    total_dps =
      dps_roles
      |>       Enum.map(fn role -> get_in(role_distribution, [role, :count]) || 0 end)
      Enum.sum()

    logi_count = get_in(role_distribution, [logi_role, :count]) || 0

    if total_dps == 0 do
      0.0
    else
      logi_ratio = logi_count / total_dps

      # Optimal ratio is around 1:8 to 1:12 (logi:dps)
      optimal_ratio = 0.1  # 1:10

      if logi_ratio == 0 do
        20.0  # Penalty for no logistics
      else
        ratio_effectiveness = 1 - abs(logi_ratio - optimal_ratio) / optimal_ratio
        max(0.0, ratio_effectiveness * 100)
      end
    end
  end

  defp calculate_tackle_dps_synergy(role_distribution) do
    tackle_count = get_in(role_distribution, [:light_dps, :count]) || 0
    heavy_dps_count =
      (get_in(role_distribution, [:capital_dps, :count]) || 0) +
      (get_in(role_distribution, [:heavy_dps, :count]) || 0)

    if heavy_dps_count == 0 do
      if tackle_count > 0, do: 60.0, else: 50.0  # Pure tackle or no fleet
    else
      tackle_ratio = tackle_count / heavy_dps_count

      # Optimal tackle ratio is around 1:3 to 1:5
      optimal_ratio = 0.25  # 1:4

      if tackle_ratio == 0 do
        40.0  # Penalty for no tackle
      else
        ratio_effectiveness = 1 - abs(tackle_ratio - optimal_ratio) / optimal_ratio
        max(40.0, ratio_effectiveness * 100)
      end
    end
  end

  defp calculate_ewar_synergy(role_distribution) do
    ewar_count = get_in(role_distribution, [:ewar, :count]) || 0
    recon_count = get_in(role_distribution, [:recon, :count]) || 0
    total_ewar = ewar_count + recon_count

    total_participants =
      role_distribution
      Enum.map(fn {_role, data} -> data[:count] || 0 end)
      Enum.sum()

    if total_participants == 0 do
      0.0
    else
      ewar_ratio = total_ewar / total_participants

      # EWAR effectiveness peaks around 10-20% of fleet
      cond do
        ewar_ratio >= 0.05 and ewar_ratio <= 0.25 ->
          # Optimal range
          base_updated_score = 80.0
          if ewar_ratio >= 0.1 and ewar_ratio <= 0.2 do
            base_score + 20.0  # Peak effectiveness
          else
            base_score
          end

        ewar_ratio > 0.25 ->
          # Too much EWAR, diminishing returns
          max(50.0, 100 - ((ewar_ratio - 0.25) * 200))

        ewar_ratio > 0 ->
          # Some EWAR but sub-optimal
          ewar_ratio * 400  # Scale up small amounts

        true ->
          50.0  # No EWAR, neutral score
      end
    end
  end

  defp calculate_range_coherence(participants) do
    if length(participants) < 2 do
      100.0  # Perfect coherence for single or no ships
    else
      engagement_ranges = Enum.map(participants, &estimate_engagement_range/1)

      # Calculate standard deviation of engagement ranges
      mean_range = Enum.sum(engagement_ranges) / length(engagement_ranges)
      variance =
        engagement_ranges
        |>         Enum.map(fn range -> :math.pow(range - mean_range, 2) end)
        Enum.sum()
        Kernel./(length(engagement_ranges))

      std_dev = :math.sqrt(variance)

      # Lower standard deviation = better coherence
      # Normalize: 0 std dev = 100%, high std dev approaches 0%
      coherence = max(0.0, 100 - (std_dev / 10))  # Adjust divisor as needed
      min(100.0, coherence)
    end
  end

  defp estimate_engagement_range(participant) do
    ship_class = classify_ship_by_participant(participant)

    # Estimated optimal engagement ranges in km
    case ship_class do
      :titan -> 300
      :supercarrier -> 250
      :carrier -> 200
      :dreadnought -> 100
      :battleship -> 80
      :battlecruiser -> 60
      :cruiser -> 40
      :destroyer -> 20
      :frigate -> 10
      :logistics -> 60
      _ -> 50
    end
  end
end
