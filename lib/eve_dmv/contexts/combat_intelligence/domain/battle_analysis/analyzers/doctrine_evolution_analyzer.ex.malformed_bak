defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.DoctrineEvolutionAnalyzer do
  @moduledoc """
  Doctrine evolution and tactical adaptation analysis engine.

  Responsible for:
  - Comparing doctrine usage patterns across multiple battles
  - Tracking doctrine evolution and adaptation over time
  - Analyzing ship composition trends and changes
  - Monitoring engagement pattern evolution
  - Detecting tactical adaptation between battles
  - Calculating doctrine effectiveness and success rates
  - Identifying most used doctrines and dominant patterns
  - Measuring doctrine stability and evolution patterns
  """

  require Logger

  @doc """
  Compare doctrine usage patterns across multiple battle analyses.
  """
  def compare_doctrine_usage(battle_analyses) do
    # Compare doctrine usage patterns across battles
    if length(battle_analyses) < 2 do
      %{comparison: :insufficient_data}
    else
      # Extract doctrine data from each battle
      doctrine_timeline =
        battle_analyses
        Enum.with_index()
        |>         Enum.map(fn {analysis, index} ->
          doctrines = extract_doctrines_from_battle(analysis)

          %{
            battle_index: index,
            timestamp: extract_battle_timestamp(analysis),
            primary_doctrines: doctrines,
            doctrine_count: length(doctrines),
            doctrine_diversity: calculate_doctrine_diversity(doctrines),
            dominant_doctrine: find_dominant_doctrine(doctrines)
          }
        end)

      # Analyze doctrine evolution
      doctrine_stability = calculate_doctrine_usage_stability(doctrine_timeline)
      doctrine_effectiveness = analyze_doctrine_effectiveness(doctrine_timeline, battle_analyses)

      %{
        timeline: doctrine_timeline,
        stability_score: doctrine_stability,
        effectiveness_analysis: doctrine_effectiveness,
        most_used_doctrines: identify_most_used_doctrines(doctrine_timeline),
        doctrine_success_rates:
          calculate_doctrine_success_rates(doctrine_timeline, battle_analyses),
        evolution_pattern: determine_doctrine_evolution_pattern(doctrine_timeline)
      }
    end
  end

  @doc """
  Analyze doctrine evolution over time across sorted battles.
  """
  def analyze_doctrine_evolution(sorted_battles) do
    # Track how doctrines change over time
    doctrine_timeline =
      sorted_battles
      Enum.with_index()
      |>       Enum.map(fn {battle, index} ->
        doctrines = extract_doctrines_from_battle(battle)

        %{
          battle_index: index,
          timestamp: extract_battle_timestamp(battle),
          primary_doctrines: doctrines,
          doctrine_diversity: calculate_doctrine_diversity(doctrines)
        }
      end)

    # Analyze doctrine trends
    doctrine_changes = identify_doctrine_changes(doctrine_timeline)
    doctrine_stability = calculate_doctrine_stability(doctrine_timeline)

    %{
      timeline: doctrine_timeline,
      major_changes: doctrine_changes,
      stability_score: doctrine_stability,
      trend_direction: determine_doctrine_trend_direction(doctrine_timeline)
    }
  end

  @doc """
  Analyze ship composition trends over time.
  """
  def analyze_ship_composition_trends(sorted_battles) do
    # Analyze how ship compositions change over time
    composition_timeline =
      sorted_battles
      Enum.with_index()
      |>       Enum.map(fn {battle, index} ->
        composition = extract_ship_composition_from_battle(battle)

        %{
          battle_index: index,
          timestamp: extract_battle_timestamp(battle),
          ship_classes: analyze_ship_class_distribution(composition),
          support_ratio: calculate_composition_support_ratio(composition),
          average_ship_value: calculate_average_ship_value(composition),
          size_category: categorize_fleet_size(composition)
        }
      end)

    # Identify trends
    ship_class_trends = track_ship_class_trends(composition_timeline)
    support_trends = track_support_ratio_trends(composition_timeline)
    value_trends = track_value_trends(composition_timeline)

    %{
      timeline: composition_timeline,
      ship_class_trends: ship_class_trends,
      support_trends: support_trends,
      value_trends: value_trends,
      evolution_pattern: determine_composition_evolution_pattern(composition_timeline)
    }
  end

  @doc """
  Analyze engagement pattern evolution over time.
  """
  def analyze_engagement_pattern_evolution(sorted_battles) do
    # Analyze how engagement patterns change
    engagement_timeline =
      sorted_battles
      Enum.with_index()
      |>       Enum.map(fn {battle, index} ->
        engagement_patterns = extract_engagement_patterns_from_battle(battle)

        %{
          battle_index: index,
          timestamp: extract_battle_timestamp(battle),
          duration_category: categorize_battle_duration(battle),
          intensity_level: extract_battle_intensity(battle),
          participant_count: extract_participant_count(battle),
          tactical_complexity: calculate_tactical_complexity(battle),
          patterns: engagement_patterns
        }
      end)

    # Analyze trends
    duration_trend = analyze_duration_trends(engagement_timeline)
    intensity_trend = analyze_intensity_trends(engagement_timeline)
    complexity_trend = analyze_complexity_trends(engagement_timeline)

    %{
      timeline: engagement_timeline,
      duration_evolution: duration_trend,
      intensity_evolution: intensity_trend,
      complexity_evolution: complexity_trend,
      overall_pattern: determine_engagement_evolution_pattern(engagement_timeline)
    }
  end

  @doc """
  Analyze tactical adaptation between consecutive battles.
  """
  def analyze_tactical_adaptation(sorted_battles) do
    # Look for evidence of tactical adaptation between battles
    adaptations =
      sorted_battles
      Enum.chunk_every(2, 1, :discard)
      Enum.with_index()
      |>       Enum.map(fn {[prev_battle, curr_battle], index} ->
        prev_doctrines = extract_doctrines_from_battle(prev_battle)
        curr_doctrines = extract_doctrines_from_battle(curr_battle)

        # Calculate adaptation metrics
        doctrine_change = calculate_doctrine_change_score(prev_doctrines, curr_doctrines)
        composition_shift = analyze_composition_shift(prev_battle, curr_battle)
        tactical_shift = analyze_tactical_shift(prev_battle, curr_battle)

        %{
          battle_transition: index,
          from_battle: index,
          to_battle: index + 1,
          timestamp: extract_battle_timestamp(curr_battle),
          doctrine_adaptation: doctrine_change,
          composition_adaptation: composition_shift,
          tactical_adaptation: tactical_shift,
          adaptation_confidence:
            calculate_adaptation_confidence(doctrine_change, composition_shift, tactical_shift)
        }
      end)

    # Analyze overall adaptation patterns
    adaptation_frequency = calculate_adaptation_frequency(adaptations)
    adaptation_effectiveness = assess_adaptation_effectiveness(adaptations, sorted_battles)

    %{
      adaptations: adaptations,
      adaptation_frequency: adaptation_frequency,
      adaptation_effectiveness: adaptation_effectiveness,
      adaptation_pattern: determine_adaptation_pattern(adaptations)
    }
  end

  @doc """
  Extract doctrines from a battle analysis.
  """
  def extract_doctrines_from_battle(battle) do
    # Extract doctrine information from battle data
    case battle do
      %{doctrine_analysis: %{detected_doctrines: doctrines}} -> doctrines
      %{fleet_composition: compositions} -> extract_doctrines_from_compositions(compositions)
      _ -> []
    end
  end

  @doc """
  Extract timestamp from battle analysis.
  """
  def extract_battle_timestamp(battle) do
    case battle do
      %{battle_start: timestamp} when not is_nil(timestamp) -> timestamp
      %{timeline: %{start_time: timestamp}} when not is_nil(timestamp) -> timestamp
      %{created_at: timestamp} when not is_nil(timestamp) -> timestamp
      _ -> DateTime.utc_now()
    end
  end

  @doc """
  Calculate doctrine diversity score.
  """
  def calculate_doctrine_diversity(doctrines) do
    if Enum.empty?(doctrines) do
      0.0
    else
      # Simple diversity calculation based on number of unique doctrines
      unique_count = length(Enum.uniq(doctrines))
      total_count = length(doctrines)
      Float.round(unique_count / total_count, 2)
    end
  end

  @doc """
  Find the dominant doctrine from a list.
  """
  def find_dominant_doctrine(doctrines) do
    if Enum.empty?(doctrines) do
      :none
    else
      doctrines
      Enum.frequencies()
      Enum.max_by(fn {_doctrine, count} -> count end, fn -> {:none, 0} end) elem(0)
    end
  end

  @doc """
  Calculate doctrine usage stability across battles.
  """
  def calculate_doctrine_usage_stability(doctrine_timeline) do
    if length(doctrine_timeline) < 2 do
      1.0
    else
      # Calculate stability based on doctrine consistency
      all_doctrines = Enum.flat_map(doctrine_timeline, & &1.primary_doctrines)
      unique_doctrines = Enum.uniq(all_doctrines)

      if Enum.empty?(unique_doctrines) do
        1.0
      else
        # Measure how consistently doctrines appear across battles
        consistency_scores =
          unique_doctrines
          |>           Enum.map(fn doctrine ->
            appearances =
              Enum.count(doctrine_timeline, fn battle_data ->
                doctrine in battle_data.primary_doctrines
              end)

            appearances / length(doctrine_timeline)
          end)

        # Average consistency score
        Enum.sum(consistency_scores) / length(consistency_scores)
      end
    end
  end

  @doc """
  Analyze doctrine effectiveness.
  """
  def analyze_doctrine_effectiveness(doctrine_timeline, battle_analyses) do
    if Enum.empty?(doctrine_timeline) or Enum.empty?(battle_analyses) do
      %{overall_effectiveness: 0.0, doctrine_rankings: []}
    else
      # Simple effectiveness analysis based on usage _frequency
      all_doctrines = Enum.flat_map(doctrine_timeline, & &1.primary_doctrines)
      doctrine_usage = Enum.frequencies(all_doctrines)

      doctrine_rankings =
        doctrine_usage
        |>         Enum.map(fn {doctrine, count} ->
          effectiveness = count / length(doctrine_timeline)
          %{doctrine: doctrine, usage_count: count, effectiveness_score: effectiveness}
        end)
        Enum.sort_by(& &1.effectiveness_score, :desc)

      overall_effectiveness =
        if Enum.empty?(doctrine_rankings) do
          0.0
        else
          (doctrine_rankings |> Enum.map(& &1.effectiveness_score) Enum.sum()) /
            length(doctrine_rankings)
        end

      %{
        overall_effectiveness: overall_effectiveness,
        doctrine_rankings: doctrine_rankings
      }
    end
  end

  @doc """
  Identify most used doctrines.
  """
  def identify_most_used_doctrines(doctrine_timeline) do
    doctrine_timeline
    Enum.flat_map(& &1.primary_doctrines)
    Enum.frequencies()
    Enum.sort_by(fn {_doctrine, count} -> -count end)
    Enum.take(5)
    Enum.map(fn {doctrine, count} -> %{doctrine: doctrine, usage_count: count} end)
  end

  @doc """
  Calculate doctrine success rates.
  """
  def calculate_doctrine_success_rates(doctrine_timeline, _battle_analyses) do
    # Simplified success rate calculation
    doctrine_timeline
    Enum.flat_map(& &1.primary_doctrines) Enum.uniq()
    |>     Enum.map(fn doctrine ->
      %{
        doctrine: doctrine,
        # Simplified
        success_rate: 0.7,
        sample_size: Enum.count(doctrine_timeline, &(doctrine in &1.primary_doctrines))
      }
    end)
  end

  @doc """
  Determine doctrine evolution pattern.
  """
  def determine_doctrine_evolution_pattern(doctrine_timeline) do
    if length(doctrine_timeline) < 3 do
      :insufficient_data
    else
      # Analyze pattern of doctrine changes
      diversity_trend = :stable

      case diversity_trend do
        :increasing -> :diversifying
        :decreasing -> :consolidating
        :stable -> :stable
        _ -> :mixed
      end
    end
  end

  # Private helper functions

  defp extract_doctrines_from_compositions(compositions) do
    # Extract doctrine-like patterns from fleet compositions
    compositions
    Enum.flat_map(fn
      {_side, %{ships: ships}} when is_list(ships) -> analyze_doctrine_patterns(ships)
      {_side, ships} when is_list(ships) -> analyze_doctrine_patterns(ships)
      _ -> []
    end) Enum.uniq()
  end

  defp analyze_doctrine_patterns(ships) do
    # Simple doctrine detection based on ship patterns
    if length(ships) > 5 do
      ship_types = Enum.map(ships, &extract_ship_type/1)
      detect_common_doctrine_patterns(ship_types)
    else
      []
    end
  end

  defp extract_ship_type(ship) do
    case ship do
      %{ship_type_id: id} -> id
      %{"ship_type_id" => id} -> id
      _ -> :unknown
    end
  end

  defp detect_common_doctrine_patterns(ship_types) do
    # Simplified doctrine pattern detection
    unique_types = Enum.uniq(ship_types)

    cond do
      length(unique_types) < 3 -> [:monotype_doctrine]
      length(unique_types) < 6 -> [:focused_doctrine]
      true -> [:mixed_doctrine]
    end
  end

  defp identify_doctrine_changes(_doctrine_timeline), do: []
  defp calculate_doctrine_stability(_doctrine_timeline), do: 0.8
  defp determine_doctrine_trend_direction(_doctrine_timeline), do: :stable

  defp extract_ship_composition_from_battle(_battle), do: []
  defp analyze_ship_class_distribution(_composition), do: %{}
  defp calculate_composition_support_ratio(_composition), do: 0.2
  defp calculate_average_ship_value(_composition), do: 50_000_000
  defp categorize_fleet_size(_composition), do: :medium

  defp track_ship_class_trends(_composition_timeline), do: %{trend: :stable}
  defp track_support_ratio_trends(_composition_timeline), do: %{trend: :stable}
  defp track_value_trends(_composition_timeline), do: %{trend: :stable}
  defp determine_composition_evolution_pattern(_composition_timeline), do: :stable

  defp extract_engagement_patterns_from_battle(_battle), do: []
  defp categorize_battle_duration(_battle), do: :medium
  defp extract_battle_intensity(_battle), do: :moderate
  defp extract_participant_count(_battle), do: 20
  defp calculate_tactical_complexity(_battle), do: 0.5

  defp analyze_duration_trends(_timeline), do: %{trend: :stable}
  defp analyze_intensity_trends(_timeline), do: %{trend: :stable}
  defp analyze_complexity_trends(_timeline), do: %{trend: :stable}
  defp determine_engagement_evolution_pattern(_timeline), do: :stable

  defp calculate_doctrine_change_score(_prev, _curr), do: 0.3
  defp analyze_composition_shift(_prev, _curr), do: %{shift_magnitude: 0.2}
  defp analyze_tactical_shift(_prev, _curr), do: %{shift_magnitude: 0.1}
  defp calculate_adaptation_confidence(_doctrine, _composition, _tactical), do: 0.6

  defp calculate_adaptation_frequency(_adaptations), do: 0.4
  defp assess_adaptation_effectiveness(_adaptations, _battles), do: 0.7
  defp determine_adaptation_pattern(_adaptations), do: :gradual

end
