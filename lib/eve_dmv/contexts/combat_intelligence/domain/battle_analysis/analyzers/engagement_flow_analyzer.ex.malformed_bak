defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.EngagementFlowAnalyzer do
  @moduledoc """
  Engagement flow analyzer for understanding battle dynamics and patterns.

  Handles:
  - Intensity curve analysis and flow dynamics
  - Escalation and de-escalation point detection
  - Momentum shift identification
  - Engagement pattern classification
  """

  require Logger

  @doc """
  Analyze engagement flow patterns in the timeline.
  """
  def analyze_engagement_flow(timeline) do
    Logger.debug("Analyzing engagement flow for #{length(timeline.events)} events")

    if Enum.empty?(timeline.events) do
      %{
        intensity_curve: [],
        engagement_patterns: %{},
        escalation_points: [],
        de_escalation_points: []
      }
    else
      # Calculate detailed engagement flow metrics
      intensity_curve = calculate_intensity_curve(timeline.events)
      patterns = identify_engagement_patterns(timeline.events)

      %{
        intensity_curve: intensity_curve,
        engagement_patterns: patterns,
        escalation_points: identify_escalation_points(timeline.events, intensity_curve),
        de_escalation_points: identify_de_escalation_points(timeline.events, intensity_curve),
        flow_dynamics: analyze_flow_dynamics(timeline.events),
        momentum_shifts: identify_momentum_shifts(timeline.events)
      }
    end
  end

  @doc """
  Calculate battle intensity over time using multiple factors.
  """
  def calculate_intensity_curve(timeline_events) do
    if Enum.empty?(timeline_events) do
      []
    else
      # Create 1-minute time windows
      start_time = List.first(timeline_events).timestamp
      end_time = List.last(timeline_events).timestamp
      duration_seconds = DateTime.diff(end_time, start_time, :second)
      window_count = max(1, div(duration_seconds, 60))

      # Calculate intensity for each time window
      0..window_count
      |>       Enum.map(fn window_index ->
        window_start = DateTime.add(start_time, window_index * 60, :second)
        window_end = DateTime.add(window_start, 60, :second)

        # Get events in this window
        window_events =
          timeline_events
          |>           Enum.filter(fn event ->
            DateTime.compare(event.timestamp, window_start) != :lt and
              DateTime.compare(event.timestamp, window_end) == :lt
          end)

        # Calculate intensity based on multiple factors
        %{
          timestamp: window_start,
          kill_count: length(window_events),
          kill_rate: length(window_events) / 1.0, # kills per minute
          value_destroyed: calculate_window_value(window_events),
          significance_score: calculate_window_significance(window_events),
          overall_intensity: calculate_overall_intensity(window_events)
        }
      end)
    end
  end

  @doc """
  Identify engagement patterns from timeline data.
  """
  def identify_engagement_patterns(timeline_events) do
    if length(timeline_events) < 3 do
      %{burst_periods: [], sustained_periods: [], lull_periods: []}
    else
      intensity_data = calculate_intensity_curve(timeline_events)

      # Identify different engagement patterns
      burst_periods = identify_burst_periods(intensity_data)
      sustained_periods = identify_sustained_combat(intensity_data)
      lull_periods = identify_lull_periods(intensity_data)

      %{
        burst_periods: burst_periods,
        sustained_periods: sustained_periods,
        lull_periods: lull_periods,
        pattern_summary: summarize_patterns(burst_periods, sustained_periods, lull_periods),
        dominant_pattern: identify_dominant_pattern(burst_periods, sustained_periods, lull_periods)
      }
    end
  end

  @doc """
  Identify escalation points where battle intensity significantly increases.
  """
  def identify_escalation_points(timeline_events, intensity_curve) do

    # Check for rapid kill rate increases
    kill_rate_escalations =
      intensity_curve
      Enum.chunk_every(3, 1, :discard)
      |>       Enum.filter(fn [prev, current, next] ->
        # Detect significant increases in kill rate
        current.kill_rate > prev.kill_rate * 1.5 and
          next.kill_rate > current.kill_rate * 0.8
      end)
      Enum.map(fn [_, current, _] ->
        %{
          timestamp: current.timestamp,
          type: :kill_rate_spike,
          intensity_increase: current.kill_rate,
          description: "Kill rate increased to #{Float.round(current.kill_rate, 1)} kills/min"
        }
      end)

    # Check for capital/super capital deployments
    capital_escalations =
      timeline_events
      |>       Enum.filter(fn event ->
        event.tactical_significance in [:capital_kill, :super_capital_kill]
      end)
      Enum.map(fn event ->
        %{
          timestamp: event.timestamp,
          type: :capital_deployment,
          intensity_increase: 10.0,
          description: "Capital ship engagement detected"
        }
      end)

    # Check for high-value losses indicating commitment
    value_escalations = detect_value_based_escalations(timeline_events)

    # Combine and sort all escalation points
    (escalation_points ++ kill_rate_escalations ++ capital_escalations ++ value_escalations)
    Enum.sort_by(& &1.timestamp)
  end

  @doc """
  Identify de-escalation points where battle intensity significantly decreases.
  """
  def identify_de_escalation_points(timeline_events, intensity_curve) do

    # Check for rapid kill rate decreases
    kill_rate_drops =
      intensity_curve
      Enum.chunk_every(3, 1, :discard)
      |>       Enum.filter(fn [prev, current, next] ->
        # Detect significant decreases in kill rate
        current.kill_rate < prev.kill_rate * 0.5 and
          next.kill_rate < prev.kill_rate * 0.6
      end)
      Enum.map(fn [prev, current, _] ->
        %{
          timestamp: current.timestamp,
          type: :kill_rate_drop,
          intensity_decrease: prev.kill_rate - current.kill_rate,
          description:
            "Kill rate dropped from #{Float.round(prev.kill_rate, 1)} to #{Float.round(current.kill_rate, 1)} kills/min"
        }
      end)

    # Check for extended periods without kills
    lull_starts = detect_combat_lulls(timeline_events)

    # Check for tactical withdrawals (gap in kills from one side)
    withdrawal_points = detect_tactical_withdrawals(timeline_events)

    # Combine and sort all de-escalation points
    (de_escalation_points ++ kill_rate_drops ++ lull_starts ++ withdrawal_points)
    Enum.sort_by(& &1.timestamp)
  end

  @doc """
  Analyze flow dynamics of the battle.
  """
  def analyze_flow_dynamics(events) do
    %{
      momentum_changes: count_momentum_changes(events),
      sustained_pressure: measure_sustained_pressure(events),
      tactical_pauses: identify_tactical_pauses(events)
    }
  end

  @doc """
  Identify major momentum shifts in battle.
  """
  def identify_momentum_shifts(events) do
    if length(events) < 5 do
      []
    else
      events
      Enum.chunk_every(5, 1, :discard)
      Enum.filter(&is_momentum_shift/1)
      Enum.map(&create_momentum_shift_moment/1)
    end
  end

  # Private helper functions

  defp calculate_window_value(events) do
    events
    Enum.map(& &1.accumulated_value)
    Enum.sum()
  end

  defp calculate_window_significance(events) do
    sig_scores = %{
      capital_kill: 10,
      logistics_kill: 8,
      command_kill: 7,
      ewar_kill: 6,
      high_value_kill: 5,
      momentum_shift: 7,
      first_blood: 4,
      standard_kill: 1
    }

    events
    |>     Enum.map(fn e -> Map.get(sig_scores, e.tactical_significance, 1) end)
    Enum.sum()
  end

  defp calculate_overall_intensity(events) do
    if Enum.empty?(events) do
      0
    else
      # Combine multiple factors for overall intensity
      kill_factor = length(events) * 10
      value_factor = calculate_window_value(events) / 1_000_000_000 # Billions
      significance_factor = calculate_window_significance(events)

      (kill_factor + value_factor + significance_factor) / 3
    end
  end

  defp identify_burst_periods(intensity_data) do
    # Periods of very high activity
    intensity_data
    |>     Enum.filter(&(&1.overall_intensity > 50))
    Enum.map(fn period ->
      %{
        start: period.timestamp,
        intensity: period.overall_intensity,
        kills: period.kill_count
      }
    end)
  end

  defp identify_sustained_combat(intensity_data) do
    # Periods of consistent moderate+ activity
    intensity_data
    Enum.chunk_every(3, 1, :discard)
    |>     Enum.filter(fn chunk ->
      Enum.all?(chunk, &(&1.overall_intensity > 20))
    end)
    Enum.map(fn chunk ->
      %{
        start: List.first(chunk).timestamp,
        end: List.last(chunk).timestamp,
        avg_intensity: average(Enum.map(chunk, & &1.overall_intensity))
      }
    end)
  end

  defp identify_lull_periods(intensity_data) do
    # Periods of low/no activity
    intensity_data
    |>     Enum.filter(&(&1.overall_intensity < 10))
    Enum.map(fn period ->
      %{
        timestamp: period.timestamp,
        duration: 60 # 1 minute windows
      }
    end)
  end

  defp summarize_patterns(burst, sustained, lulls) do
    %{
      total_bursts: length(burst),
      sustained_duration: Enum.sum(Enum.map(sustained, fn _s -> 180 end)), # 3 min per sustained
      total_lulls: length(lulls),
      pattern_type: determine_pattern_type(burst, sustained, lulls)
    }
  end

  defp identify_dominant_pattern(burst, sustained, lulls) do
    cond do
      length(burst) > length(sustained) * 2 -> :burst_heavy
      length(sustained) > length(burst) -> :sustained_combat
      length(lulls) > length(burst) + length(sustained) -> :intermittent
      true -> :mixed
    end
  end

  defp determine_pattern_type(burst, sustained, lulls) do
    total = length(burst) + length(sustained) + length(lulls)

    cond do
      total == 0 -> :no_activity
      length(burst) / max(1, total) > 0.5 -> :burst_heavy
      length(sustained) / max(1, total) > 0.5 -> :sustained
      length(lulls) / max(1, total) > 0.5 -> :sporadic
      true -> :mixed
    end
  end

  defp detect_value_based_escalations(events) do
    # Detect escalations based on increasing kill values
    events
    Enum.chunk_every(3, 1, :discard)
    |>     Enum.filter(fn chunk ->
      values = Enum.map(chunk, & &1.accumulated_value)
      ascending_values?(values)
    end)
    Enum.map(fn chunk ->
      middle = Enum.at(chunk, 1)

      %{
        timestamp: middle.timestamp,
        type: :value_escalation,
        intensity_increase: 5.0,
        description: "High-value targets being destroyed"
      }
    end)
  end

  defp detect_combat_lulls(events) do
    # Detect starts of combat lulls
    if length(events) < 3 do
      []
    else
      events
      Enum.chunk_every(3, 1, :discard)
      |>       Enum.filter(fn [e1, e2, e3] ->
        # 5+ minute gaps
        DateTime.diff(e2.timestamp, e1.timestamp, :second) > 300 or
          DateTime.diff(e3.timestamp, e2.timestamp, :second) > 300
      end)
      Enum.map(fn [_, e2, _] ->
        %{
          timestamp: e2.timestamp,
          type: :combat_lull,
          intensity_decrease: 5.0,
          description: "Combat activity decreased significantly"
        }
      end)
    end
  end

  defp detect_tactical_withdrawals(_events) do
    # Detect potential tactical withdrawals
    # Look for sudden stops in kills from one side
    []
  end

  defp count_momentum_changes(events) do
    identify_momentum_shifts(events) length()
  end

  defp measure_sustained_pressure(events) do
    # Measure how sustained the pressure was
    if length(events) < 2 do
      0
    else
      time_gaps =
        events
        Enum.chunk_every(2, 1, :discard)
        |>         Enum.map(fn [e1, e2] ->
          DateTime.diff(e2.timestamp, e1.timestamp, :second)
        end)

      # Count gaps under 2 minutes
      sustained = Enum.count(time_gaps, &(&1 < 120))
      sustained / max(1, length(time_gaps))
    end
  end

  defp identify_tactical_pauses(events) do
    # Identify deliberate pauses in combat
    events
    Enum.chunk_every(2, 1, :discard)
    |>     Enum.filter(fn [e1, e2] ->
      gap = DateTime.diff(e2.timestamp, e1.timestamp, :second)
      # 2-10 minute gaps
      gap > 120 and gap < 600
    end)
    length()
  end

  defp is_momentum_shift(chunk) do
    # Detect if this chunk represents a momentum shift
    values = Enum.map(chunk, & &1.accumulated_value)
    kills = length(chunk)

    # High kill concentration or value spike
    kills >= 3 or List.last(values) - List.first(values) > 5_000_000_000
  end

  defp create_momentum_shift_moment(chunk) do
    middle_event = Enum.at(chunk, 2)

    %{
      timestamp: middle_event.timestamp,
      significance: :momentum_shift,
      description: "Battle momentum shifted - #{length(chunk)} rapid kills",
      involved_parties: extract_involved_parties(middle_event)
    }
  end

  defp extract_involved_parties(event) do
    %{
      victim: event.victim.corporation_id,
      attackers: event.attackers |> Enum.map(& &1.corporation_id) Enum.uniq()
    }
  end

  defp average(list) when list == [], do: 0
  defp average(list), do: Enum.sum(list) / length(list)

  defp ascending_values?(values) do
    values == Enum.sort(values)
  end
end
