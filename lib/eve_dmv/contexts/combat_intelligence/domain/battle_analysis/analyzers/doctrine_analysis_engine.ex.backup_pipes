defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.DoctrineAnalysisEngine do
  @moduledoc """
  Doctrine analysis engine for fleet composition and tactical doctrine evaluation.

  Responsible for:
  - Analyzing doctrine effectiveness across battles
  - Detecting doctrine adaptations and evolution patterns
  - Identifying enemy doctrine patterns and counter-strategies
  - Evaluating doctrine composition weaknesses
  - Calculating doctrine success rates and usage statistics
  - Generating doctrine-specific tactical recommendations
  - Tracking doctrine meta-game evolution over time
  """

  require Logger

  @doc """
  Count detected doctrines in a battle.
  """
  def count_doctrines(battle) do
    case battle do
      %{doctrine_analysis: %{detected_doctrines: doctrines}} -> length(doctrines)
      _ -> 0
    end
  end

  @doc """
  Detect doctrine adaptation between battles.
  """
  def detect_doctrine_adaptation(prev_doctrines, curr_doctrines) do
    prev_names = Enum.map(prev_doctrines, & &1.name)
    curr_names = Enum.map(curr_doctrines, & &1.name)

    new_doctrines = curr_names -- prev_names
    dropped_doctrines = prev_names -- curr_names

    if length(new_doctrines) > 0 or length(dropped_doctrines) > 0 do
      %{
        type: :doctrine_shift,
        new_doctrines: new_doctrines,
        dropped_doctrines: dropped_doctrines,
        significance: calculate_doctrine_change_significance(new_doctrines, dropped_doctrines)
      }
    else
      nil
    end
  end

  @doc """
  Calculate significance of doctrine changes.
  """
  def calculate_doctrine_change_significance(new_doctrines, dropped_doctrines) do
    total_changes = length(new_doctrines) + length(dropped_doctrines)

    cond do
      total_changes >= 3 -> :major
      total_changes >= 2 -> :moderate
      total_changes >= 1 -> :minor
      true -> :none
    end
  end

  @doc """
  Evaluate doctrine effectiveness.
  """
  def evaluate_doctrine_effectiveness(_fleet_analysis) do
    %{}
  end

  @doc """
  Identify enemy doctrine patterns from fleet compositions.
  """
  def identify_enemy_doctrine_patterns(fleet_compositions) do
    fleet_compositions
    Enum.group_by(& &1.doctrine_type)
    Enum.map(fn {doctrine_type, compositions} ->
      %{
        doctrine_type: doctrine_type,
        usage_count: length(compositions),
        average_fleet_size: calculate_average_fleet_size(compositions),
        common_ships: identify_common_doctrine_ships(compositions),
        role_distribution: extract_typical_role_distribution(compositions),
        engagement_preferences: analyze_doctrine_engagement_patterns(compositions),
        weaknesses: identify_doctrine_weaknesses(doctrine_type, compositions)
      }
    end)
  end

  @doc """
  Calculate counter-doctrine priority.
  """
  def calculate_counter_doctrine_priority(enemy_patterns) do
    case enemy_patterns do
      [] ->
        :low

      patterns ->
        max_usage = patterns |> Enum.map(& &1.usage_count) |> Enum.max()
        if max_usage > 5, do: :high, else: :medium
    end
  end

  @doc """
  Identify common ships in doctrine fleets.
  """
  def identify_common_doctrine_ships(fleets) do
    fleets
    Enum.flat_map(& &1.ship_types)
    Enum.frequencies()
    Enum.sort_by(fn {_ship, count} -> count end, :desc)
    Enum.take(5)
    Enum.map(fn {ship, _count} -> ship end)
  end

  @doc """
  Analyze doctrine engagement patterns.
  """
  def analyze_doctrine_engagement_patterns(fleets) do
    %{
      preferred_range: determine_doctrine_preferred_range(fleets),
      mobility: assess_doctrine_mobility(fleets),
      tank_type: identify_common_tank_type(fleets),
      engagement_style: categorize_engagement_style(fleets),
      common_loss_causes: analyze_doctrine_loss_patterns(fleets)
    }
  end

  @doc """
  Identify doctrine-specific weaknesses.
  """
  def identify_doctrine_weaknesses(doctrine_type, fleets) do
    base_weaknesses =
      case doctrine_type do
        :kiting -> ["Vulnerable to fast tackle", "Range-dependent", "Low tank"]
        :brawling -> ["Vulnerable to kiting", "Range-limited", "Logistics dependent"]
        :alpha_strike -> ["Ammunition limited", "Reload vulnerability", "Positioning critical"]
        _ -> ["General tactical limitations"]
      end

    # Add fleet-specific weaknesses based on composition analysis
    composition_weaknesses = analyze_fleet_specific_weaknesses(fleets)
    base_weaknesses ++ composition_weaknesses
  end

  @doc """
  Analyze doctrine composition weaknesses.
  """
  def analyze_doctrine_composition_weaknesses(fleet_comps) do
    fleet_comps
    Enum.flat_map(fn comp ->
      weaknesses = []

      # Check for lack of tackle
      weaknesses =
        if Map.get(comp.role_counts, :tackle, 0) < 2 do
          [%{type: :insufficient_tackle, severity: :high} | weaknesses]
        else
          weaknesses
        end

      # Check for lack of logistics
      logi_ratio = Map.get(comp.role_counts, :logistics, 0) / max(comp.fleet_size, 1)

      weaknesses =
        if logi_ratio < 0.15 do
          [%{type: :insufficient_logistics, severity: :critical} | weaknesses]
        else
          weaknesses
        end

      # Check for lack of EWAR
      weaknesses =
        if Map.get(comp.role_counts, :ewar, 0) == 0 and comp.fleet_size > 10 do
          [%{type: :no_ewar_support, severity: :medium} | weaknesses]
        else
          weaknesses
        end

      weaknesses
    end)
  end

  @doc """
  Determine doctrine adjustment priority.
  """
  def determine_doctrine_adjustment_priority(weaknesses) do
    critical_count = Enum.count(weaknesses, &(&1.severity == :critical))
    high_count = Enum.count(weaknesses, &(&1.severity == :high))

    cond do
      critical_count > 0 -> :critical
      high_count > 2 -> :high
      high_count > 0 -> :medium
      true -> :low
    end
  end

  @doc """
  Generate doctrine adjustment actions.
  """
  def generate_doctrine_adjustment_actions(weaknesses) do
    Enum.map(weaknesses, fn weakness ->
      case weakness.type do
        :insufficient_tackle ->
          "Add fast tackle ships (Interceptors, Assault Frigates)"

        :insufficient_logistics ->
          "Increase logistics wing size or upgrade to T2 logistics"

        :no_ewar_support ->
          "Add EWAR support ships for fleet superiority"

        _ ->
          "Address composition imbalances"
      end
    end)
  end

  @doc """
  Determine doctrine evolution pattern across battles.
  """
  def determine_doctrine_evolution_pattern(battles) do
    doctrine_usage =
      battles
      Enum.map(&extract_doctrine_usage/1)
      Enum.reduce(%{}, fn battle_doctrines, acc ->
        Enum.reduce(battle_doctrines, acc, fn doctrine, doctrine_acc ->
          Map.update(doctrine_acc, doctrine, 1, &(&1 + 1))
        end)
      end)

    most_used = identify_most_used_doctrines(battles)
    success_rates = calculate_doctrine_success_rates(battles, :all_time)
    effectiveness_analysis = analyze_doctrine_effectiveness(success_rates, doctrine_usage)
    usage_stability = calculate_doctrine_usage_stability(battles)

    dominant_doctrine = find_dominant_doctrine(effectiveness_analysis)

    %{
      trend: :evolving,
      dominant_doctrine: dominant_doctrine,
      most_used_doctrines: most_used,
      effectiveness_analysis: effectiveness_analysis,
      usage_stability: usage_stability,
      total_doctrines_tracked: map_size(doctrine_usage)
    }
  end

  @doc """
  Extract doctrine usage from a battle.
  """
  def extract_doctrine_usage(battle) do
    case get_in(battle, [:fleet_analysis, :doctrines]) do
      doctrines when is_list(doctrines) ->
        Enum.map(doctrines, & &1.name)

      _ ->
        []
    end
  end

  @doc """
  Calculate doctrine success rates across battles.
  """
  def calculate_doctrine_success_rates(battles, _timeframe) do
    # Group battles by doctrine
    doctrine_results =
      battles
      Enum.flat_map(&expand_battle_by_doctrines/1)
      Enum.group_by(& &1.doctrine)

    # Calculate success rate for each doctrine
    Enum.map(doctrine_results, fn {doctrine, doctrine_battles} ->
      total_battles = length(doctrine_battles)
      successful_battles = Enum.count(doctrine_battles, & &1.successful)

      success_rate =
        if total_battles > 0 do
          successful_battles / total_battles * 100
        else
          0
        end

      %{
        doctrine: doctrine,
        success_rate: success_rate,
        total_battles: total_battles,
        successful_battles: successful_battles
      }
    end)
  end

  @doc """
  Expand battle results by doctrines used.
  """
  def expand_battle_by_doctrines(battle) do
    doctrines = get_in(battle, [:fleet_analysis, :doctrines]) || []

    Enum.map(doctrines, fn doctrine ->
      %{
        doctrine: doctrine.name,
        successful: calculate_battle_effectiveness(battle) > 0.6,
        battle_id: battle.id || "unknown",
        timestamp: battle.timestamp || DateTime.utc_now()
      }
    end)
  end

  @doc """
  Identify most used doctrines.
  """
  def identify_most_used_doctrines(battles) do
    battles
    Enum.flat_map(&extract_doctrine_usage/1)
    Enum.frequencies()
    Enum.sort_by(fn {_doctrine, count} -> count end, :desc)
    Enum.take(3)
    Enum.map(fn {doctrine, count} -> %{name: doctrine, usage_count: count} end)
  end

  @doc """
  Analyze doctrine effectiveness.
  """
  def analyze_doctrine_effectiveness(success_rates, usage_counts) do
    # Combine success rates with usage to find effective doctrines
    all_doctrines =
      success_rates
      Enum.map(& &1.doctrine)
      Kernel.++(Map.keys(usage_counts))|> Enum.uniq()

    all_doctrines
    Enum.map(fn doctrine ->
      success_data = Enum.find(success_rates, &(&1.doctrine == doctrine))
      usage_count = Map.get(usage_counts, doctrine, 0)

      success_rate = if success_data, do: success_data.success_rate, else: 0
      battles = if success_data, do: success_data.total_battles, else: 0

      effectiveness_score =
        calculate_doctrine_effectiveness_score(success_rate, battles, usage_count)

      %{
        doctrine: doctrine,
        success_rate: success_rate,
        usage_count: usage_count,
        battles: battles,
        effectiveness_score: effectiveness_score,
        effectiveness_rating: rate_doctrine_effectiveness(effectiveness_score)
      }
    end)
    Enum.sort_by(& &1.effectiveness_score, :desc)
  end

  @doc """
  Calculate doctrine effectiveness score.
  """
  def calculate_doctrine_effectiveness_score(success_rate, battles, usage_count) do
    # Weight success rate by number of battles for reliability
    reliability_factor = min(1.0, battles / 10)
    usage_factor = min(1.0, usage_count / 20)

    # Combined score weighing success, reliability, and adoption
    (success_rate * 0.6 + reliability_factor * 100 * 0.3 + usage_factor * 100 * 0.1)
    Float.round(1)
  end

  @doc """
  Rate doctrine effectiveness.
  """
  def rate_doctrine_effectiveness(score) do
    cond do
      score >= 80 -> :highly_effective
      score >= 60 -> :effective
      score >= 40 -> :moderately_effective
      score >= 20 -> :somewhat_effective
      true -> :ineffective
    end
  end

  @doc """
  Calculate doctrine usage stability.
  """
  def calculate_doctrine_usage_stability(battles) do
    # Get doctrine usage over time windows
    usage_windows =
      battles
      Enum.chunk_every(5)
      Enum.map(&calculate_window_doctrine_distribution/1)

    if length(usage_windows) < 2 do
      :insufficient_data
    else
      variance = calculate_distribution_variance(usage_windows)

      cond do
        variance < 0.1 -> :very_stable
        variance < 0.2 -> :stable
        variance < 0.4 -> :somewhat_stable
        true -> :unstable
      end
    end
  end

  @doc """
  Find dominant doctrine from effectiveness analysis.
  """
  def find_dominant_doctrine(effectiveness_analysis) do
    effectiveness_analysis
    Enum.filter(&(&1.effectiveness_score >= 60))
    Enum.max_by(& &1.effectiveness_score, fn -> %{doctrine: :none, effectiveness_score: 0} end)
    Map.get(:doctrine)
  end

  # Private helper functions

  defp calculate_average_fleet_size(fleets) do
    if length(fleets) > 0 do
      total_size = fleets |> Enum.map(& &1.fleet_size)|> Enum.sum()
      Float.round(total_size / length(fleets), 1)
    else
      0
    end
  end

  defp extract_typical_role_distribution(fleets) do
    role_distributions = Enum.map(fleets, & &1.role_counts)

    # Calculate average role distribution
    all_roles =
      role_distributions
      Enum.flat_map(&Map.keys/1)|> Enum.uniq()

    all_roles
    Enum.map(fn role ->
      role_counts = Enum.map(role_distributions, fn dist -> Map.get(dist, role, 0) end)
      avg_count = Enum.sum(role_counts) / length(role_counts)
      {role, Float.round(avg_count, 1)}
    end)
    Map.new()
  end

  defp determine_doctrine_preferred_range(fleets) do
    ranges = fleets |> Enum.map(& &1.engagement_range) |> Enum.filter(& &1)

    if Enum.empty?(ranges) do
      :unknown
    else
      # Most common range
      ranges
      Enum.frequencies()
      Enum.max_by(fn {_range, count} -> count end)|> elem(0)
    end
  end

  defp assess_doctrine_mobility(fleets) do
    # Simplified mobility assessment
    avg_speed =
      fleets
      Enum.map(& &1.average_speed)
      Enum.filter(& &1)
      case do
        [] -> 0
        speeds -> Enum.sum(speeds) / length(speeds)
      end

    cond do
      avg_speed > 3000 -> :high
      avg_speed > 2000 -> :medium
      true -> :low
    end
  end

  defp identify_common_tank_type(fleets) do
    tank_types = fleets |> Enum.map(& &1.tank_type) |> Enum.filter(& &1)

    if Enum.empty?(tank_types) do
      :unknown
    else
      tank_types
      Enum.frequencies()
      Enum.max_by(fn {_type, count} -> count end)|> elem(0)
    end
  end

  defp categorize_engagement_style(fleets) do
    # Analyze engagement patterns
    avg_duration =
      fleets
      Enum.map(& &1.engagement_duration)
      Enum.filter(& &1)
      case do
        [] -> 0
        durations -> Enum.sum(durations) / length(durations)
      end

    cond do
      avg_duration < 300 -> :hit_and_run
      avg_duration < 900 -> :standard_engagement
      true -> :prolonged_engagement
    end
  end

  defp analyze_doctrine_loss_patterns(fleets) do
    # Extract patterns from losses
    loss_causes =
      fleets
      Enum.flat_map(&(&1.loss_causes || []))
      Enum.frequencies()
      Enum.sort_by(fn {_cause, count} -> count end, :desc)
      Enum.take(3)
      Enum.map(fn {cause, _count} -> cause end)

    loss_causes
  end

  defp analyze_fleet_specific_weaknesses(_fleets) do
    # Simplified analysis - would examine fleet compositions in detail
    ["Composition imbalances", "Role coverage gaps"]
  end

  defp calculate_window_doctrine_distribution(window_battles) do
    total_doctrines =
      window_battles
      Enum.flat_map(&extract_doctrine_usage/1)
      length

    if total_doctrines > 0 do
      window_battles
      Enum.flat_map(&extract_doctrine_usage/1)
      Enum.frequencies()
      Enum.map(fn {doctrine, count} ->
        {doctrine, count / total_doctrines}
      end)
      Map.new()
    else
      %{}
    end
  end

  defp calculate_distribution_variance(distributions) do
    all_doctrines =
      distributions
      Enum.flat_map(&Map.keys/1)|> Enum.uniq()

    if Enum.empty?(all_doctrines) do
      0.0
    else
      # Calculate variance for each doctrine across windows
      doctrine_variances =
        all_doctrines
        Enum.map(fn doctrine ->
          percentages = Enum.map(distributions, fn dist -> Map.get(dist, doctrine, 0.0) end)
          calculate_variance(percentages)
        end)

      # Average variance across all doctrines
      Enum.sum(doctrine_variances) / length(doctrine_variances)
    end
  end

  defp calculate_variance(values) do
    if Enum.empty?(values) do
      0
    else
      mean = Enum.sum(values) / length(values)

      variance =
        values
        Enum.map(fn value -> :math.pow(value - mean, 2) end)|> Enum.sum()
        Kernel./(length(values))

      variance
    end
  end

  defp calculate_battle_effectiveness(battle) do
    isk_efficiency = get_in(battle, [:outcome_analysis, :isk_efficiency]) || 0.5
    kill_efficiency = get_in(battle, [:outcome_analysis, :kill_efficiency]) || 0.5

    (isk_efficiency + kill_efficiency) / 2
  end
end
