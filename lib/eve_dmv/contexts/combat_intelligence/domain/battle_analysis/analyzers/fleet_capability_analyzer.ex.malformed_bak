defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.FleetCapabilityAnalyzer do
  @moduledoc """
  Fleet capability analysis engine for evaluating fleet combat potential.

  Handles:
  - Fleet firepower and damage analysis
  - Logistics capability assessment
  - EWAR effectiveness evaluation
  - Mobility and range analysis
  - Alpha strike calculations
  - Tank efficiency assessment
  """

  require Logger

  @doc """
  Analyze comprehensive fleet capabilities.
  """
  def analyze_capabilities(ship_analyses) do
    if Enum.empty?(ship_analyses) do
      %{
        firepower: %{total_dps: 0, alpha_strike: 0},
        logistics: %{power: 0, sustainability_rating: :none},
        ewar: %{effectiveness: 0, coverage: []},
        mobility: %{average_speed: 0, rating: :immobile},
        engagement_range: %{optimal: 0, flexibility: :none},
        overall_rating: :ineffective
      }
    else
      firepower = analyze_firepower_capabilities(ship_analyses)
      logistics = calculate_logistics_power(ship_analyses)
      ewar = analyze_ewar_capabilities(ship_analyses)
      mobility = analyze_fleet_mobility(ship_analyses)
      engagement_range = analyze_engagement_range(ship_analyses)

      overall_rating = assess_overall_capability_rating([
        firepower.rating,
        logistics.sustainability_rating,
        ewar.effectiveness_rating,
        mobility.rating,
        engagement_range.flexibility
      ])

      %{
        firepower: firepower,
        logistics: logistics,
        ewar: ewar,
        mobility: mobility,
        engagement_range: engagement_range,
        overall_rating: overall_rating,
        tactical_flexibility: assess_tactical_flexibility(ship_analyses)
      }
    end
  end

  @doc """
  Analyze fleet firepower capabilities.
  """
  def analyze_firepower_capabilities(ship_analyses) do
    total_dps = calculate_total_dps(ship_analyses)
    alpha_strike = calculate_alpha_strike(ship_analyses)
    damage_types = analyze_damage_types(ship_analyses)

    rating = classify_firepower_rating(total_dps, length(ship_analyses))

    %{
      total_dps: Float.round(total_dps, 0),
      dps_per_ship: Float.round(total_dps / max(1, length(ship_analyses)), 0),
      alpha_strike: Float.round(alpha_strike, 0),
      damage_types: damage_types,
      rating: rating
    }
  end

  @doc """
  Calculate logistics power and sustainability.
  """
  def calculate_logistics_power(ship_analyses) do
    logistics_ships = Enum.filter(ship_analyses, fn ship ->
      ship.role == :logistics
    end)

    total_ships = length(ship_analyses)
    logi_count = length(logistics_ships)

    if logi_count == 0 do
      %{
        power: 0,
        logistics_count: 0,
        sustainability_rating: :none,
        coverage_ratio: 0.0
      }
    else
      # Calculate total logistics power (simplified)
      total_logistics_power =
        logistics_ships
        |>         Enum.map(fn ship ->
          ship.stats[:logistics_power] || estimate_logistics_power(ship)
        end)
        Enum.sum()

      coverage_ratio = logi_count / total_ships
      sustainability_rating = rate_logistics_sustainability(logi_count, total_ships)

      %{
        power: Float.round(total_logistics_power, 0),
        logistics_count: logi_count,
        sustainability_rating: sustainability_rating,
        coverage_ratio: Float.round(coverage_ratio, 3),
        logistics_per_dps_ship: calculate_logi_to_dps_ratio(ship_analyses)
      }
    end
  end

  @doc """
  Analyze EWAR capabilities of the fleet.
  """
  def analyze_ewar_capabilities(ship_analyses) do
    ewar_ships = Enum.filter(ship_analyses, fn ship ->
      ship.ewar && not Enum.empty?(ship.ewar.types)
    end)

    if Enum.empty?(ewar_ships) do
      %{
        effectiveness: 0,
        coverage: [],
        breakdown: %{},
        ships_count: 0,
        effectiveness_rating: :none
      }
    else
      # Group by EWAR type
      ewar_breakdown =
        ewar_ships
        Enum.flat_map(fn ship -> ship.ewar.types end)
        Enum.frequencies()

      # Calculate effectiveness for each type
      type_effectiveness =
        ewar_breakdown
        |>         Enum.map(fn {type, count} ->
          {type, calculate_ewar_effectiveness(type, count)}
        end)
        Map.new()

      overall_effectiveness =
        type_effectiveness
        Map.values()
        Enum.sum()
        Kernel./(max(1, map_size(type_effectiveness)))

      strength_assessment = assess_ewar_strength(ewar_breakdown)

      %{
        effectiveness: Float.round(overall_effectiveness, 1),
        coverage: Map.keys(ewar_breakdown),
        breakdown: ewar_breakdown,
        type_effectiveness: type_effectiveness,
        ships_count: length(ewar_ships),
        effectiveness_rating: strength_assessment,
        fleet_coverage_ratio: length(ewar_ships) / length(ship_analyses)
      }
    end
  end

  @doc """
  Analyze fleet mobility characteristics.
  """
  def analyze_fleet_mobility(ship_analyses) do
    if Enum.empty?(ship_analyses) do
      %{
        average_speed: 0,
        rating: :immobile,
        bottlenecks: [],
        speed_distribution: %{}
      }
    else
      speeds = Enum.map(ship_analyses, fn ship ->
        ship.stats[:max_velocity] || estimate_ship_speed(ship)
      end)

      avg_speed = Enum.sum(speeds) / length(speeds)
      rating = rate_mobility(avg_speed)
      bottlenecks = identify_mobility_bottlenecks(ship_analyses, avg_speed)

      # Speed distribution analysis
      speed_ranges = %{
        slow: Enum.count(speeds, &(&1 < 200)),
        medium: Enum.count(speeds, &(&1 >= 200 and &1 < 400)),
        fast: Enum.count(speeds, &(&1 >= 400))
      }

      %{
        average_speed: Float.round(avg_speed, 0),
        max_speed: Enum.max(speeds),
        min_speed: Enum.min(speeds),
        rating: rating,
        bottlenecks: bottlenecks,
        speed_distribution: speed_ranges
      }
    end
  end

  @doc """
  Analyze fleet engagement range capabilities.
  """
  def analyze_engagement_range(ship_analyses) do
    if Enum.empty?(ship_analyses) do
      %{
        optimal_range: 0,
        flexibility: :none,
        range_groups: %{}
      }
    else
      # Categorize ships by engagement range
      range_groups =
        ship_analyses
        |>         Enum.group_by(fn ship ->
          optimal_range = ship.stats[:optimal_range] || estimate_engagement_range(ship)
          classify_range_category(optimal_range)
        end)
        Enum.map(fn {category, ships} ->
          {category, length(ships)}
        end)
        Map.new()

      # Find dominant range
      dominant_range =
        range_groups
        Enum.max_by(fn {_category, count} -> count end)
        elem(0)

      flexibility = assess_range_flexibility(range_groups)
      recommended_range = recommend_engagement_range(dominant_range)

      %{
        optimal_range: recommended_range,
        dominant_range_category: dominant_range,
        flexibility: flexibility,
        range_groups: range_groups,
        range_coherence: calculate_range_coherence(range_groups)
      }
    end
  end

  @doc """
  Calculate alpha strike potential.
  """
  def calculate_alpha_strike(ship_analyses) do
    ship_analyses
    |>     Enum.map(fn ship ->
      base_alpha = ship.stats[:alpha_damage] || estimate_alpha_damage(ship)
      # Apply modifiers based on ship class and fittings
      apply_alpha_modifiers(base_alpha, ship)
    end)
    Enum.sum()
  end

  @doc """
  Analyze damage type distribution.
  """
  def analyze_damage_types(ship_analyses) do
    damage_distribution =
      ship_analyses
      |>       Enum.flat_map(fn ship ->
        ship.stats[:damage_types] || estimate_damage_types(ship)
      end)
      Enum.frequencies()

    total_sources = Enum.sum(Map.values(damage_distribution))

    if total_sources == 0 do
      %{distribution: %{}, primary_type: :unknown, diversity: 0.0}
    else
      percentage_distribution =
        damage_distribution
        |>         Enum.map(fn {type, count} ->
          {type, Float.round(count / total_sources * 100, 1)}
        end)
        Map.new()

      primary_type =
        damage_distribution
        Enum.max_by(fn {_type, count} -> count end)
        elem(0)

      diversity = calculate_damage_type_diversity(damage_distribution, total_sources)

      %{
        distribution: percentage_distribution,
        primary_type: primary_type,
        diversity: Float.round(diversity, 2),
        total_damage_sources: total_sources
      }
    end
  end

  @doc """
  Assess tactical flexibility of the fleet.
  """
  def assess_tactical_flexibility(ship_analyses) do
    if Enum.empty?(ship_analyses) do
      %{rating: :none, factors: []}
    else

      # Range flexibility
      range_analysis = analyze_engagement_range(ship_analyses)
      if range_analysis.flexibility in [:high, :medium] do
        flexibility_factors = ["range_adaptability" | flexibility_factors]
      end

      # Mobility flexibility
      mobility_analysis = analyze_fleet_mobility(ship_analyses)
      if mobility_analysis.rating in [:high, :medium] do
        flexibility_factors = ["mobility_options" | flexibility_factors]
      end

      # Damage type diversity
      damage_analysis = analyze_damage_types(ship_analyses)
      if damage_analysis.diversity > 0.5 do
        flexibility_factors = ["damage_diversity" | flexibility_factors]
      end

      # Role diversity
      role_count =
        ship_analyses
        Enum.map(& &1.role)
        Enum.uniq()
        length()

      if role_count >= 4 do
        flexibility_factors = ["role_diversity" | flexibility_factors]
      end

      flexibility_rating =
        case length(flexibility_factors) do
          0 -> :very_low
          1 -> :low
          2 -> :medium
          3 -> :high
          _ -> :very_high
        end

      %{
        rating: flexibility_rating,
        factors: flexibility_factors,
        adaptability_score: length(flexibility_factors) * 25
      }
    end
  end

  # Private helper functions

  defp estimate_logistics_power(ship) do
    # Simplified logistics power estimation
    case ship.role do
      :logistics -> 1500  # Base logistics power
      _ -> 0
    end
  end

  defp rate_logistics_sustainability(logi_count, total_ships) do
    ratio = logi_count / total_ships

    cond do
      ratio >= 0.15 -> :excellent
      ratio >= 0.12 -> :very_good
      ratio >= 0.10 -> :good
      ratio >= 0.08 -> :adequate
      ratio >= 0.05 -> :minimal
      true -> :insufficient
    end
  end

  defp calculate_logi_to_dps_ratio(ship_analyses) do
    logi_count = Enum.count(ship_analyses, & &1.role == :logistics)
    dps_count = Enum.count(ship_analyses, & &1.role in [:dps, :heavy_dps, :capital_dps])

    if dps_count > 0, do: Float.round(logi_count / dps_count, 2), else: 0.0
  end

  defp calculate_total_dps(ship_analyses) do
    ship_analyses
    |>     Enum.map(fn ship ->
      ship.stats[:dps] || estimate_ship_dps(ship)
    end)
    Enum.sum()
  end

  defp classify_firepower_rating(total_dps, ship_count) do
    dps_per_ship = if ship_count > 0, do: total_dps / ship_count, else: 0

    cond do
      dps_per_ship >= 800 -> :excellent
      dps_per_ship >= 600 -> :very_good
      dps_per_ship >= 400 -> :good
      dps_per_ship >= 250 -> :average
      dps_per_ship >= 150 -> :below_average
      true -> :poor
    end
  end

  defp calculate_ewar_effectiveness(type, ship_count) do
    # EWAR effectiveness based on type and quantity
    base_effectiveness = case type do
      :ecm -> 20
      :sensor_dampening -> 15
      :tracking_disruption -> 15
      :target_painting -> 12
      :weapon_disruption -> 10
      _ -> 8
    end

    # Diminishing returns for multiple ships
    effectiveness = base_effectiveness * :math.sqrt(ship_count)
    min(100, effectiveness)
  end

  defp assess_ewar_strength(ewar_breakdown) do
    total_ewar = Enum.sum(Map.values(ewar_breakdown))
    ewar_types = map_size(ewar_breakdown)

    cond do
      total_ewar >= 8 and ewar_types >= 3 -> :overwhelming
      total_ewar >= 5 and ewar_types >= 2 -> :strong
      total_ewar >= 3 -> :moderate
      total_ewar >= 1 -> :light
      true -> :none
    end
  end

  defp estimate_ship_speed(ship) do
    # Simplified speed estimation based on ship class
    case ship.ship_class do
      :frigate -> 450
      :destroyer -> 380
      :cruiser -> 320
      :battlecruiser -> 280
      :battleship -> 220
      :capital -> 150
      _ -> 300
    end
  end

  defp rate_mobility(avg_speed) do
    cond do
      avg_speed >= 400 -> :very_high
      avg_speed >= 320 -> :high
      avg_speed >= 250 -> :medium
      avg_speed >= 180 -> :low
      true -> :very_low
    end
  end

  defp identify_mobility_bottlenecks(ship_analyses, avg_speed) do
    ship_analyses
    |>     Enum.filter(fn ship ->
      ship_speed = ship.stats[:max_velocity] || estimate_ship_speed(ship)
      ship_speed < avg_speed * 0.7  # 30% slower than average
    end)
    Enum.map(fn ship ->
      %{
        ship_class: ship.ship_class,
        estimated_speed: ship.stats[:max_velocity] || estimate_ship_speed(ship),
        impact: :mobility_bottleneck
      }
    end)
  end

  defp estimate_engagement_range(ship) do
    case ship.ship_class do
      :frigate -> 15
      :destroyer -> 25
      :cruiser -> 45
      :battlecruiser -> 65
      :battleship -> 85
      :capital -> 150
      _ -> 50
    end
  end

  defp classify_range_category(range) do
    cond do
      range <= 20 -> :short
      range <= 50 -> :medium
      range <= 100 -> :long
      true -> :very_long
    end
  end

  defp assess_range_flexibility(range_groups) do
    active_ranges = map_size(range_groups)

    cond do
      active_ranges >= 3 -> :high
      active_ranges == 2 -> :medium
      active_ranges == 1 -> :low
      true -> :none
    end
  end

  defp recommend_engagement_range(dominant_range) do
    case dominant_range do
      :short -> 15
      :medium -> 40
      :long -> 80
      :very_long -> 150
      _ -> 50
    end
  end

  defp calculate_range_coherence(range_groups) do
    total_ships = Enum.sum(Map.values(range_groups))
    max_group_size = Enum.max(Map.values(range_groups))

    if total_ships > 0 do
      Float.round(max_group_size / total_ships, 2)
    else
      0.0
    end
  end

  defp estimate_alpha_damage(ship) do
    base_dps = ship.stats[:dps] || estimate_ship_dps(ship)
    # Alpha is typically 3-5x DPS depending on weapon system
    base_dps * 4
  end

  defp apply_alpha_modifiers(base_alpha, ship) do
    # Apply modifiers based on ship characteristics
    modifier = case ship.ship_class do
      :capital -> 1.5  # Capitals have higher alpha
      :battleship -> 1.2
      :battlecruiser -> 1.1
      _ -> 1.0
    end

    base_alpha * modifier
  end

  defp estimate_damage_types(ship) do
    # Simplified damage type estimation
    case ship.ship_class do
      :frigate -> [:kinetic, :thermal]
      :destroyer -> [:explosive, :kinetic]
      :cruiser -> [:thermal, :kinetic]
      :battleship -> [:thermal, :kinetic, :explosive]
      _ -> [:thermal, :kinetic]
    end
  end

  defp calculate_damage_type_diversity(distribution, total) do
    if total == 0 do
      0.0
    else
      # Shannon diversity index for damage types
      distribution
      |>       Enum.map(fn {_type, count} ->
        p = count / total
        if p > 0, do: -p * :math.log(p), else: 0
      end)
      Enum.sum()
    end
  end

  defp estimate_ship_dps(ship) do
    # Simplified DPS estimation
    case ship.ship_class do
      :frigate -> 180
      :destroyer -> 250
      :cruiser -> 350
      :battlecruiser -> 500
      :battleship -> 700
      :capital -> 2000
      _ -> 300
    end
  end

  defp assess_overall_capability_rating(ratings) do
    # Convert ratings to numeric scores
    rating_scores = Enum.map(ratings, fn rating ->
      case rating do
        :excellent -> 5
        :very_good -> 4
        :good -> 3
        :average -> 2
        :below_average -> 1
        _ -> 0
      end
    end)

    avg_score = Enum.sum(rating_scores) / length(rating_scores)

    case round(avg_score) do
      5 -> :excellent
      4 -> :very_good
      3 -> :good
      2 -> :average
      1 -> :below_average
      _ -> :poor
    end
  end
end
