defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.SideDeterminationAnalyzer do
  @moduledoc """
  Side determination analyzer for identifying battle participants and their affiliations.

  Handles:
  - Attack pattern analysis for side determination
  - Corporation and alliance clustering
  - Neutral party identification
  - Third-party detection
  - Dynamic side assignment
  """

  require Logger

  @doc """
  Determine battle sides using advanced attack pattern analysis.
  """
  def determine_battle_sides(killmails, opts \\ []) do
    Logger.debug("Determining battle sides from #{length(killmails)} killmails")

    if length(killmails) < 2 do
      {:ok, %{sides: %{}, neutral_parties: [], confidence: :low}}
    else
      # Build attack graph
      attack_graph = build_attack_graph(killmails)

      # Identify main sides using clustering
      main_sides = identify_main_sides(attack_graph)

      # Identify neutral/third parties
      neutral_parties = identify_neutral_parties(attack_graph, main_sides)

      # Calculate confidence in side determination
      confidence = calculate_side_confidence(main_sides, neutral_parties, killmails)

      # Generate side summary
      side_summary = generate_side_summary(main_sides, killmails)

      {:ok, %{
        sides: main_sides,
        neutral_parties: neutral_parties,
        confidence: confidence,
        summary: side_summary,
        attack_patterns: analyze_attack_patterns(attack_graph)
      }}
    end
  end

  @doc """
  Determine which side an entity belongs to in a battle.
  """
  def determine_entity_side(entity_id, entity_type, battle_sides) do
    # Check main sides first
    main_side = Enum.find(battle_sides.sides, fn {_side, members} ->
      entity_in_side?(entity_id, entity_type, members)
    end)

    case main_side do
      {side, _} -> {:ok, side}
      nil ->
        # Check if neutral
        if entity_in_list?(entity_id, entity_type, battle_sides.neutral_parties) do
          {:ok, :neutral}
        else
          {:error, :not_found}
        end
    end
  end

  @doc """
  Build attack relationship graph from killmails.
  """
  def build_attack_graph(killmails) do
    killmails
    |>     Enum.reduce(%{}, fn _killmail, graph ->
      victim_key = entity_key(_killmail.victim_corporation_id, _killmail.victim_alliance_id)

      # Get attackers
      attackers = extract_attackers(_killmail)

      # Update graph with attack relationships
      |>       Enum.reduce(attackers, graph, fn attacker, acc ->
        attacker_key = entity_key(attacker.corporation_id, attacker.alliance_id)

        if attacker_key != victim_key do
          acc
          |>           Map.update(attacker_key, %{attacks: %{}, losses: %{}}, fn existing ->
            %{existing | attacks: Map.update(existing.attacks, victim_key, 1, &(&1 + 1))}
          end)
          Map.update(victim_key, %{attacks: %{}, losses: %{}}, fn existing ->
            %{existing | losses: Map.update(existing.losses, attacker_key, 1, &(&1 + 1))}
          end)
        else
          acc
        end
      end)
    end)
  end

  @doc """
  Identify main battle sides using clustering algorithm.
  """
  def identify_main_sides(attack_graph) do
    # Calculate affinity matrix
    entities = Map.keys(attack_graph)
    affinity_matrix = calculate_affinity_matrix(entities, attack_graph)

    # Perform clustering
    clusters = perform_clustering(entities, affinity_matrix)

    # Identify two main sides (largest clusters)
    main_clusters = clusters
    Enum.sort_by(&length/1, :desc)
    Enum.take(2)

    # Convert to side structure
    case main_clusters do
      [side_a, side_b] ->
        %{
          side_a: build_side_info(side_a, attack_graph),
          side_b: build_side_info(side_b, attack_graph)
        }
      [side_a] ->
        %{
          side_a: build_side_info(side_a, attack_graph),
          side_b: %{members: [], corporations: [], alliances: []}
        }
      [] ->
        %{
          side_a: %{members: [], corporations: [], alliances: []},
          side_b: %{members: [], corporations: [], alliances: []}
        }
    end
  end

  @doc """
  Identify neutral or third-party participants.
  """
  def identify_neutral_parties(attack_graph, main_sides) do
    # Get all entities
    all_entities = Map.keys(attack_graph)

    # Get entities in main sides
    main_side_entities =
      [main_sides.side_a.members, main_sides.side_b.members]
      List.flatten()
      MapSet.new()

    # Find entities not in main sides
    potential_neutrals = Enum.reject(all_entities, &MapSet.member?(main_side_entities, &1))

    # Analyze their attack patterns
    potential_neutrals
    |>     Enum.filter(fn entity ->
      is_neutral_behavior?(entity, attack_graph, main_sides)
    end)
    Enum.map(fn entity ->
      analyze_neutral_entity(entity, attack_graph)
    end)
  end

  # Private helper functions

  defp entity_key(corporation_id, alliance_id) do
    # Prefer alliance if available, otherwise use corporation
    if alliance_id && alliance_id != 0 do
      {:alliance, alliance_id}
    else
      {:corporation, corporation_id}
    end
  end

  defp extract_attackers(_killmail) do
    # Extract from raw data if available
    case Map.get(_killmail, :raw_data) do
      %{"attackers" => attackers} when is_list(attackers) ->
        Enum.map(attackers, fn attacker ->
          %{
            character_id: attacker["character_id"] || 0,
            corporation_id: attacker["corporation_id"] || 0,
            alliance_id: attacker["alliance_id"] || 0,
            damage_done: attacker["damage_done"] || 0,
            final_blow: attacker["final_blow"] || false
          }
        end)
      _ ->
        # Fallback to single attacker from final blow
        [%{
          character_id: _killmail.final_blow_character_id || 0,
          corporation_id: _killmail.final_blow_corporation_id || 0,
          alliance_id: _killmail.final_blow_alliance_id || 0,
          damage_done: _killmail.damage_taken || 0,
          final_blow: true
        }]
    end
  end

  defp calculate_affinity_matrix(entities, attack_graph) do
    # Build affinity matrix based on attack patterns
    # Entities that attack the same targets are likely on the same side

    entities
    |>     Enum.map(fn entity1 ->
      entities
      |>       Enum.map(fn entity2 ->
        if entity1 == entity2 do
          1.0
        else
          calculate_entity_affinity(entity1, entity2, attack_graph)
        end
      end)
    end)
  end

  defp calculate_entity_affinity(entity1, entity2, attack_graph) do
    data1 = Map.get(attack_graph, entity1, %{attacks: %{}, losses: %{}})
    data2 = Map.get(attack_graph, entity2, %{attacks: %{}, losses: %{}})

    # Check if they attack each other
    attacks_each_other =
      Map.has_key?(data1.attacks, entity2) or
      |>       Map.has_key?(data2.attacks, entity1)

    if attacks_each_other do
      # Strong negative affinity if they attack each other
      -1.0
    else
      # Calculate positive affinity based on shared targets
      shared_targets = MapSet.intersection(
        MapSet.new(Map.keys(data1.attacks)),
        MapSet.new(Map.keys(data2.attacks))
      )

      total_targets = MapSet.union(
        MapSet.new(Map.keys(data1.attacks)),
        MapSet.new(Map.keys(data2.attacks))
      ) MapSet.size()

      if total_targets == 0 do
        0.0
      else
        MapSet.size(shared_targets) / total_targets
      end
    end
  end

  defp perform_clustering(entities, affinity_matrix) do
    # Simple clustering based on affinity
    # Group entities with positive affinity together

    entities
    Enum.with_index()
    |>     Enum.reduce([], fn {entity, idx}, clusters ->
      # Find cluster with highest average affinity
      best_cluster = clusters
      |>       Enum.map(fn cluster ->
        avg_affinity = calculate_cluster_affinity(entity, idx, cluster, entities, affinity_matrix)
        {cluster, avg_affinity}
      end)
      Enum.filter(fn {_cluster, affinity} -> affinity > 0 end)
      Enum.max_by(fn {_cluster, affinity} -> affinity end, fn -> {nil, 0} end)

      case best_cluster do
        {nil, _} ->
          # Create new cluster
          [[entity] | clusters]
        {cluster, _} ->
          # Add to existing cluster
          clusters
          |>           Enum.map(fn c ->
            if c == cluster, do: [entity | c], else: c
          end)
      end
    end)
  end

  defp calculate_cluster_affinity(entity, entity_idx, cluster, all_entities, affinity_matrix) do
    cluster_indices = cluster
    |>     Enum.map(fn e -> Enum.find_index(all_entities, & &1 == e) end)
    Enum.reject(&is_nil/1)

    if Enum.empty?(cluster_indices) do
      0.0
    else
      affinities = cluster_indices
      |>       Enum.map(fn cluster_idx ->
        Enum.at(Enum.at(affinity_matrix, entity_idx), cluster_idx)
      end)

      Enum.sum(affinities) / length(affinities)
    end
  end

  defp build_side_info(entities, attack_graph) do
    # Extract detailed information about the side
    corporations = entities
    Enum.filter(fn {type, _} -> type == :corporation end)
    Enum.map(fn {_, id} -> id end)

    alliances = entities
    Enum.filter(fn {type, _} -> type == :alliance end)
    Enum.map(fn {_, id} -> id end)

    # Calculate side statistics
    total_kills = entities
    |>     Enum.map(fn entity ->
      data = Map.get(attack_graph, entity, %{attacks: %{}})
      data.attacks |> Map.values() Enum.sum()
    end)
    Enum.sum()

    total_losses = entities
    |>     Enum.map(fn entity ->
      data = Map.get(attack_graph, entity, %{losses: %{}})
      data.losses |> Map.values() Enum.sum()
    end)
    Enum.sum()

    %{
      members: entities,
      corporations: corporations,
      alliances: alliances,
      stats: %{
        total_kills: total_kills,
        total_losses: total_losses,
        efficiency: calculate_efficiency(total_kills, total_losses)
      }
    }
  end

  defp is_neutral_behavior?(entity, attack_graph, main_sides) do
    data = Map.get(attack_graph, entity, %{attacks: %{}, losses: %{}})

    # Check if attacks both sides roughly equally
    side_a_attacks = count_attacks_on_side(data.attacks, main_sides.side_a.members)
    side_b_attacks = count_attacks_on_side(data.attacks, main_sides.side_b.members)

    # Neutral if attacks both sides or neither side significantly
    total_attacks = side_a_attacks + side_b_attacks

    if total_attacks == 0 do
      true
    else
      ratio = min(side_a_attacks, side_b_attacks) / max(side_a_attacks, side_b_attacks)
      ratio > 0.3 # Attacks both sides somewhat equally
    end
  end

  defp count_attacks_on_side(attacks, side_members) do
    side_set = MapSet.new(side_members)

    attacks
    |>     Enum.filter(fn {target, _count} -> MapSet.member?(side_set, target) end)
    Enum.map(fn {_target, count} -> count end)
    Enum.sum()
  end

  defp analyze_neutral_entity(entity, attack_graph) do
    data = Map.get(attack_graph, entity, %{attacks: %{}, losses: %{}})

    %{
      entity: entity,
      type: classify_neutral_type(data),
      activity: %{
        kills: data.attacks |> Map.values() Enum.sum(),
        losses: data.losses |> Map.values() Enum.sum()
      }
    }
  end

  defp classify_neutral_type(data) do
    kill_count = data.attacks |> Map.values() Enum.sum()
    loss_count = data.losses |> Map.values() Enum.sum()

    cond do
      kill_count > loss_count * 3 -> :opportunist
      loss_count > kill_count * 3 -> :victim
      kill_count + loss_count < 3 -> :bystander
      true -> :third_party
    end
  end

  defp calculate_side_confidence(main_sides, neutral_parties, killmails) do
    # Calculate confidence based on various factors
    total_entities =
      length(main_sides.side_a.members) +
      length(main_sides.side_b.members) +
      length(neutral_parties)

    # Factor 1: Percentage of kills accounted for
    accounted_percentage = if length(killmails) > 0 do
      total_entities / length(killmails)
    else
      0
    end

    # Factor 2: Balance between sides
    side_balance = if length(main_sides.side_a.members) > 0 and length(main_sides.side_b.members) > 0 do
      min_side = min(length(main_sides.side_a.members), length(main_sides.side_b.members))
      max_side = max(length(main_sides.side_a.members), length(main_sides.side_b.members))
      min_side / max_side
    else
      0
    end

    # Factor 3: Clear attack patterns
    pattern_clarity = calculate_pattern_clarity(main_sides)

    # Combine factors
    confidence_score = (accounted_percentage * 0.3 + side_balance * 0.3 + pattern_clarity * 0.4)

    cond do
      confidence_score > 0.8 -> :high
      confidence_score > 0.5 -> :medium
      true -> :low
    end
  end

  defp calculate_pattern_clarity(main_sides) do
    # Check how clearly the sides attack each other vs. internal attacks
    # This is simplified - would need the full attack graph
    if main_sides.side_a.stats.total_kills > 0 and main_sides.side_b.stats.total_kills > 0 do
      0.8
    else
      0.3
    end
  end

  defp generate_side_summary(main_sides, killmails) do
    total_isk = killmails |> Enum.map(& &1.total_value) Enum.sum()

    %{
      side_a: %{
        entities: length(main_sides.side_a.members),
        corporations: length(main_sides.side_a.corporations),
        alliances: length(main_sides.side_a.alliances),
        performance: main_sides.side_a.stats
      },
      side_b: %{
        entities: length(main_sides.side_b.members),
        corporations: length(main_sides.side_b.corporations),
        alliances: length(main_sides.side_b.alliances),
        performance: main_sides.side_b.stats
      },
      balance: calculate_side_balance(main_sides),
      total_isk_involved: total_isk
    }
  end

  defp calculate_side_balance(main_sides) do
    side_a_strength = main_sides.side_a.stats.total_kills + length(main_sides.side_a.members)
    side_b_strength = main_sides.side_b.stats.total_kills + length(main_sides.side_b.members)

    if side_a_strength + side_b_strength == 0 do
      :unknown
    else
      ratio = min(side_a_strength, side_b_strength) / max(side_a_strength, side_b_strength)

      cond do
        ratio > 0.8 -> :balanced
        ratio > 0.5 -> :slightly_unbalanced
        true -> :heavily_unbalanced
      end
    end
  end

  defp analyze_attack_patterns(attack_graph) do
    # Analyze overall attack patterns
    total_attacks = attack_graph
    Map.values()
    |>     Enum.map(fn data -> data.attacks |> Map.values() Enum.sum() end)
    Enum.sum()

    focus_fire_instances = attack_graph
    Map.values()
    |>     Enum.map(&Map.values(&1.attacks))
    List.flatten()
    Enum.count(& &1 > 3)

    %{
      total_attack_relationships: map_size(attack_graph),
      total_attacks: total_attacks,
      focus_fire_percentage: if(total_attacks > 0, do: focus_fire_instances / total_attacks * 100, else: 0),
      complexity: classify_battle_complexity(attack_graph)
    }
  end

  defp classify_battle_complexity(attack_graph) do
    entity_count = map_size(attack_graph)

    cond do
      entity_count < 5 -> :simple
      entity_count < 20 -> :moderate
      entity_count < 50 -> :complex
      true -> :very_complex
    end
  end

  defp calculate_efficiency(kills, losses) do
    total = kills + losses
    if total == 0, do: 0.5, else: kills / total
  end

  defp entity_in_side?(entity_id, entity_type, side_members) do
    Enum.any?(side_members, fn member ->
      case {member, entity_type} do
        {{:corporation, corp_id}, :corporation} -> corp_id == entity_id
        {{:alliance, alliance_id}, :alliance} -> alliance_id == entity_id
        _ -> false
      end
    end)
  end

  defp entity_in_list?(entity_id, entity_type, neutral_list) do
    Enum.any?(neutral_list, fn neutral ->
      case {neutral.entity, entity_type} do
        {{:corporation, corp_id}, :corporation} -> corp_id == entity_id
        {{:alliance, alliance_id}, :alliance} -> alliance_id == entity_id
        _ -> false
      end
    end)
  end
end
