  @doc """
  Check if composition has mixed weapon systems.
  """
  def has_mixed_weapon_systems?(comp) do
    # Simplified check - would need ship fitting data
    Map.get(comp, :has_mixed_weapons, false)
  end

  # Helper functions

  defp count_doctrine_frequency(doctrine, fleet_compositions) do
    fleet_compositions
    |>     Enum.count(fn comp ->
      case comp do
        %{doctrine_detected: %{detected_doctrines: doctrines}} ->
          Enum.any?(doctrines, &(&1.name == doctrine.name))
        _ -> false
      end
    end)
  end

  defp assess_doctrine_threat(doctrine) do
    # Assess threat based on doctrine characteristics
    case doctrine do
      %{name: name} when name in [:capital_escalation, :titan_bridge] -> :critical
      %{name: name} when name in [:ahac_fleet, :battleship_fleet] -> :high
      %{name: name} when name in [:cruiser_gang, :bc_fleet] -> :medium
      _ -> :low
    end
  end
end
