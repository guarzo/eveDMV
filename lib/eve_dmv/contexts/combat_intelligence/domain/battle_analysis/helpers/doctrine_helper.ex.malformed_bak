defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Helpers.DoctrineHelper do
  @moduledoc """
  Helper functions for doctrine analysis and recommendations.

  Handles:
  - Doctrine pattern identification
  - Counter-strategy generation
  - Training scenario generation
  - Role specialization recommendations
  - Weakness analysis
  """

  alias EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Utilities.ShipClassificationUtility

  @doc """
  Identify enemy doctrine patterns from fleet compositions.
  """
  def identify_enemy_doctrine_patterns(fleet_compositions) do
    # Extract doctrine patterns from enemy fleets
    fleet_compositions
    |>     Enum.flat_map(fn comp ->
      case comp do
        %{doctrine_detected: %{detected_doctrines: doctrines}} -> doctrines
        _ -> []
      end
    end)
    Enum.uniq()
    |>     Enum.map(fn doctrine ->
      %{
        name: doctrine.name,
        _frequency: count_doctrine_frequency(doctrine, fleet_compositions),
        threat_level: assess_doctrine_threat(doctrine)
      }
    end)
  end

  @doc """
  Generate counter-strategies for enemy patterns.
  """
  def generate_counter_strategies(enemy_patterns) do
    enemy_patterns
    |>     Enum.map(fn pattern ->
      case pattern.name do
        :armor_brawl ->
          "Deploy long-range kiting doctrine with tracking disruptors"
        :shield_kite ->
          "Use fast tackle with scrams and webs to close range"
        :bombing_run ->
          "Maintain proper fleet spacing and use destroyer screen"
        :capital_escalation ->
          "Prepare anti-capital doctrine with void bombs and neuts"
        _ ->
          "Adapt doctrine based on enemy composition"
      end
    end)
  end

  @doc """
  Calculate counter-doctrine priority.
  """
  def calculate_counter_doctrine_priority(enemy_patterns) do
    max_threat =
      enemy_patterns
      Enum.map(& &1.threat_level)
      Enum.max(fn -> :low end)

    case max_threat do
      :critical -> :urgent
      :high -> :high
      :medium -> :medium
      _ -> :low
    end
  end

