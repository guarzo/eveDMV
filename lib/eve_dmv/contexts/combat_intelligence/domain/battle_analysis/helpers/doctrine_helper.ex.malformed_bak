  @doc """
  Generate tactical drill scenarios from insights.
  """
  def generate_tactical_drill_scenarios(insights) do
    base_scenarios = [
      %{
        drill: "Rapid target switching",
        objective: "Improve focus fire effectiveness",
        metrics: ["Time to target death", "Wasted damage"]
      },
      %{
        drill: "Emergency scatter",
        objective: "Survive bombing runs",
        metrics: ["Survival rate", "Regroup time"]
      }
    ]

    # Add insight-specific scenarios
    insight_scenarios =
      insights
      |>       Enum.flat_map(fn insight ->
        case insight do
          %{type: :low_efficiency} ->
            [%{
              drill: "Efficiency optimization",
              objective: "Reduce overkill and improve target selection",
              metrics: ["ISK efficiency", "Application percentage"]
            }]
          _ -> []
        end
      end)

    base_scenarios ++ insight_scenarios
  end

  @doc """
  Check if a ship is an EWAR ship.
  """
  def is_ewar_ship?(ship_name) do
    ewar_ships = [
      "Falcon", "Rook", "Blackbird", "Kitsune", "Keres",
      "Maulus", "Arazu", "Lachesis", "Curse", "Pilgrim",
      "Arbitrator", "Bellicose", "Celestis", "Griffin",
      "Crucifier", "Vigil", "Sentinel", "Kirin"
    ]

    Enum.member?(ewar_ships, ship_name)
  end

  @doc """
  Check if a ship is a command ship.
  """
  def is_command_ship?(ship_name) do
    command_ships = [
      "Claymore", "Vulture", "Astarte", "Sleipnir",
      "Eos", "Damnation", "Absolution", "Nighthawk",
      "Bifrost", "Magus", "Pontifex", "Stork"
    ]

    Enum.member?(command_ships, ship_name)
  end

  @doc """
  Analyze EWAR impact on fleet compositions.
  """
  def analyze_ewar_impact(compositions) do
    ewar_ships =
      compositions
      Enum.flat_map(& &1.ships)
      Enum.filter(&is_ewar_ship?/1)
      length()

    total_ships =
      compositions
      Enum.map(& &1.fleet_size)
      Enum.sum()

    if total_ships > 0 do
      # 10% EWAR is max effectiveness
      min(1.0, ewar_ships / total_ships * 10)
    else
      0.0
    end
  end

  @doc """
  Calculate logistics impact on fleet effectiveness.
  """
  def calculate_logistics_impact(compositions) do
    logi_ratio =
      compositions
      |>       Enum.map(fn comp ->
        logi_count = Map.get(comp.role_counts, :logistics, 0)

        if comp.fleet_size > 0 do
          logi_count / comp.fleet_size
        else
          0.0
        end
      end)
      Enum.max(fn -> 0.0 end)

    # Optimal is around 20-25% logistics
    cond do
      logi_ratio > 0.25 -> 0.9
      logi_ratio > 0.20 -> 1.0
      logi_ratio > 0.15 -> 0.8
      logi_ratio > 0.10 -> 0.6
      true -> 0.3
    end
  end

  @doc """
  Estimate command boost effect on fleet.
  """
  def estimate_command_boost_effect(compositions) do
    command_ships =
      compositions
      Enum.flat_map(& &1.ships)
      Enum.filter(&is_command_ship?/1)
      length()

    if command_ships > 0 do
      # Each command ship adds 30% effectiveness, max 100%
      min(1.0, command_ships * 0.3)
    else
      0.0
    end
  end

