defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Utilities.ShipClassificationUtility do
  @moduledoc """
  Ship classification utility for categorizing EVE Online ships.

  Handles:
  - Ship type ID to class mapping
  - Ship role classification
  - Ship size categorization
  - Engagement range estimation
  """

  @doc """
  Classify a ship based on its type ID.
  """
  def classify_ship_type_id(ship_type_id) when is_integer(ship_type_id) do
    cond do
      # Frigates
      ship_type_id in 580..700 -> :frigate
      # Assault Frigates
      ship_type_id in 11_365..11_378 -> :assault_frigate
      # Interceptors
      ship_type_id in 11_177..11_190 -> :interceptor
      # Destroyers
      ship_type_id in 420..450 -> :destroyer
      # Interdictors
      ship_type_id in 22_440..22_460 -> :interdictor
      # Cruisers
      ship_type_id in 620..650 -> :cruiser
      # Heavy Assault Cruisers
      ship_type_id in 12_017..12_030 -> :heavy_assault_cruiser
      # Heavy Interdictors
      ship_type_id in 12_011..12_016 -> :heavy_interdictor
      # Logistics Cruisers
      ship_type_id in 11_987..11_995 -> :logistics_cruiser
      # Recon Ships
      ship_type_id in 11_957..11_971 -> :recon_ship
      # Battlecruisers
      ship_type_id in 540..570 -> :battlecruiser
      # Command Ships
      ship_type_id in 12_003..12_010 -> :command_ship
      # Battleships
      ship_type_id in 640..670 -> :battleship
      # Marauders
      ship_type_id in 28_659..28_665 -> :marauder
      # Black Ops
      ship_type_id in 22_440..22_456 -> :black_ops
      # Carriers
      ship_type_id in 547..554 -> :carrier
      # Dreadnoughts
      ship_type_id in 19_720..19_726 -> :dreadnought
      # Force Auxiliaries
      ship_type_id in 1_538..1_540 -> :force_auxiliary
      # Supercarriers
      ship_type_id in 23_757..23_773 -> :supercarrier
      # Titans
      ship_type_id in 3514..3518 -> :titan
      # Industrial Ships
      ship_type_id in 1_022..1_034 -> :industrial
      # T3 Cruisers
      ship_type_id in 29_984..29_990 -> :strategic_cruiser
      # Default fallback
      true -> :other
    end
  end

  def classify_ship_type_id(_), do: :unknown

  @doc """
  Classify ship by name pattern.
  """
  def classify_ship(ship_type_id) do
    # This delegates to the main classification function
    # but could be extended with name-based classification
    classify_ship_type_id(ship_type_id)
  end

  @doc """
  Determine ship size category.
  """
  def ship_size_category(ship_class) do
    case ship_class do
      c when c in [:frigate, :assault_frigate, :interceptor, :destroyer] -> :small
      c when c in [:cruiser, :heavy_assault_cruiser, :heavy_interdictor, :logistics_cruiser, :recon_ship, :strategic_cruiser] -> :medium
      c when c in [:battlecruiser, :command_ship, :battleship, :marauder, :black_ops] -> :large
      c when c in [:carrier, :dreadnought, :force_auxiliary, :supercarrier, :titan] -> :capital
      _ -> :unknown
    end
  end

  @doc """
  Determine if ship is a capital class.
  """
  def is_capital_ship?(ship_class) do
    ship_class in [:carrier, :dreadnought, :force_auxiliary, :supercarrier, :titan]
  end

  @doc """
  Determine if ship is a support role.
  """
  def is_support_ship?(ship_class) do
    ship_class in [:logistics_cruiser, :force_auxiliary, :command_ship, :recon_ship, :heavy_interdictor, :interdictor]
  end

  @doc """
  Estimate typical engagement range for ship class.
  """
  def estimate_engagement_range(ship_class) do
    case ship_class do
      # Close range brawlers
      c when c in [:assault_frigate, :heavy_assault_cruiser] -> :close
      # Medium range
      c when c in [:cruiser, :battlecruiser, :strategic_cruiser] -> :medium
      # Long range
      c when c in [:battleship, :marauder] -> :long
      # Extreme range
      c when c in [:titan, :dreadnought] -> :extreme
      # Variable/tactical
      c when c in [:interceptor, :recon_ship] -> :variable
      # Support ships
      c when c in [:logistics_cruiser, :command_ship] -> :fleet_range
      # Default
      _ -> :medium
    end
  end

  @doc """
  Get typical mass category for ship class.
  """
  def mass_category(ship_class) do
    case ship_size_category(ship_class) do
      :small -> :low_mass
      :medium -> :medium_mass
      :large -> :high_mass
      :capital -> :extreme_mass
      _ -> :unknown_mass
    end
  end

  @doc """
  Determine if ship class is typically used for tackle.
  """
  def is_tackle_ship?(ship_class) do
    ship_class in [:interceptor, :interdictor, :heavy_interdictor]
  end

  @doc """
  Get ship role category.
  """
  def ship_role_category(ship_class) do
    cond do
      ship_class in [:logistics_cruiser, :force_auxiliary] -> :logistics
      ship_class in [:interceptor, :interdictor, :heavy_interdictor] -> :tackle
      ship_class in [:recon_ship] -> :ewar
      ship_class in [:command_ship] -> :command
      ship_class in [:carrier, :supercarrier] -> :fighter_platform
      ship_class in [:dreadnought, :titan] -> :siege_platform
      true -> :damage_dealer
    end
  end
end
