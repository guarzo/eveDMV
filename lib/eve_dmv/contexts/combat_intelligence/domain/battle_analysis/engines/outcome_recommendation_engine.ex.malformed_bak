defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Engines.OutcomeRecommendationEngine do
  @moduledoc """
  Outcome recommendation engine for generating actionable insights from battle analysis.

  Handles:
  - Immediate tactical recommendations
  - Strategic adjustment suggestions
  - Training priority identification
  - Doctrine modification proposals
  - Future consideration planning
  - Weakness and strength analysis
  """

  require Logger

  @doc """
  Generate comprehensive recommendations based on battle outcome analysis.
  """
  def generate_outcome_recommendations(outcome_analysis) do
    Logger.debug("Generating outcome recommendations")

    # Analyze outcome data to generate targeted recommendations
    weaknesses = identify_critical_weaknesses(outcome_analysis)
    _strengths = identify_key_strengths(outcome_analysis)
    _opportunities = identify_improvement_opportunities(outcome_analysis)

    # Generate recommendations by category
    immediate_tactical = generate_immediate_tactical_recommendations(outcome_analysis, weaknesses)
    strategic_adjustments = generate_strategic_adjustments(outcome_analysis)
    training_priorities = identify_training_priorities(outcome_analysis)
    doctrine_modifications = suggest_doctrine_modifications(outcome_analysis)
    future_considerations = identify_future_considerations(outcome_analysis)

    # Prioritize recommendations
    prioritized_actions = prioritize_recommendations(immediate_tactical ++ strategic_adjustments)

    %{
      immediate_tactical: immediate_tactical,
      strategic_adjustments: strategic_adjustments,
      training_priorities: training_priorities,
      doctrine_modifications: doctrine_modifications,
      future_considerations: future_considerations,
      prioritized_actions: prioritized_actions,
      implementation_timeline: generate_implementation_timeline(prioritized_actions),
      expected_improvements: estimate_improvement_impact(prioritized_actions)
    }
  end

  @doc """
  Identify critical weaknesses from outcome analysis.
  """
  def identify_critical_weaknesses(outcome_analysis) do

    # Check primary factors for poor performance
    primary_factors = Map.get(outcome_analysis, :primary_factors, [])

    weaknesses = if Enum.any?(
         primary_factors,
         &(Map.get(&1, :factor) == :logistics_advantage and Map.get(&1, :impact, 0) < 0.3)
       ) do
      [%{type: :logistics_vulnerability, severity: :critical, impact: 0.8} | weaknesses]
    else
      weaknesses
    end

    weaknesses = if Enum.any?(
         primary_factors,
         &(Map.get(&1, :factor) == :target_selection and Map.get(&1, :impact, 0) < 0.4)
       ) do
      [%{type: :poor_target_selection, severity: :high, impact: 0.6} | weaknesses]
    else
      weaknesses
    end

    weaknesses = if Enum.any?(
         primary_factors,
         &(Map.get(&1, :factor) == :coordination and Map.get(&1, :impact, 0) < 0.5)
       ) do
      [%{type: :poor_coordination, severity: :high, impact: 0.7} | weaknesses]
    else
      weaknesses
    end

    # Check for timing issues
    _weaknesses = if Map.get(outcome_analysis, :timing_score, 0.5) < 0.4 do
      [%{type: :timing_issues, severity: :medium, impact: 0.5} | weaknesses]
    else
      weaknesses
    end

    Enum.sort_by(weaknesses, & &1.impact, :desc)
  end

  @doc """
  Identify key strengths from outcome analysis.
  """
  def identify_key_strengths(outcome_analysis) do

    primary_factors = Map.get(outcome_analysis, :primary_factors, [])

    strengths = if Enum.any?(
         primary_factors,
         &(Map.get(&1, :factor) == :numerical_superiority and Map.get(&1, :impact, 0) > 0.7)
       ) do
      [%{type: :numerical_advantage, strength: :major, impact: 0.8} | strengths]
    else
      strengths
    end

    _strengths = if Enum.any?(
         primary_factors,
         &(Map.get(&1, :factor) == :combat_efficiency and Map.get(&1, :impact, 0) > 0.8)
       ) do
      [%{type: :combat_effectiveness, strength: :major, impact: 0.9} | strengths]
    else
      strengths
    end

    strengths
  end

  @doc """
  Identify improvement opportunities from outcome analysis.
  """
  def identify_improvement_opportunities(outcome_analysis) do

    secondary_factors = Map.get(outcome_analysis, :secondary_factors, [])

    opportunities = if Enum.any?(
         secondary_factors,
         &(Map.get(&1, :factor) == :positioning and Map.get(&1, :impact, 0) < 0.6)
       ) do
      [%{type: :positioning_improvement, potential: :high, effort: :medium} | opportunities]
    else
      opportunities
    end

    _opportunities = if Enum.any?(
         secondary_factors,
         &(Map.get(&1, :factor) == :timing and Map.get(&1, :impact, 0) < 0.7)
       ) do
      [%{type: :timing_optimization, potential: :medium, effort: :low} | opportunities]
    else
      opportunities
    end

    opportunities
  end

  # Private helper functions

  defp generate_immediate_tactical_recommendations(outcome_analysis, weaknesses) do
    # Address critical weaknesses first
    recommendations = Enum.reduce(weaknesses, [], fn weakness, acc ->
      case weakness.type do
        :poor_target_selection ->
          [
            %{
              action: "Implement strict target priority list: Logistics → EWAR → DPS",
              urgency: :critical,
              expected_impact: :high,
              implementation: "Pre-brief all FCs on target priorities"
            }
            | acc
          ]

        :logistics_vulnerability ->
          [
            %{
              action: "Increase logistics ratio to 25% and improve positioning",
              urgency: :critical,
              expected_impact: :high,
              implementation: "Adjust doctrine requirements immediately"
            }
            | acc
          ]

        :poor_coordination ->
          [
            %{
              action: "Establish clear command hierarchy and improve comms discipline",
              urgency: :high,
              expected_impact: :medium,
              implementation: "Run coordination drills before next op"
            }
            | acc
          ]

        :timing_issues ->
          [
            %{
              action: "Improve engagement timing through better intel gathering",
              urgency: :medium,
              expected_impact: :medium,
              implementation: "Deploy scouts 30 minutes before fleet movement"
            }
            | acc
          ]

        _ ->
          acc
      end
    end)

    # Add general tactical improvements based on outcome
    final_recommendations = if outcome_analysis[:primary_factors] do
      Enum.reduce(outcome_analysis.primary_factors, recommendations, fn factor, acc ->
        if factor.impact < 0.5 do
          recommendation = generate_factor_improvement(factor)
          if recommendation, do: [recommendation | acc], else: acc
        else
          acc
        end
      end)
    else
      recommendations
    end

    final_recommendations
    Enum.uniq_by(& &1.action)
    |>     Enum.sort_by(fn r ->
      {urgency_to_number(r.urgency), impact_to_number(r.expected_impact)}
    end)
    Enum.take(5)
  end

  defp generate_strategic_adjustments(outcome_analysis) do

    # Check numerical factors
    if Map.get(outcome_analysis, :numerical_disadvantage, false) do
      adjustments = [
        "Form strategic alliances to balance numerical disadvantage" | adjustments
      ]
    end

    # Check efficiency factors
    if Map.get(outcome_analysis, :isk_efficiency, 1.0) < 0.5 do
      adjustments = [
        "Reconsider doctrine cost-effectiveness and ship selection" | adjustments
      ]
    end

    # Check coordination factors
    coordination_score = get_in(outcome_analysis, [:tactical_factors, :coordination_effectiveness, :overall_effectiveness]) || 0.5
    if coordination_score < 0.6 do
      adjustments = [
        "Improve command structure efficiency" | adjustments
      ]
    end

    # Add general strategic recommendations
    adjustments ++ [
      "Increase logistics support ratio in fleet compositions",
      "Develop counter-strategies for enemy tactics"
    ]
    Enum.take(3)
  end

  defp identify_training_priorities(outcome_analysis) do

    # Check coordination effectiveness
    coordination_updated_score = get_in(outcome_analysis, [:tactical_factors, :coordination_effectiveness, :overall_effectiveness]) || 0.5
    priorities = if coordination_score < 0.6 do
      [%{priority: :fleet_coordination, urgency: :high} | priorities]
    else
      priorities
    end

    # Check target selection
    target_updated_score = get_in(outcome_analysis, [:tactical_factors, :target_selection_quality, :overall_quality]) || 0.5
    priorities = if target_score < 0.6 do
      [%{priority: :target_selection, urgency: :medium} | priorities]
    else
      priorities
    end

    # Check positioning
    positioning_updated_score = get_in(outcome_analysis, [:tactical_factors, :positioning_advantages, :overall_positioning]) || 0.5
    _priorities = if positioning_score < 0.6 do
      [%{priority: :tactical_positioning, urgency: :medium} | priorities]
    else
      priorities
    end

    Enum.sort_by(priorities, &urgency_to_number(&1.urgency), :desc)
  end

  defp suggest_doctrine_modifications(outcome_analysis) do

    # Check logistics ratio
    logistics_survival = get_in(outcome_analysis, [:victory_factors, :primary_factors])
      case do
        nil -> 0.5
        factors ->
          Enum.find(factors, fn f -> f[:factor] == :logistics_advantage end)
          case do
            nil -> 0.5
            factor -> Map.get(factor, :impact, 0.5)
          end
      end

    modifications = if logistics_survival < 0.5 do
      ["Increase logistics ship ratio to 25%" | modifications]
    else
      modifications
    end

    # Check for capital usage
    force_multipliers = Map.get(outcome_analysis, :force_multipliers, [])
    has_capitals = Enum.any?(force_multipliers, fn m -> m[:multiplier] == :capital_superiority end)

    _modifications = if not has_capitals do
      ["Consider capital or anti-capital doctrine" | modifications]
    else
      modifications
    end

    # General improvements
    modifications ++ [
      "Add interdiction specialists to doctrine",
      "Improve command ship integration"
    ]
    Enum.take(3)
  end

  defp identify_future_considerations(_outcome_analysis) do
    [
      "Monitor enemy tactical evolution",
      "Develop counter-strategies for identified weaknesses",
      "Invest in pilot training for identified skill gaps",
      "Consider doctrine diversification for adaptability",
      "Establish intelligence network for better pre-battle information"
    ]
    Enum.take(3)
  end

  defp generate_factor_improvement(factor) do
    case factor[:factor] do
      :logistics_advantage when factor.impact < 0.5 ->
        %{
          action: "Improve logistics support and survival rates",
          urgency: :high,
          expected_impact: :high,
          implementation: "Add 2-3 more logistics per 10 DPS ships"
        }

      :target_selection when factor.impact < 0.6 ->
        %{
          action: "Enhance target calling and prioritization",
          urgency: :medium,
          expected_impact: :medium,
          implementation: "Train FCs on target priority: Logi > EWAR > DPS"
        }

      :coordination when factor.impact < 0.5 ->
        %{
          action: "Strengthen fleet coordination protocols",
          urgency: :high,
          expected_impact: :high,
          implementation: "Implement strict comms discipline and anchor training"
        }

      _ -> nil
    end
  end

  defp prioritize_recommendations(immediate_actions) do
    immediate_actions
    |>     Enum.sort_by(
      fn action ->
        urgency_updated_score = urgency_to_number(Map.get(action, :urgency, :low))
        impact_updated_score = impact_to_number(Map.get(action, :expected_impact, :low))
        {urgency_score, impact_score}
      end,
      :desc
    )
  end

  defp generate_implementation_timeline(prioritized_actions) do
    prioritized_actions
    Enum.with_index()
    |>     Enum.map(fn {action, index} ->
      urgency = Map.get(action, :urgency, :low)

      timeframe = case urgency do
        :critical -> "Immediate (0-24 hours)"
        :high -> "Short term (1-3 days)"
        :medium -> "Medium term (1-2 weeks)"
        :low -> "Long term (2-4 weeks)"
      end

      %{
        action: Map.get(action, :action, "Unknown action"),
        priority: index + 1,
        timeframe: timeframe,
        urgency: urgency
      }
    end)
  end

  defp estimate_improvement_impact(prioritized_actions) do
    if Enum.empty?(prioritized_actions) do
      %{total_impact: 0.0, timeline: "N/A"}
    else
      total_impact = prioritized_actions
        |>         Enum.map(&impact_to_number(Map.get(&1, :expected_impact, :low)))
        Enum.sum()
        Kernel./(length(prioritized_actions))

      %{
        total_impact: Float.round(total_impact / 3.0, 2),
        timeline: "2-4 weeks",
        high_impact_actions: Enum.count(prioritized_actions, &(Map.get(&1, :expected_impact) == :high))
      }
    end
  end

  defp urgency_to_number(urgency) do
    case urgency do
      :critical -> 4
      :high -> 3
      :medium -> 2
      :low -> 1
      _ -> 0
    end
  end

  defp impact_to_number(impact) do
    case impact do
      :high -> 3
      :medium -> 2
      :low -> 1
      _ -> 0
    end
  end
end
