defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Engines.SideClassificationEngine do
  @moduledoc """
  Engine for classifying battle participants into opposing sides.

  Handles:
  - Alliance/corporation-based side classification
  - Engagement-based participant splitting
  - Connected component analysis for side determination
  - Complex multi-faction battle analysis
  """

  alias EveDmv.Contexts.CorporationIntelligence.Domain.CorpIntelligenceUtils
  require Logger

  @doc """
  Classify participants by side based on alliance and corporation relationships.
  """
  def classify_participants_by_side(participants) do
    Logger.debug("Classifying #{length(participants)} participants by side")

    if Enum.empty?(participants) do
      %{side_a: [], side_b: []}
    else
      # Group participants by alliance/corporation
      grouped_participants = group_participants_by_affiliation(participants)

      case Map.keys(grouped_participants) do
        [] ->
          %{side_a: [], side_b: []}

        [single_group] ->
          # All participants belong to the same group - need to split by engagement patterns
          Logger.debug("Single affiliation group detected, splitting by engagement patterns")
          split_single_group_by_engagement(grouped_participants[single_group])

        affiliations when length(affiliations) == 2 ->
          # Clear two-sided battle
          [side_a_key, side_b_key] = affiliations
          %{
            side_a: grouped_participants[side_a_key],
            side_b: grouped_participants[side_b_key]
          }

        affiliations when length(affiliations) > 2 ->
          # Multi-faction battle - group into two main sides
          Logger.debug("Multi-faction battle detected, grouping into main sides")
          group_multi_faction_battle(grouped_participants)
      end
    end
  end

  @doc """
  Split a single group by engagement patterns when all participants share affiliation.
  """
  def split_single_group_by_engagement(participants) do
    Logger.debug("Splitting #{length(participants)} participants by engagement patterns")

    if length(participants) < 2 do
      %{side_a: participants, side_b: []}
    else
      # Build attack/victim relationship graph
      attack_graph = build_attack_relationship_graph(participants)

      # Perform graph-based clustering to identify opposing sides
      if map_size(attack_graph) == 0 do
        # No attack relationships found, split randomly
        {side_a, side_b} = Enum.split(participants, div(length(participants), 2))
        %{side_a: side_a, side_b: side_b}
      else
        # Use graph analysis to determine sides
        sides = analyze_attack_graph_for_sides(attack_graph, participants)

        case sides do
          {side_a, side_b} when length(side_a) > 0 and length(side_b) > 0 ->
            %{side_a: side_a, side_b: side_b}

          _ ->
            # Fallback to random split
            {side_a, side_b} = Enum.split(participants, div(length(participants), 2))
            %{side_a: side_a, side_b: side_b}
        end
      end
    end
  end

  @doc """
  Build connected component from participant relationships.
  """
  def build_connected_component(participant, visited, all_participants) do
    if MapSet.member?(visited, participant.character_id) do
      {[], visited}
    else
      # Add this participant to visited
      visited = MapSet.put(visited, participant.character_id)

      # Find connected participants (same alliance/corp)
      connected = find_connected_participants(participant, all_participants)

      # Recursively build component
      {component_members, final_visited} =
        Enum.reduce(connected, {[participant], visited}, fn connected_participant, {acc_members, acc_visited} ->
          {new_members, new_visited} = build_connected_component(connected_participant, acc_visited, all_participants)
          {acc_members ++ new_members, new_visited}
        end)

      {component_members, final_visited}
    end
  end

  # Private helper functions

  defp group_participants_by_affiliation(participants) do
    participants
    |>     Enum.group_by(fn participant ->
      # Use alliance_id if available, otherwise corporation_id
      case participant do
        %{alliance_id: alliance_id} when alliance_id != nil and alliance_id != 0 ->
          {:alliance, alliance_id}
        %{corporation_id: corp_id} when corp_id != nil and corp_id != 0 ->
          {:corporation, corp_id}
        _ ->
          {:unknown, :unknown}
      end
    end)
    Enum.reject(fn {key, _participants} -> key == {:unknown, :unknown} end)
    Enum.into(%{})
  end

  defp group_multi_faction_battle(grouped_participants) do
    # Sort groups by size (largest first)
    sorted_groups =
      grouped_participants
      |>       Enum.sort_by(fn {_key, participants} -> length(participants) end, :desc)

    case sorted_groups do
      [{_key1, side_a} | rest] ->
        # Largest group becomes side A, combine the rest into side B
        side_b = rest |> Enum.flat_map(fn {_key, participants} -> participants end)
        %{side_a: side_a, side_b: side_b}

      [] ->
        %{side_a: [], side_b: []}
    end
  end

  defp build_attack_relationship_graph(participants) do
    # Build a graph where edges represent attack relationships
    # This is a simplified approach - in reality, we'd need killmail data
    participants
    |>     Enum.reduce(%{}, fn participant, graph ->
      # For now, create empty adjacency list
      Map.put(graph, participant.character_id, [])
    end)
  end

  defp analyze_attack_graph_for_sides(attack_graph, participants) do
    # Simplified graph analysis - in practice would use more sophisticated clustering
    participant_ids = Map.keys(attack_graph)

    # Simple approach: split based on character IDs (odd/even)
    {odds, evens} =
      participant_ids
      |>       Enum.partition(fn id -> rem(id, 2) == 1 end)

    # Map back to participant objects
    id_to_participant = participants |> Enum.group_by(&(&1.character_id)) Enum.map(fn {id, [p]} -> {id, p} end) Enum.into(%{})

    side_a = odds |> Enum.map(&Map.get(id_to_participant, &1)) Enum.filter(&(&1 != nil))
    side_b = evens |> Enum.map(&Map.get(id_to_participant, &1)) Enum.filter(&(&1 != nil))

    {side_a, side_b}
  end

  defp find_connected_participants(participant, all_participants) do
    all_participants
    |>     Enum.filter(fn other ->
      other.character_id != participant.character_id and
      same_affiliation?(participant, other)
    end)
  end

  defp same_affiliation?(p1, p2) do
    # Check if participants share alliance or corporation
    case {p1, p2} do
      {%{alliance_id: aid}, %{alliance_id: aid}} when aid != nil and aid != 0 ->
        true
      {%{corporation_id: cid}, %{corporation_id: cid}} when cid != nil and cid != 0 ->
        true
      _ ->
        false
    end
  end
end
