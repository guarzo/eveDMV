defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Phases.TimelineAnalyzer do
  @moduledoc """
  Timeline analyzer for reconstructing battle timelines from _killmail data.

  Analyzes the sequence of events in a battle to understand the flow of combat,
  identify key moments, and provide temporal context for tactical analysis.
  """

  alias EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Processors.TimelineProcessor
  alias EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.BattlePhaseAnalyzer
  alias EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.EngagementFlowAnalyzer
  alias EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.FocusFireAnalyzer
  alias EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.TargetSelectionAnalyzer

  require Logger

  @doc """
  Reconstruct battle timeline from _killmail data.
  """
  def reconstruct_timeline(killmails) do
    Logger.debug("Reconstructing timeline from #{length(killmails)} killmails")

    # Delegate to TimelineProcessor for core reconstruction
    timeline_result = TimelineProcessor.reconstruct_timeline(killmails)

    if Enum.empty?(timeline_result.events) do
      timeline_result
    else
      # Enhance with phase analysis using BattlePhaseAnalyzer
      phases = BattlePhaseAnalyzer.identify_battle_phases(timeline_result.events)
      key_moments = BattlePhaseAnalyzer.identify_key_moments(timeline_result.events)

      # Add tempo and intensity analysis
      tempo = calculate_battle_tempo(timeline_result.events)
      intensity_profile = calculate_intensity_profile(timeline_result.events)

      Map.merge(timeline_result, %{
        phases: phases,
        key_moments: key_moments,
        tempo: tempo,
        intensity_profile: intensity_profile
      })
    end
  end

  @doc """
  Analyze engagement flow patterns in the timeline.
  """
  def analyze_engagement_flow(timeline) do
    # Delegate to EngagementFlowAnalyzer
    EngagementFlowAnalyzer.analyze_engagement_flow(timeline)
  end

  @doc """
  Analyze focus fire patterns in the timeline.
  """
  def analyze_focus_fire(timeline) do
    # Delegate to FocusFireAnalyzer
    FocusFireAnalyzer.analyze_focus_fire(timeline)
  end

  @doc """
  Analyze target selection patterns throughout the timeline.
  """
  def analyze_target_selection(timeline, fleet_analysis) do
    # Delegate to TargetSelectionAnalyzer
    TargetSelectionAnalyzer.analyze_target_selection(timeline, fleet_analysis)
  end

  # Private helper functions for tempo and intensity analysis

  defp calculate_battle_tempo(timeline_events) do
    if length(timeline_events) < 2 do
      :slow
    else
      avg_time_between =
        timeline_events
        Enum.chunk_every(2, 1, :discard)
        |>         Enum.map(fn [e1, e2] -> DateTime.diff(e2.timestamp, e1.timestamp, :second) end)
        Enum.sum()
        Kernel./(length(timeline_events) - 1)

      cond do
        avg_time_between < 30 -> :very_fast
        avg_time_between < 60 -> :fast
        avg_time_between < 120 -> :moderate
        avg_time_between < 300 -> :slow
        true -> :very_slow
      end
    end
  end

  defp calculate_intensity_profile(timeline_events) do
    # Use EngagementFlowAnalyzer for intensity calculation
    intensity_curve = EngagementFlowAnalyzer.calculate_intensity_curve(timeline_events)

    if Enum.empty?(intensity_curve) do
      %{peak: 0, average: 0, variance: 0}
    else
      intensities = Enum.map(intensity_curve, & &1.overall_intensity)
      peak = Enum.max(intensities, fn -> 0 end)
      average = Enum.sum(intensities) / length(intensities)
      variance = calculate_variance(intensities, average)

      %{peak: peak, average: average, variance: variance}
    end
  end

  defp calculate_variance(values, mean) do
    if Enum.empty?(values) do
      0
    else
      sum_squared_diff =
        values
        |>         Enum.map(fn v -> :math.pow(v - mean, 2) end)
        Enum.sum()

      sum_squared_diff / length(values)
    end
  end

end
