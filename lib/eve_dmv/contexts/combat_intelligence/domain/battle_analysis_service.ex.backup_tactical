  defp determine_engagement_status(engagement) do
    last_activity_seconds = DateTime.diff(DateTime.utc_now(), engagement.last_activity)

    cond do
      last_activity_seconds < 60 -> :active
      last_activity_seconds < 300 -> :winding_down
      true -> :concluded
    end
  end

