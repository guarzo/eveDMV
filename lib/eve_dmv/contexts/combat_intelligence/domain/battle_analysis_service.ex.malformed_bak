  defp calculate_variance(values) do
    if Enum.empty?(values) do
      0
    else
      mean = Enum.sum(values) / length(values)

      sum_squares =
        values
        |>         Enum.map(fn v -> (v - mean) * (v - mean) end)
        Enum.sum()

      sum_squares / length(values)
    end
  end

