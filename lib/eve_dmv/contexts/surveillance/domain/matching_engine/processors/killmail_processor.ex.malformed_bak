defmodule EveDmv.Contexts.Surveillance.Domain.MatchingEngine.Processors.KillmailProcessor do
  @moduledoc """
  Processes killmails against surveillance profiles.
  """

  alias EveDmv.Contexts.Surveillance.Domain.MatchingEngine.{
    Core.StateManager,
    Core.MatchProcessor,
    Matchers.CriteriaEvaluator
  }
  
  alias EveDmv.Contexts.Surveillance.Infrastructure.{
    ProfileRepository,
    MatchCache
  }
  
  alias EveDmv.DomainEvents.SurveillanceMatch
  alias EveDmv.Infrastructure.EventBus

  @doc """
  Process a killmail against all active profiles.
  """
  def process_killmail(killmail_data, state) do
    start_time = System.monotonic_time(:millisecond)

    # Get active profiles
    {:ok, profiles} = ProfileRepository.get_active_profiles()

    # Process matches
    matches =
      Enum.reduce(profiles, [], fn profile, acc ->
        case evaluate_killmail_against_profile(killmail_data, profile) do
          {:ok, match} -> [match | acc]
          {:error, _} -> acc
        end
      end)

    # Store matches and trigger alerts
    |>     Enum.each(matches, fn match ->
      MatchCache.store_match(match)
      publish_match_event(match)
    end)

    end_time = System.monotonic_time(:millisecond)
    processing_time = end_time - start_time

    # Update metrics
    StateManager.update_state_with_processing(state, length(matches), processing_time)
  end

  @doc """
  Force match killmail against all profiles for debugging.
  """
  def force_match_all_profiles(killmail_data, _state) do
    {:ok, profiles} = ProfileRepository.get_active_profiles()

    matches =
      Enum.map(profiles, fn profile ->
        case evaluate_killmail_against_profile(killmail_data, profile) do
          {:ok, match} -> {:match, match}
          {:error, reason} -> {:no_match, profile.id, reason}
        end
      end)

    {:ok, matches}
  end

  # Private functions

  defp evaluate_killmail_against_profile(killmail_data, profile) do
    result = CriteriaEvaluator.evaluate_criteria(profile.criteria, killmail_data)

    if result.matches do
      match = build_match_record(profile, killmail_data, result)
      {:ok, match}
    else
      {:error, :no_match}
    end
  end

  defp build_match_record(profile, killmail_data, result) do
    %{
      id: generate_match_id(),
      profile_id: profile.id,
      killmail_id: killmail_data.killmail_id,
      matched_criteria: result.matched_criteria,
      confidence_score: result.confidence_score,
      timestamp: DateTime.utc_now(),
      killmail_data: killmail_data
    }
  end

  defp publish_match_event(match) do
    EventBus.publish(%SurveillanceMatch{
      profile_id: match.profile_id,
      killmail_id: match.killmail_id,
      # Default type
      match_type: :character,
      match_details: %{id: match.id, matched_criteria: match.matched_criteria},
      confidence_score: match.confidence_score,
      timestamp: DateTime.utc_now()
    })
  end

  defp generate_match_id do
    random_bytes = :crypto.strong_rand_bytes(16)
    Base.encode16(random_bytes, case: :lower)
  end
end