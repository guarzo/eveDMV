defmodule EveDmv.Contexts.WormholeOperations.Analyzers.SecurityAssessment do
  @moduledoc """
  Security assessment analyzer for wormhole operations recruitment.

  Provides comprehensive security evaluation including:
  - OpSec risk assessment and scoring
  - Character background evaluation
  - Wormhole experience analysis
  - Security indicator identification
  - Threat level categorization
  """

  alias EveDmv.Contexts.WormholeOperations.Analyzers.CorporationAnalyzer

  require Logger

  # Risk thresholds
  @high_risk_threshold 0.7
  @medium_risk_threshold 0.4
  @critical_risk_threshold 0.85

  # Security status thresholds
  @low_sec_status_threshold -2.0
  @very_low_sec_status_threshold -5.0

  # Character age thresholds (in days)
  @new_character_threshold 30
  @young_character_threshold 90
  @established_character_threshold 365

  # SP gain thresholds (per day)
  @normal_sp_gain 1500
  @high_sp_gain 3000
  @suspicious_sp_gain 100_000

  @doc """
  Performs comprehensive OpSec risk assessment on a character.
  """
  def assess_opsec_risks(character_data, _vetting_criteria) do
    all_risks =
      assess_security_status_risks(character_data) ++
        assess_corp_pattern_risks(character_data.corporation_history) ++
        assess_spy_risk_indicators(character_data) ++
        assess_character_age_risks(character_data)

    risk_score = calculate_opsec_risk_score(all_risks)

    {:ok,
     %{
       risk_score: risk_score,
       risk_level: categorize_risk_level(risk_score),
       identified_risks: all_risks,
       mitigation_recommendations: generate_opsec_mitigations(all_risks),
       background_check_passed: risk_score < @medium_risk_threshold,
       requires_additional_vetting: risk_score > @high_risk_threshold
     }}
  end

  @doc """
  Evaluates security risks based on character's security status.
  """
  def assess_security_status_risks(character_data) do
    cond do
      character_data.security_status < @very_low_sec_status_threshold ->
        [
          %{
            type: :very_low_security_status,
            severity: :high,
            description: "Very low security status indicates extensive criminal activity",
            value: character_data.security_status
          }
        ]

      character_data.security_status < @low_sec_status_threshold ->
        [
          %{
            type: :low_security_status,
            severity: :medium,
            description: "Low security status indicates high-sec ganking",
            value: character_data.security_status
          }
        ]

      true ->
        []
    end
  end

  @doc """
  Analyzes corporation history for suspicious patterns.
  """
  def assess_corp_pattern_risks(corp_history) do
    CorporationAnalyzer.assess_corp_pattern_risks(corp_history)
  end

  @doc """
  Identifies potential spy risk indicators in character profile.
  """
  def assess_spy_risk_indicators(character_data) do
    character_age_days = DateTime.diff(DateTime.utc_now(), character_data.creation_date, :day)
    sp_per_day = character_data.total_sp / max(character_age_days, 1)

    []
    add_unrealistic_sp_risk(sp_per_day)
    add_new_character_sp_risk(character_age_days, character_data.total_sp)
    add_suspicious_pattern_risk(character_age_days, sp_per_day)
  end

  @doc """
  Evaluates character age-related security risks.
  """
  def assess_character_age_risks(character_data) do
    character_age_days = DateTime.diff(DateTime.utc_now(), character_data.creation_date, :day)
    corp_count = length(character_data.corporation_history)

    []
    add_age_based_risks(character_age_days)
    add_recycled_account_risk(character_age_days, corp_count)
  end

  @doc """
  Calculates overall OpSec risk score from identified risks.
  """
  def calculate_opsec_risk_score([]), do: 0.0

  def calculate_opsec_risk_score(opsec_risks) do
    severity_weights = %{critical: 0.4, high: 0.3, medium: 0.2, low: 0.1}

    total_risk =
      Enum.reduce(opsec_risks, 0.0, fn risk, acc ->
        weight = Map.get(severity_weights, risk.severity, 0.1)
        acc + weight
      end)

    # Apply diminishing returns for multiple risks
    adjusted_risk = if length(opsec_risks) > 3, do: total_risk * 0.9, else: total_risk

    Float.round(min(1.0, adjusted_risk), 3)
  end

  @doc """
  Categorizes risk level based on risk score.
  """
  def categorize_risk_level(risk_score) do
    cond do
      risk_score >= @critical_risk_threshold -> :critical
      risk_score >= @high_risk_threshold -> :high
      risk_score >= @medium_risk_threshold -> :medium
      risk_score >= 0.1 -> :low
      true -> :minimal
    end
  end

  @doc """
  Generates mitigation recommendations for identified risks.
  """
  def generate_opsec_mitigations(opsec_risks) do
    opsec_risks
    Enum.map(&get_mitigation_text/1)
    Enum.uniq()
  end

  @doc """
  Assesses character metrics for security evaluation.
  """
  def assess_character_security_metrics(character_data) do
    character_age_days = DateTime.diff(DateTime.utc_now(), character_data.creation_date, :day)
    age_updated_score = calculate_age_score(character_age_days)
    sp_updated_score = calculate_sp_security_score(character_data.total_sp, character_age_days)
    skill_focus_updated_score = calculate_skill_focus_score(character_data.total_sp)

    {:ok,
     %{
       character_name: character_data.character_name,
       age_score: age_score,
       sp_security_score: sp_score,
       skill_focus_score: skill_focus_score,
       character_age_days: character_age_days,
       total_sp: character_data.total_sp,
       sp_per_day: Float.round(character_data.total_sp / max(character_age_days, 1), 2),
       security_classification: classify_security_profile(age_score, sp_score),
       maturity_level: determine_character_maturity(character_age_days, character_data.total_sp)
     }}
  end

  @doc """
  Calculates character age score for security assessment.
  """
  def calculate_age_score(character_age_days) do
    cond do
      character_age_days >= @established_character_threshold -> 1.0
      character_age_days >= 180 -> 0.8
      character_age_days >= @young_character_threshold -> 0.6
      character_age_days >= @new_character_threshold -> 0.4
      character_age_days >= 7 -> 0.2
      true -> 0.1
    end
  end

  @doc """
  Calculates SP-based security score.
  """
  def calculate_sp_security_score(total_sp, character_age_days) do
    expected_sp = character_age_days * @normal_sp_gain

    if expected_sp > 0 do
      sp_ratio = total_sp / expected_sp

      cond do
        # Suspiciously high
        sp_ratio >= 3.0 -> 0.2
        # Very high
        sp_ratio >= 2.0 -> 0.4
        # High but reasonable
        sp_ratio >= 1.5 -> 0.7
        # Normal progression
        sp_ratio >= 0.8 -> 1.0
        # Below average
        sp_ratio >= 0.5 -> 0.8
        # Low progression
        true -> 0.6
      end
    else
      0.5
    end
  end

  @doc """
  Calculates skill focus score for security purposes.
  """
  def calculate_skill_focus_score(total_sp) do
    cond do
      total_sp >= 50_000_000 -> 0.9
      total_sp >= 30_000_000 -> 0.8
      total_sp >= 20_000_000 -> 0.7
      total_sp >= 10_000_000 -> 0.6
      total_sp >= 5_000_000 -> 0.5
      true -> 0.3
    end
  end

  @doc """
  Identifies security-related red flags in vetting data.
  """
  def identify_security_red_flags(opsec_assessment, character_metrics) do
    opsec_red_flags =
      opsec_assessment.identified_risks
      |>       Enum.filter(&(&1.severity in [:critical, :high]))
      Enum.map(&format_red_flag/1)

    character_red_flags =
      if character_metrics.security_classification == :high_risk do
        [
          %{
            type: :high_risk_profile,
            description: "Character profile indicates high security risk",
            severity: :high
          }
        ]
      else
        []
      end

    opsec_red_flags ++ character_red_flags
  end

  @doc """
  Identifies positive security indicators.
  """
  def identify_security_green_flags(character_metrics, opsec_assessment) do
    []
    add_low_risk_flag(opsec_assessment.risk_level)
    add_established_character_flag(character_metrics.character_age_days)
    add_normal_progression_flag(character_metrics.sp_security_score)
  end

  # Private helper functions

  defp add_unrealistic_sp_risk(risks, sp_per_day) do
    if sp_per_day > @suspicious_sp_gain do
      [
        %{
          type: :unrealistic_sp_gain,
          severity: :high,
          description: "Unrealistic skill point gain rate indicates potential account trading",
          sp_per_day: Float.round(sp_per_day, 2)
        }
        | risks
      ]
    else
      risks
    end
  end

  defp add_new_character_sp_risk(risks, age_days, total_sp) do
    if age_days < @new_character_threshold and total_sp > 10_000_000 do
      [
        %{
          type: :new_character_high_sp,
          severity: :medium,
          description: "New character with high SP suggests heavy skill injector use",
          age_days: age_days,
          total_sp: total_sp
        }
        | risks
      ]
    else
      risks
    end
  end

  defp add_suspicious_pattern_risk(risks, age_days, sp_per_day) do
    if age_days < @young_character_threshold and sp_per_day > @high_sp_gain do
      [
        %{
          type: :suspicious_skill_pattern,
          severity: :medium,
          description: "Abnormal skill progression pattern",
          pattern: "rapid_progression"
        }
        | risks
      ]
    else
      risks
    end
  end

  defp add_age_based_risks(risks, age_days) do
    cond do
      age_days < 7 ->
        [
          %{
            type: :brand_new_character,
            severity: :high,
            description: "Character less than a week old poses infiltration risk",
            age_days: age_days
          }
          | risks
        ]

      age_days < @new_character_threshold ->
        [
          %{
            type: :new_character,
            severity: :medium,
            description: "New character requires additional vetting",
            age_days: age_days
          }
          | risks
        ]

      true ->
        risks
    end
  end

  defp add_recycled_account_risk(risks, age_days, corp_count) do
    if age_days > @established_character_threshold and corp_count == 1 do
      [
        %{
          type: :potential_recycled_account,
          severity: :low,
          description: "Old character with minimal corporation history",
          pattern: "single_corp_veteran"
        }
        | risks
      ]
    else
      risks
    end
  end

  defp get_mitigation_text(risk) do
    case risk.type do
      :low_security_status -> "Monitor for continued high-sec ganking activity"
      :very_low_security_status -> "Require detailed explanation of criminal activities"
      :unrealistic_sp_gain -> "Verify character legitimacy through additional channels"
      :new_character_high_sp -> "Investigate skill injector usage patterns"
      :brand_new_character -> "Extended probation period with limited access"
      :new_character -> "Standard probation with activity monitoring"
      :spy_corp_history -> "Require additional background verification"
      :suspicious_skill_pattern -> "Review skill training history in detail"
      :potential_recycled_account -> "Verify account ownership and history"
      _ -> "Standard monitoring procedures"
    end
  end

  defp format_red_flag(risk) do
    %{
      type: risk.type,
      severity: risk.severity,
      description: risk.description,
      details: Map.drop(risk, [:type, :severity, :description])
    }
  end

  defp classify_security_profile(age_score, sp_score) do
    combined_updated_score = (age_score + sp_score) / 2

    cond do
      combined_score >= 0.8 -> :low_risk
      combined_score >= 0.6 -> :moderate_risk
      combined_score >= 0.4 -> :elevated_risk
      true -> :high_risk
    end
  end

  defp determine_character_maturity(age_days, total_sp) do
    age_category =
      cond do
        age_days >= @established_character_threshold -> :veteran
        age_days >= 180 -> :experienced
        age_days >= @young_character_threshold -> :developing
        age_days >= @new_character_threshold -> :new
        true -> :fresh
      end

    sp_category =
      cond do
        total_sp >= 50_000_000 -> :advanced
        total_sp >= 20_000_000 -> :intermediate
        total_sp >= 5_000_000 -> :basic
        true -> :minimal
      end

    %{
      age_category: age_category,
      sp_category: sp_category,
      overall: determine_overall_maturity(age_category, sp_category)
    }
  end

  defp determine_overall_maturity(age_category, sp_category) do
    case {age_category, sp_category} do
      {:veteran, :advanced} -> :highly_mature
      {:veteran, _} -> :mature
      {:experienced, :advanced} -> :mature
      {:experienced, :intermediate} -> :developing_mature
      {:developing, _} -> :developing
      {:new, _} -> :novice
      {:fresh, _} -> :unproven
    end
  end

  defp add_low_risk_flag(flags, risk_level) do
    if risk_level in [:minimal, :low] do
      [%{type: :low_risk_profile, description: "Minimal security concerns identified"} | flags]
    else
      flags
    end
  end

  defp add_established_character_flag(flags, age_days) do
    if age_days > @established_character_threshold do
      [
        %{
          type: :established_character,
          description: "Well-established character with long history"
        }
        | flags
      ]
    else
      flags
    end
  end

  defp add_normal_progression_flag(flags, sp_score) do
    if sp_score >= 0.8 do
      [
        %{type: :normal_progression, description: "Normal skill point progression pattern"}
        | flags
      ]
    else
      flags
    end
  end
end
