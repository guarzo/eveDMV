defmodule EveDmv.Contexts.WormholeOperations.Domain.DefenseUtilities do
  @moduledoc """
  Shared utility functions for defense analysis across wormhole operations.

  This module contains pure functions that can be reused across multiple defense
  analyzers, including scoring algorithms, categorization functions, and
  normalization utilities.
  """

  # Defense scoring constants
  @default_base_response_time_minutes 30
  @activity_score_thresholds [
    {100, 1.0},
    {50, 0.8},
    {20, 0.6},
    {10, 0.4},
    {5, 0.2}
  ]
  @availability_score_thresholds [
    {100, 1.0},
    {50, 0.8},
    {25, 0.6},
    {10, 0.4},
    {5, 0.2}
  ]

  # Ship classification constants
  @capital_ship_range 19720..19740
  @battleship_range 600..700
  @cruiser_range 300..400
  @frigate_range 1..100

  # Fleet strength multipliers
  @capital_strength_multiplier 10
  @battleship_strength_multiplier 3
  @cruiser_strength_multiplier 2
  @frigate_strength_multiplier 1

  # Timezone ranges (hours)
  @us_timezone_hours 0..7
  @eu_timezone_hours 8..15
  @asia_timezone_hours 16..23

  # Defense readiness weights
  @defense_readiness_weights %{
    activity: 0.25,
    availability: 0.25,
    timezone: 0.20,
    fleet_readiness: 0.20,
    response: 0.10
  }

  # Strategic importance by wormhole class
  @strategic_importance_by_class %{
    c6: 0.9,
    c5: 0.8,
    c4: 0.7,
    c3: 0.6,
    c2: 0.5,
    c1: 0.4,
    unknown: 0.3
  }

  @doc """
  Categorizes a ship by its type ID into standard ship classes.

  ## Examples

      iex> categorize_ship_type(19725)
      :capital

      iex> categorize_ship_type(650)
      :battleship

      iex> categorize_ship_type(350)
      :cruiser

      iex> categorize_ship_type(50)
      :frigate
  """
  @spec categorize_ship_type(integer()) :: atom()
  def categorize_ship_type(ship_type_id) do
    cond do
      ship_type_id in @capital_ship_range -> :capital
      ship_type_id in @battleship_range -> :battleship
      ship_type_id in @cruiser_range -> :cruiser
      ship_type_id in @frigate_range -> :frigate
      true -> :other
    end
  end

  @doc """
  Calculates recent activity factor based on activity distribution.

  Compares activity in the last 7 days vs total activity period.
  """
  @spec calculate_recent_activity_factor([map()]) :: float()
  def calculate_recent_activity_factor(member_activity) do
    now = DateTime.utc_now()
    seven_days_ago = DateTime.add(now, -7 * 24 * 3600, :second)

    recent_activity =
      Enum.count(member_activity, fn activity ->
        DateTime.compare(activity.killmail_time, seven_days_ago) == :gt
      end)

    total_activity = length(member_activity)

    if total_activity > 0 do
      recent_activity / total_activity
    else
      0.0
    end
  end

  @doc """
  Calculates activity score based on normalized thresholds.
  """
  @spec calculate_activity_score([map()]) :: float()
  def calculate_activity_score(member_activity) do
    activity_count = length(member_activity)
    normalize_score_by_thresholds(activity_count, @activity_score_thresholds)
  end

  @doc """
  Calculates availability score based on ship count thresholds.
  """
  @spec calculate_availability_score([map()]) :: float()
  def calculate_availability_score(member_ships) do
    ship_count = length(member_ships)
    normalize_score_by_thresholds(ship_count, @availability_score_thresholds)
  end

  @doc """
  Categorizes timezone coverage based on active hours.

  Returns coverage breakdown by major timezone regions.
  """
  @spec categorize_timezone_coverage([integer()]) :: map()
  def categorize_timezone_coverage(active_hours) do
    us_tz = Enum.count(active_hours, fn h -> h in @us_timezone_hours end)
    eu_tz = Enum.count(active_hours, fn h -> h in @eu_timezone_hours end)
    asia_tz = Enum.count(active_hours, fn h -> h in @asia_timezone_hours end)

    %{
      us_coverage: us_tz,
      eu_coverage: eu_tz,
      asia_coverage: asia_tz,
      dominant_tz: determine_dominant_timezone(us_tz, eu_tz, asia_tz)
    }
  end

  @doc """
  Determines the dominant timezone based on coverage distribution.
  """
  @spec determine_dominant_timezone(integer(), integer(), integer()) :: atom()
  def determine_dominant_timezone(us, eu, asia) do
    cond do
      us >= eu and us >= asia -> :us
      eu >= us and eu >= asia -> :eu
      asia >= us and asia >= eu -> :asia
      true -> :mixed
    end
  end

  @doc """
  Rates coverage quality based on percentage and hour distribution.
  """
  @spec rate_coverage_quality(float(), [integer()]) :: atom()
  def rate_coverage_quality(coverage_percentage, peak_hours) do
    base_score = coverage_percentage / 100

    # Bonus for distributed peak hours
    hour_distribution = calculate_hour_distribution(peak_hours)
    distribution_bonus = hour_distribution * 0.2

    total_updated_score = base_score + distribution_bonus

    cond do
      total_score >= 0.8 -> :excellent
      total_score >= 0.6 -> :good
      total_score >= 0.4 -> :fair
      total_score >= 0.2 -> :poor
      true -> :critical
    end
  end

  @doc """
  Calculates how evenly distributed hours are across timezone ranges.
  """
  @spec calculate_hour_distribution([integer()]) :: float()
  def calculate_hour_distribution(hours) do
    if Enum.empty?(hours) do
      0.0
    else
      hour_ranges = [@us_timezone_hours, @eu_timezone_hours, @asia_timezone_hours]

      range_counts =
        hour_ranges
        |>         Enum.map(fn range ->
          Enum.count(hours, fn h -> h in range end)
        end)

      # Better distribution = more even spread across ranges
      max_count = Enum.max(range_counts)
      min_count = Enum.min(range_counts)

      if max_count > 0 do
        1.0 - (max_count - min_count) / max_count
      else
        0.0
      end
    end
  end

  @doc """
  Estimates response time based on timezone coverage and activity patterns.
  """
  @spec estimate_response_time([map()], map()) :: integer()
  def estimate_response_time(member_activity, timezone_coverage) do
    # Adjust based on timezone coverage
    coverage_factor =
      case timezone_coverage.coverage_quality do
        :excellent -> 0.7
        :good -> 0.8
        :fair -> 1.0
        :poor -> 1.3
        :critical -> 1.6
      end

    # Adjust based on recent activity
    activity_factor = if length(member_activity) > 100, do: 0.9, else: 1.1

    round(@default_base_response_time_minutes * coverage_factor * activity_factor)
  end

  @doc """
  Categorizes ships by type and returns count distribution.
  """
  @spec categorize_ships([map()]) :: map()
  def categorize_ships(member_ships) do
    member_ships
    |>     Enum.group_by(fn ship ->
      categorize_ship_type(ship.ship_type_id)
    end)
    Enum.map(fn {category, ships} -> {category, length(ships)} end)
    Enum.into(%{})
  end

  @doc """
  Calculates fleet strength based on ship composition.
  """
  @spec calculate_fleet_strength(map()) :: map()
  def calculate_fleet_strength(ship_categories) do
    capital_strength = Map.get(ship_categories, :capital, 0) * @capital_strength_multiplier
    battleship_strength = Map.get(ship_categories, :battleship, 0) * @battleship_strength_multiplier
    cruiser_strength = Map.get(ship_categories, :cruiser, 0) * @cruiser_strength_multiplier
    frigate_strength = Map.get(ship_categories, :frigate, 0) * @frigate_strength_multiplier

    total_strength = capital_strength + battleship_strength + cruiser_strength + frigate_strength

    %{
      total_strength: total_strength,
      ship_categories: ship_categories,
      strength_rating: rate_fleet_strength(total_strength)
    }
  end

  @doc """
  Rates fleet strength based on total calculated strength.
  """
  @spec rate_fleet_strength(integer()) :: atom()
  def rate_fleet_strength(total_strength) do
    cond do
      total_strength >= 200 -> :overwhelming
      total_strength >= 100 -> :strong
      total_strength >= 50 -> :moderate
      total_strength >= 20 -> :weak
      true -> :minimal
    end
  end

  @doc """
  Calculates doctrine coherence based on ship type _frequency distribution.
  """
  @spec calculate_doctrine_coherence(map()) :: float()
  def calculate_doctrine_coherence(type_frequencies) do
    total_ships = type_frequencies |> Map.values() Enum.sum()

    if total_ships > 0 do
      # Find most common ship types
      top_types =
        type_frequencies
        |>         Enum.sort_by(&elem(&1, 1), :desc)
        Enum.take(3)
        |>         Enum.map(&elem(&1, 1))
        Enum.sum()

      coherence = top_types / total_ships
      Float.round(coherence, 2)
    else
      0.0
    end
  end

  @doc """
  Maps ship type IDs to doctrine names.
  """
  @spec get_doctrine_name(integer()) :: String.t()
  def get_doctrine_name(ship_type_id) do
    case categorize_ship_type(ship_type_id) do
      :capital -> "Capital Doctrine"
      :battleship -> "Battleship Doctrine"
      :cruiser -> "Cruiser Doctrine"
      :frigate -> "Frigate Doctrine"
      _ -> "Mixed Doctrine"
    end
  end

  @doc """
  Calculates strategic importance based on wormhole class.
  """
  @spec calculate_strategic_importance(atom()) :: float()
  def calculate_strategic_importance(system_class) do
    Map.get(@strategic_importance_by_class, system_class, 0.3)
  end

  @doc """
  Calculates coverage gap for entry points based on threat level.
  """
  @spec calculate_coverage_gap(map()) :: float()
  def calculate_coverage_gap(entry) do
    base_gap = 0.5

    threat_multiplier =
      case entry.threat_level do
        :high -> 1.5
        :medium -> 1.0
        :low -> 0.7
      end

    Float.round(base_gap * threat_multiplier, 2)
  end

  @doc """
  Calculates vulnerability score based on multiple factors.
  """
  @spec calculate_vulnerability_score(list(), list(), list()) :: float()
  def calculate_vulnerability_score(entry_points, blind_spots, recent_activity) do
    entry_factor = length(entry_points) / 10
    blind_spot_factor = length(blind_spots) / 5
    activity_factor = length(recent_activity) / 100

    vulnerability = (entry_factor + blind_spot_factor + activity_factor) / 3
    min(1.0, vulnerability)
  end

  @doc """
  Assesses route security based on connection count.
  """
  @spec assess_route_security(integer()) :: atom()
  def assess_route_security(connection_count) do
    cond do
      connection_count >= 4 -> :good
      connection_count >= 2 -> :moderate
      connection_count >= 1 -> :poor
      true -> :critical
    end
  end

  @doc """
  Calculates defense readiness using weighted component scores.
  """
  @spec calculate_weighted_defense_readiness(map()) :: float()
  def calculate_weighted_defense_readiness(component_scores) do
    weights = @defense_readiness_weights

    readiness_score =
      Map.get(component_scores, :activity, 0.0) * weights.activity +
        Map.get(component_scores, :availability, 0.0) * weights.availability +
        Map.get(component_scores, :timezone, 0.0) * weights.timezone +
        Map.get(component_scores, :fleet_readiness, 0.0) * weights.fleet_readiness +
        Map.get(component_scores, :response, 0.0) * weights.response

    Float.round(readiness_score, 3)
  end

  @doc """
  Calculates response score based on recent activity factor.
  """
  @spec calculate_response_score([map()]) :: float()
  def calculate_response_score(member_activity) do
    recent_factor = calculate_recent_activity_factor(member_activity)
    min(1.0, recent_factor * 2)
  end

  @doc """
  Converts coverage quality rating to numeric score.
  """
  @spec coverage_quality_to_score(atom()) :: float()
  def coverage_quality_to_score(coverage_quality) do
    case coverage_quality do
      :excellent -> 1.0
      :good -> 0.8
      :fair -> 0.6
      :poor -> 0.4
      :critical -> 0.2
    end
  end

  @doc """
  Converts fleet strength rating to numeric score.
  """
  @spec fleet_strength_to_score(atom()) :: float()
  def fleet_strength_to_score(strength_rating) do
    case strength_rating do
      :overwhelming -> 1.0
      :strong -> 0.8
      :moderate -> 0.6
      :weak -> 0.4
      :minimal -> 0.2
    end
  end

  @doc """
  Converts priority atoms to numeric weights for sorting.
  """
  @spec priority_weight(atom()) :: integer()
  def priority_weight(priority) do
    case priority do
      :critical -> 0
      :high -> 1
      :medium -> 2
      :low -> 3
      _ -> 4
    end
  end

  @doc """
  Assesses threat level based on activity and vulnerability factors.
  """
  @spec assess_threat_level(list(), list()) :: atom()
  def assess_threat_level(system_activity, vulnerabilities) do
    activity_factor = length(system_activity) / 50
    vulnerability_factor = length(vulnerabilities) / 5

    threat_updated_score = (activity_factor + vulnerability_factor) / 2

    cond do
      threat_score >= 0.8 -> :critical
      threat_score >= 0.6 -> :high
      threat_score >= 0.4 -> :moderate
      threat_score >= 0.2 -> :low
      true -> :minimal
    end
  end

  @doc """
  Counts unique active members from activity data.
  """
  @spec count_active_members([map()]) :: integer()
  def count_active_members(member_activity) do
    member_activity
    Enum.map(& &1.character_id)
    Enum.uniq()
    length()
  end

  @doc """
  Counts unique available ships from ship data.
  """
  @spec count_available_ships([map()]) :: integer()
  def count_available_ships(member_ships) do
    member_ships
    Enum.map(& &1.ship_type_id)
    Enum.uniq()
    length()
  end

  @doc """
  Counts recent kills within the last 7 days.
  """
  @spec count_recent_kills([map()]) :: integer()
  def count_recent_kills(system_activity) do
    seven_days_ago = DateTime.add(DateTime.utc_now(), -7 * 24 * 3600, :second)

    Enum.count(system_activity, fn activity ->
      DateTime.compare(activity.killmail_time, seven_days_ago) == :gt
    end)
  end

  @doc """
  Counts unique active corporations from activity data.
  """
  @spec count_active_corporations([map()]) :: integer()
  def count_active_corporations(system_activity) do
    system_activity
    Enum.map(& &1.victim_corporation_id)
    Enum.filter(& &1)
    Enum.uniq()
    length()
  end

  @doc """
  Analyzes activity trend by comparing recent vs older activity.
  """
  @spec analyze_activity_trend([map()]) :: atom()
  def analyze_activity_trend(system_activity) do
    if length(system_activity) < 10 do
      :stable
    else
      recent_half = Enum.take(system_activity, div(length(system_activity), 2))
      older_half = Enum.drop(system_activity, div(length(system_activity), 2))

      if length(recent_half) > length(older_half) do
        :increasing
      else
        :decreasing
      end
    end
  end

  # Private helper functions

  defp normalize_score_by_thresholds(value, thresholds) do
    thresholds
    Enum.find(fn {threshold, _score} -> value >= threshold end)
    case do
      {_threshold, score} -> score
      nil -> 0.0
    end
  end
end
