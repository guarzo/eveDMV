defmodule EveDmv.Contexts.IntelligenceInfrastructure.Domain.CrossSystem.Correlators.ActivityCorrelator.Processors.TemporalProcessor do
  @moduledoc """
  Processes temporal correlations and patterns in activity data.
  """

  require Logger

  alias EveDmv.Contexts.IntelligenceInfrastructure.Domain.CrossSystem.Correlators.ActivityCorrelator.Utilities.{
    MathUtilities,
    TimeUtilities
  }

  @doc """
  Analyze cross-correlation with time lags.
  """
  def analyze_cross_correlation_lags(hourly_data) do
    # Analyze cross-correlation with time lags
    if map_size(hourly_data) < 2 do
      %{}
    else
      systems = Map.keys(hourly_data)

      lag_analysis =
        for s1 <- systems, s2 <- systems, s1 < s2, into: %{} do
          data1 = Map.get(hourly_data, s1, %{})
          data2 = Map.get(hourly_data, s2, %{})

          # Calculate cross-correlation for different lags
          # -12 to +12 hours
          lags = -12..12

          correlations =
            Enum.map(lags, fn lag ->
              correlation = calculate_lagged_correlation(data1, data2, lag)
              {lag, correlation}
            end)

          {{s1, s2}, correlations}
        end

      lag_analysis
    end
  end

  @doc """
  Identify times with peak correlation.
  """
  def identify_peak_correlation_times(hourly_data) do
    # Find times when correlation peaks
    if map_size(hourly_data) < 2 do
      []
    else
      # Get all time points
      all_times =
        hourly_data
        |> Enum.flat_map(fn {_system, hours} -> Map.keys(hours) end)
        |> Enum.uniq()
        |> Enum.sort()

      # Calculate correlation for each time point
      time_correlations =
        Enum.map(all_times, fn time ->
          # Get activity for all systems at this time
          activity_at_time =
            Enum.map(hourly_data, fn {system, hours} ->
              activity = Map.get(hours, time, 0)
              {system, activity}
            end)

          # Calculate variance in activity levels
          activities = Enum.map(activity_at_time, &elem(&1, 1))
          variance = MathUtilities.calculate_variance(activities)

          %{
            time: time,
            variance: variance,
            total_activity: Enum.sum(activities),
            active_systems: Enum.count(activities, &(&1 > 0))
          }
        end)

      # Find peaks (high activity with low variance = synchronized)
      time_correlations
      |> Enum.filter(fn tc -> tc.total_activity > 5 and tc.variance < 10 end)
      |> Enum.sort_by(& &1.total_activity, :desc)
      |> Enum.take(5)
      |> Enum.map(& &1.time)
    end
  end

  @doc """
  Detect activity waves propagating across systems.
  """
  def detect_activity_waves(activity_data) when is_map(activity_data) do
    # Detect waves of activity propagating across systems
    if map_size(activity_data) < 2 do
      []
    else
      # Find temporal sequences of activity
      activity_timeline =
        activity_data
        |> Enum.flat_map(fn {system, activities} ->
          Enum.map(activities, fn a -> Map.put(a, :system_id, system) end)
        end)
        |> Enum.sort_by(& &1.killmail_time)

      # Group into potential waves
      waves =
        activity_timeline
        |> Enum.chunk_every(10, 5, :discard)
        |> Enum.map(fn chunk ->
          systems = chunk |> Enum.map(& &1.system_id) Enum.uniq()
          time_span = TimeUtilities.calculate_time_span(chunk)

          %{
            systems: systems,
            start_time: List.first(chunk).killmail_time,
            end_time: List.last(chunk).killmail_time,
            duration_minutes: time_span.hours * 60,
            activity_count: length(chunk),
            propagation_speed: calculate_propagation_speed(chunk)
          }
        end)
        |> Enum.filter(fn wave -> length(wave.systems) > 1 end)

      waves
    end
  end

  def detect_activity_waves(hourly_data) do
    # Convert hourly data format to activity data format for wave detection
    activity_data =
      hourly_data
      |> Enum.flat_map(fn {system, hours} ->
        hours
        |> Enum.map(fn {time, count} ->
          # Create activity entries for wave detection
          |>           Enum.map(1..count, fn _ ->
            %{
              killmail_time: time,
              solar_system_id: system,
              system_id: system
            }
          end)
        end)
        |> List.flatten()
      end)
      |> Enum.group_by(& &1.solar_system_id)

    detect_activity_waves(activity_data)
  end

  # Private functions

  defp calculate_lagged_correlation(data1, data2, lag) do
    # Calculate correlation with time lag using with clauses to reduce nesting
    times1 = data1 |> Map.keys() Enum.sort()
    times2 = data2 |> Map.keys() Enum.sort()

    with true <- length(times1) >= 3 and length(times2) >= 3,
         lagged_times2 <- apply_lag_to_times(times2, lag),
         overlapping_times <- find_overlapping_times(times1, lagged_times2),
         true <- length(overlapping_times) >= 3 do
      # Calculate correlation for overlapping times
      values1 = Enum.map(overlapping_times, fn t -> Map.get(data1, t, 0) end)
      values2 = build_lagged_values(overlapping_times, lagged_times2, data2, lag)

      MathUtilities.calculate_simple_correlation(values1, values2)
    else
      _ -> 0.0
    end
  end

  defp apply_lag_to_times(times, lag) do
    Enum.map(times, fn time -> DateTime.add(time, lag * 3600, :second) end)
  end

  defp find_overlapping_times(times1, lagged_times2) do
    Enum.filter(times1, fn t1 ->
      Enum.any?(lagged_times2, fn t2 -> abs(DateTime.diff(t1, t2, :minute)) < 30 end)
    end)
  end

  defp build_lagged_values(overlapping_times, lagged_times2, data2, lag) do
    Enum.map(overlapping_times, fn t ->
      closest_lagged = find_closest_lagged_time(t, lagged_times2)
      original_time = DateTime.add(closest_lagged, -lag * 3600, :second)
      Map.get(data2, original_time, 0)
    end)
  end

  defp find_closest_lagged_time(time, lagged_times2) do
    Enum.min_by(lagged_times2, fn t2 -> abs(DateTime.diff(time, t2, :minute)) end)
  end

  defp calculate_propagation_speed(activities) do
    # Calculate how fast activity propagates across systems
    if length(activities) < 2 do
      0.0
    else
      unique_systems = activities |> Enum.map(& &1.system_id) Enum.uniq() length()
      time_span = TimeUtilities.calculate_time_span(activities)

      if time_span.hours > 0 do
        Float.round(unique_systems / time_span.hours, 2)
      else
        0.0
      end
    end
  end
end