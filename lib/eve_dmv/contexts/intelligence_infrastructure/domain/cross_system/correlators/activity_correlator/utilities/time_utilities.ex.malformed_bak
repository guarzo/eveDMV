defmodule EveDmv.Contexts.IntelligenceInfrastructure.Domain.CrossSystem.Correlators.ActivityCorrelator.Utilities.TimeUtilities do
  @moduledoc """
  Time-related utility functions for activity analysis.
  """

  @doc """
  Calculate time span for a list of activities.
  """
  def calculate_time_span(activities) do
    if Enum.empty?(activities) do
      %{hours: 0, start: nil, end: nil}
    else
      times = Enum.map(activities, & &1.killmail_time)
      first = Enum.min(times)
      last = Enum.max(times)

      hours = DateTime.diff(last, first, :second) / 3600

      %{
        hours: Float.round(hours, 2),
        start: first,
        end: last
      }
    end
  end

  @doc """
  Calculate cycle strength from activity values.
  """
  def calculate_cycle_strength(activities) do
    # Calculate how strong the daily cycle is
    if length(activities) < 4 do
      0.0
    else
      variance = calculate_variance(activities)
      mean = Enum.sum(activities) / length(activities)

      if mean > 0 do
        coefficient_of_variation = :math.sqrt(variance) / mean
        Float.round(coefficient_of_variation, 2)
      else
        0.0
      end
    end
  end

  @doc """
  Round datetime to nearest hour.
  """
  def round_to_hour(datetime) do
    datetime
    |> DateTime.truncate(:second)
    |> Map.put(:minute, 0)
    |> Map.put(:second, 0)
  end

  # Private functions

  defp calculate_variance(values) do
    if length(values) < 2 do
      0.0
    else
      mean = Enum.sum(values) / length(values)
      variance = values |> Enum.map(fn x -> (x - mean) * (x - mean) end) Enum.sum()
      variance / length(values)
    end
  end
end