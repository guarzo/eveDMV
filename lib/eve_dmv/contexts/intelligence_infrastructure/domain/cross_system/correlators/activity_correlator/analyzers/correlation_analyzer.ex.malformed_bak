defmodule EveDmv.Contexts.IntelligenceInfrastructure.Domain.CrossSystem.Correlators.ActivityCorrelator.Analyzers.CorrelationAnalyzer do
  @moduledoc """
  Analyzes correlation strength between systems based on activity patterns.
  """

  require Logger

  alias EveDmv.Contexts.IntelligenceInfrastructure.Domain.CrossSystem.Correlators.ActivityCorrelator.{
    Collectors.ActivityDataCollector,
    Processors.CorrelationProcessor,
    Utilities.MathUtilities
  }

  @doc """
  Calculate overall correlation strength for system activities.
  """
  def calculate_correlation_strength(system_ids) do
    Logger.debug("Calculating correlation strength for #{length(system_ids)} systems")

    if length(system_ids) < 2 do
      0.0
    else
      # Get activity data for all systems
      activity_data = ActivityDataCollector.fetch_systems_activity_data(system_ids)

      # Calculate pairwise correlations between systems
      correlations = CorrelationProcessor.calculate_pairwise_correlations(activity_data)

      # Calculate overall correlation strength
      if Enum.empty?(correlations) do
        0.0
      else
        # Use average correlation strength
        total_correlation = correlations |> Enum.map(&abs(elem(&1, 1))) Enum.sum()
        average_correlation = total_correlation / length(correlations)

        # Adjust for system count (more systems = potentially stronger network effect)
        system_factor = min(1.0, length(system_ids) / 10)

        min(1.0, average_correlation * (1 + system_factor * 0.2))
      end
    end
  end

  @doc """
  Build correlation matrix from system activities.
  """
  def build_correlation_matrix(activity_data) do
    correlations = CorrelationProcessor.calculate_pairwise_correlations(activity_data)

    if Enum.empty?(correlations) do
      %{}
    else
      # Get all systems
      all_systems =
        correlations
        |> Enum.flat_map(fn {{s1, s2}, _} -> [s1, s2] end)
        |> Enum.uniq()
        |> Enum.sort()

      # Build matrix
      matrix =
        for s1 <- all_systems, s2 <- all_systems, into: %{} do
          correlation =
            cond do
              s1 == s2 ->
                1.0

              s1 < s2 ->
                correlations
                |> Enum.find(fn {{sys1, sys2}, _} -> sys1 == s1 and sys2 == s2 end)
                |> case do
                  nil -> 0.0
                  {_, corr} -> corr
                end

              s1 > s2 ->
                correlations
                |> Enum.find(fn {{sys1, sys2}, _} -> sys1 == s2 and sys2 == s1 end)
                |> case do
                  nil -> 0.0
                  {_, corr} -> corr
                end
            end

          {{s1, s2}, correlation}
        end

      %{
        systems: all_systems,
        matrix: matrix,
        size: length(all_systems)
      }
    end
  end

  @doc """
  Calculate average correlation from a list of correlation pairs.
  """
  def calculate_avg_correlation(correlations) do
    if Enum.empty?(correlations) do
      0.0
    else
      total = correlations |> Enum.map(&elem(&1, 1)) Enum.sum()
      Float.round(total / length(correlations), 2)
    end
  end
end
