defmodule EveDmv.Contexts.IntelligenceInfrastructure.Domain.CrossSystem.Correlators.ActivityCorrelator.Processors.CorrelationProcessor do
  @moduledoc """
  Processes correlation calculations between system activities.
  """

  alias EveDmv.Contexts.IntelligenceInfrastructure.Domain.CrossSystem.Correlators.ActivityCorrelator.Utilities.MathUtilities

  @doc """
  Calculate pairwise correlations between systems.
  """
  def calculate_pairwise_correlations(activity_data) do
    # Calculate correlation coefficients between system pairs
    systems = Map.keys(activity_data)

    if length(systems) < 2 do
      []
    else
      for s1 <- systems, s2 <- systems, s1 < s2 do
        data1 = Map.get(activity_data, s1, [])
        data2 = Map.get(activity_data, s2, [])

        correlation = calculate_correlation_coefficient(data1, data2)
        {{s1, s2}, correlation}
      end
    end
  end

  @doc """
  Build correlation matrix from pairwise correlations.
  """
  def build_correlation_matrix(activity_data) do
    correlations = calculate_pairwise_correlations(activity_data)

    if Enum.empty?(correlations) do
      %{}
    else
      # Get all systems
      all_systems =
        correlations
        |> Enum.flat_map(fn {{s1, s2}, _} -> [s1, s2] end)
        |> Enum.uniq()
        |> Enum.sort()

      # Build matrix
      matrix =
        for s1 <- all_systems, s2 <- all_systems, into: %{} do
          correlation =
            cond do
              s1 == s2 ->
                1.0

              s1 < s2 ->
                correlations
                |> Enum.find(fn {{sys1, sys2}, _} -> sys1 == s1 and sys2 == s2 end)
                |> case do
                  nil -> 0.0
                  {_, corr} -> corr
                end

              s1 > s2 ->
                correlations
                |> Enum.find(fn {{sys1, sys2}, _} -> sys1 == s2 and sys2 == s1 end)
                |> case do
                  nil -> 0.0
                  {_, corr} -> corr
                end
            end

          {{s1, s2}, correlation}
        end

      %{
        systems: all_systems,
        matrix: matrix,
        size: length(all_systems)
      }
    end
  end

  # Private functions

  defp calculate_correlation_coefficient(data1, data2) do
    # Calculate Pearson correlation coefficient
    if length(data1) < 3 or length(data2) < 3 do
      0.0
    else
      # Align data by timestamp
      {aligned1, aligned2} = align_by_timestamp(data1, data2)

      if length(aligned1) < 3 do
        0.0
      else
        # Extract activity counts from aligned data
        values1 = Enum.map(aligned1, &(&1.attacker_count || 1))
        values2 = Enum.map(aligned2, &(&1.attacker_count || 1))

        # Calculate correlation using math utilities
        MathUtilities.calculate_simple_correlation(values1, values2)
      end
    end
  end

  defp align_by_timestamp(data1, data2) do
    # Create maps indexed by rounded timestamp for efficient lookup
    map1 =
      Enum.into(data1, %{}, fn item ->
        # Round to nearest hour for alignment
        rounded_time =
          item.killmail_time
          |> DateTime.truncate(:second)
          |> Map.put(:minute, 0)
          |> Map.put(:second, 0)

        {rounded_time, item}
      end)

    map2 =
      Enum.into(data2, %{}, fn item ->
        rounded_time =
          item.killmail_time
          |> DateTime.truncate(:second)
          |> Map.put(:minute, 0)
          |> Map.put(:second, 0)

        {rounded_time, item}
      end)

    # Find common timestamps
    common_times =
      map1
      |> Map.keys()
      |> MapSet.new()
      |> MapSet.intersection(MapSet.new(Map.keys(map2)))
      |> Enum.sort()

    # Extract aligned data
    aligned1 = Enum.map(common_times, &Map.get(map1, &1))
    aligned2 = Enum.map(common_times, &Map.get(map2, &1))

    {aligned1, aligned2}
  end
end