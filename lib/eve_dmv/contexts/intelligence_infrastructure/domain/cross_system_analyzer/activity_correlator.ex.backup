defmodule EveDmv.Contexts.IntelligenceInfrastructure.Domain.CrossSystemAnalyzer.ActivityCorrelator do
  @moduledoc """
  Analyzes and correlates activities across multiple systems.

  Handles:
  - Temporal correlation analysis
  - Activity pattern detection
  - Cross-system movement tracking
  - Corporation behavior analysis
  - Synchronized activity detection
  """

  alias EveDmv.Api
  alias EveDmv.Killmails.KillmailRaw

  require Logger

  # Correlation thresholds
  @min_correlation_threshold 0.7
  @high_correlation_threshold 0.85
  @min_activity_overlap 0.6
  @temporal_window_minutes 30

  @doc """
  Fetches activity data for multiple systems within a time window.
  """
  def fetch_system_activities(system_ids, time_window_hours) do
    since = DateTime.utc_now() |> DateTime.add(-time_window_hours * 3600, :second)

    activities =
      Enum.map(system_ids, fn system_id ->
        case get_system_killmails(system_id, since) do
          {:ok, killmails} ->
            %{
              system_id: system_id,
              activities: process_killmail_activities(killmails),
              pilot_activity: extract_pilot_activity_data(killmails),
              corp_activity: extract_corp_activity_data(killmails),
              ship_activity: extract_ship_activity_data(killmails),
              temporal_markers: extract_temporal_markers(killmails)
            }

          {:error, _reason} ->
            %{
              system_id: system_id,
              activities: [],
              pilot_activity: %{},
              corp_activity: %{},
              ship_activity: %{},
              temporal_markers: []
            }
        end
      end)

    {:ok, activities}
  end

  @doc """
  Builds an activity timeline from system activities.
  """
  def build_activity_timeline(system_activities) do
    timeline =
      system_activities
      |> Enum.flat_map(fn system_data ->
        Enum.map(system_data.activities, fn activity ->
          Map.put(activity, :system_id, system_data.system_id)
        end)
      end)
      |> Enum.sort_by(& &1.timestamp, DateTime)

    %{
      events: timeline,
      duration: calculate_timeline_duration(timeline),
      event_density: calculate_event_density(timeline),
      peak_periods: identify_peak_activity_periods(timeline)
    }
  end

  @doc """
  Analyzes temporal correlations between system activities.
  """
  def analyze_temporal_correlations(activity_timeline) do
    systems = extract_unique_systems(activity_timeline.events)

    correlations =
      for s1 <- systems, s2 <- systems, s1 < s2 do
        s1_events = filter_events_by_system(activity_timeline.events, s1)
        s2_events = filter_events_by_system(activity_timeline.events, s2)

        correlation = calculate_temporal_correlation(s1_events, s2_events)

        %{
          system_pair: {s1, s2},
          correlation_coefficient: correlation.coefficient,
          lag_correlation: correlation.lag,
          confidence: correlation.confidence,
          pattern_type: classify_correlation_pattern(correlation)
        }
      end

    %{
      correlations: correlations,
      strong_correlations: filter_strong_correlations(correlations),
      correlation_clusters: identify_correlation_clusters(correlations),
      overall_correlation_strength: calculate_average_correlation_strength(correlations)
    }
  end

  @doc """
  Tracks pilot movements across systems.
  """
  def track_pilot_movements(system_activities) do
    pilot_movements =
      system_activities
      |> extract_pilot_activities()
      |> group_by_pilot()
      |> analyze_pilot_movements()

    %{
      total_pilots_tracked: Kernel.map_size(pilot_movements),
      movement_patterns: pilot_movements,
      coordinated_movements: identify_coordinated_movement_patterns(pilot_movements),
      movement_statistics: calculate_movement_statistics(pilot_movements)
    }
  end

  @doc """
  Analyzes corporation activities across systems.
  """
  def analyze_corp_activities(system_activities) do
    corp_data =
      system_activities
      |> extract_corp_activities()
      |> group_by_corp()

    corp_analysis =
      Enum.map(corp_data, fn {corp_id, activities} ->
        {corp_id, analyze_corp_cross_system_behavior(corp_id, activities)}
      end)
      |> Enum.into(%{})

    %{
      total_corps_analyzed: Kernel.map_size(corp_analysis),
      corp_behaviors: corp_analysis,
      alliance_patterns: extract_alliance_patterns(corp_analysis),
      conflict_zones: identify_potential_conflicts(corp_analysis)
    }
  end

  @doc """
  Identifies activity bursts across systems.
  """
  def identify_activity_bursts(timeline_events) do
    events_by_window = group_events_by_time_window(timeline_events, @temporal_window_minutes)

    bursts =
      events_by_window
      |> Enum.filter(fn {_window, events} ->
        # Minimum events for a burst
        Kernel.length(events) >= 5
      end)
      |> Enum.map(fn {window_start, events} ->
        analyze_burst(window_start, events)
      end)

    %{
      total_bursts: Kernel.length(bursts),
      burst_details: bursts,
      synchronized_bursts: identify_synchronized_bursts(bursts),
      burst_patterns: categorize_burst_patterns(bursts)
    }
  end

  # Private functions

  defp get_system_killmails(system_id, since) do
    # Query actual killmail data from the database
    try do
      killmails =
        Api.read!(KillmailRaw,
          filter: [
            solar_system_id: system_id,
            timestamp: [greater_than: since]
          ],
          limit: 1000
        )

      {:ok, killmails}
    rescue
      e -> {:error, e}
    end
  end

  defp process_killmail_activities(killmails) do
    Enum.map(killmails, fn km ->
      %{
        killmail_id: km.killmail_id,
        timestamp: km.timestamp,
        activity_type: classify_activity_type(km),
        participants: count_participants(km),
        total_value: km.total_value || 0,
        ship_types_involved: extract_ship_types_from_killmail(km)
      }
    end)
  end

  defp classify_activity_type(killmail) do
    participant_count = count_participants(killmail)

    cond do
      participant_count <= 2 -> :solo_combat
      participant_count <= 5 -> :small_gang
      participant_count <= 15 -> :medium_fleet
      true -> :large_fleet
    end
  end

  defp count_participants(killmail) do
    case killmail.zkb_data do
      %{"attackers" => attackers} when is_list(attackers) ->
        # +1 for victim
        Kernel.length(attackers) + 1

      _ ->
        # Default minimum
        2
    end
  end

  defp extract_pilot_activity_data(killmails) do
    killmails
    |> Enum.flat_map(&extract_all_participants_from_killmail/1)
    |> Enum.group_by(& &1.character_id)
    |> Enum.map(fn {pilot_id, participations} ->
      {pilot_id, analyze_pilot_activity_pattern(participations)}
    end)
    |> Enum.into(%{})
  end

  defp extract_all_participants_from_killmail(killmail) do
    victim = [
      %{
        character_id: killmail.victim_character_id,
        corporation_id: killmail.victim_corporation_id,
        ship_type_id: killmail.victim_ship_type_id,
        timestamp: killmail.timestamp,
        role: :victim
      }
    ]

    attackers =
      case killmail.zkb_data do
        %{"attackers" => attackers} when is_list(attackers) ->
          Enum.map(attackers, fn attacker ->
            %{
              character_id: attacker["character_id"],
              corporation_id: attacker["corporation_id"],
              ship_type_id: attacker["ship_type_id"],
              timestamp: killmail.timestamp,
              role: :attacker
            }
          end)

        _ ->
          []
      end

    victim ++ attackers
  end

  defp extract_corp_activity_data(killmails) do
    killmails
    |> Enum.flat_map(&extract_corp_ids_from_killmail/1)
    |> Enum.group_by(& &1.corporation_id)
    |> Enum.map(fn {corp_id, participations} ->
      {corp_id,
       %{
         total_engagements: Kernel.length(participations),
         activity_times: Enum.map(participations, & &1.timestamp),
         engagement_types: classify_corp_engagements(participations)
       }}
    end)
    |> Enum.into(%{})
  end

  defp extract_corp_ids_from_killmail(killmail) do
    victim_corp = [
      %{
        corporation_id: killmail.victim_corporation_id,
        timestamp: killmail.timestamp,
        role: :victim
      }
    ]

    attacker_corps =
      case killmail.zkb_data do
        %{"attackers" => attackers} when is_list(attackers) ->
          attackers
          |> Enum.map(fn a ->
            %{
              corporation_id: a["corporation_id"],
              timestamp: killmail.timestamp,
              role: :attacker
            }
          end)
          |> Enum.filter(& &1.corporation_id)

        _ ->
          []
      end

    victim_corp ++ attacker_corps
  end

  defp extract_ship_activity_data(killmails) do
    killmails
    |> Enum.flat_map(&extract_ship_types_from_killmail/1)
    |> Enum.frequencies()
    |> Enum.map(fn {ship_type_id, count} ->
      {ship_type_id,
       %{
         usage_count: count,
         classification: classify_ship_type(ship_type_id)
       }}
    end)
    |> Enum.into(%{})
  end

  defp extract_ship_types_from_killmail(killmail) do
    victim_ship = [killmail.victim_ship_type_id]

    attacker_ships =
      case killmail.zkb_data do
        %{"attackers" => attackers} when is_list(attackers) ->
          attackers
          |> Enum.map(& &1["ship_type_id"])
          |> Enum.filter(& &1)

        _ ->
          []
      end

    victim_ship ++ attacker_ships
  end

  defp extract_temporal_markers(killmails) do
    killmails
    |> Enum.map(& &1.timestamp)
    |> Enum.sort(DateTime)
    |> identify_temporal_patterns()
  end

  defp identify_temporal_patterns(timestamps) do
    case timestamps do
      [] ->
        []

      [_] ->
        []

      _ ->
        gaps = calculate_time_gaps(timestamps)

        %{
          average_gap_minutes: calculate_average_gap(gaps),
          burst_periods: identify_burst_periods(timestamps),
          quiet_periods: identify_quiet_periods(gaps),
          periodicity: detect_periodicity(gaps)
        }
    end
  end

  defp calculate_time_gaps([]), do: []
  defp calculate_time_gaps([_]), do: []

  defp calculate_time_gaps([t1, t2 | rest]) do
    # Convert to minutes
    gap = DateTime.diff(t2, t1, :second) / 60
    [gap | calculate_time_gaps([t2 | rest])]
  end

  defp calculate_average_gap([]), do: 0

  defp calculate_average_gap(gaps) do
    Enum.sum(gaps) / Kernel.length(gaps)
  end

  defp identify_burst_periods(timestamps) do
    # Group timestamps into bursts (events within 30 minutes of each other)
    chunk_fun = fn timestamp, acc ->
      case acc do
        [] ->
          {:cont, [timestamp]}

        [last | _] = chunk ->
          if DateTime.diff(timestamp, last, :minute) <= @temporal_window_minutes do
            {:cont, [timestamp | chunk]}
          else
            {:cont, Enum.reverse(chunk), [timestamp]}
          end
      end
    end

    after_fun = fn
      [] -> {:cont, []}
      acc -> {:cont, Enum.reverse(acc), []}
    end

    timestamps
    |> Enum.chunk_while([], chunk_fun, after_fun)
    |> Enum.filter(fn chunk -> Kernel.length(chunk) >= 3 end)
    |> Enum.map(fn chunk ->
      %{
        start_time: List.first(chunk),
        end_time: List.last(chunk),
        event_count: Kernel.length(chunk),
        intensity:
          Kernel.length(chunk) / (DateTime.diff(List.last(chunk), List.first(chunk), :minute) + 1)
      }
    end)
  end

  defp identify_quiet_periods(gaps) do
    gaps
    |> Enum.with_index()
    # 2+ hour gaps
    |> Enum.filter(fn {gap, _} -> gap >= 120 end)
    |> Enum.map(fn {gap, index} ->
      %{
        gap_index: index,
        duration_hours: gap / 60,
        significance: classify_gap_significance(gap)
      }
    end)
  end

  defp classify_gap_significance(gap_minutes) do
    cond do
      # 8+ hours
      gap_minutes >= 480 -> :major
      # 4+ hours
      gap_minutes >= 240 -> :moderate
      true -> :minor
    end
  end

  defp detect_periodicity(gaps) do
    # Simple periodicity detection
    if Kernel.length(gaps) < 10 do
      :insufficient_data
    else
      avg_gap = calculate_average_gap(gaps)
      variance = calculate_variance(gaps, avg_gap)
      cv = :math.sqrt(variance) / avg_gap

      cond do
        cv < 0.3 -> :highly_periodic
        cv < 0.6 -> :moderately_periodic
        cv < 1.0 -> :weakly_periodic
        true -> :non_periodic
      end
    end
  end

  defp calculate_variance(values, mean) do
    sum_squared_diff =
      values
      |> Enum.map(fn v -> :math.pow(v - mean, 2) end)
      |> Enum.sum()

    sum_squared_diff / Kernel.length(values)
  end

  defp calculate_timeline_duration([]), do: 0

  defp calculate_timeline_duration(events) do
    first = List.first(events)
    last = List.last(events)
    DateTime.diff(last.timestamp, first.timestamp, :hour)
  end

  defp calculate_event_density([]), do: 0

  defp calculate_event_density(events) do
    duration_hours = calculate_timeline_duration(events)

    if duration_hours > 0 do
      Kernel.length(events) / duration_hours
    else
      Kernel.length(events)
    end
  end

  defp identify_peak_activity_periods(events) do
    events
    |> group_events_by_hour()
    |> Enum.sort_by(fn {_, count} -> -count end)
    |> Enum.take(5)
    |> Enum.map(fn {hour, count} ->
      %{
        hour: hour,
        event_count: count,
        percentage_of_total: Float.round(count * 100 / Kernel.length(events), 1)
      }
    end)
  end

  defp group_events_by_hour(events) do
    events
    |> Enum.group_by(fn event ->
      event.timestamp.hour
    end)
    |> Enum.map(fn {hour, hour_events} ->
      {hour, Kernel.length(hour_events)}
    end)
    |> Enum.into(%{})
  end

  defp extract_unique_systems(events) do
    events
    |> Enum.map(& &1.system_id)
    |> Enum.uniq()
    |> Enum.sort()
  end

  defp filter_events_by_system(events, system_id) do
    Enum.filter(events, &(&1.system_id == system_id))
  end

  defp calculate_temporal_correlation(events1, events2) do
    if Kernel.length(events1) < 3 or Kernel.length(events2) < 3 do
      %{coefficient: 0.0, lag: 0, confidence: 0.0}
    else
      # Build time series for correlation
      series1 = build_time_series(events1)
      series2 = build_time_series(events2)

      # Calculate correlation at different lags
      correlations =
        for lag <- -5..5 do
          {lag, calculate_lag_correlation(series1, series2, lag)}
        end

      # Find best correlation
      {best_lag, best_correlation} = Enum.max_by(correlations, fn {_, corr} -> abs(corr) end)

      %{
        coefficient: Float.round(best_correlation, 3),
        lag: best_lag,
        confidence: calculate_correlation_confidence(events1, events2)
      }
    end
  end

  defp build_time_series(events) do
    # Convert events to hourly time series
    events
    |> Enum.group_by(fn event ->
      DateTime.truncate(event.timestamp, :hour)
    end)
    |> Enum.map(fn {hour, hour_events} ->
      {hour, Kernel.length(hour_events)}
    end)
    |> Enum.sort_by(fn {hour, _} -> hour end, DateTime)
  end

  defp calculate_lag_correlation(series1, series2, lag) do
    # Apply lag to series2
    lagged_series2 =
      if lag >= 0 do
        Enum.drop(series2, lag)
      else
        # Negative lag means series2 leads series1
        [{nil, 0} | series2]
        |> Enum.take(Kernel.length(series2) + lag)
      end

    # Align series
    min_length = min(Kernel.length(series1), Kernel.length(lagged_series2))
    aligned_series1 = Enum.take(series1, min_length)
    aligned_series2 = Enum.take(lagged_series2, min_length)

    # Calculate Pearson correlation
    values1 = Enum.map(aligned_series1, fn {_, count} -> count end)
    values2 = Enum.map(aligned_series2, fn {_, count} -> count end)

    calculate_pearson_correlation(values1, values2)
  end

  defp calculate_pearson_correlation(values1, values2) do
    n = Kernel.length(values1)

    if n < 2 do
      0.0
    else
      mean1 = Enum.sum(values1) / n
      mean2 = Enum.sum(values2) / n

      covariance =
        Enum.zip(values1, values2)
        |> Enum.map(fn {v1, v2} -> (v1 - mean1) * (v2 - mean2) end)
        |> Enum.sum()

      std1 = :math.sqrt(Enum.sum(Enum.map(values1, fn v -> :math.pow(v - mean1, 2) end)) / n)
      std2 = :math.sqrt(Enum.sum(Enum.map(values2, fn v -> :math.pow(v - mean2, 2) end)) / n)

      if std1 * std2 == 0 do
        0.0
      else
        covariance / (n * std1 * std2)
      end
    end
  end

  defp calculate_correlation_confidence(events1, events2) do
    sample_size = min(Kernel.length(events1), Kernel.length(events2))
    overlap_ratio = calculate_temporal_overlap(events1, events2)

    # Confidence based on sample size and temporal overlap
    size_factor = min(1.0, sample_size / 20)
    overlap_factor = overlap_ratio

    Float.round(size_factor * overlap_factor, 2)
  end

  defp calculate_temporal_overlap(events1, events2) do
    times1 = MapSet.new(events1, &DateTime.truncate(&1.timestamp, :hour))
    times2 = MapSet.new(events2, &DateTime.truncate(&1.timestamp, :hour))

    intersection_size = MapSet.intersection(times1, times2) |> MapSet.size()
    union_size = MapSet.union(times1, times2) |> MapSet.size()

    if union_size == 0, do: 0.0, else: intersection_size / union_size
  end

  defp classify_correlation_pattern(correlation) do
    cond do
      correlation.coefficient >= @high_correlation_threshold ->
        if correlation.lag == 0, do: :synchronized, else: :sequential

      correlation.coefficient >= @min_correlation_threshold ->
        :correlated

      correlation.coefficient <= -@min_correlation_threshold ->
        :anti_correlated

      true ->
        :uncorrelated
    end
  end

  defp filter_strong_correlations(correlations) do
    Enum.filter(correlations, fn corr ->
      abs(corr.correlation_coefficient) >= @min_correlation_threshold
    end)
  end

  defp identify_correlation_clusters(correlations) do
    # Group systems that are all correlated with each other
    strong_pairs =
      correlations
      |> filter_strong_correlations()
      |> Enum.map(& &1.system_pair)

    # Build adjacency list
    graph =
      Enum.reduce(strong_pairs, %{}, fn {s1, s2}, acc ->
        acc
        |> Map.update(s1, [s2], &[s2 | &1])
        |> Map.update(s2, [s1], &[s1 | &1])
      end)

    # Find connected components
    find_connected_components(graph)
  end

  defp find_connected_components(graph) do
    nodes = Map.keys(graph)
    find_components(nodes, graph, [])
  end

  defp find_components([], _graph, components), do: components

  defp find_components([node | rest], graph, components) do
    {component, remaining} = explore_component(node, graph, MapSet.new(), rest)

    if MapSet.size(component) > 1 do
      find_components(remaining, graph, [MapSet.to_list(component) | components])
    else
      find_components(remaining, graph, components)
    end
  end

  defp explore_component(node, graph, visited, unvisited) do
    if MapSet.member?(visited, node) or node not in unvisited do
      {visited, unvisited}
    else
      visited = MapSet.put(visited, node)
      unvisited = List.delete(unvisited, node)

      neighbors = Map.get(graph, node, [])

      Enum.reduce(neighbors, {visited, unvisited}, fn neighbor, {vis, unvis} ->
        explore_component(neighbor, graph, vis, unvis)
      end)
    end
  end

  defp calculate_average_correlation_strength(correlations) do
    if Enum.empty?(correlations) do
      0.0
    else
      total =
        correlations
        |> Enum.map(&abs(&1.correlation_coefficient))
        |> Enum.sum()

      Float.round(total / Kernel.length(correlations), 3)
    end
  end

  defp extract_pilot_activities(system_activities) do
    system_activities
    |> Enum.flat_map(fn system ->
      Enum.map(system.pilot_activity, fn {pilot_id, activity} ->
        {pilot_id, Map.put(activity, :system_id, system.system_id)}
      end)
    end)
  end

  defp group_by_pilot(pilot_activities) do
    pilot_activities
    |> Enum.group_by(fn {pilot_id, _} -> pilot_id end)
    |> Enum.map(fn {pilot_id, activities} ->
      {pilot_id, Enum.map(activities, fn {_, activity} -> activity end)}
    end)
    |> Enum.into(%{})
  end

  defp analyze_pilot_movements(grouped_pilot_data) do
    Enum.map(grouped_pilot_data, fn {pilot_id, activities} ->
      {pilot_id, analyze_pilot_movement_pattern(pilot_id, activities)}
    end)
    |> Enum.into(%{})
  end

  defp analyze_pilot_movement_pattern(pilot_id, activities) do
    sorted_activities = Enum.sort_by(activities, & &1.last_seen, DateTime)

    systems_visited =
      activities
      |> Enum.map(& &1.system_id)
      |> Enum.uniq()

    %{
      pilot_id: pilot_id,
      systems_visited: systems_visited,
      system_count: Kernel.length(systems_visited),
      movement_sequence: extract_movement_sequence(sorted_activities),
      movement_velocity: calculate_movement_velocity(sorted_activities),
      preferred_systems: identify_preferred_systems(activities),
      movement_pattern_type: classify_movement_pattern(activities)
    }
  end

  defp extract_movement_sequence(sorted_activities) do
    sorted_activities
    |> Enum.map(& &1.system_id)
    |> Enum.chunk_every(2, 1, :discard)
    |> Enum.filter(fn [s1, s2] -> s1 != s2 end)
    |> Enum.map(fn [from, to] -> %{from: from, to: to} end)
  end

  defp calculate_movement_velocity(activities) do
    case activities do
      [] ->
        0.0

      [_] ->
        0.0

      _ ->
        first = List.first(activities)
        last = List.last(activities)

        time_span_hours = DateTime.diff(last.last_seen, first.last_seen, :hour)
        system_changes = Kernel.length(extract_movement_sequence(activities))

        if time_span_hours > 0 do
          Float.round(system_changes / time_span_hours, 2)
        else
          0.0
        end
    end
  end

  defp identify_preferred_systems(activities) do
    activities
    |> Enum.group_by(& &1.system_id)
    |> Enum.map(fn {system_id, system_activities} ->
      {system_id,
       %{
         visit_count: Kernel.length(system_activities),
         total_kills: Enum.sum(Enum.map(system_activities, & &1.kill_count)),
         total_deaths: Enum.sum(Enum.map(system_activities, & &1.death_count))
       }}
    end)
    |> Enum.sort_by(fn {_, stats} -> -stats.visit_count end)
    |> Enum.take(3)
  end

  defp classify_movement_pattern(activities) do
    system_count = activities |> Enum.map(& &1.system_id) |> Enum.uniq() |> Kernel.length()
    activity_count = Kernel.length(activities)

    cond do
      system_count == 1 -> :stationary
      system_count == 2 and activity_count >= 5 -> :binary_patrol
      system_count >= activity_count * 0.8 -> :nomadic
      system_count <= 3 -> :territorial
      true -> :roaming
    end
  end

  defp identify_coordinated_movement_patterns(pilot_movements) do
    # Find pilots who move together
    movement_pairs =
      for {p1, m1} <- pilot_movements,
          {p2, m2} <- pilot_movements,
          p1 < p2 do
        overlap = calculate_movement_overlap(m1, m2)

        if overlap >= @min_activity_overlap do
          %{
            pilots: [p1, p2],
            overlap_ratio: overlap,
            common_systems: find_common_systems(m1, m2),
            synchronization_score: calculate_sync_score(m1, m2)
          }
        else
          nil
        end
      end

    movement_pairs
    |> Enum.filter(& &1)
    |> group_coordinated_movements()
  end

  defp calculate_movement_overlap(movement1, movement2) do
    systems1 = MapSet.new(movement1.systems_visited)
    systems2 = MapSet.new(movement2.systems_visited)

    intersection = MapSet.intersection(systems1, systems2) |> MapSet.size()
    union = MapSet.union(systems1, systems2) |> MapSet.size()

    if union == 0, do: 0.0, else: intersection / union
  end

  defp find_common_systems(movement1, movement2) do
    systems1 = MapSet.new(movement1.systems_visited)
    systems2 = MapSet.new(movement2.systems_visited)

    MapSet.intersection(systems1, systems2) |> MapSet.to_list()
  end

  defp calculate_sync_score(movement1, movement2) do
    # Simple synchronization score based on movement patterns
    pattern_match =
      if movement1.movement_pattern_type == movement2.movement_pattern_type, do: 0.5, else: 0.0

    velocity_similarity =
      1.0 -
        abs(movement1.movement_velocity - movement2.movement_velocity) /
          max_value(movement1.movement_velocity, movement2.movement_velocity, 1.0)

    Float.round((pattern_match + velocity_similarity) / 2, 2)
  end

  defp group_coordinated_movements(movement_pairs) do
    # Group pilots who all move together
    movement_pairs
    |> Enum.reduce([], fn pair, groups ->
      matching_group =
        Enum.find_index(groups, fn group ->
          Enum.any?(group.pilots, fn pilot -> pilot in pair.pilots end)
        end)

      case matching_group do
        nil ->
          [pair | groups]

        index ->
          List.update_at(groups, index, fn group ->
            %{
              group
              | pilots: Enum.uniq(group.pilots ++ pair.pilots),
                overlap_ratio: min(group.overlap_ratio, pair.overlap_ratio)
            }
          end)
      end
    end)
  end

  defp calculate_movement_statistics(pilot_movements) do
    all_movements = Map.values(pilot_movements)

    %{
      average_systems_visited: calculate_average_systems_visited(all_movements),
      movement_pattern_distribution: calculate_pattern_distribution(all_movements),
      average_movement_velocity: calculate_average_velocity(all_movements),
      common_routes: identify_common_routes(all_movements)
    }
  end

  defp calculate_average_systems_visited(movements) do
    if Enum.empty?(movements) do
      0.0
    else
      total = Enum.sum(Enum.map(movements, & &1.system_count))
      Float.round(total / Kernel.length(movements), 1)
    end
  end

  defp calculate_pattern_distribution(movements) do
    movements
    |> Enum.map(& &1.movement_pattern_type)
    |> Enum.frequencies()
  end

  defp calculate_average_velocity(movements) do
    velocities = Enum.map(movements, & &1.movement_velocity)

    if Enum.empty?(velocities) do
      0.0
    else
      Float.round(Enum.sum(velocities) / Kernel.length(velocities), 2)
    end
  end

  defp identify_common_routes(movements) do
    movements
    |> Enum.flat_map(& &1.movement_sequence)
    |> Enum.frequencies()
    |> Enum.sort_by(fn {_, count} -> -count end)
    |> Enum.take(10)
    |> Enum.map(fn {route, count} ->
      %{
        route: route,
        usage_count: count,
        pilots_using: count_pilots_using_route(movements, route)
      }
    end)
  end

  defp count_pilots_using_route(movements, route) do
    movements
    |> Enum.count(fn movement ->
      Enum.any?(movement.movement_sequence, fn seq ->
        seq.from == route.from and seq.to == route.to
      end)
    end)
  end

  defp extract_corp_activities(system_activities) do
    system_activities
    |> Enum.flat_map(fn system ->
      Enum.map(system.corp_activity, fn {corp_id, activity} ->
        {corp_id, Map.put(activity, :system_id, system.system_id)}
      end)
    end)
  end

  defp group_by_corp(corp_activities) do
    corp_activities
    |> Enum.group_by(fn {corp_id, _} -> corp_id end)
    |> Enum.map(fn {corp_id, activities} ->
      {corp_id, Enum.map(activities, fn {_, activity} -> activity end)}
    end)
    |> Enum.into(%{})
  end

  defp analyze_corp_cross_system_behavior(corp_id, activities) do
    %{
      corporation_id: corp_id,
      systems_active_in: extract_active_systems(activities),
      total_engagements: calculate_total_engagements(activities),
      engagement_distribution: calculate_engagement_distribution(activities),
      temporal_pattern: analyze_corp_temporal_behavior(activities),
      territorial_behavior: analyze_corp_territorial_behavior(activities),
      coordination_level: assess_corp_coordination_level(activities),
      preferred_engagement_style: analyze_corp_engagement_style(activities)
    }
  end

  defp extract_active_systems(activities) do
    activities
    |> Enum.map(& &1.system_id)
    |> Enum.uniq()
  end

  defp calculate_total_engagements(activities) do
    activities
    |> Enum.map(& &1.total_engagements)
    |> Enum.sum()
  end

  defp calculate_engagement_distribution(activities) do
    activities
    |> Enum.flat_map(&Map.get(&1, :engagement_types, []))
    |> Enum.frequencies()
  end

  defp analyze_corp_temporal_behavior(activities) do
    all_times =
      activities
      |> Enum.flat_map(& &1.activity_times)
      |> Enum.sort(DateTime)

    %{
      peak_activity_hours: identify_peak_hours(all_times),
      activity_consistency: calculate_activity_consistency(all_times),
      temporal_pattern: classify_temporal_pattern(all_times)
    }
  end

  defp identify_peak_hours(timestamps) do
    timestamps
    |> Enum.map(& &1.hour)
    |> Enum.frequencies()
    |> Enum.sort_by(fn {_, count} -> -count end)
    |> Enum.take(3)
    |> Enum.map(fn {hour, _} -> hour end)
  end

  defp calculate_activity_consistency(timestamps) do
    case timestamps do
      [] ->
        0.0

      [_] ->
        0.0

      _ ->
        gaps = calculate_time_gaps(timestamps)

        if Enum.empty?(gaps) do
          0.0
        else
          avg_gap = calculate_average_gap(gaps)
          variance = calculate_variance(gaps, avg_gap)

          # Lower variance means more consistent
          consistency = 1.0 / (1.0 + :math.sqrt(variance) / avg_gap)
          Float.round(consistency, 2)
        end
    end
  end

  defp classify_temporal_pattern(timestamps) do
    hours = Enum.map(timestamps, & &1.hour)
    hour_spread = Enum.uniq(hours) |> Kernel.length()

    cond do
      hour_spread <= 4 -> :timezone_restricted
      hour_spread <= 8 -> :prime_time_focused
      hour_spread <= 16 -> :extended_coverage
      true -> :round_the_clock
    end
  end

  defp analyze_corp_territorial_behavior(activities) do
    systems = extract_active_systems(activities)

    %{
      territory_size: Kernel.length(systems),
      territorial_concentration: calculate_territorial_concentration(activities),
      expansion_pattern: analyze_expansion_pattern(activities),
      territorial_focus: classify_territorial_focus(systems, activities)
    }
  end

  defp calculate_territorial_concentration(activities) do
    system_engagements =
      activities
      |> Enum.group_by(& &1.system_id)
      |> Enum.map(fn {system, acts} ->
        total = Enum.sum(Enum.map(acts, & &1.total_engagements))
        {system, total}
      end)

    total_engagements =
      system_engagements
      |> Enum.map(fn {_, count} -> count end)
      |> Enum.sum()

    if total_engagements == 0 do
      0.0
    else
      # Calculate Gini coefficient for concentration
      sorted_counts =
        system_engagements
        |> Enum.map(fn {_, count} -> count end)
        |> Enum.sort()

      n = Kernel.length(sorted_counts)

      index_sum =
        sorted_counts
        |> Enum.with_index(1)
        |> Enum.map(fn {count, index} -> count * index end)
        |> Enum.sum()

      gini = 2 * index_sum / (n * total_engagements) - (n + 1) / n
      # Invert so higher = more concentrated
      Float.round(1 - gini, 2)
    end
  end

  defp analyze_expansion_pattern(_activities) do
    # Simplified - would need historical data for real analysis
    :stable
  end

  defp classify_territorial_focus(systems, activities) do
    system_count = Kernel.length(systems)
    concentration = calculate_territorial_concentration(activities)

    cond do
      system_count == 1 -> :single_system
      system_count <= 3 and concentration >= 0.7 -> :localized
      system_count <= 5 and concentration >= 0.5 -> :regional
      system_count > 10 -> :widespread
      true -> :distributed
    end
  end

  defp assess_corp_coordination_level(activities) do
    # Assess how coordinated the corp's activities are
    temporal_clustering = assess_temporal_clustering(activities)
    system_coordination = assess_system_coordination(activities)

    coordination_score = (temporal_clustering + system_coordination) / 2

    %{
      score: Float.round(coordination_score, 2),
      temporal_clustering: temporal_clustering,
      system_coordination: system_coordination,
      classification: classify_coordination_level(coordination_score)
    }
  end

  defp assess_temporal_clustering(activities) do
    all_times =
      activities
      |> Enum.flat_map(& &1.activity_times)

    if Kernel.length(all_times) < 5 do
      # Neutral score for insufficient data
      0.5
    else
      # Check if activities cluster in time
      time_gaps = calculate_time_gaps(Enum.sort(all_times, DateTime))

      if Enum.empty?(time_gaps) do
        0.5
      else
        avg_gap = calculate_average_gap(time_gaps)
        short_gaps = Enum.count(time_gaps, &(&1 <= @temporal_window_minutes))

        clustering_ratio = short_gaps / Kernel.length(time_gaps)
        Float.round(clustering_ratio, 2)
      end
    end
  end

  defp assess_system_coordination(activities) do
    # Check if corp members operate in same systems at same times
    system_overlaps = identify_corp_system_overlaps(activities)

    if Enum.empty?(system_overlaps) do
      0.0
    else
      max_overlap =
        system_overlaps
        |> Enum.map(& &1.overlap_score)
        |> Enum.max()

      Float.round(max_overlap, 2)
    end
  end

  defp identify_corp_system_overlaps(activities) do
    # Find temporal overlaps in same systems
    activities
    |> Enum.group_by(& &1.system_id)
    |> Enum.flat_map(fn {system_id, system_activities} ->
      if Kernel.length(system_activities) >= 2 do
        analyze_system_activity_overlaps(system_id, system_activities)
      else
        []
      end
    end)
  end

  defp analyze_system_activity_overlaps(system_id, system_activities) do
    # Check for temporal overlaps
    time_windows =
      system_activities
      |> Enum.flat_map(fn activity ->
        Enum.map(activity.activity_times, fn time ->
          {time, activity}
        end)
      end)
      |> Enum.sort_by(fn {time, _} -> time end, DateTime)

    # Find overlapping time windows
    overlaps = find_temporal_overlaps(time_windows)

    Enum.map(overlaps, fn overlap ->
      %{
        system_id: system_id,
        overlap_score: calculate_overlap_score(overlap),
        participants: Kernel.length(overlap)
      }
    end)
  end

  defp find_temporal_overlaps(time_windows) do
    # Group events within temporal windows
    time_windows
    |> Enum.chunk_while(
      [],
      fn {time, activity}, acc ->
        case acc do
          [] ->
            {:cont, [{time, activity}]}

          prev_windows ->
            {last_time, _} = List.last(prev_windows)

            if DateTime.diff(time, last_time, :minute) <= @temporal_window_minutes do
              {:cont, prev_windows ++ [{time, activity}]}
            else
              if Kernel.length(prev_windows) >= 2 do
                {:cont, prev_windows, [{time, activity}]}
              else
                {:cont, [{time, activity}]}
              end
            end
        end
      end,
      fn acc ->
        if Kernel.length(acc) >= 2 do
          {:cont, acc, []}
        else
          {:cont, []}
        end
      end
    )
    |> Enum.filter(&(Kernel.length(&1) >= 2))
  end

  defp calculate_overlap_score(overlap_events) do
    # Score based on number of overlapping events and time proximity
    event_count = Kernel.length(overlap_events)

    # Calculate average time proximity
    times = Enum.map(overlap_events, fn {time, _} -> time end)
    {first_time, last_time} = {List.first(times), List.last(times)}

    time_spread = DateTime.diff(last_time, first_time, :minute)

    proximity_score =
      if time_spread > 0 do
        1.0 - time_spread / @temporal_window_minutes
      else
        1.0
      end

    # Combine event count and proximity
    # Normalize to 5+ events = max score
    event_score = min(1.0, event_count / 5)

    (event_score + proximity_score) / 2
  end

  defp classify_coordination_level(score) do
    cond do
      score >= 0.8 -> :highly_coordinated
      score >= 0.6 -> :well_coordinated
      score >= 0.4 -> :moderately_coordinated
      score >= 0.2 -> :loosely_coordinated
      true -> :uncoordinated
    end
  end

  defp analyze_corp_engagement_style(activities) do
    engagement_dist = calculate_engagement_distribution(activities)

    total_engagements =
      engagement_dist
      |> Map.values()
      |> Enum.sum()

    if total_engagements == 0 do
      :unknown
    else
      # Classify based on engagement type distribution
      fleet_ratio = Map.get(engagement_dist, :large_fleet, 0) / total_engagements
      small_gang_ratio = Map.get(engagement_dist, :small_gang, 0) / total_engagements
      solo_ratio = Map.get(engagement_dist, :solo_combat, 0) / total_engagements

      cond do
        fleet_ratio >= 0.5 -> :fleet_warfare
        small_gang_ratio >= 0.5 -> :small_gang_focused
        solo_ratio >= 0.5 -> :solo_hunters
        fleet_ratio >= 0.3 -> :mixed_fleet_emphasis
        true -> :opportunistic
      end
    end
  end

  defp extract_alliance_patterns(corp_analysis) do
    # Identify potential alliances based on coordinated behavior
    corp_pairs =
      for {c1, a1} <- corp_analysis,
          {c2, a2} <- corp_analysis,
          c1 < c2 do
        common_systems = find_common_corp_systems(a1, a2)
        temporal_overlap = analyze_corp_temporal_overlap(a1, a2)

        if Kernel.length(common_systems) >= 2 and temporal_overlap >= 0.5 do
          %{
            corporations: [c1, c2],
            common_systems: common_systems,
            temporal_overlap: temporal_overlap,
            coordination_similarity: compare_coordination_levels(a1, a2),
            likely_allied: assess_alliance_likelihood(a1, a2, common_systems, temporal_overlap)
          }
        else
          nil
        end
      end

    corp_pairs
    |> Enum.filter(& &1)
    |> group_into_alliances()
  end

  defp find_common_corp_systems(analysis1, analysis2) do
    systems1 = MapSet.new(analysis1.systems_active_in)
    systems2 = MapSet.new(analysis2.systems_active_in)

    MapSet.intersection(systems1, systems2) |> MapSet.to_list()
  end

  defp analyze_corp_temporal_overlap(analysis1, analysis2) do
    hours1 = MapSet.new(analysis1.temporal_pattern.peak_activity_hours)
    hours2 = MapSet.new(analysis2.temporal_pattern.peak_activity_hours)

    if MapSet.size(hours1) == 0 or MapSet.size(hours2) == 0 do
      0.0
    else
      intersection = MapSet.intersection(hours1, hours2) |> MapSet.size()
      union = MapSet.union(hours1, hours2) |> MapSet.size()

      intersection / union
    end
  end

  defp compare_coordination_levels(analysis1, analysis2) do
    coord1 = analysis1.coordination_level.score
    coord2 = analysis2.coordination_level.score

    1.0 - abs(coord1 - coord2)
  end

  defp assess_alliance_likelihood(analysis1, analysis2, common_systems, temporal_overlap) do
    # Factors indicating alliance
    system_overlap_score = min(1.0, Kernel.length(common_systems) / 5)
    coordination_match = compare_coordination_levels(analysis1, analysis2)

    style_match =
      if analysis1.preferred_engagement_style == analysis2.preferred_engagement_style,
        do: 1.0,
        else: 0.5

    likelihood = (system_overlap_score + temporal_overlap + coordination_match + style_match) / 4

    Float.round(likelihood, 2)
  end

  defp group_into_alliances(corp_pairs) do
    # Group corporations that are all potentially allied
    corp_pairs
    |> Enum.reduce([], fn pair, alliances ->
      matching_alliance =
        Enum.find_index(alliances, fn alliance ->
          Enum.any?(alliance.members, fn member -> member in pair.corporations end)
        end)

      case matching_alliance do
        nil ->
          # Create new alliance group
          [
            %{
              members: pair.corporations,
              common_systems: pair.common_systems,
              average_likelihood: pair.likely_allied,
              coordination_level: pair.coordination_similarity
            }
            | alliances
          ]

        index ->
          # Merge into existing alliance
          List.update_at(alliances, index, fn alliance ->
            %{
              alliance
              | members: Enum.uniq(alliance.members ++ pair.corporations),
                common_systems: Enum.uniq(alliance.common_systems ++ pair.common_systems),
                average_likelihood: (alliance.average_likelihood + pair.likely_allied) / 2
            }
          end)
      end
    end)
  end

  defp identify_potential_conflicts(corp_analysis) do
    # Find corporations that operate in same systems but aren't allied
    active_systems =
      corp_analysis
      |> Enum.flat_map(fn {corp_id, analysis} ->
        Enum.map(analysis.systems_active_in, fn system_id ->
          {system_id, corp_id}
        end)
      end)
      |> Enum.group_by(fn {system_id, _} -> system_id end)
      |> Enum.map(fn {system_id, corps} ->
        {system_id, Enum.map(corps, fn {_, corp_id} -> corp_id end)}
      end)
      |> Enum.filter(fn {_, corps} -> Kernel.length(corps) >= 2 end)

    Enum.map(active_systems, fn {system_id, corps} ->
      %{
        system_id: system_id,
        competing_corporations: corps,
        conflict_intensity: assess_conflict_intensity(system_id, corps, corp_analysis),
        likely_flashpoint: Kernel.length(corps) >= 3
      }
    end)
  end

  defp assess_conflict_intensity(system_id, corps, corp_analysis) do
    # Assess based on activity levels and engagement styles
    activities =
      corps
      |> Enum.map(fn corp_id ->
        Map.get(corp_analysis, corp_id)
      end)
      |> Enum.filter(& &1)

    # Higher activity in same system = higher conflict potential
    total_engagements =
      activities
      |> Enum.map(& &1.total_engagements)
      |> Enum.sum()

    # Different engagement styles = higher conflict
    style_diversity =
      activities
      |> Enum.map(& &1.preferred_engagement_style)
      |> Enum.uniq()
      |> Kernel.length()

    intensity_score = min(100, total_engagements / 10 + style_diversity * 20)

    cond do
      intensity_score >= 80 -> :extreme
      intensity_score >= 60 -> :high
      intensity_score >= 40 -> :moderate
      intensity_score >= 20 -> :low
      true -> :minimal
    end
  end

  defp group_events_by_time_window(events, window_minutes) do
    events
    |> Enum.sort_by(& &1.timestamp, DateTime)
    |> Enum.chunk_while(
      {nil, []},
      fn event, {window_start, acc} ->
        if window_start == nil do
          {:cont, {event.timestamp, [event]}}
        else
          if DateTime.diff(event.timestamp, window_start, :minute) <= window_minutes do
            {:cont, {window_start, acc ++ [event]}}
          else
            {:cont, {window_start, acc}, {event.timestamp, [event]}}
          end
        end
      end,
      fn {window_start, acc} ->
        if window_start == nil do
          {:cont, []}
        else
          {:cont, {window_start, acc}, []}
        end
      end
    )
    |> Enum.filter(fn {_, events} -> Kernel.length(events) > 0 end)
    |> Enum.into(%{})
  end

  defp analyze_burst(window_start, events) do
    systems_involved =
      events
      |> Enum.map(& &1.system_id)
      |> Enum.uniq()

    %{
      start_time: window_start,
      end_time: List.last(events).timestamp,
      event_count: Kernel.length(events),
      systems_affected: systems_involved,
      intensity: calculate_burst_intensity(events),
      dominant_activity_type: find_dominant_activity_type(events),
      participants_estimate: estimate_burst_participants(events)
    }
  end

  defp calculate_burst_intensity(events) do
    duration_minutes =
      if Kernel.length(events) > 1 do
        DateTime.diff(List.last(events).timestamp, List.first(events).timestamp, :minute) + 1
      else
        1
      end

    events_per_minute = Kernel.length(events) / duration_minutes

    cond do
      events_per_minute >= 2.0 -> :extreme
      events_per_minute >= 1.0 -> :high
      events_per_minute >= 0.5 -> :moderate
      true -> :low
    end
  end

  defp find_dominant_activity_type(events) do
    events
    |> Enum.map(& &1.activity_type)
    |> Enum.frequencies()
    |> Enum.max_by(fn {_, count} -> count end)
    |> elem(0)
  end

  defp estimate_burst_participants(events) do
    events
    |> Enum.map(& &1.participants)
    |> Enum.sum()
  end

  defp identify_synchronized_bursts(bursts) do
    # Find bursts that occur at similar times across systems
    burst_pairs =
      for b1 <- bursts, b2 <- bursts, b1 != b2 do
        if overlapping_bursts?(b1, b2) and different_systems?(b1, b2) do
          %{
            burst_pair: [b1, b2],
            overlap_duration: calculate_burst_overlap(b1, b2),
            systems_involved: Enum.uniq(b1.systems_affected ++ b2.systems_affected),
            combined_intensity: max_intensity(b1.intensity, b2.intensity),
            synchronization_score: calculate_burst_sync_score(b1, b2)
          }
        else
          nil
        end
      end

    burst_pairs
    |> Enum.filter(& &1)
    |> group_synchronized_bursts()
  end

  defp overlapping_bursts?(burst1, burst2) do
    DateTime.compare(burst1.start_time, burst2.end_time) != :gt and
      DateTime.compare(burst2.start_time, burst1.end_time) != :gt
  end

  defp different_systems?(burst1, burst2) do
    systems1 = MapSet.new(burst1.systems_affected)
    systems2 = MapSet.new(burst2.systems_affected)

    MapSet.disjoint?(systems1, systems2)
  end

  defp calculate_burst_overlap(burst1, burst2) do
    overlap_start = max_datetime(burst1.start_time, burst2.start_time)
    overlap_end = min_datetime(burst1.end_time, burst2.end_time)

    DateTime.diff(overlap_end, overlap_start, :minute)
  end

  defp max_datetime(dt1, dt2) do
    if DateTime.compare(dt1, dt2) == :gt, do: dt1, else: dt2
  end

  defp min_datetime(dt1, dt2) do
    if DateTime.compare(dt1, dt2) == :lt, do: dt1, else: dt2
  end

  defp max_intensity(i1, i2) do
    intensities = [:low, :moderate, :high, :extreme]
    idx1 = Enum.find_index(intensities, &(&1 == i1)) || 0
    idx2 = Enum.find_index(intensities, &(&1 == i2)) || 0

    Enum.at(intensities, max(idx1, idx2))
  end

  defp calculate_burst_sync_score(burst1, burst2) do
    # Score based on temporal alignment and intensity matching
    time_alignment = calculate_time_alignment(burst1, burst2)
    intensity_match = if burst1.intensity == burst2.intensity, do: 1.0, else: 0.5

    activity_match =
      if burst1.dominant_activity_type == burst2.dominant_activity_type, do: 1.0, else: 0.3

    Float.round((time_alignment + intensity_match + activity_match) / 3, 2)
  end

  defp calculate_time_alignment(burst1, burst2) do
    # How well aligned are the burst start times?
    time_diff = abs(DateTime.diff(burst1.start_time, burst2.start_time, :minute))

    # Perfect alignment = 0 minutes difference
    # Score decreases as difference increases
    max(0, 1.0 - time_diff / @temporal_window_minutes)
  end

  defp group_synchronized_bursts(burst_pairs) do
    # Group all related synchronized bursts
    burst_pairs
    |> Enum.reduce([], fn pair, groups ->
      matching_group =
        Enum.find_index(groups, fn group ->
          Enum.any?(group.bursts, fn burst ->
            burst in pair.burst_pair
          end)
        end)

      case matching_group do
        nil ->
          [
            %{
              bursts: pair.burst_pair,
              systems_involved: pair.systems_involved,
              synchronization_score: pair.synchronization_score,
              combined_intensity: pair.combined_intensity
            }
            | groups
          ]

        index ->
          List.update_at(groups, index, fn group ->
            %{
              group
              | bursts: Enum.uniq(group.bursts ++ pair.burst_pair),
                systems_involved: Enum.uniq(group.systems_involved ++ pair.systems_involved),
                synchronization_score:
                  (group.synchronization_score + pair.synchronization_score) / 2
            }
          end)
      end
    end)
  end

  defp categorize_burst_patterns(bursts) do
    %{
      coordinated_operations: identify_coordinated_operations(bursts),
      chain_reactions: identify_chain_reactions(bursts),
      periodic_patterns: identify_periodic_patterns(bursts),
      escalation_sequences: identify_escalation_sequences(bursts)
    }
  end

  defp identify_coordinated_operations(bursts) do
    # High-intensity synchronized bursts across multiple systems
    bursts
    |> Enum.filter(fn burst ->
      burst.intensity in [:high, :extreme] and
        Kernel.length(burst.systems_affected) >= 2
    end)
    |> Enum.map(fn burst ->
      %{
        burst: burst,
        operation_type: classify_operation_type(burst),
        coordination_level: assess_burst_coordination(burst)
      }
    end)
  end

  defp classify_operation_type(burst) do
    case burst.dominant_activity_type do
      :large_fleet -> :major_fleet_operation
      :medium_fleet -> :coordinated_strike
      :small_gang -> :raiding_party
      :solo_combat -> :hunter_killer_sweep
    end
  end

  defp assess_burst_coordination(burst) do
    # Based on participant count and timing precision
    cond do
      burst.participants_estimate >= 50 -> :strategic
      burst.participants_estimate >= 20 -> :tactical
      true -> :opportunistic
    end
  end

  defp identify_chain_reactions(bursts) do
    # Sequential bursts that appear to trigger each other
    sorted_bursts = Enum.sort_by(bursts, & &1.start_time, DateTime)

    chains =
      sorted_bursts
      |> Enum.chunk_while(
        [],
        fn burst, acc ->
          case acc do
            [] ->
              {:cont, [burst]}

            prev_bursts ->
              last_burst = List.last(prev_bursts)

              if causally_related?(last_burst, burst) do
                {:cont, prev_bursts ++ [burst]}
              else
                if Kernel.length(prev_bursts) >= 2 do
                  {:cont, prev_bursts, [burst]}
                else
                  {:cont, [burst]}
                end
              end
          end
        end,
        fn acc ->
          if Kernel.length(acc) >= 2 do
            {:cont, acc, []}
          else
            {:cont, []}
          end
        end
      )
      |> Enum.filter(&(Kernel.length(&1) >= 2))

    Enum.map(chains, fn chain ->
      %{
        chain_length: Kernel.length(chain),
        duration_minutes:
          DateTime.diff(List.last(chain).end_time, List.first(chain).start_time, :minute),
        systems_affected: chain |> Enum.flat_map(& &1.systems_affected) |> Enum.uniq(),
        escalation_pattern: analyze_escalation_pattern(chain)
      }
    end)
  end

  defp causally_related?(burst1, burst2) do
    # Check if burst2 could be caused by burst1
    time_gap = DateTime.diff(burst2.start_time, burst1.end_time, :minute)

    # Must be within reasonable response time
    # Some system overlap or adjacency (simplified)
    time_gap >= 0 and time_gap <= 60 and
      not Enum.empty?(
        MapSet.intersection(
          MapSet.new(burst1.systems_affected),
          MapSet.new(burst2.systems_affected)
        )
      )
  end

  defp analyze_escalation_pattern(chain) do
    intensities = Enum.map(chain, & &1.intensity)
    participant_trend = analyze_participant_trend(chain)

    cond do
      increasing_intensity?(intensities) -> :escalating
      decreasing_intensity?(intensities) -> :de_escalating
      participant_trend == :increasing -> :reinforcement_arriving
      participant_trend == :decreasing -> :disengagement
      true -> :sustained_conflict
    end
  end

  defp increasing_intensity?(intensities) do
    intensity_values = Enum.map(intensities, &intensity_to_value/1)

    intensity_values == Enum.sort(intensity_values)
  end

  defp decreasing_intensity?(intensities) do
    intensity_values = Enum.map(intensities, &intensity_to_value/1)

    intensity_values == Enum.sort(intensity_values, :desc)
  end

  defp intensity_to_value(intensity) do
    case intensity do
      :extreme -> 4
      :high -> 3
      :moderate -> 2
      :low -> 1
    end
  end

  defp analyze_participant_trend(chain) do
    counts = Enum.map(chain, & &1.participants_estimate)

    avg_first_half =
      (Enum.take(counts, div(Kernel.length(counts), 2)) |> Enum.sum()) /
        (Kernel.length(counts) / 2)

    avg_second_half =
      (Enum.drop(counts, div(Kernel.length(counts), 2)) |> Enum.sum()) /
        (Kernel.length(counts) / 2)

    cond do
      avg_second_half > avg_first_half * 1.2 -> :increasing
      avg_second_half < avg_first_half * 0.8 -> :decreasing
      true -> :stable
    end
  end

  defp identify_periodic_patterns(bursts) do
    # Look for bursts that occur at regular intervals
    sorted_bursts = Enum.sort_by(bursts, & &1.start_time, DateTime)

    if Kernel.length(sorted_bursts) < 3 do
      []
    else
      # Calculate intervals between bursts
      intervals =
        sorted_bursts
        |> Enum.chunk_every(2, 1, :discard)
        |> Enum.map(fn [b1, b2] ->
          DateTime.diff(b2.start_time, b1.start_time, :minute)
        end)

      # Look for regular patterns
      detect_regular_intervals(intervals)
    end
  end

  defp detect_regular_intervals(intervals) do
    if Kernel.length(intervals) < 2 do
      []
    else
      avg_interval = Enum.sum(intervals) / Kernel.length(intervals)
      variance = calculate_variance(intervals, avg_interval)
      cv = :math.sqrt(variance) / avg_interval

      # Low coefficient of variation indicates regularity
      if cv < 0.3 do
        [
          %{
            period_minutes: round(avg_interval),
            confidence: Float.round(1.0 - cv, 2),
            pattern_type: classify_period_type(avg_interval),
            likely_cause: infer_periodic_cause(avg_interval)
          }
        ]
      else
        []
      end
    end
  end

  defp classify_period_type(period_minutes) do
    cond do
      period_minutes <= 30 -> :rapid_cycle
      period_minutes <= 120 -> :hourly_pattern
      period_minutes <= 1440 -> :daily_pattern
      true -> :long_cycle
    end
  end

  defp infer_periodic_cause(period_minutes) do
    cond do
      # ~24 hours
      period_minutes >= 1380 and period_minutes <= 1500 -> :daily_ops
      # ~1 hour
      period_minutes >= 50 and period_minutes <= 70 -> :respawn_timer
      # ~2 hours
      period_minutes >= 110 and period_minutes <= 130 -> :patrol_route
      true -> :unknown_pattern
    end
  end

  defp identify_escalation_sequences(bursts) do
    # Find sequences where conflicts escalate in intensity or scope
    sequences =
      bursts
      |> Enum.sort_by(& &1.start_time, DateTime)
      |> find_escalation_sequences([])

    Enum.map(sequences, fn sequence ->
      %{
        stages: Kernel.length(sequence),
        initial_scope: List.first(sequence).event_count,
        final_scope: List.last(sequence).event_count,
        systems_drawn_in: count_systems_drawn_in(sequence),
        escalation_rate: calculate_escalation_rate(sequence),
        likely_flashpoint: identify_flashpoint(sequence)
      }
    end)
  end

  defp find_escalation_sequences([], acc), do: acc

  defp find_escalation_sequences([burst | rest], acc) do
    {sequence, remaining} = build_escalation_sequence([burst], rest)

    if Kernel.length(sequence) >= 2 do
      find_escalation_sequences(remaining, [sequence | acc])
    else
      find_escalation_sequences(remaining, acc)
    end
  end

  defp build_escalation_sequence(current_seq, []), do: {current_seq, []}

  defp build_escalation_sequence(current_seq, [next_burst | rest] = remaining) do
    last_burst = List.last(current_seq)

    if escalates_from?(last_burst, next_burst) do
      build_escalation_sequence(current_seq ++ [next_burst], rest)
    else
      {current_seq, remaining}
    end
  end

  defp escalates_from?(burst1, burst2) do
    # Check if burst2 escalates from burst1
    time_gap = DateTime.diff(burst2.start_time, burst1.end_time, :minute)

    # Within 2 hours
    # More events
    # More systems
    # Higher intensity
    time_gap >= 0 and time_gap <= 120 and
      (burst2.event_count > burst1.event_count or
         Kernel.length(burst2.systems_affected) > Kernel.length(burst1.systems_affected) or
         intensity_to_value(burst2.intensity) > intensity_to_value(burst1.intensity))
  end

  defp count_systems_drawn_in(sequence) do
    initial_systems = MapSet.new(List.first(sequence).systems_affected)

    final_systems =
      sequence
      |> Enum.flat_map(& &1.systems_affected)
      |> MapSet.new()

    MapSet.size(final_systems) - MapSet.size(initial_systems)
  end

  defp calculate_escalation_rate(sequence) do
    duration =
      DateTime.diff(
        List.last(sequence).end_time,
        List.first(sequence).start_time,
        :hour
      )

    if duration > 0 do
      scope_increase = List.last(sequence).event_count - List.first(sequence).event_count
      Float.round(scope_increase / duration, 1)
    else
      0.0
    end
  end

  defp identify_flashpoint(sequence) do
    # Find the burst that triggered the biggest escalation
    sequence
    |> Enum.chunk_every(2, 1, :discard)
    |> Enum.map(fn [b1, b2] ->
      {b1, calculate_escalation_magnitude(b1, b2)}
    end)
    |> Enum.max_by(fn {_, magnitude} -> magnitude end)
    |> elem(0)
  end

  defp calculate_escalation_magnitude(burst1, burst2) do
    event_increase = burst2.event_count - burst1.event_count

    system_increase =
      Kernel.length(burst2.systems_affected) - Kernel.length(burst1.systems_affected)

    intensity_increase =
      intensity_to_value(burst2.intensity) - intensity_to_value(burst1.intensity)

    event_increase + system_increase * 10 + intensity_increase * 20
  end

  defp classify_activity_frequency(activity_count, time_span_hours) do
    rate = activity_count / max(time_span_hours, 1)

    cond do
      rate >= 2.0 -> :hyperactive
      rate >= 1.0 -> :very_active
      rate >= 0.5 -> :active
      rate >= 0.1 -> :moderate
      true -> :quiet
    end
  end

  defp classify_corp_engagements(participations) do
    # This would need actual analysis of engagement data
    # For now, return a simple distribution
    [:solo_combat, :small_gang, :medium_fleet, :large_fleet]
  end

  defp classify_ship_type(ship_type_id) do
    # Simplified ship classification
    # In production, would use actual EVE ship data
    cond do
      ship_type_id < 1000 -> :frigate
      ship_type_id < 2000 -> :destroyer
      ship_type_id < 3000 -> :cruiser
      ship_type_id < 4000 -> :battlecruiser
      ship_type_id < 5000 -> :battleship
      true -> :capital
    end
  end

  defp analyze_pilot_activity_pattern(participations) do
    %{
      total_activities: Kernel.length(participations),
      kill_count: Enum.count(participations, &(&1.role == :attacker)),
      death_count: Enum.count(participations, &(&1.role == :victim)),
      activity_frequency:
        classify_activity_frequency(
          Kernel.length(participations),
          # Default to 24 hour window
          24
        ),
      preferred_ship: find_preferred_ship(participations),
      last_seen: participations |> Enum.map(& &1.timestamp) |> Enum.max(DateTime)
    }
  end

  defp find_preferred_ship(participations) do
    participations
    |> Enum.map(& &1.ship_type_id)
    |> Enum.frequencies()
    |> Enum.max_by(fn {_, count} -> count end, fn -> {nil, 0} end)
    |> elem(0)
  end

  defp max_value(a, b, c), do: max(max(a, b), c)
end
