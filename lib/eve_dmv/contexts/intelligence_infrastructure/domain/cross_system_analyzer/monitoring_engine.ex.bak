defmodule EveDmv.Contexts.IntelligenceInfrastructure.Domain.CrossSystemAnalyzer.MonitoringEngine do
  @moduledoc """
  Real-time monitoring engine for cross-system intelligence operations.
  
  Handles:
  - Baseline establishment for intelligence monitoring
  - Real-time intelligence stream processing
  - Anomaly detection and alerting
  - Predictive monitoring based on patterns
  - Intelligence monitoring configuration and management
  """
  
  alias EveDmv.Api
  alias EveDmv.Killmails.KillmailRaw
  
  require Logger
  
  # Monitoring configuration
  @default_monitoring_interval_minutes 5
  @baseline_establishment_window_hours 24
  @anomaly_detection_threshold 2.0  # Standard deviations from baseline
  @alert_cooldown_minutes 15
  @max_concurrent_monitors 50
  
  # Alert levels
  @alert_levels [:info, :warning, :critical, :emergency]
  
  # Monitoring stream state
  @monitoring_states [:active, :paused, :stopped, :error]
  
  @doc """
  Establishes intelligence baseline for the specified monitoring scope.
  """
  def establish_intelligence_baseline(monitored_systems, options \\ []) do
    baseline_window_hours = Keyword.get(options, :baseline_window_hours, @baseline_establishment_window_hours)
    include_predictive_baseline = Keyword.get(options, :include_predictive_baseline, true)
    baseline_confidence_threshold = Keyword.get(options, :confidence_threshold, 0.7)
    
    Logger.info("Establishing intelligence baseline for #{Kernel.length(monitored_systems)} systems")
    
    start_time = System.monotonic_time(:millisecond)
    
    with {:ok, historical_data} <- collect_baseline_data(monitored_systems, baseline_window_hours),
         {:ok, activity_baseline} <- calculate_activity_baseline(historical_data),
         {:ok, pattern_baseline} <- calculate_pattern_baseline(historical_data),
         {:ok, threat_baseline} <- calculate_threat_baseline(historical_data),
         {:ok, predictive_baseline} <- 
           maybe_calculate_predictive_baseline(historical_data, include_predictive_baseline),
         {:ok, baseline_metrics} <- compile_baseline_metrics(
           activity_baseline,
           pattern_baseline, 
           threat_baseline,
           predictive_baseline
         ),
         {:ok, baseline_validation} <- validate_baseline_quality(baseline_metrics, baseline_confidence_threshold) do
      
      end_time = System.monotonic_time(:millisecond)
      duration_ms = end_time - start_time
      
      Logger.info("Intelligence baseline established in #{duration_ms}ms")
      
      {:ok, %{
        monitored_systems: monitored_systems,
        baseline_window: {DateTime.utc_now() |> DateTime.add(-baseline_window_hours * 3600, :second), DateTime.utc_now()},
        activity_baseline: activity_baseline,
        pattern_baseline: pattern_baseline,
        threat_baseline: threat_baseline,
        predictive_baseline: predictive_baseline,
        baseline_metrics: baseline_metrics,
        baseline_validation: baseline_validation,
        establishment_duration_ms: duration_ms,
        established_at: DateTime.utc_now()
      }}
    else
      error -> error
    end
  end
  
  @doc """
  Sets up intelligence monitoring with configured parameters.
  """
  def setup_intelligence_monitoring(monitored_systems, baseline, options \\ []) do
    monitoring_interval = Keyword.get(options, :monitoring_interval_minutes, @default_monitoring_interval_minutes)
    alert_thresholds = Keyword.get(options, :alert_thresholds, %{})
    enable_predictive_monitoring = Keyword.get(options, :enable_predictive_monitoring, true)
    monitoring_focus = Keyword.get(options, :monitoring_focus, [:activity, :patterns, :threats])
    
    # Validate monitoring configuration
    with {:ok, validated_config} <- validate_monitoring_config(
           monitored_systems, 
           baseline, 
           monitoring_interval,
           alert_thresholds,
           monitoring_focus
         ),
         {:ok, monitoring_state} <- initialize_monitoring_state(validated_config),
         {:ok, alert_system} <- setup_alert_system(validated_config.alert_thresholds),
         {:ok, predictive_monitors} <- 
           maybe_setup_predictive_monitoring(baseline, enable_predictive_monitoring) do
      
      {:ok, %{
        monitoring_id: generate_monitoring_id(),
        monitored_systems: monitored_systems,
        baseline_reference: baseline,
        monitoring_config: validated_config,
        monitoring_state: monitoring_state,
        alert_system: alert_system,
        predictive_monitors: predictive_monitors,
        setup_timestamp: DateTime.utc_now(),
        status: :configured
      }}
    else
      error -> error
    end
  end
  
  @doc """
  Starts real-time intelligence streaming and monitoring.
  """
  def start_intelligence_stream(monitoring_setup, stream_options \\ []) do
    stream_mode = Keyword.get(stream_options, :stream_mode, :continuous)
    buffer_size = Keyword.get(stream_options, :buffer_size, 100)
    batch_processing = Keyword.get(stream_options, :batch_processing, true)
    
    Logger.info("Starting intelligence stream for monitoring #{monitoring_setup.monitoring_id}")
    
    with {:ok, stream_state} <- initialize_stream_state(monitoring_setup, stream_mode, buffer_size),
         {:ok, processing_pipeline} <- setup_processing_pipeline(monitoring_setup, batch_processing),
         {:ok, anomaly_detector} <- initialize_anomaly_detector(monitoring_setup.baseline_reference),
         {:ok, alert_manager} <- initialize_alert_manager(monitoring_setup.alert_system) do
      
      # Start the monitoring stream process
      stream_pid = start_monitoring_process(%{
        monitoring_setup: monitoring_setup,
        stream_state: stream_state,
        processing_pipeline: processing_pipeline,
        anomaly_detector: anomaly_detector,
        alert_manager: alert_manager
      })
      
      {:ok, %{
        monitoring_id: monitoring_setup.monitoring_id,
        stream_pid: stream_pid,
        stream_state: Map.put(stream_state, :status, :active),
        processing_pipeline: processing_pipeline,
        anomaly_detector: anomaly_detector,
        alert_manager: alert_manager,
        stream_started_at: DateTime.utc_now()
      }}
    else
      error -> error
    end
  end
  
  # Private functions
  
  defp collect_baseline_data(monitored_systems, baseline_window_hours) do
    since = DateTime.utc_now() |> DateTime.add(-baseline_window_hours * 3600, :second)
    
    try do
      system_data = Enum.map(monitored_systems, fn system_id ->
        killmails = Api.read!(KillmailRaw,
          filter: [
            solar_system_id: system_id,
            timestamp: [greater_than: since]
          ],
          limit: 1000
        )
        
        {system_id, %{
          killmails: killmails,
          system_id: system_id,
          data_window: {since, DateTime.utc_now()},
          killmail_count: Kernel.length(killmails)
        }}
      end)
      |> Enum.into(%{})
      
      total_killmails = system_data
      |> Map.values()
      |> Enum.map(& &1.killmail_count)
      |> Enum.sum()
      
      {:ok, %{
        systems: monitored_systems,
        system_data: system_data,
        total_killmails: total_killmails,
        data_window: {since, DateTime.utc_now()},
        collection_timestamp: DateTime.utc_now(),
        data_quality: assess_baseline_data_quality(system_data)
      }}
    rescue
      e -> {:error, e}
    end
  end
  
  defp assess_baseline_data_quality(system_data) do
    total_systems = Kernel.map_size(system_data)
    systems_with_data = system_data
    |> Map.values()
    |> Enum.count(& &1.killmail_count > 0)
    
    total_killmails = system_data
    |> Map.values()
    |> Enum.map(& &1.killmail_count)
    |> Enum.sum()
    
    coverage_ratio = if total_systems > 0, do: systems_with_data / total_systems, else: 0.0
    
    data_quality = cond do
      total_killmails >= 200 and coverage_ratio >= 0.8 -> :excellent
      total_killmails >= 100 and coverage_ratio >= 0.6 -> :good
      total_killmails >= 50 and coverage_ratio >= 0.4 -> :fair
      total_killmails >= 20 and coverage_ratio >= 0.2 -> :poor
      true -> :insufficient
    end
    
    %{
      quality_level: data_quality,
      total_killmails: total_killmails,
      coverage_ratio: Float.round(coverage_ratio, 2),
      systems_with_data: systems_with_data,
      total_systems: total_systems
    }
  end
  
  defp calculate_activity_baseline(historical_data) do
    system_baselines = Enum.map(historical_data.system_data, fn {system_id, data} ->
      killmails = data.killmails
      
      baseline_metrics = %{
        average_killmails_per_hour: calculate_average_killmails_per_hour(killmails),
        peak_activity_hours: identify_peak_activity_hours(killmails),
        activity_variance: calculate_activity_variance(killmails),
        participant_baseline: calculate_participant_baseline(killmails),
        value_baseline: calculate_value_baseline(killmails),
        temporal_patterns: analyze_temporal_patterns(killmails)
      }
      
      {system_id, baseline_metrics}
    end)
    |> Enum.into(%{})
    
    # Calculate aggregate baseline
    aggregate_baseline = calculate_aggregate_activity_baseline(system_baselines)
    
    {:ok, %{
      system_baselines: system_baselines,
      aggregate_baseline: aggregate_baseline,
      baseline_confidence: calculate_activity_baseline_confidence(system_baselines),
      anomaly_detection_thresholds: calculate_activity_anomaly_thresholds(system_baselines)
    }}
  end
  
  defp calculate_average_killmails_per_hour(killmails) do
    if Enum.empty?(killmails) do
      0.0
    else
      # Group by hour and calculate average
      hourly_counts = killmails
      |> Enum.group_by(fn km ->
        DateTime.truncate(km.timestamp, :hour)
      end)
      |> Enum.map(fn {_hour, hour_killmails} ->
        Kernel.length(hour_killmails)
      end)
      
      if Enum.empty?(hourly_counts) do
        0.0
      else
        Float.round(Enum.sum(hourly_counts) / Kernel.length(hourly_counts), 2)
      end
    end
  end
  
  defp identify_peak_activity_hours(killmails) do
    if Enum.empty?(killmails) do
      []
    else
      killmails
      |> Enum.map(& &1.timestamp.hour)
      |> Enum.frequencies()
      |> Enum.sort_by(fn {_, count} -> -count end)
      |> Enum.take(3)
      |> Enum.map(fn {hour, _} -> hour end)
    end
  end
  
  defp calculate_activity_variance(killmails) do
    hourly_counts = killmails
    |> Enum.group_by(fn km ->
      DateTime.truncate(km.timestamp, :hour)
    end)
    |> Map.values()
    |> Enum.map(&Kernel.length/1)
    
    if Kernel.length(hourly_counts) < 2 do
      0.0
    else
      mean = Enum.sum(hourly_counts) / Kernel.length(hourly_counts)
      
      variance = hourly_counts
      |> Enum.map(fn count -> :math.pow(count - mean, 2) end)
      |> Enum.sum()
      |> Kernel./(Kernel.length(hourly_counts))
      
      Float.round(variance, 2)
    end
  end
  
  defp calculate_participant_baseline(killmails) do
    if Enum.empty?(killmails) do
      %{average_participants: 0.0, participant_variance: 0.0}
    else
      participant_counts = Enum.map(killmails, fn km ->
        count_killmail_participants(km)
      end)
      
      avg_participants = Enum.sum(participant_counts) / Kernel.length(participant_counts)
      
      variance = if Kernel.length(participant_counts) > 1 do
        participant_counts
        |> Enum.map(fn count -> :math.pow(count - avg_participants, 2) end)
        |> Enum.sum()
        |> Kernel./(Kernel.length(participant_counts))
      else
        0.0
      end
      
      %{
        average_participants: Float.round(avg_participants, 2),
        participant_variance: Float.round(variance, 2),
        max_participants: Enum.max(participant_counts, fn -> 0 end),
        min_participants: Enum.min(participant_counts, fn -> 0 end)
      }
    end
  end
  
  defp count_killmail_participants(killmail) do
    base_count = 1  # victim
    
    attacker_count = case killmail.zkb_data do
      %{"attackers" => attackers} when is_list(attackers) ->
        Kernel.length(attackers)
      _ -> 0
    end
    
    base_count + attacker_count
  end
  
  defp calculate_value_baseline(killmails) do
    if Enum.empty?(killmails) do
      %{average_value: 0.0, value_variance: 0.0}
    else
      values = Enum.map(killmails, & &1.total_value || 0)
      
      avg_value = Enum.sum(values) / Kernel.length(values)
      
      variance = if Kernel.length(values) > 1 do
        values
        |> Enum.map(fn value -> :math.pow(value - avg_value, 2) end)
        |> Enum.sum()
        |> Kernel./(Kernel.length(values))
      else
        0.0
      end
      
      %{
        average_value: Float.round(avg_value, 0),
        value_variance: Float.round(variance, 0),
        max_value: Enum.max(values, fn -> 0 end),
        total_value: Enum.sum(values)
      }
    end
  end
  
  defp analyze_temporal_patterns(killmails) do
    if Enum.empty?(killmails) do
      %{pattern_type: :no_activity}
    else
      # Analyze hourly distribution
      hourly_dist = killmails
      |> Enum.map(& &1.timestamp.hour)
      |> Enum.frequencies()
      
      # Analyze daily distribution
      daily_dist = killmails
      |> Enum.map(& Date.day_of_week(&1.timestamp))
      |> Enum.frequencies()
      
      # Calculate temporal clustering
      clustering = assess_temporal_clustering_baseline(killmails)
      
      %{
        pattern_type: :temporal_analysis,
        hourly_distribution: hourly_dist,
        daily_distribution: daily_dist,
        temporal_clustering: clustering,
        activity_consistency: calculate_temporal_consistency(killmails)
      }
    end
  end
  
  defp assess_temporal_clustering_baseline(killmails) do
    if Kernel.length(killmails) < 5 do
      :insufficient_data
    else
      # Calculate time gaps between events
      timestamps = killmails
      |> Enum.map(& &1.timestamp)
      |> Enum.sort(DateTime)
      
      gaps = timestamps
      |> Enum.chunk_every(2, 1, :discard)
      |> Enum.map(fn [t1, t2] -> DateTime.diff(t2, t1, :minute) end)
      
      if Enum.empty?(gaps) do
        :no_clustering
      else
        avg_gap = Enum.sum(gaps) / Kernel.length(gaps)
        
        # Short gaps indicate clustering
        short_gaps = Enum.count(gaps, & &1 <= 30)  # 30 minutes or less
        clustering_ratio = short_gaps / Kernel.length(gaps)
        
        cond do
          clustering_ratio >= 0.7 -> :highly_clustered
          clustering_ratio >= 0.5 -> :moderately_clustered
          clustering_ratio >= 0.3 -> :weakly_clustered
          true -> :distributed
        end
      end
    end
  end
  
  defp calculate_temporal_consistency(killmails) do
    if Kernel.length(killmails) < 10 do
      :insufficient_data
    else
      # Group into time windows and check consistency
      time_windows = group_killmails_by_hour(killmails)
      
      if Kernel.map_size(time_windows) < 5 do
        :insufficient_windows
      else
        window_counts = Map.values(time_windows)
        mean_count = Enum.sum(window_counts) / Kernel.length(window_counts)
        
        variance = window_counts
        |> Enum.map(fn count -> :math.pow(count - mean_count, 2) end)
        |> Enum.sum()
        |> Kernel./(Kernel.length(window_counts))
        
        cv = if mean_count > 0, do: :math.sqrt(variance) / mean_count, else: 0
        
        cond do
          cv <= 0.5 -> :very_consistent
          cv <= 1.0 -> :consistent
          cv <= 2.0 -> :moderately_consistent
          true -> :inconsistent
        end
      end
    end
  end
  
  defp group_killmails_by_hour(killmails) do
    killmails
    |> Enum.group_by(fn km ->
      DateTime.truncate(km.timestamp, :hour)
    end)
    |> Enum.map(fn {hour, hour_killmails} ->
      {hour, Kernel.length(hour_killmails)}
    end)
    |> Enum.into(%{})
  end
  
  defp calculate_aggregate_activity_baseline(system_baselines) do
    if Enum.empty?(system_baselines) do
      %{overall_activity_level: :no_activity}
    else
      # Aggregate metrics across all systems
      total_avg_killmails = system_baselines
      |> Map.values()
      |> Enum.map(& &1.average_killmails_per_hour)
      |> Enum.sum()
      
      avg_participants = system_baselines
      |> Map.values()
      |> Enum.map(& &1.participant_baseline.average_participants)
      |> Enum.sum()
      |> Kernel./(Kernel.map_size(system_baselines))
      
      total_value = system_baselines
      |> Map.values()
      |> Enum.map(& &1.value_baseline.total_value)
      |> Enum.sum()
      
      %{
        total_average_killmails_per_hour: Float.round(total_avg_killmails, 2),
        average_participants_per_system: Float.round(avg_participants, 2),
        total_baseline_value: total_value,
        overall_activity_level: classify_overall_activity_level(total_avg_killmails, avg_participants),
        systems_count: Kernel.map_size(system_baselines)
      }
    end
  end
  
  defp classify_overall_activity_level(total_killmails_per_hour, avg_participants) do
    cond do
      total_killmails_per_hour >= 20 and avg_participants >= 50 -> :very_high
      total_killmails_per_hour >= 10 and avg_participants >= 25 -> :high
      total_killmails_per_hour >= 5 and avg_participants >= 10 -> :moderate
      total_killmails_per_hour >= 2 and avg_participants >= 5 -> :low
      true -> :minimal
    end
  end
  
  defp calculate_activity_baseline_confidence(system_baselines) do
    if Enum.empty?(system_baselines) do
      0.0
    else
      # Base confidence on data availability and consistency
      systems_with_data = system_baselines
      |> Map.values()
      |> Enum.count(& &1.average_killmails_per_hour > 0)
      
      data_coverage = systems_with_data / Kernel.map_size(system_baselines)
      
      # Check temporal consistency across systems
      consistent_systems = system_baselines
      |> Map.values()
      |> Enum.count(fn baseline ->
        baseline.temporal_patterns.activity_consistency in [:very_consistent, :consistent]
      end)
      
      consistency_ratio = consistent_systems / Kernel.map_size(system_baselines)
      
      # Combine factors
      confidence = (data_coverage * 0.6) + (consistency_ratio * 0.4)
      Float.round(confidence, 2)
    end
  end
  
  defp calculate_activity_anomaly_thresholds(system_baselines) do
    Enum.map(system_baselines, fn {system_id, baseline} ->
      # Calculate thresholds based on variance
      killmail_threshold = %{
        upper: baseline.average_killmails_per_hour + (@anomaly_detection_threshold * :math.sqrt(baseline.activity_variance)),
        lower: max(0, baseline.average_killmails_per_hour - (@anomaly_detection_threshold * :math.sqrt(baseline.activity_variance)))
      }
      
      participant_threshold = %{
        upper: baseline.participant_baseline.average_participants + (@anomaly_detection_threshold * :math.sqrt(baseline.participant_baseline.participant_variance)),
        lower: max(0, baseline.participant_baseline.average_participants - (@anomaly_detection_threshold * :math.sqrt(baseline.participant_baseline.participant_variance)))
      }
      
      value_threshold = %{
        upper: baseline.value_baseline.average_value + (@anomaly_detection_threshold * :math.sqrt(baseline.value_baseline.value_variance)),
        high_value_alert: baseline.value_baseline.max_value * 2  # Alert on values 2x historical max
      }
      
      {system_id, %{
        killmail_threshold: killmail_threshold,
        participant_threshold: participant_threshold,
        value_threshold: value_threshold
      }}
    end)
    |> Enum.into(%{})
  end
  
  defp calculate_pattern_baseline(historical_data) do
    # Simplified pattern baseline - would integrate with actual pattern detection
    system_patterns = Enum.map(historical_data.system_data, fn {system_id, data} ->
      killmails = data.killmails
      
      pattern_metrics = %{
        engagement_patterns: analyze_engagement_patterns(killmails),
        temporal_patterns: analyze_pattern_temporal_distribution(killmails),
        participant_patterns: analyze_participant_patterns(killmails),
        value_patterns: analyze_value_patterns(killmails)
      }
      
      {system_id, pattern_metrics}
    end)
    |> Enum.into(%{})
    
    {:ok, %{
      system_patterns: system_patterns,
      pattern_baseline_confidence: calculate_pattern_baseline_confidence(system_patterns),
      common_patterns: identify_common_patterns(system_patterns),
      anomaly_patterns: []  # Would be populated with known anomaly signatures
    }}
  end
  
  defp analyze_engagement_patterns(killmails) do
    if Enum.empty?(killmails) do
      %{pattern_type: :no_engagements}
    else
      # Classify engagements by participant count
      engagement_types = Enum.map(killmails, fn km ->
        participant_count = count_killmail_participants(km)
        
        cond do
          participant_count <= 2 -> :solo
          participant_count <= 5 -> :small_gang
          participant_count <= 15 -> :medium_fleet
          true -> :large_fleet
        end
      end)
      |> Enum.frequencies()
      
      dominant_pattern = engagement_types
      |> Enum.max_by(fn {_, count} -> count end)
      |> elem(0)
      
      %{
        engagement_distribution: engagement_types,
        dominant_pattern: dominant_pattern,
        total_engagements: Kernel.length(killmails),
        diversity_index: calculate_engagement_diversity(engagement_types)
      }
    end
  end
  
  defp calculate_engagement_diversity(engagement_types) do
    total = engagement_types |> Map.values() |> Enum.sum()
    
    if total == 0 do
      0.0
    else
      # Shannon diversity index
      diversity = engagement_types
      |> Map.values()
      |> Enum.map(fn count ->
        p = count / total
        if p > 0, do: -p * :math.log2(p), else: 0
      end)
      |> Enum.sum()
      
      Float.round(diversity, 2)
    end
  end
  
  defp analyze_pattern_temporal_distribution(killmails) do
    if Enum.empty?(killmails) do
      %{pattern: :no_temporal_data}
    else
      # Analyze when different types of engagements occur
      hourly_patterns = killmails
      |> Enum.group_by(& &1.timestamp.hour)
      |> Enum.map(fn {hour, hour_killmails} ->
        engagement_types = Enum.map(hour_killmails, fn km ->
          participant_count = count_killmail_participants(km)
          
          cond do
            participant_count <= 2 -> :solo
            participant_count <= 5 -> :small_gang
            participant_count <= 15 -> :medium_fleet
            true -> :large_fleet
          end
        end)
        |> Enum.frequencies()
        
        {hour, engagement_types}
      end)
      |> Enum.into(%{})
      
      %{
        hourly_patterns: hourly_patterns,
        peak_activity_patterns: identify_peak_pattern_hours(hourly_patterns),
        pattern_consistency: assess_pattern_consistency(hourly_patterns)
      }
    end
  end
  
  defp identify_peak_pattern_hours(hourly_patterns) do
    hourly_patterns
    |> Enum.map(fn {hour, patterns} ->
      total_activity = patterns |> Map.values() |> Enum.sum()
      {hour, total_activity}
    end)
    |> Enum.sort_by(fn {_, activity} -> -activity end)
    |> Enum.take(3)
    |> Enum.map(fn {hour, _} -> hour end)
  end
  
  defp assess_pattern_consistency(hourly_patterns) do
    if Kernel.map_size(hourly_patterns) < 5 do
      :insufficient_data
    else
      # Check if similar patterns occur at similar times
      # Simplified consistency check
      pattern_variations = hourly_patterns
      |> Map.values()
      |> Enum.map(fn patterns ->
        total = patterns |> Map.values() |> Enum.sum()
        
        if total > 0 do
          # Calculate dominant pattern for this hour
          patterns
          |> Enum.max_by(fn {_, count} -> count end)
          |> elem(0)
        else
          :no_activity
        end
      end)
      |> Enum.frequencies()
      
      # If one pattern dominates most hours, it's consistent
      max_pattern_hours = pattern_variations |> Map.values() |> Enum.max(fn -> 0 end)
      total_hours = pattern_variations |> Map.values() |> Enum.sum()
      
      consistency_ratio = if total_hours > 0, do: max_pattern_hours / total_hours, else: 0
      
      cond do
        consistency_ratio >= 0.7 -> :very_consistent
        consistency_ratio >= 0.5 -> :consistent
        consistency_ratio >= 0.3 -> :moderately_consistent
        true -> :inconsistent
      end
    end
  end
  
  defp analyze_participant_patterns(killmails) do
    if Enum.empty?(killmails) do
      %{pattern_type: :no_participants}
    else
      # Extract unique participants and analyze their patterns
      all_participants = killmails
      |> Enum.flat_map(fn km ->
        victim = [km.victim_character_id]
        
        attackers = case km.zkb_data do
          %{"attackers" => attackers} when is_list(attackers) ->
            Enum.map(attackers, & &1["character_id"])
          _ -> []
        end
        
        victim ++ attackers
      end)
      |> Enum.filter(& &1)
      
      unique_participants = Enum.uniq(all_participants)
      
      # Analyze participant frequency
      participant_frequency = Enum.frequencies(all_participants)
      
      # Identify frequent participants (potential key players)
      frequent_participants = participant_frequency
      |> Enum.filter(fn {_, count} -> count >= 3 end)
      |> Enum.sort_by(fn {_, count} -> -count end)
      |> Enum.take(10)
      
      %{
        total_unique_participants: Kernel.length(unique_participants),
        frequent_participants: frequent_participants,
        participation_distribution: analyze_participation_distribution(participant_frequency),
        key_player_indicators: identify_key_players(frequent_participants, killmails)
      }
    end
  end
  
  defp analyze_participation_distribution(participant_frequency) do
    frequency_counts = participant_frequency
    |> Map.values()
    |> Enum.frequencies()
    
    %{
      single_appearance: Map.get(frequency_counts, 1, 0),
      multiple_appearances: frequency_counts |> Map.drop([1]) |> Map.values() |> Enum.sum(),
      max_appearances: frequency_counts |> Map.keys() |> Enum.max(fn -> 0 end),
      distribution_type: classify_participation_distribution(frequency_counts)
    }
  end
  
  defp classify_participation_distribution(frequency_counts) do
    total_participants = frequency_counts |> Map.values() |> Enum.sum()
    single_appearances = Map.get(frequency_counts, 1, 0)
    
    if total_participants == 0 do
      :no_data
    else
      single_ratio = single_appearances / total_participants
      
      cond do
        single_ratio >= 0.8 -> :mostly_transient
        single_ratio >= 0.6 -> :mixed_transient
        single_ratio >= 0.4 -> :balanced
        single_ratio >= 0.2 -> :mostly_regular
        true -> :highly_regular
      end
    end
  end
  
  defp identify_key_players(frequent_participants, killmails) do
    Enum.map(frequent_participants, fn {participant_id, frequency} ->
      # Analyze this participant's role patterns
      participant_killmails = Enum.filter(killmails, fn km ->
        participant_in_killmail?(participant_id, km)
      end)
      
      roles = analyze_participant_roles(participant_id, participant_killmails)
      
      %{
        participant_id: participant_id,
        appearance_frequency: frequency,
        roles: roles,
        activity_span: calculate_activity_span(participant_killmails),
        influence_score: calculate_influence_score(frequency, roles, participant_killmails)
      }
    end)
  end
  
  defp participant_in_killmail?(participant_id, killmail) do
    victim_match = killmail.victim_character_id == participant_id
    
    attacker_match = case killmail.zkb_data do
      %{"attackers" => attackers} when is_list(attackers) ->
        Enum.any?(attackers, & &1["character_id"] == participant_id)
      _ -> false
    end
    
    victim_match or attacker_match
  end
  
  defp analyze_participant_roles(participant_id, participant_killmails) do
    roles = Enum.map(participant_killmails, fn km ->
      if km.victim_character_id == participant_id do
        :victim
      else
        :attacker
      end
    end)
    |> Enum.frequencies()
    
    total_roles = roles |> Map.values() |> Enum.sum()
    
    %{
      victim_count: Map.get(roles, :victim, 0),
      attacker_count: Map.get(roles, :attacker, 0),
      survival_rate: if(total_roles > 0, do: Float.round(Map.get(roles, :attacker, 0) / total_roles, 2), else: 0.0),
      role_preference: if(Map.get(roles, :attacker, 0) > Map.get(roles, :victim, 0), do: :aggressive, else: :defensive)
    }
  end
  
  defp calculate_activity_span(participant_killmails) do
    if Kernel.length(participant_killmails) <= 1 do
      0
    else
      timestamps = Enum.map(participant_killmails, & &1.timestamp) |> Enum.sort(DateTime)
      first = List.first(timestamps)
      last = List.last(timestamps)
      
      DateTime.diff(last, first, :hour)
    end
  end
  
  defp calculate_influence_score(frequency, roles, participant_killmails) do
    # Simple influence score based on multiple factors
    frequency_score = min(10, frequency)  # Cap at 10
    survival_score = roles.survival_rate * 5
    span_score = min(5, calculate_activity_span(participant_killmails) / 24)  # Days of activity
    
    Float.round(frequency_score + survival_score + span_score, 2)
  end
  
  defp analyze_value_patterns(killmails) do
    if Enum.empty?(killmails) do
      %{pattern_type: :no_value_data}
    else
      values = Enum.map(killmails, & &1.total_value || 0)
      
      value_ranges = classify_value_ranges(values)
      temporal_value_patterns = analyze_temporal_value_patterns(killmails)
      
      %{
        value_distribution: value_ranges,
        temporal_patterns: temporal_value_patterns,
        high_value_indicators: identify_high_value_patterns(killmails),
        economic_impact: assess_economic_impact(values)
      }
    end
  end
  
  defp classify_value_ranges(values) do
    ranges = %{
      low: Enum.count(values, & &1 < 100_000_000),        # < 100M
      medium: Enum.count(values, fn v -> v >= 100_000_000 and v < 1_000_000_000 end),  # 100M - 1B
      high: Enum.count(values, fn v -> v >= 1_000_000_000 and v < 10_000_000_000 end), # 1B - 10B
      very_high: Enum.count(values, & &1 >= 10_000_000_000) # > 10B
    }
    
    total = Enum.sum(Map.values(ranges))
    
    if total > 0 do
      percentages = Enum.map(ranges, fn {range, count} ->
        {range, Float.round(count * 100 / total, 1)}
      end)
      |> Enum.into(%{})
      
      %{
        counts: ranges,
        percentages: percentages,
        dominant_range: ranges |> Enum.max_by(fn {_, count} -> count end) |> elem(0)
      }
    else
      %{counts: ranges, percentages: %{}, dominant_range: :no_data}
    end
  end
  
  defp analyze_temporal_value_patterns(killmails) do
    hourly_values = killmails
    |> Enum.group_by(& &1.timestamp.hour)
    |> Enum.map(fn {hour, hour_killmails} ->
      total_value = hour_killmails |> Enum.map(& &1.total_value || 0) |> Enum.sum()
      avg_value = if Kernel.length(hour_killmails) > 0 do
        total_value / Kernel.length(hour_killmails)
      else
        0
      end
      
      {hour, %{total_value: total_value, average_value: avg_value, kill_count: Kernel.length(hour_killmails)}}
    end)
    |> Enum.into(%{})
    
    peak_value_hours = hourly_values
    |> Enum.sort_by(fn {_, data} -> -data.total_value end)
    |> Enum.take(3)
    |> Enum.map(fn {hour, _} -> hour end)
    
    %{
      hourly_values: hourly_values,
      peak_value_hours: peak_value_hours,
      value_concentration: assess_value_concentration(hourly_values)
    }
  end
  
  defp assess_value_concentration(hourly_values) do
    if Enum.empty?(hourly_values) do
      :no_data
    else
      total_value = hourly_values |> Map.values() |> Enum.map(& &1.total_value) |> Enum.sum()
      
      if total_value == 0 do
        :no_value
      else
        # Calculate Gini coefficient for value concentration
        values = hourly_values |> Map.values() |> Enum.map(& &1.total_value) |> Enum.sort()
        n = Kernel.length(values)
        
        if n <= 1 do
          :insufficient_data
        else
          index_sum = values
          |> Enum.with_index(1)
          |> Enum.map(fn {value, index} -> value * index end)
          |> Enum.sum()
          
          gini = (2 * index_sum) / (n * total_value) - (n + 1) / n
          
          cond do
            gini >= 0.7 -> :highly_concentrated
            gini >= 0.5 -> :moderately_concentrated
            gini >= 0.3 -> :somewhat_concentrated
            true -> :evenly_distributed
          end
        end
      end
    end
  end
  
  defp identify_high_value_patterns(killmails) do
    high_value_kills = Enum.filter(killmails, & (&1.total_value || 0) >= 1_000_000_000)
    
    if Enum.empty?(high_value_kills) do
      %{pattern_type: :no_high_value}
    else
      # Analyze patterns in high-value kills
      temporal_distribution = high_value_kills
      |> Enum.map(& &1.timestamp.hour)
      |> Enum.frequencies()
      
      participant_analysis = high_value_kills
      |> Enum.map(&count_killmail_participants/1)
      |> Enum.frequencies()
      
      %{
        high_value_count: Kernel.length(high_value_kills),
        temporal_distribution: temporal_distribution,
        participant_patterns: participant_analysis,
        average_value: Float.round(Enum.sum(Enum.map(high_value_kills, & &1.total_value || 0)) / Kernel.length(high_value_kills), 0),
        clustering: assess_high_value_clustering(high_value_kills)
      }
    end
  end
  
  defp assess_high_value_clustering(high_value_kills) do
    if Kernel.length(high_value_kills) < 3 do
      :insufficient_data
    else
      timestamps = high_value_kills |> Enum.map(& &1.timestamp) |> Enum.sort(DateTime)
      
      # Calculate time gaps between high-value kills
      gaps = timestamps
      |> Enum.chunk_every(2, 1, :discard)
      |> Enum.map(fn [t1, t2] -> DateTime.diff(t2, t1, :hour) end)
      
      avg_gap = Enum.sum(gaps) / Kernel.length(gaps)
      
      cond do
        avg_gap <= 2 -> :highly_clustered
        avg_gap <= 6 -> :moderately_clustered
        avg_gap <= 24 -> :loosely_clustered
        true -> :distributed
      end
    end
  end
  
  defp assess_economic_impact(values) do
    total_value = Enum.sum(values)
    
    impact_level = cond do
      total_value >= 100_000_000_000 -> :massive
      total_value >= 50_000_000_000 -> :major
      total_value >= 10_000_000_000 -> :significant
      total_value >= 1_000_000_000 -> :moderate
      total_value >= 100_000_000 -> :minor
      true -> :negligible
    end
    
    %{
      total_value: total_value,
      impact_level: impact_level,
      average_kill_value: if(Kernel.length(values) > 0, do: Float.round(total_value / Kernel.length(values), 0), else: 0)
    }
  end
  
  defp calculate_pattern_baseline_confidence(system_patterns) do
    if Enum.empty?(system_patterns) do
      0.0
    else
      # Calculate confidence based on data consistency across systems
      systems_with_patterns = system_patterns
      |> Map.values()
      |> Enum.count(fn patterns ->
        patterns.engagement_patterns.total_engagements > 0
      end)
      
      pattern_coverage = systems_with_patterns / Kernel.map_size(system_patterns)
      
      # Check for consistent patterns across systems
      consistent_patterns = system_patterns
      |> Map.values()
      |> Enum.count(fn patterns ->
        patterns.temporal_patterns.pattern_consistency in [:very_consistent, :consistent]
      end)
      
      consistency_ratio = consistent_patterns / Kernel.map_size(system_patterns)
      
      confidence = (pattern_coverage * 0.6) + (consistency_ratio * 0.4)
      Float.round(confidence, 2)
    end
  end
  
  defp identify_common_patterns(system_patterns) do
    if Enum.empty?(system_patterns) do
      []
    else
      # Find engagement patterns that appear across multiple systems
      all_dominant_patterns = system_patterns
      |> Map.values()
      |> Enum.map(& &1.engagement_patterns.dominant_pattern)
      |> Enum.frequencies()
      
      # Find temporal patterns that are common
      common_temporal_patterns = system_patterns
      |> Map.values()
      |> Enum.map(& &1.temporal_patterns.pattern_consistency)
      |> Enum.frequencies()
      
      [
        %{
          pattern_type: :engagement_patterns,
          common_patterns: all_dominant_patterns
        },
        %{
          pattern_type: :temporal_consistency,
          common_patterns: common_temporal_patterns
        }
      ]
    end
  end
  
  defp calculate_threat_baseline(historical_data) do
    # Simplified threat baseline calculation
    threat_indicators = Enum.map(historical_data.system_data, fn {system_id, data} ->
      killmails = data.killmails
      
      threat_metrics = %{
        high_value_threats: count_high_value_threats(killmails),
        capital_ship_threats: count_capital_ship_threats(killmails),
        fleet_threats: count_fleet_threats(killmails),
        pod_kills: count_pod_kills(killmails),
        threat_frequency: calculate_threat_frequency(killmails),
        threat_severity: assess_threat_severity(killmails)
      }
      
      {system_id, threat_metrics}
    end)
    |> Enum.into(%{})
    
    aggregate_threats = calculate_aggregate_threat_baseline(threat_indicators)
    
    {:ok, %{
      system_threats: threat_indicators,
      aggregate_threats: aggregate_threats,
      threat_baseline_confidence: calculate_threat_baseline_confidence(threat_indicators),
      threat_alert_thresholds: calculate_threat_alert_thresholds(threat_indicators)
    }}
  end
  
  defp count_high_value_threats(killmails) do
    Enum.count(killmails, & (&1.total_value || 0) >= 5_000_000_000)  # 5B+ ISK
  end
  
  defp count_capital_ship_threats(killmails) do
    # Simplified capital ship detection
    Enum.count(killmails, fn km ->
      victim_ship = km.victim_ship_type_id || 0
      victim_ship > 20_000  # Simplified capital ship ID range
    end)
  end
  
  defp count_fleet_threats(killmails) do
    Enum.count(killmails, fn km ->
      count_killmail_participants(km) >= 15  # 15+ participants = fleet threat
    end)
  end
  
  defp count_pod_kills(killmails) do
    Enum.count(killmails, fn km ->
      victim_ship = km.victim_ship_type_id || 0
      victim_ship >= 670 and victim_ship <= 680  # Pod ship type range
    end)
  end
  
  defp calculate_threat_frequency(killmails) do
    if Enum.empty?(killmails) do
      0.0
    else
      threat_events = count_high_value_threats(killmails) + 
                     count_capital_ship_threats(killmails) + 
                     count_fleet_threats(killmails)
      
      # Calculate threats per hour
      if Kernel.length(killmails) > 0 do
        timestamps = Enum.map(killmails, & &1.timestamp) |> Enum.sort(DateTime)
        first = List.first(timestamps)
        last = List.last(timestamps)
        
        hours_span = max(1, DateTime.diff(last, first, :hour))
        Float.round(threat_events / hours_span, 2)
      else
        0.0
      end
    end
  end
  
  defp assess_threat_severity(killmails) do
    if Enum.empty?(killmails) do
      :no_threats
    else
      threat_score = 0
      threat_score = threat_score + (count_high_value_threats(killmails) * 3)
      threat_score = threat_score + (count_capital_ship_threats(killmails) * 5)
      threat_score = threat_score + (count_fleet_threats(killmails) * 2)
      threat_score = threat_score + count_pod_kills(killmails)
      
      cond do
        threat_score >= 20 -> :critical
        threat_score >= 10 -> :high
        threat_score >= 5 -> :moderate
        threat_score >= 1 -> :low
        true -> :minimal
      end
    end
  end
  
  defp calculate_aggregate_threat_baseline(threat_indicators) do
    if Enum.empty?(threat_indicators) do
      %{overall_threat_level: :no_threats}
    else
      total_high_value = threat_indicators |> Map.values() |> Enum.map(& &1.high_value_threats) |> Enum.sum()
      total_capital = threat_indicators |> Map.values() |> Enum.map(& &1.capital_ship_threats) |> Enum.sum()
      total_fleet = threat_indicators |> Map.values() |> Enum.map(& &1.fleet_threats) |> Enum.sum()
      
      avg_frequency = threat_indicators
      |> Map.values()
      |> Enum.map(& &1.threat_frequency)
      |> Enum.sum()
      |> Kernel./(Kernel.map_size(threat_indicators))
      
      severity_distribution = threat_indicators
      |> Map.values()
      |> Enum.map(& &1.threat_severity)
      |> Enum.frequencies()
      
      overall_threat = assess_overall_threat_level(total_high_value, total_capital, total_fleet, avg_frequency)
      
      %{
        total_high_value_threats: total_high_value,
        total_capital_threats: total_capital,
        total_fleet_threats: total_fleet,
        average_threat_frequency: Float.round(avg_frequency, 2),
        severity_distribution: severity_distribution,
        overall_threat_level: overall_threat,
        systems_count: Kernel.map_size(threat_indicators)
      }
    end
  end
  
  defp assess_overall_threat_level(high_value_count, capital_count, fleet_count, avg_frequency) do
    threat_score = (high_value_count * 3) + (capital_count * 5) + (fleet_count * 2) + (avg_frequency * 10)
    
    cond do
      threat_score >= 50 -> :critical
      threat_score >= 25 -> :high
      threat_score >= 10 -> :moderate
      threat_score >= 3 -> :low
      true -> :minimal
    end
  end
  
  defp calculate_threat_baseline_confidence(threat_indicators) do
    if Enum.empty?(threat_indicators) do
      0.0
    else
      # Base confidence on threat data availability and consistency
      systems_with_threats = threat_indicators
      |> Map.values()
      |> Enum.count(fn threats ->
        threats.high_value_threats + threats.capital_ship_threats + threats.fleet_threats > 0
      end)
      
      threat_coverage = systems_with_threats / Kernel.map_size(threat_indicators)
      
      # Consistent threat levels indicate reliable baseline
      severity_levels = threat_indicators
      |> Map.values()
      |> Enum.map(& &1.threat_severity)
      |> Enum.frequencies()
      
      # If most systems have similar threat levels, confidence is higher
      max_severity_count = severity_levels |> Map.values() |> Enum.max(fn -> 0 end)
      total_systems = severity_levels |> Map.values() |> Enum.sum()
      
      consistency_ratio = if total_systems > 0, do: max_severity_count / total_systems, else: 0
      
      confidence = (threat_coverage * 0.6) + (consistency_ratio * 0.4)
      Float.round(confidence, 2)
    end
  end
  
  defp calculate_threat_alert_thresholds(threat_indicators) do
    Enum.map(threat_indicators, fn {system_id, threats} ->
      thresholds = %{
        high_value_alert: max(1, threats.high_value_threats + 2),  # Alert if 2+ above baseline
        capital_alert: max(1, threats.capital_ship_threats + 1),   # Alert if 1+ above baseline
        fleet_alert: max(1, threats.fleet_threats + 1),           # Alert if 1+ above baseline
        frequency_alert: threats.threat_frequency * 2,            # Alert if frequency doubles
        severity_escalation: escalate_threat_severity(threats.threat_severity)
      }
      
      {system_id, thresholds}
    end)
    |> Enum.into(%{})
  end
  
  defp escalate_threat_severity(current_severity) do
    case current_severity do
      :minimal -> :low
      :low -> :moderate
      :moderate -> :high
      :high -> :critical
      :critical -> :critical  # Already at max
      _ -> :moderate
    end
  end
  
  defp maybe_calculate_predictive_baseline(historical_data, true) do
    # Simplified predictive baseline - would integrate with machine learning models
    calculate_predictive_patterns(historical_data)
  end
  
  defp maybe_calculate_predictive_baseline(_historical_data, false) do
    {:ok, nil}
  end
  
  defp calculate_predictive_patterns(historical_data) do
    # Analyze trends for prediction
    trend_analysis = analyze_baseline_trends(historical_data)
    seasonal_patterns = identify_seasonal_patterns(historical_data)
    escalation_indicators = identify_escalation_indicators(historical_data)
    
    {:ok, %{
      trend_analysis: trend_analysis,
      seasonal_patterns: seasonal_patterns,
      escalation_indicators: escalation_indicators,
      prediction_confidence: calculate_prediction_confidence(trend_analysis, seasonal_patterns),
      prediction_horizon_hours: 24  # 24-hour prediction window
    }}
  end
  
  defp analyze_baseline_trends(historical_data) do
    # Simple trend analysis on activity levels
    system_trends = Enum.map(historical_data.system_data, fn {system_id, data} ->
      killmails = data.killmails
      
      if Kernel.length(killmails) >= 10 do
        # Split into early and late periods
        sorted_killmails = Enum.sort_by(killmails, & &1.timestamp, DateTime)
        mid_point = div(Kernel.length(sorted_killmails), 2)
        
        early_period = Enum.take(sorted_killmails, mid_point)
        late_period = Enum.drop(sorted_killmails, mid_point)
        
        early_activity = Kernel.length(early_period)
        late_activity = Kernel.length(late_period)
        
        trend = cond do
          late_activity > early_activity * 1.5 -> :strong_increase
          late_activity > early_activity * 1.2 -> :moderate_increase
          late_activity < early_activity * 0.8 -> :moderate_decrease
          late_activity < early_activity * 0.5 -> :strong_decrease
          true -> :stable
        end
        
        {system_id, %{
          trend: trend,
          early_activity: early_activity,
          late_activity: late_activity,
          trend_strength: abs(late_activity - early_activity) / max(early_activity, 1)
        }}
      else
        {system_id, %{trend: :insufficient_data, trend_strength: 0.0}}
      end
    end)
    |> Enum.into(%{})
    
    # Overall trend
    increasing_systems = system_trends
    |> Map.values()
    |> Enum.count(& &1.trend in [:strong_increase, :moderate_increase])
    
    decreasing_systems = system_trends
    |> Map.values()
    |> Enum.count(& &1.trend in [:strong_decrease, :moderate_decrease])
    
    overall_trend = cond do
      increasing_systems > decreasing_systems -> :overall_increase
      decreasing_systems > increasing_systems -> :overall_decrease
      true -> :overall_stable
    end
    
    %{
      system_trends: system_trends,
      overall_trend: overall_trend,
      trend_confidence: calculate_trend_confidence(system_trends)
    }
  end
  
  defp calculate_trend_confidence(system_trends) do
    systems_with_data = system_trends
    |> Map.values()
    |> Enum.count(& &1.trend != :insufficient_data)
    
    total_systems = Kernel.map_size(system_trends)
    
    if total_systems > 0, do: Float.round(systems_with_data / total_systems, 2), else: 0.0
  end
  
  defp identify_seasonal_patterns(historical_data) do
    # Analyze patterns by day of week and hour
    all_killmails = historical_data.system_data
    |> Map.values()
    |> Enum.flat_map(& &1.killmails)
    
    if Kernel.length(all_killmails) >= 50 do
      daily_patterns = all_killmails
      |> Enum.map(& Date.day_of_week(&1.timestamp))
      |> Enum.frequencies()
      
      hourly_patterns = all_killmails
      |> Enum.map(& &1.timestamp.hour)
      |> Enum.frequencies()
      
      %{
        daily_patterns: daily_patterns,
        hourly_patterns: hourly_patterns,
        peak_day: daily_patterns |> Enum.max_by(fn {_, count} -> count end) |> elem(0),
        peak_hour: hourly_patterns |> Enum.max_by(fn {_, count} -> count end) |> elem(0),
        pattern_strength: assess_pattern_strength(daily_patterns, hourly_patterns)
      }
    else
      %{
        pattern_type: :insufficient_data,
        pattern_strength: 0.0
      }
    end
  end
  
  defp assess_pattern_strength(daily_patterns, hourly_patterns) do
    # Calculate how concentrated the activity is in specific times
    total_daily = daily_patterns |> Map.values() |> Enum.sum()
    max_daily = daily_patterns |> Map.values() |> Enum.max(fn -> 0 end)
    
    total_hourly = hourly_patterns |> Map.values() |> Enum.sum()
    max_hourly = hourly_patterns |> Map.values() |> Enum.max(fn -> 0 end)
    
    daily_concentration = if total_daily > 0, do: max_daily / total_daily, else: 0
    hourly_concentration = if total_hourly > 0, do: max_hourly / total_hourly, else: 0
    
    # Average concentration indicates pattern strength
    Float.round((daily_concentration + hourly_concentration) / 2, 2)
  end
  
  defp identify_escalation_indicators(historical_data) do
    # Look for patterns that typically precede escalation
    all_killmails = historical_data.system_data
    |> Map.values()
    |> Enum.flat_map(& &1.killmails)
    
    if Kernel.length(all_killmails) >= 20 do
      # Analyze value escalation
      value_trend = analyze_value_escalation(all_killmails)
      
      # Analyze participant escalation
      participant_trend = analyze_participant_escalation(all_killmails)
      
      # Analyze frequency escalation
      frequency_trend = analyze_frequency_escalation(all_killmails)
      
      escalation_score = calculate_escalation_score(value_trend, participant_trend, frequency_trend)
      
      %{
        value_trend: value_trend,
        participant_trend: participant_trend,
        frequency_trend: frequency_trend,
        escalation_score: escalation_score,
        escalation_likelihood: classify_escalation_likelihood(escalation_score)
      }
    else
      %{
        indicator_type: :insufficient_data,
        escalation_likelihood: :unknown
      }
    end
  end
  
  defp analyze_value_escalation(killmails) do
    sorted_killmails = Enum.sort_by(killmails, & &1.timestamp, DateTime)
    
    if Kernel.length(sorted_killmails) >= 10 do
      # Compare early vs late values
      mid_point = div(Kernel.length(sorted_killmails), 2)
      early_values = Enum.take(sorted_killmails, mid_point) |> Enum.map(& &1.total_value || 0)
      late_values = Enum.drop(sorted_killmails, mid_point) |> Enum.map(& &1.total_value || 0)
      
      early_avg = if Enum.empty?(early_values), do: 0, else: Enum.sum(early_values) / Kernel.length(early_values)
      late_avg = if Enum.empty?(late_values), do: 0, else: Enum.sum(late_values) / Kernel.length(late_values)
      
      if early_avg > 0 do
        escalation_ratio = late_avg / early_avg
        
        cond do
          escalation_ratio >= 2.0 -> :strong_escalation
          escalation_ratio >= 1.5 -> :moderate_escalation
          escalation_ratio <= 0.5 -> :de_escalation
          true -> :stable
        end
      else
        :no_baseline
      end
    else
      :insufficient_data
    end
  end
  
  defp analyze_participant_escalation(killmails) do
    sorted_killmails = Enum.sort_by(killmails, & &1.timestamp, DateTime)
    
    if Kernel.length(sorted_killmails) >= 10 do
      mid_point = div(Kernel.length(sorted_killmails), 2)
      early_participants = Enum.take(sorted_killmails, mid_point) |> Enum.map(&count_killmail_participants/1)
      late_participants = Enum.drop(sorted_killmails, mid_point) |> Enum.map(&count_killmail_participants/1)
      
      early_avg = Enum.sum(early_participants) / Kernel.length(early_participants)
      late_avg = Enum.sum(late_participants) / Kernel.length(late_participants)
      
      if early_avg > 0 do
        escalation_ratio = late_avg / early_avg
        
        cond do
          escalation_ratio >= 2.0 -> :strong_escalation
          escalation_ratio >= 1.5 -> :moderate_escalation
          escalation_ratio <= 0.5 -> :de_escalation
          true -> :stable
        end
      else
        :no_baseline
      end
    else
      :insufficient_data
    end
  end
  
  defp analyze_frequency_escalation(killmails) do
    if Kernel.length(killmails) >= 20 do
      sorted_killmails = Enum.sort_by(killmails, & &1.timestamp, DateTime)
      
      # Divide into time periods and compare frequency
      mid_point = div(Kernel.length(sorted_killmails), 2)
      early_period = Enum.take(sorted_killmails, mid_point)
      late_period = Enum.drop(sorted_killmails, mid_point)
      
      early_span = if Kernel.length(early_period) > 1 do
        DateTime.diff(List.last(early_period).timestamp, List.first(early_period).timestamp, :hour)
      else
        1
      end
      
      late_span = if Kernel.length(late_period) > 1 do
        DateTime.diff(List.last(late_period).timestamp, List.first(late_period).timestamp, :hour)
      else
        1
      end
      
      early_frequency = Kernel.length(early_period) / max(early_span, 1)
      late_frequency = Kernel.length(late_period) / max(late_span, 1)
      
      if early_frequency > 0 do
        frequency_ratio = late_frequency / early_frequency
        
        cond do
          frequency_ratio >= 2.0 -> :strong_escalation
          frequency_ratio >= 1.5 -> :moderate_escalation
          frequency_ratio <= 0.5 -> :de_escalation
          true -> :stable
        end
      else
        :no_baseline
      end
    else
      :insufficient_data
    end
  end
  
  defp calculate_escalation_score(value_trend, participant_trend, frequency_trend) do
    score = 0
    
    score = case value_trend do
      :strong_escalation -> score + 3
      :moderate_escalation -> score + 2
      :de_escalation -> score - 1
      _ -> score
    end
    
    score = case participant_trend do
      :strong_escalation -> score + 3
      :moderate_escalation -> score + 2
      :de_escalation -> score - 1
      _ -> score
    end
    
    score = case frequency_trend do
      :strong_escalation -> score + 3
      :moderate_escalation -> score + 2
      :de_escalation -> score - 1
      _ -> score
    end
    
    score
  end
  
  defp classify_escalation_likelihood(escalation_score) do
    cond do
      escalation_score >= 7 -> :very_high
      escalation_score >= 5 -> :high
      escalation_score >= 3 -> :moderate
      escalation_score >= 1 -> :low
      escalation_score <= -2 -> :de_escalation_likely
      true -> :stable
    end
  end
  
  defp calculate_prediction_confidence(trend_analysis, seasonal_patterns) do
    trend_confidence = trend_analysis.trend_confidence
    
    pattern_confidence = case seasonal_patterns do
      %{pattern_strength: strength} -> strength
      _ -> 0.0
    end
    
    # Combine confidences
    overall_confidence = (trend_confidence * 0.6) + (pattern_confidence * 0.4)
    Float.round(overall_confidence, 2)
  end
  
  defp compile_baseline_metrics(activity_baseline, pattern_baseline, threat_baseline, predictive_baseline) do
    {:ok, %{
      activity_confidence: activity_baseline.baseline_confidence,
      pattern_confidence: pattern_baseline.pattern_baseline_confidence,
      threat_confidence: threat_baseline.threat_baseline_confidence,
      predictive_confidence: if(predictive_baseline, do: predictive_baseline.prediction_confidence, else: 0.0),
      overall_baseline_quality: calculate_overall_baseline_quality(
        activity_baseline.baseline_confidence,
        pattern_baseline.pattern_baseline_confidence,
        threat_baseline.threat_baseline_confidence
      ),
      baseline_completeness: assess_baseline_completeness(activity_baseline, pattern_baseline, threat_baseline),
      anomaly_detection_readiness: assess_anomaly_detection_readiness(activity_baseline, threat_baseline)
    }}
  end
  
  defp calculate_overall_baseline_quality(activity_conf, pattern_conf, threat_conf) do
    # Weighted average of confidence levels
    overall = (activity_conf * 0.4) + (pattern_conf * 0.3) + (threat_conf * 0.3)
    Float.round(overall, 2)
  end
  
  defp assess_baseline_completeness(activity_baseline, pattern_baseline, threat_baseline) do
    components = []
    
    components = if activity_baseline.baseline_confidence >= 0.5, do: [:activity | components], else: components
    components = if pattern_baseline.pattern_baseline_confidence >= 0.5, do: [:patterns | components], else: components
    components = if threat_baseline.threat_baseline_confidence >= 0.5, do: [:threats | components], else: components
    
    completeness_ratio = Kernel.length(components) / 3
    
    %{
      complete_components: components,
      completeness_ratio: Float.round(completeness_ratio, 2),
      completeness_level: cond do
        completeness_ratio >= 1.0 -> :complete
        completeness_ratio >= 0.67 -> :mostly_complete
        completeness_ratio >= 0.33 -> :partially_complete
        true -> :incomplete
      end
    }
  end
  
  defp assess_anomaly_detection_readiness(activity_baseline, threat_baseline) do
    activity_ready = activity_baseline.baseline_confidence >= 0.6
    threat_ready = threat_baseline.threat_baseline_confidence >= 0.6
    
    thresholds_available = not Enum.empty?(activity_baseline.anomaly_detection_thresholds)
    
    readiness_score = 0
    readiness_score = if activity_ready, do: readiness_score + 40, else: readiness_score
    readiness_score = if threat_ready, do: readiness_score + 40, else: readiness_score
    readiness_score = if thresholds_available, do: readiness_score + 20, else: readiness_score
    
    %{
      readiness_score: readiness_score,
      readiness_level: cond do
        readiness_score >= 80 -> :fully_ready
        readiness_score >= 60 -> :mostly_ready
        readiness_score >= 40 -> :partially_ready
        true -> :not_ready
      end,
      requirements_met: %{
        activity_baseline: activity_ready,
        threat_baseline: threat_ready,
        thresholds_configured: thresholds_available
      }
    }
  end
  
  defp validate_baseline_quality(baseline_metrics, confidence_threshold) do
    validation_results = []
    
    # Check overall quality
    quality_check = if baseline_metrics.overall_baseline_quality >= confidence_threshold do
      {:pass, "Baseline quality meets confidence threshold"}
    else
      {:fail, "Baseline quality below confidence threshold (#{baseline_metrics.overall_baseline_quality} < #{confidence_threshold})"}
    end
    
    validation_results = [quality_check | validation_results]
    
    # Check completeness
    completeness_check = if baseline_metrics.baseline_completeness.completeness_ratio >= 0.67 do
      {:pass, "Baseline completeness acceptable"}
    else
      {:fail, "Baseline completeness insufficient (#{baseline_metrics.baseline_completeness.completeness_ratio} < 0.67)"}
    end
    
    validation_results = [completeness_check | validation_results]
    
    # Check anomaly detection readiness
    anomaly_check = if baseline_metrics.anomaly_detection_readiness.readiness_score >= 60 do
      {:pass, "Anomaly detection ready"}
    else
      {:fail, "Anomaly detection not ready (score: #{baseline_metrics.anomaly_detection_readiness.readiness_score})"}
    end
    
    validation_results = [anomaly_check | validation_results]
    
    # Overall validation
    failed_checks = Enum.count(validation_results, fn {status, _} -> status == :fail end)
    
    overall_status = if failed_checks == 0 do
      :valid
    elsif failed_checks <= 1 do
      :acceptable_with_warnings
    else
      :invalid
    end
    
    {:ok, %{
      validation_status: overall_status,
      validation_results: validation_results,
      failed_checks: failed_checks,
      total_checks: Kernel.length(validation_results),
      validation_timestamp: DateTime.utc_now()
    }}
  end
  
  defp validate_monitoring_config(monitored_systems, baseline, monitoring_interval, alert_thresholds, monitoring_focus) do
    validation_errors = []
    
    # Validate systems
    validation_errors = if Enum.empty?(monitored_systems) do
      ["No systems specified for monitoring" | validation_errors]
    elsif Kernel.length(monitored_systems) > @max_concurrent_monitors do
      ["Too many systems for monitoring (#{Kernel.length(monitored_systems)} > #{@max_concurrent_monitors})" | validation_errors]
    else
      validation_errors
    end
    
    # Validate baseline
    validation_errors = if baseline.baseline_validation.validation_status == :invalid do
      ["Baseline validation failed" | validation_errors]
    else
      validation_errors
    end
    
    # Validate monitoring interval
    validation_errors = if monitoring_interval < 1 or monitoring_interval > 60 do
      ["Invalid monitoring interval (must be 1-60 minutes)" | validation_errors]
    else
      validation_errors
    end
    
    # Validate monitoring focus
    valid_focus_areas = [:activity, :patterns, :threats, :predictive]
    invalid_focus = monitoring_focus -- valid_focus_areas
    
    validation_errors = if not Enum.empty?(invalid_focus) do
      ["Invalid monitoring focus areas: #{Enum.join(invalid_focus, ", ")}" | validation_errors]
    else
      validation_errors
    end
    
    if Enum.empty?(validation_errors) do
      {:ok, %{
        monitored_systems: monitored_systems,
        baseline: baseline,
        monitoring_interval_minutes: monitoring_interval,
        alert_thresholds: merge_default_alert_thresholds(alert_thresholds),
        monitoring_focus: monitoring_focus,
        validation_timestamp: DateTime.utc_now()
      }}
    else
      {:error, {:validation_failed, validation_errors}}
    end
  end
  
  defp merge_default_alert_thresholds(custom_thresholds) do
    default_thresholds = %{
      activity_spike: 2.0,      # 2x normal activity
      value_spike: 5.0,         # 5x normal value
      participant_spike: 3.0,   # 3x normal participants
      threat_escalation: 1.5,   # 1.5x normal threat level
      pattern_anomaly: 0.8      # 80% confidence for pattern anomalies
    }
    
    Map.merge(default_thresholds, custom_thresholds)
  end
  
  defp initialize_monitoring_state(validated_config) do
    {:ok, %{
      status: :initialized,
      monitored_systems: validated_config.monitored_systems,
      monitoring_interval: validated_config.monitoring_interval_minutes,
      last_check_timestamp: nil,
      consecutive_checks: 0,
      error_count: 0,
      alert_cooldowns: %{},  # Track alert cooldowns by type
      monitoring_statistics: initialize_monitoring_statistics(),
      state_transitions: [
        %{from: nil, to: :initialized, timestamp: DateTime.utc_now()}
      ]
    }}
  end
  
  defp initialize_monitoring_statistics() do
    %{
      total_checks_performed: 0,
      anomalies_detected: 0,
      alerts_generated: 0,
      false_positives: 0,
      monitoring_uptime_percentage: 100.0,
      average_check_duration_ms: 0,
      last_statistics_reset: DateTime.utc_now()
    }
  end
  
  defp setup_alert_system(alert_thresholds) do
    {:ok, %{
      alert_thresholds: alert_thresholds,
      alert_channels: [:log, :monitoring_dashboard],  # Default channels
      alert_history: [],
      active_alerts: %{},
      alert_statistics: %{
        total_alerts: 0,
        alerts_by_level: Enum.map(@alert_levels, &{&1, 0}) |> Enum.into(%{}),
        last_alert_timestamp: nil
      },
      escalation_rules: configure_default_escalation_rules()
    }}
  end
  
  defp configure_default_escalation_rules() do
    %{
      critical_immediate: %{
        conditions: [:critical_threat, :massive_activity_spike],
        escalation_time_minutes: 0,
        notification_channels: [:log, :monitoring_dashboard, :emergency_alert]
      },
      warning_escalation: %{
        conditions: [:persistent_anomaly, :multiple_warnings],
        escalation_time_minutes: 30,
        notification_channels: [:log, :monitoring_dashboard]
      },
      info_consolidation: %{
        conditions: [:multiple_info_alerts],
        escalation_time_minutes: 60,
        notification_channels: [:log]
      }
    }
  end
  
  defp maybe_setup_predictive_monitoring(baseline, true) do
    if baseline.predictive_baseline do
      {:ok, initialize_predictive_monitors(baseline.predictive_baseline)}
    else
      {:ok, nil}
    end
  end
  
  defp maybe_setup_predictive_monitoring(_baseline, false) do
    {:ok, nil}
  end
  
  defp initialize_predictive_monitors(predictive_baseline) do
    %{
      enabled: true,
      prediction_horizon_hours: predictive_baseline.prediction_horizon_hours,
      prediction_confidence_threshold: 0.7,
      trend_monitoring: %{
        enabled: true,
        trend_data: predictive_baseline.trend_analysis,
        last_trend_update: DateTime.utc_now()
      },
      escalation_monitoring: %{
        enabled: true,
        escalation_indicators: predictive_baseline.escalation_indicators,
        escalation_watch_list: [],
        last_escalation_check: DateTime.utc_now()
      },
      seasonal_monitoring: %{
        enabled: true,
        seasonal_patterns: predictive_baseline.seasonal_patterns,
        pattern_deviations: [],
        last_pattern_check: DateTime.utc_now()
      }
    }
  end
  
  defp initialize_stream_state(monitoring_setup, stream_mode, buffer_size) do
    {:ok, %{
      stream_mode: stream_mode,
      buffer_size: buffer_size,
      current_buffer: [],
      buffer_count: 0,
      stream_statistics: %{
        events_processed: 0,
        anomalies_detected: 0,
        processing_errors: 0,
        average_processing_time_ms: 0,
        stream_start_time: DateTime.utc_now(),
        last_event_timestamp: nil
      },
      status: :initializing
    }}
  end
  
  defp setup_processing_pipeline(monitoring_setup, batch_processing) do
    pipeline_stages = [
      %{stage: :data_collection, enabled: true},
      %{stage: :anomaly_detection, enabled: true},
      %{stage: :pattern_matching, enabled: :patterns in monitoring_setup.monitoring_config.monitoring_focus},
      %{stage: :threat_assessment, enabled: :threats in monitoring_setup.monitoring_config.monitoring_focus},
      %{stage: :predictive_analysis, enabled: monitoring_setup.predictive_monitors != nil},
      %{stage: :alert_generation, enabled: true},
      %{stage: :response_coordination, enabled: true}
    ]
    
    {:ok, %{
      stages: pipeline_stages,
      batch_processing: batch_processing,
      batch_size: if(batch_processing, do: 10, else: 1),
      pipeline_statistics: initialize_pipeline_statistics(),
      error_handling: %{
        retry_attempts: 3,
        error_threshold: 10,
        recovery_mode: :automatic
      }
    }}
  end
  
  defp initialize_pipeline_statistics() do
    %{
      stages_executed: 0,
      stage_performance: %{},
      pipeline_errors: 0,
      pipeline_success_rate: 100.0,
      average_pipeline_duration_ms: 0
    }
  end
  
  defp initialize_anomaly_detector(baseline) do
    {:ok, %{
      baseline_reference: baseline,
      detection_algorithms: [:statistical_deviation, :pattern_matching, :trend_analysis],
      detection_sensitivity: :normal,  # :low, :normal, :high
      anomaly_history: [],
      detection_statistics: %{
        total_detections: 0,
        true_positives: 0,
        false_positives: 0,
        detection_accuracy: 0.0,
        last_detection_timestamp: nil
      },
      adaptive_thresholds: initialize_adaptive_thresholds(baseline)
    }}
  end
  
  defp initialize_adaptive_thresholds(baseline) do
    # Initialize adaptive thresholds based on baseline
    activity_thresholds = baseline.activity_baseline.anomaly_detection_thresholds
    threat_thresholds = baseline.threat_baseline.threat_alert_thresholds
    
    %{
      activity_thresholds: activity_thresholds,
      threat_thresholds: threat_thresholds,
      adaptation_rate: 0.1,  # 10% adaptation per update
      last_adaptation: DateTime.utc_now()
    }
  end
  
  defp initialize_alert_manager(alert_system) do
    {:ok, %{
      alert_system: alert_system,
      active_monitoring_alerts: %{},
      alert_queue: [],
      processing_status: :ready,
      alert_processing_statistics: %{
        alerts_processed: 0,
        average_processing_time_ms: 0,
        successful_notifications: 0,
        failed_notifications: 0
      },
      notification_channels: configure_notification_channels()
    }}
  end
  end  # End of validate_monitoring_config function
  
  defp configure_notification_channels() do
    %{
      log: %{enabled: true, level: :info},
      monitoring_dashboard: %{enabled: true, level: :warning},
      emergency_alert: %{enabled: false, level: :critical}  # Disabled by default
    }
  end
  
  defp start_monitoring_process(monitoring_components) do
    # In a real implementation, this would start a GenServer process
    # For now, simulate a process ID
    monitoring_pid = :erlang.spawn(fn ->
      simulate_monitoring_loop(monitoring_components)
    end)
    
    Logger.info("Started monitoring process: #{inspect(monitoring_pid)}")
    monitoring_pid
  end
  
  defp simulate_monitoring_loop(monitoring_components) do
    # Simulate continuous monitoring
    Process.sleep(monitoring_components.monitoring_setup.monitoring_config.monitoring_interval_minutes * 60 * 1000)
    
    # Simulate monitoring cycle
    Logger.debug("Monitoring cycle executed for #{monitoring_components.monitoring_setup.monitoring_id}")
    
    # Continue loop
    simulate_monitoring_loop(monitoring_components)
  end
  
  defp generate_monitoring_id() do
    timestamp = DateTime.utc_now() |> DateTime.to_unix()
    random = :rand.uniform(9999)
    "MON-#{timestamp}-#{random}"
  end
  
  defp max(a, b), do: if(a > b, do: a, else: b)
end