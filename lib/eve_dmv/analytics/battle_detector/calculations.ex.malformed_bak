defmodule EveDmv.Analytics.BattleDetector.Calculations do
  @moduledoc """
  Battle-related calculations and metrics.
  """

  @doc """
  Calculates battle efficiency percentage.
  """
  def calculate_battle_efficiency(won, lost) do
    case {won, lost} do
      {0, 0} -> 0
      {w, 0} when w > 0 -> 100
      {0, l} when l > 0 -> 0
      {w, l} -> round(w / (w + l) * 100)
    end
  end

  @doc """
  Calculates fleet coordination based on participation ratios.
  """
  def calculate_fleet_coordination(avg_corp_participation, avg_fleet_size) do
    case {avg_corp_participation, avg_fleet_size} do
      {nil, _} -> "unknown"
      {_, nil} -> "unknown"
      {corp, fleet} when corp >= fleet * 0.5 -> "corp_dominated"
      {corp, fleet} when corp >= fleet * 0.25 -> "significant_presence"
      {corp, fleet} when corp >= fleet * 0.1 -> "active_participation"
      _ -> "limited_involvement"
    end
  end

  @doc """
  Classifies doctrine preference based on ship usage.
  """
  def classify_doctrine_preference(ship_type, _usage_count, avg_fleet_size) do
    cond do
      String.contains?(String.downcase(ship_type), "battleship") and avg_fleet_size >= 15 ->
        "capital_doctrine"

      String.contains?(String.downcase(ship_type), "cruiser") and avg_fleet_size >= 10 ->
        "mainline_doctrine"

      String.contains?(String.downcase(ship_type), "destroyer") and avg_fleet_size >= 5 ->
        "support_doctrine"

      String.contains?(String.downcase(ship_type), "frigate") and avg_fleet_size <= 8 ->
        "small_gang_doctrine"

      true ->
        "mixed_engagement"
    end
  end

  @doc """
  Calculates battle frequency category.
  """
  def calculate_battle_frequency(total_battles, battle_days) do
    cond do
      battle_days == 0 -> "none"
      total_battles / battle_days >= 3 -> "very_high"
      total_battles / battle_days >= 2 -> "high"
      total_battles / battle_days >= 1 -> "moderate"
      total_battles / battle_days >= 0.5 -> "low"
      true -> "minimal"
    end
  end

  @doc """
  Calculates system threat level based on battle activity.
  """
  def calculate_system_threat_level(total_battles, max_intensity, battle_days) do
    # Up to 50 points for battle count
    # Up to 30 points for intensity
    # Up to 20 points for consistency
    threat_score =
      min(total_battles, 50) +
        min(max_intensity * 2, 30) +
        min(battle_days * 2, 20)

    cond do
      threat_score >= 80 -> "extreme"
      threat_score >= 60 -> "high"
      threat_score >= 40 -> "moderate"
      threat_score >= 20 -> "low"
      true -> "minimal"
    end
  end

  # Note: Using Kernel.min/2 instead of defining our own
end