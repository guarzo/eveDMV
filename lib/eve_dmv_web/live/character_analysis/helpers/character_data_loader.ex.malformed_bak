defmodule EveDmvWeb.CharacterAnalysis.Helpers.CharacterDataLoader do
  @moduledoc """
  Main orchestrator for character analysis data loading.
  Coordinates data collection and delegates calculations to specialized modules.
  """

  alias EveDmv.Database.CharacterQueries
  alias EveDmv.Database.QueryPerformance
  alias EveDmvWeb.CharacterAnalysis.Helpers.{CharacterCalculator, CharacterDataExtractor}
  require Logger

  @doc """
  Analyze character data for the character analysis LiveView.

  This is the main entry point that orchestrates all character analysis.
  It gathers data from multiple sources and combines them into a comprehensive
  analysis structure for the UI.

  ## Parameters
  - character_id: Integer ID of the character to analyze

  ## Returns
  - {:ok, analysis_map} on success
  - {:error, reason} on failure

  ## Analysis Structure
  The returned analysis map contains:
  - Basic character info (name, corporation, alliance)
  - Combat statistics (kills, deaths, K/D ratio)
  - ISK efficiency metrics
  - Ship and weapon preferences
  - External group collaborations
  - Gang size patterns and preferences
  - Activity statistics and patterns
  - Intelligence summary and operational patterns
  """
  def analyze_character(character_id) do
    Logger.info("Starting analysis for character #{character_id}")

    # Set up time windows for analysis
    ninety_days_ago = DateTime.utc_now() DateTime.add(-90, :day)
    thirty_days_ago = DateTime.utc_now() DateTime.add(-30, :day)
    fifteen_days_ago = DateTime.utc_now() DateTime.add(-15, :day)

    # Get character stats using optimized query
    stats =
      QueryPerformance.tracked_query(
        "character_stats",
        fn -> CharacterQueries.get_character_stats(character_id, ninety_days_ago) end,
        metadata: %{character_id: character_id}
      )

    # Get character name from _killmail data
    character_name =
      QueryPerformance.tracked_query(
        "character_name",
        fn -> CharacterQueries.get_character_name_from_killmails(character_id) end
      )

    Logger.info("Found character name: #{character_name || "Unknown"}")

    Logger.info(
      "Found #{stats.kills} kills and #{stats.deaths} deaths for character #{character_id}"
    )

    # Get affiliations
    affiliations =
      QueryPerformance.tracked_query(
        "character_affiliations",
        fn -> CharacterQueries.get_character_affiliations(character_id) end
      )

    # Get ship and weapon preferences
    top_ships = CharacterDataExtractor.get_ship_preferences(character_id, ninety_days_ago)
    weapon_preferences = CharacterDataExtractor.get_weapon_preferences(character_id, ninety_days_ago)

    # Calculate ISK efficiency
    isk_stats = CharacterDataExtractor.calculate_isk_efficiency(character_id, ninety_days_ago)

    # Get external groups analysis (15-day window for more recent activity)
    external_groups = CharacterDataExtractor.get_external_groups(character_id, fifteen_days_ago)

    # Get gang size patterns
    gang_size_patterns = CharacterDataExtractor.get_gang_size_patterns(character_id, ninety_days_ago)

    # Calculate activity metrics for the last 30 days
    activity_stats = CharacterCalculator.calculate_activity_stats(character_id, thirty_days_ago)

    # Calculate intelligence summary
    intelligence_summary =
      CharacterCalculator.calculate_character_intelligence_summary(character_id, ninety_days_ago)

    # Build comprehensive analysis result
    analysis = %{
      character_id: character_id,
      character_name: character_name,
      corporation_name: affiliations.corporation_name,
      corporation_id: affiliations.corporation_id,
      alliance_name: affiliations.alliance_name,
      alliance_id: affiliations.alliance_id,
      total_kills: stats.kills,
      total_deaths: stats.deaths,
      kd_ratio: stats.kd_ratio,
      isk_efficiency: isk_stats.efficiency,
      isk_destroyed: isk_stats.destroyed,
      isk_lost: isk_stats.lost,
      top_ships: top_ships,
      weapon_preferences: weapon_preferences,
      external_groups: external_groups,
      gang_size_patterns: gang_size_patterns,
      recent_kills: activity_stats.recent_kills,
      most_active_day: activity_stats.most_active_day,
      active_days: activity_stats.active_days,
      intelligence_summary: intelligence_summary
    }

    Logger.info("Successfully completed analysis for character #{character_id}")
    {:ok, analysis}
  rescue
    error ->
      Logger.error("Analysis failed for character #{character_id}: #{inspect(error)}")
      {:error, "Failed to analyze character: #{inspect(error)}"}
  end

  @doc """
  Get a quick summary of character data without full analysis.

  This is a lighter-weight version for scenarios where you need
  basic character information quickly without the full analysis.
  """
  def get_character_summary(character_id) do
    try do
      thirty_days_ago = DateTime.utc_now() DateTime.add(-30, :day)

      # Get basic stats
      stats =
        QueryPerformance.tracked_query(
          "character_basic_stats",
          fn -> CharacterQueries.get_character_stats(character_id, thirty_days_ago) end
        )

      # Get character name
      character_name =
        QueryPerformance.tracked_query(
          "character_name",
          fn -> CharacterQueries.get_character_name_from_killmails(character_id) end
        )

      # Get affiliations
      affiliations =
        QueryPerformance.tracked_query(
          "character_affiliations",
          fn -> CharacterQueries.get_character_affiliations(character_id) end
        )

      summary = %{
        character_id: character_id,
        character_name: character_name,
        corporation_name: affiliations.corporation_name,
        corporation_id: affiliations.corporation_id,
        alliance_name: affiliations.alliance_name,
        alliance_id: affiliations.alliance_id,
        total_kills: stats.kills,
        total_deaths: stats.deaths,
        kd_ratio: stats.kd_ratio
      }

      {:ok, summary}
    rescue
      error ->
        Logger.error("Summary failed for character #{character_id}: #{inspect(error)}")
        {:error, "Failed to get character summary"}
    end
  end

  @doc """
  Refresh cached data for a character.

  This forces a refresh of all cached analysis data for the given character.
  Useful when you know the data has changed and want to ensure fresh results.
  """
  def refresh_character_cache(character_id) do
    try do
      # Clear relevant cache entries
      cache_patterns = [
        "ship_preferences:#{character_id}:",
        "weapon_preferences:#{character_id}:",
        "isk_efficiency:#{character_id}:",
        "external_groups:#{character_id}:",
        "gang_patterns:#{character_id}:",
        "activity_stats:#{character_id}:",
        "intelligence_summary:#{character_id}:"
      ]

      # Note: This would need to be implemented in the QueryCache module
      # For now, we'll just log the refresh request
      Logger.info("Cache refresh requested for character #{character_id}")

      # Patterns to clear (would be passed to cache clearing function)
      {:ok, cache_patterns}
    rescue
      error ->
        Logger.error("Cache refresh failed for character #{character_id}: #{inspect(error)}")
        {:error, "Failed to refresh cache"}
    end
  end

  @doc """
  Validate that character analysis data is available.

  Checks if a character has sufficient _killmail data for meaningful analysis.
  """
  def validate_character_data(character_id) do
    try do
      thirty_days_ago = DateTime.utc_now() DateTime.add(-30, :day)

      stats =
        QueryPerformance.tracked_query(
          "character_validation_stats",
          fn -> CharacterQueries.get_character_stats(character_id, thirty_days_ago) end
        )

      total_activity = stats.kills + stats.deaths

      cond do
        total_activity >= 10 -> {:ok, :sufficient_data}
        total_activity >= 3 -> {:ok, :limited_data}
        total_activity >= 1 -> {:ok, :minimal_data}
        true -> {:error, :insufficient_data}
      end
    rescue
      error ->
        Logger.error("Validation failed for character #{character_id}: #{inspect(error)}")
        {:error, :validation_failed}
    end
  end
end
