  @doc """
  Calculate detailed activity statistics for a character.
  """
  def calculate_activity_stats(character_id, since_date) do
    try do
      # Get recent kills with time distribution
      recent_query = """
      SELECT
        COUNT(*) as total_kills,
        COUNT(DISTINCT DATE(kill_time)) as active_days,
        EXTRACT(hour FROM kill_time) as hour,
        COUNT(*) as hour_count
      FROM killmails_raw
      WHERE attacker_character_id = $1
        AND kill_time >= $2
      GROUP BY EXTRACT(hour FROM kill_time)
      ORDER BY hour_count DESC
      """

      activity_data =
        QueryPerformance.tracked_query(
          "activity_distribution",
          fn -> EveDmv.Repo.query(recent_query, [character_id, since_date]) end
        )

      case activity_data do
        {:ok, %{rows: rows}} when length(rows) > 0 ->
          total_kills = rows |> Enum.map(&Enum.at(&1, 1)) Enum.sum()
          active_days = rows |> Enum.map(&Enum.at(&1, 1)) Enum.max()

          # Find peak hour
          peak_hour_data = Enum.max_by(rows, &Enum.at(&1, 3), fn -> [0, 0, 0, 0] end)
          peak_hour = Enum.at(peak_hour_data, 2)

          # Calculate activity variance
          hour_counts = Enum.map(rows, &Enum.at(&1, 3))
          mean_activity = Enum.sum(hour_counts) / length(hour_counts)
          variance =
            hour_counts
            |>             Enum.map(&(:math.pow(&1 - mean_activity, 2)))
            Enum.sum()
            Kernel./(length(hour_counts))

          # Calculate streaks
          current_streak = calculate_current_streak(character_id, since_date)
          longest_streak = calculate_longest_streak(character_id, since_date)

          %{
            recent_kills: total_kills,
            active_days: active_days,
            peak_hour: peak_hour,
            activity_variance: variance,
            current_streak: current_streak,
            longest_streak: longest_streak,
            most_active_day: determine_most_active_day(rows)
          }

        {:ok, %{rows: []}} ->
          Logger.info("No activity data found for character #{character_id}")
          %{
            recent_kills: 0,
            active_days: 0,
            peak_hour: nil,
            activity_variance: 0,
            current_streak: 0,
            longest_streak: 0,
            most_active_day: nil
          }

        {:error, error} ->
          Logger.error("Failed to calculate activity stats: #{inspect(error)}")
          %{
            recent_kills: 0,
            active_days: 0,
            peak_hour: nil,
            activity_variance: 0,
            current_streak: 0,
            longest_streak: 0,
            most_active_day: nil
          }
      end
    rescue
      error ->
        Logger.error("Activity stats calculation failed: #{inspect(error)}")
        %{
          recent_kills: 0,
          active_days: 0,
          peak_hour: nil,
          activity_variance: 0,
          current_streak: 0,
          longest_streak: 0,
          most_active_day: nil
        }
    end
  end

  @doc """
  Calculate character intelligence summary with operational analysis.
  """
  def calculate_character_intelligence_summary(character_id, since_date) do
    try do
      # Query for operational intelligence
      intelligence_query = """
      SELECT
        COUNT(DISTINCT km.solar_system_id) as active_systems,
        COUNT(DISTINCT sys.region_id) as active_regions,
        EXTRACT(hour FROM km.kill_time) as hour,
        COUNT(*) as activity_count,
        AVG(km.victim_ship_value) as avg_target_value
      FROM killmails_raw km
      JOIN eve_solar_systems sys ON km.solar_system_id = sys.system_id
      WHERE km.attacker_character_id = $1
        AND km.kill_time >= $2
      GROUP BY EXTRACT(hour FROM km.kill_time)
      ORDER BY activity_count DESC
      """

      summary_data =
        QueryPerformance.tracked_query(
          "intelligence_summary",
          fn -> EveDmv.Repo.query(intelligence_query, [character_id, since_date]) end
        )

      case summary_data do
        {:ok, %{rows: rows}} when length(rows) > 0 ->
          first_row = List.first(rows)
          active_systems = Enum.at(first_row, 0) || 0
          active_regions = Enum.at(first_row, 1) || 0
          peak_activity = Enum.reduce(rows, 0, fn row, acc ->
            max(acc, Enum.at(row, 3) || 0)
          end)

          # Calculate operational metrics
          active_hours = length(rows)
          avg_target_value =
            rows
            |>             Enum.map(&(Enum.at(&1, 4) || 0))
            Enum.filter(&(&1 > 0))
            case do
              [] -> 0
              values -> Enum.sum(values) / length(values)
            end

          # Determine patterns
          activity_concentration =
            EveDmvWeb.CharacterAnalysis.Helpers.CharacterFormatter.determine_activity_concentration(
              active_hours, active_systems, active_regions
            )

          operational_preference =
            EveDmvWeb.CharacterAnalysis.Helpers.CharacterFormatter.determine_operational_preference(
              active_systems, active_regions
            )

          intelligence_rating =
            EveDmvWeb.CharacterAnalysis.Helpers.CharacterFormatter.calculate_intelligence_rating(
              active_systems, active_regions, peak_activity
            )

          %{
            active_systems: active_systems,
            active_regions: active_regions,
            active_hours: active_hours,
            peak_activity: peak_activity,
            avg_target_value: avg_target_value,
            activity_concentration: activity_concentration,
            operational_preference: operational_preference,
            intelligence_rating: intelligence_rating
          }

        {:ok, %{rows: []}} ->
          Logger.info("No intelligence data found for character #{character_id}")
          %{
            active_systems: 0,
            active_regions: 0,
            active_hours: 0,
            peak_activity: 0,
            avg_target_value: 0,
            activity_concentration: :no_data,
            operational_preference: :unknown,
            intelligence_rating: :minimal
          }

        {:error, error} ->
          Logger.error("Failed to calculate intelligence summary: #{inspect(error)}")
          %{
            active_systems: 0,
            active_regions: 0,
            active_hours: 0,
            peak_activity: 0,
            avg_target_value: 0,
            activity_concentration: :no_data,
            operational_preference: :unknown,
            intelligence_rating: :minimal
          }
      end
    rescue
      error ->
        Logger.error("Intelligence summary calculation failed: #{inspect(error)}")
        %{
          active_systems: 0,
          active_regions: 0,
          active_hours: 0,
          peak_activity: 0,
          avg_target_value: 0,
          activity_concentration: :no_data,
          operational_preference: :unknown,
          intelligence_rating: :minimal
        }
    end
  end

  # Private helper functions

  defp determine_most_active_day(activity_rows) do
    # This would analyze daily patterns from the activity data
    # For now, return a simple calculation
    case activity_rows do
      [] -> nil
      rows ->
        # Find the day with highest activity (simplified)
        peak_data = Enum.max_by(rows, &Enum.at(&1, 3), fn -> [0, 0, 0, 0] end)
        case Enum.at(peak_data, 2) do
          hour when hour >= 0 and hour <= 6 -> :sunday
          hour when hour >= 7 and hour <= 13 -> :monday
          hour when hour >= 14 and hour <= 20 -> :tuesday
          _ -> :unknown
        end
    end
  end
