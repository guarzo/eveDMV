  @doc """
  Calculate current activity streak for a character.
  """
  def calculate_current_streak(character_id, since_date) do
    query = """
    WITH daily_activity AS (
      SELECT DATE(km.kill_time) as kill_date
      FROM killmails_raw km
      WHERE (km.attacker_character_id = $1 OR km.victim_character_id = $1)
        AND km.kill_time >= $2
      GROUP BY DATE(km.kill_time)
      ORDER BY kill_date DESC
    ),
    consecutive_days AS (
      SELECT kill_date,
             ROW_NUMBER() OVER (ORDER BY kill_date DESC) as row_num,
             kill_date - INTERVAL '1 day' * (ROW_NUMBER() OVER (ORDER BY kill_date DESC) - 1) as expected_date
      FROM daily_activity
    )
    SELECT COUNT(*) as current_streak
    FROM consecutive_days
    WHERE expected_date = (SELECT MIN(expected_date) FROM consecutive_days)
    """

    case QueryPerformance.tracked_query(
           "current_streak",
           fn ->
             EveDmv.Repo.query(query, [character_id, since_date])
           end
         ) do
      {:ok, %{rows: [[streak]]}} when is_integer(streak) -> streak
      {:ok, %{rows: []}} -> 0
      {:error, error} ->
        Logger.warning("Failed to calculate current streak: #{inspect(error)}")
        0
    end
  end

