<div class="min-h-screen bg-gray-900 text-gray-100">
  <!-- Header -->
  <.page_header 
    title="Character Comparison" 
    subtitle="Compare pilots across combat effectiveness, activity patterns, and threat levels"
    current_user={assigns[:current_user]}
  >
    <:action>
      <div class="flex items-center gap-2">
        <!-- Comparison Mode Selector -->
        <div class="flex bg-gray-800 rounded-lg p-1">
          <button
            phx-click="change_comparison_mode"
            phx-value-mode="multi_character"
            class={[
              "px-3 py-1 text-sm rounded transition-colors",
              if(@comparison_mode == :multi_character, do: "bg-blue-600 text-white", else: "text-gray-400 hover:text-white")
            ]}
          >
            Multi Compare
          </button>
          <button
            phx-click="change_comparison_mode"
            phx-value-mode="head_to_head"
            class={[
              "px-3 py-1 text-sm rounded transition-colors",
              if(@comparison_mode == :head_to_head, do: "bg-blue-600 text-white", else: "text-gray-400 hover:text-white")
            ]}
          >
            Head-to-Head
          </button>
          <button
            phx-click="change_comparison_mode"
            phx-value-mode="find_similar"
            class={[
              "px-3 py-1 text-sm rounded transition-colors",
              if(@comparison_mode == :find_similar, do: "bg-blue-600 text-white", else: "text-gray-400 hover:text-white")
            ]}
          >
            Find Similar
          </button>
        </div>
        
        <!-- Timeframe Selector -->
        <select 
          phx-change="change_timeframe"
          class="bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-sm text-gray-200"
        >
          <option value="last_7_days" selected={@timeframe == :last_7_days}>Last 7 Days</option>
          <option value="last_30_days" selected={@timeframe == :last_30_days}>Last 30 Days</option>
          <option value="last_90_days" selected={@timeframe == :last_90_days}>Last 90 Days</option>
          <option value="last_180_days" selected={@timeframe == :last_180_days}>Last 180 Days</option>
        </select>
      </div>
    </:action>
    <:info>
      <div class="text-sm text-gray-400">
        Mode: <span class="text-blue-400"><%= String.replace(to_string(@comparison_mode), "_", " ") |> String.capitalize() %></span>
        • Timeframe: <span class="text-blue-400"><%= format_timeframe(@timeframe) %></span>
        • Requires: <span class="text-yellow-400"><%= comparison_mode_requirements(@comparison_mode) %></span>
      </div>
    </:info>
  </.page_header>

  <!-- Main Content -->
  <div class="p-6">
    <!-- Character Selection -->
    <div class="bg-gray-800 rounded-lg p-6 mb-6">
      <h3 class="text-lg font-semibold text-gray-200 mb-4">Character Selection</h3>
      
      <!-- Character Input -->
      <div class="mb-4">
        <div class="relative">
          <input
            type="text"
            phx-change="character_input_changed"
            value={@character_input}
            placeholder="Enter character name or ID..."
            class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-gray-200 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
          
          <!-- Character Suggestions -->
          <%= if length(@character_suggestions) > 0 do %>
            <div class="absolute z-10 w-full mt-1 bg-gray-700 border border-gray-600 rounded-lg shadow-lg">
              <%= for suggestion <- @character_suggestions do %>
                <button
                  phx-click="add_character"
                  phx-value-character_id={suggestion.character_id}
                  class="w-full text-left px-4 py-2 hover:bg-gray-600 text-gray-200 border-b border-gray-600 last:border-b-0"
                >
                  <%= suggestion.character_name %>
                  <span class="text-xs text-gray-400 ml-2">(ID: <%= suggestion.character_id %>)</span>
                </button>
              <% end %>
            </div>
          <% end %>
        </div>
        
        <div class="text-xs text-gray-400 mt-1">
          Type at least 3 characters to search for pilots
        </div>
      </div>
      
      <!-- Selected Characters -->
      <%= if length(@selected_characters) > 0 do %>
        <div class="mb-4">
          <h4 class="text-sm font-medium text-gray-300 mb-2">Selected Characters (<%= length(@selected_characters) %>)</h4>
          <div class="flex flex-wrap gap-2">
            <%= for character_id <- @selected_characters do %>
              <div class="flex items-center bg-gray-700 rounded-lg px-3 py-1">
                <span class="text-gray-200 text-sm"><%= get_character_display_name(character_id) %></span>
                <button
                  phx-click="remove_character"
                  phx-value-character_id={character_id}
                  class="ml-2 text-gray-400 hover:text-red-400 transition-colors"
                >
                  ×
                </button>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
      
      <!-- Action Buttons -->
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <button
            phx-click="run_comparison"
            disabled={!can_run_comparison?(@comparison_mode, length(@selected_characters)) or @loading}
            class={[
              "px-4 py-2 rounded-lg text-sm font-medium transition-colors",
              if(can_run_comparison?(@comparison_mode, length(@selected_characters)) and not @loading,
                do: "bg-blue-600 hover:bg-blue-700 text-white",
                else: "bg-gray-600 text-gray-400 cursor-not-allowed"
              )
            ]}
          >
            <%= if @loading do %>
              <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Analyzing...
            <% else %>
              Run <%= String.replace(to_string(@comparison_mode), "_", " ") |> String.capitalize() %>
            <% end %>
          </button>
          
          <%= if length(@selected_characters) > 0 do %>
            <button
              phx-click="clear_all"
              class="px-4 py-2 bg-red-600 hover:bg-red-700 rounded-lg text-sm font-medium text-white transition-colors"
            >
              Clear All
            </button>
          <% end %>
        </div>
        
        <div class="text-xs text-gray-400">
          <%= length(@selected_characters) %> / <%= case @comparison_mode do %>
            <% :multi_character -> %>"10 characters selected"
            <% :head_to_head -> %>"2 characters selected"
            <% :find_similar -> %>"1 character selected"
          <% end %>
        </div>
      </div>
    </div>

    <!-- Results Section -->
    <%= cond do %>
      <% @loading -> %>
        <div class="flex justify-center py-12">
          <div class="flex items-center space-x-2 text-gray-400">
            <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-500"></div>
            <span>Analyzing character data...</span>
          </div>
        </div>

      <% @error -> %>
        <div class="bg-red-900/20 border border-red-700 rounded-lg p-6">
          <div class="flex items-center">
            <svg class="w-5 h-5 text-red-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            <span class="text-red-400 font-medium">Analysis Error</span>
          </div>
          <p class="text-gray-300 mt-2"><%= @error %></p>
        </div>

      <% @comparison_result && @comparison_mode in [:multi_character, :head_to_head] -> %>
        <!-- Comparison results are rendered below -->

      <% @similarity_result && @comparison_mode == :find_similar -> %>
        <!-- Similarity results are rendered below -->

      <% true -> %>
        <div class="bg-gray-800 rounded-lg p-8 text-center">
          <div class="text-gray-400 mb-4">
            <svg class="w-16 h-16 mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <h3 class="text-lg font-medium text-gray-300 mb-2">No Analysis Results</h3>
            <p>Select characters and run a comparison to see detailed analysis.</p>
          </div>
        </div>
    <% end %>
  </div>
</div>

<!-- Results Templates -->
<%= if @comparison_result do %>
  <div class="bg-gray-800 rounded-lg p-6 mt-6">
    <h3 class="text-lg font-semibold text-gray-200 mb-6">Comparison Results</h3>
    
    <!-- Combat Effectiveness Rankings -->
    <%= if @comparison_result.combat_comparison do %>
      <div class="mb-8">
        <h4 class="text-md font-medium text-gray-300 mb-4">Combat Effectiveness Rankings</h4>
        <div class="space-y-2">
          <%= for {char, index} <- Enum.with_index(@comparison_result.combat_comparison.rankings) do %>
            <div class="flex items-center justify-between p-3 bg-gray-700 rounded">
              <div class="flex items-center">
                <span class={[
                  "w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold mr-3",
                  case index do
                    0 -> "bg-yellow-500 text-black"
                    1 -> "bg-gray-400 text-black"  
                    2 -> "bg-orange-600 text-white"
                    _ -> "bg-gray-600 text-gray-300"
                  end
                ]}>
                  <%= index + 1 %>
                </span>
                <span class="text-gray-200 font-medium"><%= char.character_name %></span>
              </div>
              <div class="text-right text-sm">
                <div class="text-gray-300">Score: <%= Float.round(char.combat_effectiveness_score, 1) %></div>
                <div class="text-gray-500">K/D: <%= char.kill_death_ratio %> • ISK Eff: <%= format_percentage(char.isk_efficiency) %></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Activity Patterns -->
    <%= if @comparison_result.activity_comparison do %>
      <div class="mb-8">
        <h4 class="text-md font-medium text-gray-300 mb-4">Activity Patterns</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <%= for char <- @comparison_result.activity_comparison.activity_rankings do %>
            <div class="bg-gray-700 rounded p-4">
              <div class="text-gray-200 font-medium mb-2"><%= char.character_name %></div>
              <div class="text-sm text-gray-400 space-y-1">
                <div>Total Activity: <%= char.total_activity %></div>
                <div>Activity Score: <%= Float.round(char.activity_score, 1) %></div>
                <div>Activity Spread: <%= Float.round(char.activity_spread, 2) %></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Threat Assessment -->
    <%= if @comparison_result.threat_comparison do %>
      <div class="mb-8">
        <h4 class="text-md font-medium text-gray-300 mb-4">Threat Assessment</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <%= for char <- @comparison_result.threat_comparison.threat_rankings do %>
            <div class="bg-gray-700 rounded p-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-gray-200 font-medium"><%= char.character_name %></span>
                <%= case format_danger_rating(char.danger_rating) do %>
                  <% {label, color_class} -> %>
                    <span class={["text-xs font-medium px-2 py-1 rounded", color_class, "bg-gray-800"]}>
                      <%= label %>
                    </span>
                <% end %>
              </div>
              <div class="text-sm text-gray-400 space-y-1">
                <div>Threat Level: <%= char.threat_level %></div>
                <%= case format_survival_rating(char.survival_rating) do %>
                  <% {survival_label, survival_color} -> %>
                    <div>Survival: <span class={survival_color}><%= survival_label %></span></div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<%= if @similarity_result do %>
  <div class="bg-gray-800 rounded-lg p-6 mt-6">
    <h3 class="text-lg font-semibold text-gray-200 mb-6">Similar Characters</h3>
    
    <!-- Base Character -->
    <div class="bg-gray-700 rounded-lg p-4 mb-6">
      <h4 class="text-md font-medium text-gray-300 mb-2">Base Character</h4>
      <div class="text-gray-200"><%= @similarity_result.base_character.character_name %></div>
      <div class="text-sm text-gray-400 mt-1">
        K/D: <%= @similarity_result.base_character.kill_death_ratio %> • 
        ISK Eff: <%= format_percentage(@similarity_result.base_character.isk_efficiency) %> •
        <%= case format_combat_style(@similarity_result.base_character.combat_style) do %>
          <% {style_label, style_color} -> %>
            <span class={style_color}><%= style_label %></span>
        <% end %>
      </div>
    </div>

    <!-- Similar Characters List -->
    <div class="space-y-3">
      <%= for similar <- @similarity_result.similar_characters do %>
        <div class="flex items-center justify-between p-4 bg-gray-700 rounded-lg">
          <div>
            <div class="text-gray-200 font-medium"><%= similar.character.character_name %></div>
            <div class="text-sm text-gray-400 mt-1">
              K/D: <%= similar.character.kill_death_ratio %> • 
              ISK Eff: <%= format_percentage(similar.character.isk_efficiency) %> •
              <%= case format_combat_style(similar.character.combat_style) do %>
                <% {style_label, style_color} -> %>
                  <span class={style_color}><%= style_label %></span>
              <% end %>
            </div>
            <%= if length(similar.similarity_factors) > 0 do %>
              <div class="text-xs text-gray-500 mt-1">
                Similar: <%= Enum.join(similar.similarity_factors, ", ") %>
              </div>
            <% end %>
          </div>
          <div class="text-right">
            <div class="text-lg font-bold text-blue-400">
              <%= Float.round(similar.similarity_score * 100, 1) %>%
            </div>
            <div class="text-xs text-gray-500">Similarity</div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>