defmodule EveDmvWeb.FleetOperations.Helpers.FleetDataLoader do
  @moduledoc """
  Data loading utilities for fleet operations analysis.
  Handles fleet data extraction, analysis coordination, and data preparation.
  """

  alias EveDmv.Contexts.BattleAnalysis
  alias EveDmv.Contexts.FleetOperations.Analyzers.CompositionAnalyzer
  alias EveDmv.Intelligence.Analyzers.WhFleetAnalyzer
  alias EveDmv.Eve.NameResolver
  require Logger

  @doc """
  Load fleet data from a specific battle side.
  """
  def load_fleet_side_from_battle(battle_id, side) do
    try do
      case BattleAnalysis.get_battle(battle_id) do
        {:ok, battle} ->
          participants = extract_side_participants(battle, side)
          fleet_data = format_fleet_data(participants, battle)
          {:ok, fleet_data}

        {:error, error} ->
          Logger.error("Failed to load battle #{battle_id}: #{inspect(error)}")
          {:error, "Battle not found"}
      end
    rescue
      error ->
        Logger.error("Fleet side loading failed: #{inspect(error)}")
        {:error, "Failed to load fleet data"}
    end
  end

  @doc """
  Load fleet data from a battle at a specific time window.
  """
  def load_fleet_from_battle_window(battle_id, window_timestamp) do
    try do
      case BattleAnalysis.get_battle(battle_id) do
        {:ok, battle} ->
          fleet_data = extract_fleet_from_battle_timeline(battle, window_timestamp)
          {:ok, fleet_data}

        {:error, error} ->
          Logger.error("Failed to load battle #{battle_id}: #{inspect(error)}")
          {:error, "Battle not found"}
      end
    rescue
      error ->
        Logger.error("Fleet window loading failed: #{inspect(error)}")
        {:error, "Failed to load fleet data"}
    end
  end

  @doc """
  Analyze fleet composition using the composition analyzer.
  """
  def analyze_fleet_composition(fleet_data) do
    try do
      case CompositionAnalyzer.analyze_fleet_composition(fleet_data) do
        {:ok, analysis} ->
          enhanced_analysis = enhance_composition_analysis(analysis, fleet_data)
          {:ok, enhanced_analysis}

        {:error, error} ->
          Logger.error("Composition analysis failed: #{inspect(error)}")
          {:error, "Analysis failed"}
      end
    rescue
      error ->
        Logger.error("Fleet composition analysis error: #{inspect(error)}")
        {:error, "Analysis error"}
    end
  end

  @doc """
  Analyze fleet effectiveness and performance.
  """
  def analyze_fleet_effectiveness(fleet_data) do
    try do
      # Calculate various effectiveness metrics
      combat_effectiveness = calculate_combat_effectiveness(fleet_data)
      survival_rate = calculate_survival_rate(fleet_data)
      isk_efficiency = calculate_isk_efficiency(fleet_data)
      coordination_score = calculate_coordination_score(fleet_data)

      effectiveness = %{
        overall_score: calculate_overall_effectiveness_score(combat_effectiveness, survival_rate, isk_efficiency),
        combat_effectiveness: combat_effectiveness,
        survival_rate: survival_rate,
        isk_efficiency: isk_efficiency,
        coordination_score: coordination_score,
        total_damage: calculate_total_damage(fleet_data),
        damage_per_pilot: calculate_damage_per_pilot(fleet_data),
        positioning_score: calculate_positioning_score(fleet_data),
        target_selection_score: calculate_target_selection_score(fleet_data),
        recommendations: generate_effectiveness_recommendations(fleet_data)
      }

      {:ok, effectiveness}
    rescue
      error ->
        Logger.error("Fleet effectiveness analysis error: #{inspect(error)}")
        {:error, "Effectiveness analysis failed"}
    end
  end

  @doc """
  Analyze individual pilot performance within the fleet.
  """
  def analyze_pilot_performance(fleet_data) do
    try do
      pilots =
        fleet_data.participants
        Enum.map(&calculate_pilot_performance_metrics/1)
        Enum.sort_by(& &1.performance_score, :desc)

      {:ok, pilots}
    rescue
      error ->
        Logger.error("Pilot performance analysis error: #{inspect(error)}")
        {:error, "Pilot analysis failed"}
    end
  end

  # Private helper functions

  defp extract_side_participants(battle, side) do
    if battle.sides && Map.has_key?(battle.sides, side) do
      battle.sides[side].participants || []
    else
      # Fallback: try to extract from participants list
      battle.participants || []
    end
  end

  defp format_fleet_data(participants, battle) do
    %{
      id: "fleet_#{battle.id}",
      battle_id: battle.id,
      battle_name: battle.title || "Battle #{battle.id}",
      start_time: battle.start_time,
      end_time: battle.end_time,
      participants: Enum.map(participants, &format_participant/1),
      total_participants: length(participants),
      systems: battle.systems || [],
      killmails: battle.killmails || []
    }
  end

  defp format_participant(participant) do
    %{
      character_id: participant.character_id,
      character_name: participant.character_name || resolve_character_name(participant.character_id),
      corporation_id: participant.corporation_id,
      corporation_name: participant.corporation_name,
      alliance_id: participant.alliance_id,
      alliance_name: participant.alliance_name,
      ship_type_id: participant.ship_type_id,
      ship_name: participant.ship_name || resolve_ship_name(participant.ship_type_id),
      ship_class: get_ship_class(participant.ship_type_id),
      ship_value: estimate_ship_value(participant.ship_type_id),
      role: determine_fleet_role(participant),
      kills: participant.kills || 0,
      assists: participant.assists || 0,
      final_blows: participant.final_blows || 0,
      damage_done: participant.damage_done || 0,
      damage_taken: participant.damage_taken || 0,
      survived: participant.survived || false,
      destruction_time: participant.destruction_time
    }
  end

  defp extract_fleet_from_battle_timeline(battle, _window_timestamp) do
    # For now, extract all participants - in a real implementation,
    # this would filter based on the time window
    participants = battle.participants || []
    format_fleet_data(participants, battle)
  end

  defp enhance_composition_analysis(analysis, fleet_data) do
    # Add additional analysis like doctrine compliance
    doctrine_analysis = analyze_doctrine_compliance(fleet_data)
    optimization = generate_fleet_optimization(fleet_data, analysis)

    analysis
    Map.put(:doctrine_analysis, doctrine_analysis)
    Map.put(:optimization, optimization)
  end

  defp analyze_doctrine_compliance(fleet_data) do
    # This would analyze against known doctrines
    # For now, return a basic analysis
    %{
      doctrine_name: detect_doctrine(fleet_data),
      compliance_score: calculate_doctrine_score(fleet_data),
      deviations: identify_doctrine_deviations(fleet_data)
    }
  end

  defp detect_doctrine(fleet_data) do
    # Analyze ship composition to detect likely doctrine
    ship_classes = fleet_data.participants
                   Enum.group_by(& &1.ship_class)
                   |>                    Enum.map(fn {class, ships} -> {class, length(ships)} end)
                   Enum.into(%{})

    cond do
      Map.get(ship_classes, "Battleship", 0) > 5 -> "Battleship Doctrine"
      Map.get(ship_classes, "Cruiser", 0) > 10 -> "Cruiser Doctrine"
      Map.get(ship_classes, "Frigate", 0) > 15 -> "Frigate Swarm"
      true -> "Mixed Composition"
    end
  end

  defp calculate_doctrine_score(_fleet_data) do
    # Calculate how well the fleet matches expected doctrine
    # For now, return a placeholder score
    Float.round(65.0 + :rand.uniform() * 30.0, 1)
  end

  defp identify_doctrine_deviations(_fleet_data) do
    # Identify ships that don't fit the expected doctrine
    # For now, return empty list
    []
  end

  defp generate_fleet_optimization(fleet_data, _analysis) do
    recommendations = generate_optimization_recommendations(fleet_data)

    %{
      recommendations: recommendations,
      potential_improvements: calculate_potential_improvements(fleet_data)
    }
  end

  defp generate_optimization_recommendations(_fleet_data) do
    # Generate specific recommendations for fleet improvement
    # For now, return empty list
    []
  end

  defp calculate_potential_improvements(_fleet_data) do
    # Calculate potential effectiveness improvements
    %{
      damage_increase: "15-25%",
      survival_improvement: "10-20%",
      coordination_boost: "20-30%"
    }
  end

  defp calculate_combat_effectiveness(fleet_data) do
    # Calculate based on damage output vs expected
    total_damage = calculate_total_damage(fleet_data)
    pilot_count = fleet_data.total_participants

    if pilot_count > 0 do
      damage_per_pilot = total_damage / pilot_count
      # Normalize to percentage (example thresholds)
      min(damage_per_pilot / 50_000_000 * 100, 100.0)
    else
      0.0
    end
  end

  defp calculate_survival_rate(fleet_data) do
    survivors = Enum.count(fleet_data.participants, & &1.survived)
    total = fleet_data.total_participants

    if total > 0 do
      survivors / total * 100.0
    else
      0.0
    end
  end

  defp calculate_isk_efficiency(fleet_data) do
    damage_done = calculate_total_damage(fleet_data)
    damage_taken = Enum.reduce(fleet_data.participants, 0, & &1.damage_taken + &2)

    if damage_done + damage_taken > 0 do
      damage_done / (damage_done + damage_taken) * 100.0
    else
      0.0
    end
  end

  defp calculate_coordination_score(_fleet_data) do
    # Calculate based on timing of actions, target focus, etc.
    # For now, return a placeholder score
    Float.round(5.0 + :rand.uniform() * 5.0, 1)
  end

  defp calculate_overall_effectiveness_score(combat, survival, efficiency) do
    # Weighted average of different factors
    (combat * 0.4 + survival * 0.3 + efficiency * 0.3) / 10.0
  end

  defp calculate_total_damage(fleet_data) do
    Enum.reduce(fleet_data.participants, 0, & &1.damage_done + &2)
  end

  defp calculate_damage_per_pilot(fleet_data) do
    total_damage = calculate_total_damage(fleet_data)
    pilot_count = fleet_data.total_participants

    if pilot_count > 0 do
      total_damage / pilot_count
    else
      0.0
    end
  end

  defp calculate_positioning_score(_fleet_data) do
    # Analyze positioning based on engagement patterns
    # For now, return a placeholder score
    Float.round(4.0 + :rand.uniform() * 6.0, 1)
  end

  defp calculate_target_selection_score(_fleet_data) do
    # Analyze target prioritization effectiveness
    # For now, return a placeholder score
    Float.round(4.0 + :rand.uniform() * 6.0, 1)
  end

  defp generate_effectiveness_recommendations(_fleet_data) do
    # Generate recommendations for improving effectiveness
    # For now, return empty list
    []
  end

  defp calculate_pilot_performance_metrics(pilot) do
    # Calculate individual pilot performance score
    damage_updated_score = calculate_damage_score(pilot.damage_done)
    survival_updated_score = if pilot.survived, do: 2.0, else: 0.0
    kill_updated_score = calculate_kill_score(pilot.kills, pilot.final_blows)

    performance_updated_score = (damage_score + survival_score + kill_score) / 3.0

    pilot
    Map.put(:performance_score, performance_score)
    Map.put(:damage_score, damage_score)
    Map.put(:survival_score, survival_score)
    Map.put(:kill_score, kill_score)
  end

  defp calculate_damage_score(damage) do
    cond do
      damage >= 100_000_000 -> 10.0
      damage >= 50_000_000 -> 8.0
      damage >= 20_000_000 -> 6.0
      damage >= 5_000_000 -> 4.0
      damage >= 1_000_000 -> 2.0
      true -> 0.0
    end
  end

  defp calculate_kill_score(kills, final_blows) do
    (kills * 1.0 + final_blows * 2.0) min(10.0)
  end

  # Helper functions for data resolution
  defp resolve_character_name(character_id) do
    case NameResolver.resolve_character_name(character_id) do
      {:ok, name} -> name
      _ -> "Unknown"
    end
  end

  defp resolve_ship_name(ship_type_id) do
    case NameResolver.resolve_ship_name(ship_type_id) do
      {:ok, name} -> name
      _ -> "Unknown Ship"
    end
  end

  defp get_ship_class(ship_type_id) when is_integer(ship_type_id) do
    # This would query static data for ship class
    # For now, return based on common type IDs
    cond do
      ship_type_id in [17918, 17920, 17922] -> "Frigate"
      ship_type_id in [17843, 17841, 17845] -> "Cruiser"
      ship_type_id in [17732, 17736, 17738] -> "Battleship"
      true -> "Other"
    end
  end
  defp get_ship_class(_), do: "Unknown"

  defp estimate_ship_value(ship_type_id) when is_integer(ship_type_id) do
    # Estimate based on ship class
    case get_ship_class(ship_type_id) do
      "Frigate" -> 5_000_000
      "Destroyer" -> 15_000_000
      "Cruiser" -> 50_000_000
      "Battlecruiser" -> 100_000_000
      "Battleship" -> 200_000_000
      "Capital" -> 2_000_000_000
      _ -> 10_000_000
    end
  end
  defp estimate_ship_value(_), do: 10_000_000

  defp determine_fleet_role(participant) do
    ship_class = get_ship_class(participant.ship_type_id)

    case ship_class do
      "Frigate" -> :tackle
      "Destroyer" -> :support
      "Cruiser" -> :dps
      "Battlecruiser" -> :dps
      "Battleship" -> :dps
      "Capital" -> :command
      _ -> :support
    end
  end
end
