<div class="min-h-screen bg-gray-900 text-gray-100">
  <!-- Header -->
  <.page_header 
    title="System Activity Analytics" 
    subtitle="Solar system activity patterns and metrics"
    current_user={assigns[:current_user]}
  >
    <:action>
      <div class="flex items-center gap-2">
        <!-- View Mode Selector -->
        <div class="flex bg-gray-800 rounded-lg p-1">
          <button
            phx-click="change_view"
            phx-value-view="overview"
            class={["px-3 py-1 text-sm rounded transition-colors", if(@view_mode == :overview, do: "bg-blue-600 text-white", else: "text-gray-400 hover:text-white")]}
          >
            Overview
          </button>
          <button
            phx-click="change_view"
            phx-value-view="regional"
            class={["px-3 py-1 text-sm rounded transition-colors", if(@view_mode == :regional, do: "bg-blue-600 text-white", else: "text-gray-400 hover:text-white")]}
          >
            Regional
          </button>
          <button
            phx-click="change_view"
            phx-value-view="trends"
            class={["px-3 py-1 text-sm rounded transition-colors", if(@view_mode == :trends, do: "bg-blue-600 text-white", else: "text-gray-400 hover:text-white")]}
          >
            Trends
          </button>
          <button
            phx-click="change_view"
            phx-value-view="heatmap"
            class={["px-3 py-1 text-sm rounded transition-colors", if(@view_mode == :heatmap, do: "bg-blue-600 text-white", else: "text-gray-400 hover:text-white")]}
          >
            Heatmap
          </button>
        </div>
        
        <!-- Timeframe Selector -->
        <select 
          phx-change="change_timeframe"
          class="bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-sm text-gray-200"
        >
          <option value="last_24_hours" selected={@selected_timeframe == :last_24_hours}>Last 24 Hours</option>
          <option value="last_7_days" selected={@selected_timeframe == :last_7_days}>Last 7 Days</option>
          <option value="last_30_days" selected={@selected_timeframe == :last_30_days}>Last 30 Days</option>
          <option value="last_90_days" selected={@selected_timeframe == :last_90_days}>Last 90 Days</option>
        </select>
        
        <button
          phx-click="refresh_data"
          class="px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg text-sm font-medium transition-colors"
        >
          <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0V9a8 8 0 1115.356 2M15 15v5h-.582m0 0a8.001 8.001 0 01-15.356-2m15.356 2V15a8 8 0 00-15.356 2" />
          </svg>
          Refresh
        </button>
      </div>
    </:action>
    <:info>
      <div class="text-sm text-gray-400">
        Analyzing activity for <span class="text-blue-400"><%= format_timeframe(@selected_timeframe) %></span>
        <%= if @loading do %>
          <span class="text-yellow-400">(Loading...)</span>
        <% end %>
      </div>
    </:info>
  </.page_header>

  <!-- Main Content -->
  <div class="p-6">
    <%= if @loading do %>
      <div class="flex justify-center py-12">
        <div class="flex items-center space-x-2 text-gray-400">
          <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-500"></div>
          <span>Loading activity metrics...</span>
        </div>
      </div>
    <% else %>
      <%= case @view_mode do %>
        <% :overview -> %>
          <!-- Overview Metrics -->
          <div class="metrics-grid grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
            <div class="metric-card bg-gray-800 rounded-lg p-4">
              <div class="text-gray-400 text-sm">Total Kills</div>
              <div class="text-2xl font-bold text-white">
                <%= format_number(@overview_metrics.total_kills || 0) %>
              </div>
              <%= if (@overview_metrics.kills_change || 0) >= 0 do %>
                <div class="text-xs text-green-400">
                  +<%= @overview_metrics.kills_change || 0 %>% vs previous period
                </div>
              <% else %>
                <div class="text-xs text-red-400">
                  <%= @overview_metrics.kills_change || 0 %>% vs previous period
                </div>
              <% end %>
            </div>
            
            <div class="metric-card bg-gray-800 rounded-lg p-4">
              <div class="text-gray-400 text-sm">Active Systems</div>
              <div class="text-2xl font-bold text-white">
                <%= @overview_metrics.active_systems || 0 %>
              </div>
              <div class="text-xs text-gray-400">
                <%= @overview_metrics.active_percentage || 0 %>% of total
              </div>
            </div>
            
            <div class="metric-card bg-gray-800 rounded-lg p-4">
              <div class="text-gray-400 text-sm">Threat Escalations</div>
              <div class="text-2xl font-bold text-yellow-400">
                <%= length(@escalation_alerts) %>
              </div>
              <div class="text-xs text-gray-400">
                Active alerts
              </div>
            </div>
            
            <div class="metric-card bg-gray-800 rounded-lg p-4">
              <div class="text-gray-400 text-sm">Avg Response Time</div>
              <div class="text-2xl font-bold text-white">
                <%= @overview_metrics.avg_response_time || 0 %>ms
              </div>
              <div class="text-xs text-gray-400">
                Query performance
              </div>
            </div>
          </div>
          
          <!-- Escalation Alerts -->
          <%= if length(@escalation_alerts) > 0 do %>
            <div class="bg-red-900/10 border border-red-800/50 rounded-lg p-6 mb-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-red-400 flex items-center">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
                  </svg>
                  Threat Escalations (<%= length(@escalation_alerts) %>)
                </h3>
                <div class="text-xs text-gray-400">
                  Last updated: <%= format_datetime_ago(DateTime.utc_now()) %>
                </div>
              </div>
              
              <div class="space-y-3">
                <%= for {alert, idx} <- Enum.with_index(Enum.take(@escalation_alerts, 5)) do %>
                  <% {severity_label, severity_class} = format_escalation_severity(alert.severity) %>
                  <div class="bg-gray-800/50 rounded-lg p-4 border-l-4 border-red-500">
                    <div class="flex items-start justify-between">
                      <div class="flex-1">
                        <div class="flex items-center space-x-2 mb-2">
                          <span class={["px-2 py-1 rounded text-xs font-medium", severity_class]}>
                            <%= severity_label %>
                          </span>
                          <span class="text-gray-400 text-sm">
                            <%= format_escalation_type(alert.escalation_type) %>
                          </span>
                          <span class="text-xs text-gray-500">
                            Score: <%= alert.escalation_score %>
                          </span>
                        </div>
                        
                        <button
                          phx-click="view_alert_system"
                          phx-value-system_id={alert.system_id}
                          class="text-blue-400 hover:text-blue-300 transition-colors text-left font-medium"
                        >
                          <%= alert.system_name %>
                        </button>
                        
                        <div class="text-gray-300 text-sm mt-1">
                          <%= alert.description %>
                        </div>
                        
                        <div class="flex items-center space-x-4 mt-2 text-xs text-gray-400">
                          <span>Kills: <%= alert.current_kills %> (↗ <%= alert.kill_factor %>x)</span>
                          <span>ISK: <%= format_isk(alert.current_isk) %></span>
                          <span><%= format_datetime_ago(alert.detected_at) %></span>
                        </div>
                      </div>
                      
                      <div class="flex items-center space-x-2 ml-4">
                        <button
                          phx-click="view_alert_system"
                          phx-value-system_id={alert.system_id}
                          class="px-3 py-1 bg-blue-600 hover:bg-blue-700 rounded text-xs transition-colors"
                        >
                          View Details
                        </button>
                        <button
                          phx-click="dismiss_alert"
                          phx-value-alert_id={alert.system_id}
                          class="px-2 py-1 text-gray-400 hover:text-white transition-colors"
                          title="Dismiss Alert"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
              
              <%= if length(@escalation_alerts) > 5 do %>
                <div class="mt-4 text-center">
                  <div class="text-sm text-gray-400">
                    Showing 5 of <%= length(@escalation_alerts) %> alerts
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>

          <!-- Top Active Systems -->
          <%= if length(@top_systems) > 0 do %>
            <div class="bg-gray-800 rounded-lg p-6 mb-6">
              <h3 class="text-lg font-semibold text-gray-200 mb-4">Current Hotspots</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <%= for system <- Enum.take(@top_systems, 6) do %>
                  <div class="bg-gray-700 rounded-lg p-4 hover:bg-gray-600 transition-colors">
                    <button
                      phx-click="select_system"
                      phx-value-system_id={system.system_id}
                      class="text-blue-400 hover:text-blue-300 transition-colors text-left w-full"
                    >
                      <div class="font-semibold">System <%= system.system_id %></div>
                    </button>
                    <div class="text-sm text-gray-300 mt-2">
                      <div><%= system.kill_count %> kills</div>
                      <div class="text-green-400"><%= format_isk(system.isk_destroyed) %> destroyed</div>
                      <div class="text-yellow-400">Score: <%= if is_float(system.activity_score), do: Float.round(system.activity_score, 1), else: system.activity_score %></div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
          
        <% :system_detail -> %>
          <%= if @system_metrics do %>
            <div class="max-w-7xl mx-auto">
              <!-- System Header -->
              <div class="bg-gray-800 rounded-lg p-6 mb-6">
                <div class="flex items-center justify-between">
                  <div>
                    <h2 class="text-2xl font-bold text-gray-200"><%= @system_metrics.system_name %></h2>
                    <div class="flex items-center space-x-4 mt-2">
                      <span class={["text-sm", security_class_color(@system_metrics.security_info.class)]}>
                        <%= String.capitalize(to_string(@system_metrics.security_info.class)) %>
                      </span>
                      <span class="text-sm text-gray-400">
                        Security: <%= Float.round(@system_metrics.security_info.status, 1) %>
                      </span>
                      <%= case format_danger_rating(@system_metrics.danger_rating.rating) do %>
                        <% {label, color_class} -> %>
                          <span class={["text-sm font-medium", color_class]}>
                            <%= label %> (<%= @system_metrics.danger_rating.score %>)
                          </span>
                      <% end %>
                    </div>
                  </div>
                  <button
                    phx-click="change_view"
                    phx-value-view="overview"
                    class="text-gray-400 hover:text-white text-sm"
                  >
                    ← Back to Overview
                  </button>
                </div>
              </div>
              
              <!-- Key Metrics -->
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                <div class="bg-gray-800 rounded-lg p-6">
                  <div class="text-2xl font-bold text-blue-400"><%= @system_metrics.total_kills %></div>
                  <div class="text-sm text-gray-400">Total Kills</div>
                  <%= case format_activity_trend(@system_metrics.activity_trends.trend) do %>
                    <% {trend_label, trend_color} -> %>
                      <div class={["text-xs mt-1", trend_color]}><%= trend_label %></div>
                  <% end %>
                </div>
                
                <div class="bg-gray-800 rounded-lg p-6">
                  <div class="text-2xl font-bold text-red-400"><%= format_isk(@system_metrics.total_isk_destroyed) %></div>
                  <div class="text-sm text-gray-400">ISK Destroyed</div>
                  <div class="text-xs text-gray-500 mt-1">
                    Avg: <%= format_isk(Decimal.div(@system_metrics.total_isk_destroyed, max(@system_metrics.total_kills, 1))) %>
                  </div>
                </div>
                
                <div class="bg-gray-800 rounded-lg p-6">
                  <div class="text-2xl font-bold text-green-400"><%= @system_metrics.unique_characters %></div>
                  <div class="text-sm text-gray-400">Unique Pilots</div>
                  <div class="text-xs text-gray-500 mt-1">
                    <%= @system_metrics.unique_corporations %> Corps, <%= @system_metrics.unique_alliances %> Alliances
                  </div>
                </div>
                
                <div class="bg-gray-800 rounded-lg p-6">
                  <div class="text-2xl font-bold text-purple-400"><%= Float.round(@system_metrics.activity_intensity, 1) %></div>
                  <div class="text-sm text-gray-400">Activity Intensity</div>
                  <div class="text-xs text-gray-500 mt-1">
                    PvP Quality: <%= Float.round(@system_metrics.pvp_quality_score, 1) %>
                  </div>
                </div>
              </div>
              
              <!-- Ship Classes -->
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                <div class="bg-gray-800 rounded-lg p-6">
                  <h3 class="text-lg font-semibold text-gray-200 mb-4">Ship Class Distribution</h3>
                  <div class="space-y-2">
                    <%= for ship_class <- @system_metrics.ship_class_distribution do %>
                      <div class="flex items-center justify-between">
                        <span class="text-gray-300 capitalize"><%= ship_class.ship_class %></span>
                        <div class="flex items-center space-x-2">
                          <div class="w-24 bg-gray-700 rounded-full h-2">
                            <div 
                              class="bg-blue-500 h-2 rounded-full" 
                              style={"width: #{min(ship_class.kill_count / @system_metrics.total_kills * 100, 100)}%"}
                            ></div>
                          </div>
                          <span class="text-sm text-gray-400 w-8 text-right"><%= ship_class.kill_count %></span>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
                
                <!-- Top Alliances -->
                <div class="bg-gray-800 rounded-lg p-6">
                  <h3 class="text-lg font-semibold text-gray-200 mb-4">Most Active Alliances</h3>
                  <div class="space-y-2">
                    <%= for alliance <- Enum.take(@system_metrics.top_alliances, 5) do %>
                      <div class="flex items-center justify-between p-2 bg-gray-700 rounded">
                        <span class="text-gray-300 truncate"><%= alliance.alliance_name %></span>
                        <div class="text-right text-sm">
                          <div class="text-red-400"><%= alliance.kill_count %> losses</div>
                          <div class="text-gray-500"><%= format_isk(alliance.isk_lost) %></div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
              
              <!-- Recent Escalations -->
              <%= if length(@system_metrics.recent_escalations) > 0 do %>
                <div class="bg-red-900/20 border border-red-700 rounded-lg p-6 mb-8">
                  <h3 class="text-lg font-semibold text-red-400 mb-4">⚠️ Recent Escalations</h3>
                  <div class="space-y-2">
                    <%= for escalation <- @system_metrics.recent_escalations do %>
                      <div class="flex items-center space-x-3">
                        <span class={["px-2 py-1 rounded text-xs font-medium", 
                          if(escalation.severity == :high, do: "bg-red-600 text-white", else: "bg-yellow-600 text-white")]}
                        >
                          <%= String.upcase(to_string(escalation.severity)) %>
                        </span>
                        <span class="text-gray-300"><%= escalation.description %></span>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
          
        <% :regional -> %>
          <%= if @regional_metrics do %>
            <div class="bg-gray-800 rounded-lg p-6">
              <h3 class="text-lg font-semibold text-gray-200 mb-6">Regional Activity Analysis</h3>
              
              <!-- Regional Overview Stats -->
              <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
                <div class="text-center">
                  <div class="text-2xl font-bold text-blue-400"><%= @regional_metrics.systems_analyzed %></div>
                  <div class="text-sm text-gray-400">Systems Analyzed</div>
                </div>
                <div class="text-center">
                  <div class="text-2xl font-bold text-red-400"><%= @regional_metrics.total_kills %></div>
                  <div class="text-sm text-gray-400">Total Kills</div>
                </div>
                <div class="text-center">
                  <div class="text-2xl font-bold text-green-400"><%= format_isk(@regional_metrics.total_isk_destroyed) %></div>
                  <div class="text-sm text-gray-400">ISK Destroyed</div>
                </div>
                <div class="text-center">
                  <div class="text-2xl font-bold text-purple-400"><%= length(@regional_metrics.hotspots) %></div>
                  <div class="text-sm text-gray-400">Active Hotspots</div>
                </div>
              </div>
              
              <!-- System List -->
              <div class="overflow-x-auto">
                <table class="w-full">
                  <thead>
                    <tr class="border-b border-gray-700">
                      <th class="text-left py-3 px-4 text-gray-400">System</th>
                      <th class="text-left py-3 px-4 text-gray-400">Kills</th>
                      <th class="text-left py-3 px-4 text-gray-400">ISK Destroyed</th>
                      <th class="text-left py-3 px-4 text-gray-400">Danger</th>
                      <th class="text-left py-3 px-4 text-gray-400">Activity Score</th>
                      <th class="text-left py-3 px-4 text-gray-400">Last Activity</th>
                    </tr>
                  </thead>
                  <tbody>
                    <%= for system <- @regional_metrics.system_metrics do %>
                      <tr class="border-b border-gray-800 hover:bg-gray-700/50">
                        <td class="py-3 px-4">
                          <button
                            phx-click="select_system"
                            phx-value-system_id={system.system_id}
                            class="text-blue-400 hover:text-blue-300 transition-colors"
                          >
                            <%= system.system_name %>
                          </button>
                        </td>
                        <td class="py-3 px-4 text-gray-300"><%= system.kill_count %></td>
                        <td class="py-3 px-4 text-gray-300"><%= format_isk(system.isk_destroyed) %></td>
                        <td class="py-3 px-4">
                          <%= case format_danger_rating(system.danger_rating.rating) do %>
                            <% {label, color_class} -> %>
                              <span class={["text-xs font-medium", color_class]}><%= label %></span>
                          <% end %>
                        </td>
                        <td class="py-3 px-4 text-gray-300"><%= Float.round(system.activity_score, 1) %></td>
                        <td class="py-3 px-4 text-xs text-gray-500">
                          <%= if system.last_activity do %>
                            <%= format_datetime_ago(system.last_activity) %>
                          <% else %>
                            No recent activity
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          <% end %>
          
        <% :trends -> %>
          <%= if @activity_trends do %>
            <div class="space-y-6">
              <div class="bg-gray-800 rounded-lg p-6">
                <h3 class="text-lg font-semibold text-gray-200 mb-4">Activity Trends</h3>
                <p class="text-gray-400">
                  Analyzed <%= @activity_trends.total_kills_analyzed %> kills over the selected timeframe.
                  Trend analysis and emerging hotspot detection coming soon.
                </p>
              </div>
            </div>
          <% end %>
          
        <% :heatmap -> %>
          <div class="bg-gray-800 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-gray-200 mb-4">
              System Threat Heatmap
              <%= if @activity_heatmap do %>
                <span class="text-sm text-gray-400 font-normal">
                  (<%= @activity_heatmap.totalSystems || 0 %> systems)
                </span>
              <% end %>
            </h3>
            
            <!-- Heatmap Controls -->
            <div class="mb-4 flex items-center justify-between">
              <div class="text-sm text-gray-400">
                <%= if @activity_heatmap do %>
                  Generated <%= format_datetime_ago(@activity_heatmap.generatedAt) %>
                <% else %>
                  No data available
                <% end %>
              </div>
              
              <div class="flex space-x-2">
                <button
                  phx-click="refresh_data"
                  class="px-3 py-1 bg-blue-600 hover:bg-blue-700 rounded text-sm transition-colors"
                >
                  Refresh Data
                </button>
              </div>
            </div>
            
            <!-- Heatmap Visualization -->
            <div 
              id="heatmap-container"
              phx-hook="HeatmapVisualization"
              data-heatmap={Jason.encode!(@activity_heatmap || %{})}
              class="heatmap-visualization bg-gray-900 rounded-lg border-2 border-gray-700 min-h-96"
              style="min-height: 600px;"
            >
              <!-- D3.js renders here -->
            </div>
            
            <!-- Heatmap Legend and Info -->
            <%= if @activity_heatmap && @activity_heatmap.totalSystems > 0 do %>
              <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-gray-700 rounded-lg p-4">
                  <div class="text-sm text-gray-400">Max Threat Level</div>
                  <div class="text-lg font-bold text-red-400">
                    <%= Float.round((@activity_heatmap.maxThreat || 0) * 100, 1) %>%
                  </div>
                </div>
                
                <div class="bg-gray-700 rounded-lg p-4">
                  <div class="text-sm text-gray-400">Systems Analyzed</div>
                  <div class="text-lg font-bold text-blue-400">
                    <%= @activity_heatmap.totalSystems || 0 %>
                  </div>
                </div>
                
                <div class="bg-gray-700 rounded-lg p-4">
                  <div class="text-sm text-gray-400">Time Range</div>
                  <div class="text-lg font-bold text-gray-200">
                    <%= format_timeframe(@selected_timeframe) %>
                  </div>
                </div>
              </div>
              
              <div class="mt-4 text-sm text-gray-400">
                <div class="mb-2">
                  <strong>How to use:</strong>
                </div>
                <ul class="list-disc list-inside space-y-1">
                  <li>Hover over hexagons to see detailed system information</li>
                  <li>Click on a system to view detailed analysis</li>
                  <li>Red indicates high threat (lots of recent kills/ISK destroyed)</li>
                  <li>Green indicates low threat (minimal activity)</li>
                </ul>
              </div>
            <% end %>
          </div>
      <% end %>
    <% end %>
  </div>
</div>