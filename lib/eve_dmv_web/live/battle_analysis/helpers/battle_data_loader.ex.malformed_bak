  @doc """
  Load recent battles for display.
  """
  def load_recent_battles do
    try do
      [limit: 20]
      BattleAnalysis.list_recent_battles()
      Enum.map(&format_battle_summary/1)
    rescue
      error ->
        Logger.error("Failed to load recent battles: #{inspect(error)}")
        []
    end
  end

  @doc """
  Load a specific battle with full analysis data.
  """
  def load_battle(battle_id) do
    try do
      case BattleAnalysis.get_battle(battle_id) do
        {:ok, battle} ->
          battle
          enhance_battle_data()
          resolve_names()

        {:error, :not_found} ->
          {:error, "Battle not found"}

        {:error, error} ->
          Logger.error("Failed to load battle #{battle_id}: #{inspect(error)}")
          {:error, "Failed to load battle"}
      end
    rescue
      error ->
        Logger.error("Battle loading failed for #{battle_id}: #{inspect(error)}")
        {:error, "Battle loading failed"}
    end
  end

  @doc """
  Load combat logs for a battle.
  """
  def load_combat_logs(battle_id) do
    try do
      battle_id
      CombatLog.list_by_battle()
      Enum.map(&format_combat_log/1)
    rescue
      error ->
        Logger.error("Failed to load combat logs for battle #{battle_id}: #{inspect(error)}")
        []
    end
  end

  @doc """
  Load battle reports for sharing.
  """
  def load_battle_reports(battle_id) do
    try do
      battle_id
      BattleSharing.list_battle_reports()
      Enum.map(&format_battle_report/1)
    rescue
      error ->
        Logger.error("Failed to load battle reports for battle #{battle_id}: #{inspect(error)}")
        []
    end
  end

  @doc """
  Import battle from zkillboard URL.
  """
  def import_from_zkillboard(url) do
    try do
      case parse_zkillboard_url(url) do
        {:ok, battle_id} ->
          BattleAnalysis.import_from_zkillboard(battle_id)

        {:error, reason} ->
          {:error, format_import_error(reason)}
      end
    rescue
      error ->
        Logger.error("zkillboard import failed: #{inspect(error)}")
        {:error, "Import failed"}
    end
  end

  @doc """
  Get pilot suggestions for autocomplete.
  """
  def get_pilot_suggestions(battle, search_term) when is_binary(search_term) do
    if String.length(search_term) >= 2 do
      battle
      get_all_pilots_from_battle()
      |>       Enum.filter(&String.contains?(String.downcase(&1), String.downcase(search_term)))
      Enum.take(10)
      Enum.sort()
    else
      []
    end
  end

  def get_pilot_suggestions(_, _), do: []

