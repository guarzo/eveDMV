defmodule EveDmvWeb.BattleAnalysis.Helpers.BattleDataLoader do
  @moduledoc """
  Data loading utilities for battle analysis.
  Handles battle loading, caching, and data preparation for the UI.
  """

  alias EveDmv.Contexts.BattleAnalysis
  alias EveDmv.Contexts.BattleAnalysis.Resources.CombatLog
