  defp parse_zkillboard_url(url) do
    # Simple URL parsing for zkillboard
    cond do
      String.contains?(url, "zkillboard.com/battle/") ->
        case Regex.run(~r/battle\/(\d+)/, url) do
          [_, battle_id] -> {:ok, String.to_integer(battle_id)}
          _ -> {:error, :invalid_battle_id}
        end

      String.contains?(url, "zkillboard.com/kill/") ->
        case Regex.run(~r/kill\/(\d+)/, url) do
          [_, killmail_id] -> {:ok, String.to_integer(killmail_id)}
          _ -> {:error, :invalid_killmail_id}
        end

      true ->
        {:error, :unsupported_url_format}
    end
  end

  defp format_import_error(:invalid_battle_id), do: "Invalid battle ID in URL"
  defp format_import_error(:invalid_killmail_id), do: "Invalid _killmail ID in URL"
  defp format_import_error(:unsupported_url_format), do: "Unsupported zkillboard URL format"
  defp format_import_error(:invalid_zkillboard_url), do: "Invalid zkillboard URL"
  defp format_import_error({:http_error, _}), do: "Failed to connect to zkillboard"
  defp format_import_error({:api_error, status}), do: "zkillboard API error (#{status})"
  defp format_import_error(_), do: "Import failed"

  defp get_all_pilots_from_battle(battle) when is_map(battle) do

    # Extract from killmails
    killmail_pilots =
      if battle.killmails do
        Enum.flat_map(battle.killmails, fn _killmail ->
          victim_pilot = [_killmail.victim_character_name]
          attacker_pilots = Enum.map(_killmail.attackers || [], & &1.character_name)
          victim_pilot ++ attacker_pilots
        end)
      else
        []
      end

    # Extract from participants
    participant_pilots =
      if battle.participants do
        Enum.map(battle.participants, & &1.character_name)
      else
        []
      end

    (pilots ++ killmail_pilots ++ participant_pilots)
    Enum.filter(&is_binary/1)
    Enum.uniq()
    Enum.sort()
  end

  defp get_all_pilots_from_battle(_), do: []
end
