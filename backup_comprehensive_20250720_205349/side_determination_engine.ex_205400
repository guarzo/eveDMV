defmodule EveDmv.Contexts.CombatIntelligence.Domain.BattleAnalysis.Analyzers.SideDeterminationEngine do
  @moduledoc """
  Side determination and battle grouping engine for fleet combat analysis.

  Responsible for:
  - Determining battle sides from attack patterns and affiliations
  - Grouping participants by alliances and corporations
  - Analyzing side composition and strength imbalances
  - Calculating dominant sides for battle phases
  - Creating meaningful side mappings for battle visualization
  - Detecting neutral parties and third-party involvement
  """

  require Logger

  @doc """
  Determine battle sides from combat data and participant affiliations.
  """
  def determine_sides_from_battle_data(timeline) do
    # Analyze attack patterns to determine actual battle sides
    if Enum.empty?(timeline) do
      %{sides: [], analysis: "No timeline data available for side determination"}
    else
      # Group participants by attack patterns
      attack_groups = analyze_attack_patterns(timeline)

      # Enhance with alliance/corporation analysis
      affiliation_groups = analyze_affiliations(timeline)

      # Combine both analyses for better side determination
      combined_analysis = combine_grouping_analyses(attack_groups, affiliation_groups)

      # Create final side mappings
      side_mappings = create_side_mappings(combined_analysis)

      %{
        sides: side_mappings,
        total_sides: length(side_mappings),
        analysis: generate_side_analysis(side_mappings, combined_analysis),
        confidence: calculate_side_determination_confidence(combined_analysis),
        method: determine_primary_grouping_method(attack_groups, affiliation_groups)
      }
    end
  end

  @doc """
  Calculate the dominant side for a specific battle phase.
  """
  def calculate_dominant_side_for_phase(timeline, phase) do
    phase_events = filter_events_by_timeframe(timeline, phase.start_time, phase.end_time)

    if Enum.empty?(phase_events) do
      :undetermined
    else
      # Count kills by side during this phase
      side_performance =
        phase_events
        |> Enum.map(fn event ->
          attacker_side =
            determine_side(event.attacker_corporation_id, event.attacker_alliance_id)

          victim_side = determine_side(event.victim_corporation_id, event.victim_alliance_id)

          %{
            attacker_side: attacker_side,
            victim_side: victim_side,
            isk_value: event.isk_destroyed || 0
          }
        end)
        |> Enum.group_by(& &1.attacker_side)
        |> Enum.map(fn {side, events} ->
          total_damage = Enum.sum(Enum.map(events, & &1.isk_value))
          kill_count = length(events)

          {side, %{kills: kill_count, isk_destroyed: total_damage}}
        end)
        |> Map.new()

      # Determine dominant side based on performance
      determine_phase_dominant_side(side_performance)
    end
  end

  @doc """
  Determine side affiliation for a character/corporation/alliance.
  """
  def determine_side(corporation_id, alliance_id) do
    cond do
      # Alliance-based determination (preferred)
      not is_nil(alliance_id) and alliance_id != 0 ->
        determine_side_by_alliance(alliance_id)

      # Corporation-based fallback
      not is_nil(corporation_id) and corporation_id != 0 ->
        determine_side_by_corporation(corporation_id)

      # Unknown affiliation
      true ->
        :unknown
    end
  end

  @doc """
  Analyze cross-side composition gaps and imbalances.
  """
  def analyze_cross_side_gaps(fleet_compositions) do
    sides = Map.keys(fleet_compositions)

    if length(sides) >= 2 do
      [side_a, side_b] = Enum.take(sides, 2)
      comp_a = fleet_compositions[side_a]
      comp_b = fleet_compositions[side_b]

      # Analyze relative strengths and weaknesses
      strength_analysis = analyze_relative_strengths(comp_a, comp_b)

      [
        %{
          gap_type: :relative_strength_analysis,
          description: "Analyze relative fleet strengths between #{side_a} and #{side_b}",
          priority: :medium,
          recommendation: "Exploit opponent weaknesses while covering own gaps",
          details: strength_analysis
        }
      ]
    else
      []
    end
  end

  @doc """
  Analyze side composition gaps for tactical recommendations.
  """
  def analyze_side_composition_gaps(side, composition) do
    gaps = []

    # Check support ship ratios
    gaps = gaps ++ check_support_ship_ratios(composition)

    # Check role coverage
    gaps = gaps ++ check_role_coverage(composition)

    # Check ship synergy
    gaps = gaps ++ check_ship_synergy(composition)

    # Tag gaps with side information
    Enum.map(gaps, fn gap ->
      Map.put(gap, :side, side)
    end)
  end

  @doc """
  Create meaningful side mappings from group analysis.
  """
  def create_side_mappings(group_analysis) do
    group_analysis.groups
    |> Enum.with_index()
    |> Enum.map(fn {group, index} ->
      %{
        side_id: generate_side_id(index, group),
        name: generate_side_name(index, group),
        participants: group.participants,
        primary_alliance: identify_primary_alliance(group),
        primary_corporation: identify_primary_corporation(group),
        strength: calculate_side_strength(group),
        composition: analyze_side_composition(group.participants)
      }
    end)
  end

  # Private helper functions

  defp analyze_attack_patterns(timeline) do
    # Group events by attacker-victim relationships
    attack_relationships =
      timeline
      |> Enum.map(fn event ->
        %{
          attacker: {event.attacker_corporation_id, event.attacker_alliance_id},
          victim: {event.victim_corporation_id, event.victim_alliance_id},
          timestamp: event.killmail_time
        }
      end)
      |> Enum.group_by(& &1.attacker)

    # Analyze who attacks whom to determine sides
    conflict_matrix = build_conflict_matrix(attack_relationships)
    groups = cluster_by_attack_patterns(conflict_matrix)

    %{
      method: :attack_patterns,
      groups: groups,
      confidence: calculate_attack_pattern_confidence(conflict_matrix),
      relationships: attack_relationships
    }
  end

  defp analyze_affiliations(timeline) do
    # Group by alliance and corporation affiliations
    participants =
      timeline
      |> Enum.flat_map(fn event ->
        [
          %{
            corp: event.attacker_corporation_id,
            alliance: event.attacker_alliance_id,
            role: :attacker
          },
          %{corp: event.victim_corporation_id, alliance: event.victim_alliance_id, role: :victim}
        ]
      end)
      |> Enum.uniq()

    # Group by alliance primarily
    alliance_groups =
      participants
      |> Enum.group_by(& &1.alliance)
      |> Enum.filter(fn {alliance_id, _} -> alliance_id && alliance_id != 0 end)
      |> Enum.map(fn {alliance_id, members} ->
        %{
          type: :alliance,
          id: alliance_id,
          participants: members,
          size: length(members)
        }
      end)

    # Group unaligned corporations
    unaligned =
      participants
      |> Enum.filter(fn p -> is_nil(p.alliance) or p.alliance == 0 end)
      |> Enum.group_by(& &1.corp)
      |> Enum.map(fn {corp_id, members} ->
        %{
          type: :corporation,
          id: corp_id,
          participants: members,
          size: length(members)
        }
      end)

    all_groups = alliance_groups ++ unaligned

    %{
      method: :affiliations,
      groups: all_groups,
      confidence: calculate_affiliation_confidence(all_groups),
      alliance_groups: alliance_groups,
      unaligned_groups: unaligned
    }
  end

  defp combine_grouping_analyses(attack_groups, affiliation_groups) do
    # Weight both methods and combine for best results
    attack_weight = attack_groups.confidence * 0.6
    affiliation_weight = affiliation_groups.confidence * 0.4

    primary_method =
      if attack_weight > affiliation_weight, do: :attack_patterns, else: :affiliations

    # Use primary method but enhance with secondary
    primary_groups =
      if primary_method == :attack_patterns,
        do: attack_groups.groups,
        else: affiliation_groups.groups

    %{
      method: primary_method,
      groups: primary_groups,
      combined_confidence: attack_weight + affiliation_weight,
      attack_analysis: attack_groups,
      affiliation_analysis: affiliation_groups
    }
  end

  defp determine_side_by_alliance(alliance_id) do
    # Use a hash-based approach but ensure consistency within battle analysis
    hash = :erlang.phash2(alliance_id)

    case rem(hash, 4) do
      0 -> :alliance_alpha
      1 -> :alliance_beta
      2 -> :alliance_gamma
      3 -> :alliance_delta
    end
  end

  defp determine_side_by_corporation(corporation_id) do
    # For unaligned corporations, group them more carefully
    hash = :erlang.phash2(corporation_id)

    case rem(hash, 3) do
      0 -> :independent_alpha
      1 -> :independent_beta
      2 -> :independent_gamma
    end
  end

  defp filter_events_by_timeframe(timeline, start_time, end_time) do
    timeline
    |> Enum.filter(fn event ->
      event_time = event.killmail_time

      NaiveDateTime.compare(event_time, start_time) != :lt and
        NaiveDateTime.compare(event_time, end_time) != :gt
    end)
  end

  defp determine_phase_dominant_side(side_performance) do
    if Enum.empty?(side_performance) do
      :undetermined
    else
      # Find side with best combined performance
      {dominant_side, _performance} =
        side_performance
        |> Enum.max_by(fn {_side, perf} ->
          # Weight kills and ISK destroyed equally
          perf.kills * 1000 + perf.isk_destroyed / 1_000_000
        end)

      dominant_side
    end
  end

  defp generate_side_id(index, group) do
    case group.type do
      :alliance -> :"alliance_#{group.id}"
      :corporation -> :"corp_#{group.id}"
      _ -> :"side_#{index + 1}"
    end
  end

  defp generate_side_name(index, group) do
    case group.type do
      :alliance -> "Alliance #{group.id}"
      :corporation -> "Corporation #{group.id}"
      _ -> "Side #{index + 1}"
    end
  end

  defp identify_primary_alliance(group) do
    case group.type do
      :alliance ->
        group.id

      _ ->
        # Find most common alliance in group
        group.participants
        |> Enum.map(& &1.alliance)
        |> Enum.filter(&(&1 && &1 != 0))
        |> Enum.frequencies()
        |> Enum.max_by(fn {_alliance, count} -> count end, fn -> {nil, 0} end)
        |> elem(0)
    end
  end

  defp identify_primary_corporation(group) do
    case group.type do
      :corporation ->
        group.id

      _ ->
        # Find most common corporation in group
        group.participants
        |> Enum.map(& &1.corp)
        |> Enum.filter(&(&1 && &1 != 0))
        |> Enum.frequencies()
        |> Enum.max_by(fn {_corp, count} -> count end, fn -> {nil, 0} end)
        |> elem(0)
    end
  end

  defp calculate_side_strength(group) do
    # Simple strength based on participant count
    participant_count = length(group.participants)

    cond do
      participant_count > 50 -> :very_strong
      participant_count > 20 -> :strong
      participant_count > 10 -> :moderate
      participant_count > 5 -> :weak
      true -> :very_weak
    end
  end

  defp analyze_side_composition(participants) do
    %{
      total_participants: length(participants),
      unique_corporations: participants |> Enum.map(& &1.corp) |> Enum.uniq() |> length(),
      unique_alliances:
        participants
        |> Enum.map(& &1.alliance)
        |> Enum.filter(&(&1 && &1 != 0))
        |> Enum.uniq()
        |> length()
    }
  end

  defp build_conflict_matrix(attack_relationships) do
    # Build matrix of who attacks whom
    all_entities =
      attack_relationships
      |> Map.keys()
      |> Kernel.++(
        Enum.flat_map(Map.values(attack_relationships), fn events ->
          Enum.map(events, & &1.victim)
        end)
      )
      |> Enum.uniq()

    # Create conflict matrix
    all_entities
    |> Enum.map(fn entity1 ->
      conflicts =
        all_entities
        |> Enum.map(fn entity2 ->
          attacks = Map.get(attack_relationships, entity1, [])
          attack_count = Enum.count(attacks, fn event -> event.victim == entity2 end)
          {entity2, attack_count}
        end)
        |> Map.new()

      {entity1, conflicts}
    end)
    |> Map.new()
  end

  defp cluster_by_attack_patterns(conflict_matrix) do
    # Simple clustering: entities that don't attack each other are on same side
    entities = Map.keys(conflict_matrix)

    # Start with each entity as its own group
    initial_groups = Enum.map(entities, fn entity -> [entity] end)

    # Merge groups that don't have conflicts
    merge_compatible_groups(initial_groups, conflict_matrix)
  end

  defp merge_compatible_groups(groups, conflict_matrix) do
    # Simplified merging: if two groups have no mutual attacks, merge them
    groups
    |> Enum.reduce([], fn group, acc ->
      merged =
        Enum.find(acc, fn existing_group ->
          no_conflicts_between_groups?(group, existing_group, conflict_matrix)
        end)

      if merged do
        # Merge with existing group
        Enum.map(acc, fn g ->
          if g == merged, do: g ++ group, else: g
        end)
      else
        # Add as new group
        [group | acc]
      end
    end)
    |> Enum.map(fn group_entities ->
      %{
        type: :attack_cluster,
        participants:
          Enum.map(group_entities, fn {corp, alliance} ->
            %{corp: corp, alliance: alliance}
          end),
        size: length(group_entities)
      }
    end)
  end

  defp no_conflicts_between_groups?(group1, group2, conflict_matrix) do
    # Check if any entity in group1 attacks any entity in group2
    conflicts =
      for entity1 <- group1,
          entity2 <- group2,
          do: Map.get(conflict_matrix[entity1], entity2, 0) > 0

    not Enum.any?(conflicts)
  end

  defp calculate_attack_pattern_confidence(conflict_matrix) do
    total_entities = map_size(conflict_matrix)

    if total_entities < 3 do
      # Low confidence with few entities
      0.3
    else
      # Higher confidence with more clear attack patterns
      conflict_density = calculate_conflict_density(conflict_matrix)
      min(0.9, 0.4 + conflict_density * 0.5)
    end
  end

  defp calculate_affiliation_confidence(groups) do
    total_groups = length(groups)
    alliance_groups = Enum.count(groups, &(&1.type == :alliance))

    if total_groups == 0 do
      0.0
    else
      # Higher confidence with more alliance-based grouping
      alliance_ratio = alliance_groups / total_groups
      0.5 + alliance_ratio * 0.4
    end
  end

  defp calculate_conflict_density(conflict_matrix) do
    total_possible = map_size(conflict_matrix) * map_size(conflict_matrix)

    actual_conflicts =
      conflict_matrix
      |> Map.values()
      |> Enum.flat_map(&Map.values/1)
      |> Enum.count(&(&1 > 0))

    if total_possible > 0, do: actual_conflicts / total_possible, else: 0.0
  end

  defp generate_side_analysis(side_mappings, combined_analysis) do
    side_count = length(side_mappings)
    method = combined_analysis.method
    confidence = combined_analysis.combined_confidence

    "Detected #{side_count} battle sides using #{method} analysis " <>
      "(#{Float.round(confidence * 100, 1)}% confidence). " <>
      "Primary method: #{method}."
  end

  defp calculate_side_determination_confidence(combined_analysis) do
    Float.round(combined_analysis.combined_confidence, 2)
  end

  defp determine_primary_grouping_method(attack_groups, affiliation_groups) do
    if attack_groups.confidence > affiliation_groups.confidence do
      :attack_patterns
    else
      :affiliations
    end
  end

  defp analyze_relative_strengths(comp_a, comp_b) do
    %{
      fleet_size_ratio: calculate_size_ratio(comp_a, comp_b),
      logistics_comparison: compare_logistics_ratios(comp_a, comp_b),
      dps_comparison: compare_dps_potential(comp_a, comp_b),
      ewar_comparison: compare_ewar_presence(comp_a, comp_b)
    }
  end

  defp calculate_size_ratio(comp_a, comp_b) do
    size_a = Map.get(comp_a, :fleet_size, 0)
    size_b = Map.get(comp_b, :fleet_size, 0)

    if size_b > 0, do: size_a / size_b, else: 1.0
  end

  defp compare_logistics_ratios(comp_a, comp_b) do
    logi_a = Map.get(comp_a, :logistics_ratio, 0.0)
    logi_b = Map.get(comp_b, :logistics_ratio, 0.0)

    cond do
      logi_a > logi_b * 1.5 -> :side_a_advantage
      logi_b > logi_a * 1.5 -> :side_b_advantage
      true -> :balanced
    end
  end

  defp compare_dps_potential(comp_a, comp_b) do
    # Simplified DPS comparison based on ship types
    dps_a = estimate_fleet_dps(comp_a)
    dps_b = estimate_fleet_dps(comp_b)

    cond do
      dps_a > dps_b * 1.3 -> :side_a_advantage
      dps_b > dps_a * 1.3 -> :side_b_advantage
      true -> :balanced
    end
  end

  defp compare_ewar_presence(comp_a, comp_b) do
    ewar_a = Map.get(comp_a, :ewar_ratio, 0.0)
    ewar_b = Map.get(comp_b, :ewar_ratio, 0.0)

    cond do
      ewar_a > ewar_b * 2 -> :side_a_advantage
      ewar_b > ewar_a * 2 -> :side_b_advantage
      true -> :balanced
    end
  end

  defp estimate_fleet_dps(composition) do
    # Simplified DPS estimation based on fleet size and composition
    fleet_size = Map.get(composition, :fleet_size, 0)

    # Base DPS per ship varies by composition
    # Conservative estimate
    base_dps_per_ship = 150

    fleet_size * base_dps_per_ship
  end

  # Placeholder functions for role coverage analysis
  defp check_support_ship_ratios(_composition), do: []
  defp check_role_coverage(_composition), do: []
  defp check_ship_synergy(_composition), do: []
end
