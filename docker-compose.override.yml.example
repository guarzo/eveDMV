# docker-compose.override.yml.example
#
# Copy this file to docker-compose.override.yml for local customizations.
# The override file is .gitignored and will be auto-created (empty) by the
# devcontainer's initializeCommand if missing.
#
# Compose merges this file on top of docker-compose.yml automatically when
# both are listed in .devcontainer/devcontainer.json's dockerComposeFile.
#
# Mount selections below are user-specific; uncomment what you actually use.

services:
  app:
    volumes:
      # Host SSH keys (Git over SSH, signing). Read-only.
      - ~/.ssh:/home/vscode/.ssh:ro

      # GitHub CLI auth (paired with the github-cli devcontainer feature).
      - ~/.config/gh:/home/vscode/.config/gh:ro

      # Claude Code config + plugins. Cached so writes from inside the
      # container show up on the host.
      - ~/.claude:/home/vscode/.claude:cached

      # OpenCode CLI config.
      - ~/.config/opencode:/home/vscode/.config/opencode:cached

      # Personal dotfiles (sourced by post-create.sh / shell rc).
      - ~/.dotfiles:/home/vscode/.dotfiles:cached,ro

      # Optional: pi agent tooling.
      # - ~/.pi:/home/vscode/.pi:cached

      # Optional: host gitconfig (commit signing / user info).
      # - ~/.gitconfig:/home/vscode/.gitconfig:cached,ro

    # environment:
    #   MY_CUSTOM_VAR: "value"
